    (function () {
      var el = document.querySelector('.lib-item');
      var elNoiDungTin = document.querySelector('#thongTinNganh');
      if (!el || !elNoiDungTin) return;
  
      function updateHeightt() {
        var newHeight1 = ((el.clientHeight * 2) + 30) + 'px';
        elNoiDungTin.style.height = newHeight1;
      }
  
      var resizeObserver = new ResizeObserver(updateHeightt);
      resizeObserver.observe(el);
      window.addEventListener('resize', updateHeightt);
      updateHeightt();
    })();
  </script>


	
	

					
				
			
		
	
	



