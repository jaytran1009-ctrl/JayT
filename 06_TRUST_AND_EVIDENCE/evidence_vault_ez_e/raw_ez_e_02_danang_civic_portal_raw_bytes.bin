    .thongtinnganh .thongtinnganh-container{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      padding-right: 8px;
    }
  
    /* Tùy chỉnh thanh cuộn cho trình duyệt hỗ trợ WebKit (Chrome, Edge, Safari) */
    .thongtinnganh::-webkit-scrollbar {
      width: 4px; /* Độ mỏng của thanh cuộn */
    }
  
    /* Màu nền của thanh cuộn */
    .thongtinnganh::-webkit-scrollbar-track {
      background: #f9f9f9;
    }
  
    /* Màu và hình dạng của nút kéo */
    .thongtinnganh::-webkit-scrollbar-thumb {
      background: #ccc;
        border-radius: 3px;
    }
  
    /* Khi hover vào thanh kéo */
    .thongtinnganh::-webkit-scrollbar-thumb:hover {
      background: #aaa;
    }
  
    .thongtinnganh a {
