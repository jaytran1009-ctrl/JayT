<script>
    (function () {
        var el = document.querySelector('#img-main');
        var elNoiDungTin = document.querySelector('#tinnoibat-trangchu');
        var elImgContainer = document.querySelector('#imgContainer');
        if (!el || !elNoiDungTin || !elImgContainer) return;

        function updateHeightt() {
            var newHeight1 = (el.clientHeight - 50) + 'px';
            var newHeight2 = (el.clientHeight - 50) + 'px';
            if (window.innerWidth < 767) {
                newHeight1 = 'fit-content';
                newHeight2 = el.clientHeight + 'px';
            }
            elNoiDungTin.style.height = newHeight1;
            elImgContainer.style.height = newHeight2;
        }

        var resizeObserver = new ResizeObserver(updateHeightt);
        resizeObserver.observe(el);
        window.addEventListener('resize', updateHeightt);
        updateHeightt();
    })();
</script>

		
		
	




			
			
		
	
	








	
	

					
				
			
		
	
	



