":"Campus TV"}]},{"type":"text","value":" episodes. Campus TV is created by GitHub and student community leaders and can be watched live or on demand."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Discover student-created repositories from GitHub Community Exchange. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/education/about-github-education/github-education-for-students/about-github-community-exchange"},"children":[{"type":"text","value":"About GitHub Community Exchange"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Education students also receive the following GitHub benefits."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"GitHub Copilot:"}]},{"type":"text","value":" Verified students get free access to Copilot and its premium features. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/set-up-copilot/enable-copilot/set-up-for-students"},"children":[{"type":"text","value":"Access GitHub Copilot for free as a student"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"GitHub Codespaces:"}]},{"type":"text","value":" Verified students get free use of GitHub Codespaces, up to 180 core hours per month, for their personal accounts. The monthly amount of storage and core hours of usage available to students is equivalent to the amount included with GitHub Pro accounts. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/billing/concepts/product-billing/github-codespaces"},"children":[{"type":"text","value":"GitHub Codespaces billing"}]},{"type":"text","value":". For more information on getting started with GitHub Codespaces, see "},{"type":"element","tagName":"a","properties":{"href":"/en/codespaces/quickstart"},"children":[{"type":"text","value":"Quickstart for GitHub Codespaces"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nIf students use GitHub Codespaces in their assignment repositories for GitHub Classroom, the usage will be charged to the organization that owns the classroom, and will not affect the usage for a student's personal account. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/education/manage-coursework-with-github-classroom/integrate-github-classroom-with-an-ide/using-github-codespaces-with-github-classroom"},"children":[{"type":"text","value":"Using GitHub Codespaces with GitHub Classroom"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"