<script type="text/javascript">   
function getNotificationsAllRead() {
    $.ajax({
        type: 'POST',
        url: "../../../themes/" + themename + "/modules/users/funcs/main.aspx/getNotificationsAllRead",
        dataType: 'json',

        contentType: "application/json; charset=utf-8",

        success: function (results) {
            getNotificationsCount();
            GetNotification()
        }

    });
}
function NotificationsIsRead(id){		
	$.ajax({
	type: 'POST',
	url: "../../../../../themes/" + themename + "/modules/users/funcs/main.aspx/NotificationsIsRead",
	dataType: 'json',
	data: "{id: " + id+ "}",
	contentType: "application/json; charset=utf-8",
	//data: $('#' + form_id).serialize(),
	success:NotificationsSuccess,
	failure: function (response) {
	// alert(response.d);
	}
	,
	error: function (response) {
	// alert(response.d);
	}
	}
	);}
	NotificationsSuccess = function (data) {
	getNotificationsCount();

	};

	
//Thêm màu nền cho thông báo
$( document ).ready(function() {
	if ($('._show_bgr')) {
	  //alert('Tồn tại');
		$('#NoRead .notification-count').addClass('_bgr');
		getNotificationsCount();
	}
});
function getNotificationsCount() {
    $.ajax({
        type: 'POST',
        url: "../../../themes/" + themename + "/modules/users/funcs/main.aspx/getNotificationsCount",
        dataType: 'json',

        contentType: "application/json; charset=utf-8",

        success: function (results) {
            var strCount = results.d;
            $('._lineSearch').find(".notification-count").html(strCount);
        }

    });
}
function GetNotification() {

    $("#panel_notication").load("../../../../themes/" + themename + "/modules/users/funcs/GetNotification.aspx #tableProducts", function () {

        getNotificationsCount();
    });
}
$(function () {
	GetNotification();
	});

</script>





