        <script async>
            function getNewCookie(Name) {
                var search = Name + "="
                var returnvalue = "";
                if (document.cookie.length > 0) {
                    offset = document.cookie.indexOf(search)
                    // if cookie exists
                    if (offset != -1) {
                        offset += search.length
                        // set index of beginning of value
                        end = document.cookie.indexOf(";", offset);
                        // set index of end of cookie value
                        if (end == -1) end = document.cookie.length;
                        returnvalue = unescape(document.cookie.substring(offset, end))
                    }
                }
                return returnvalue;
            }

            function setNewCookie(what) {
                document.cookie = "show_first=" + what;
            }
            $.removeCookie = function (key, options) {
                if ($.cookie(key) === undefined) { // this line is the problem
                    return false;
                }

                // Must not alter options, thus extending a fresh object...
                $.cookie(key, '', $.extend({}, options, { expires: -1 }));
                return !$.cookie(key);
            };
            $(function () {
                //getEffectAnimation();
                var isShow = 'true';
                //alert(isShow);
                if (isShow == 'true') 
                {
                    // chi hien thi lan dau
                    //alert('1');
                    if (getNewCookie("show_first") == "")
                    {
                        getEffectAnimation();
                        setNewCookie("true");
                    }
                    else
                    {
                        //$('body').addClass('loaded');
                        //$('#loader-wrapper').css('display','none');
                        
                    }
                }
                else
                {
                    $.removeCookie('show_first', { path: '/' });
                    //$.removeCookie("show_first");
                    getEffectAnimation();
                    // hien thi all cac lan
                }
                function getEffectAnimation(){
                    var sideS = $('div#side-bar');
                    var logo = 'UploadImages/logo.png';
                    var $divStrContent = "<div id='_show_logo'><div class='ads_head'><a href='#' class='outPopup'></a></div>"

                                   + "<div class='ads_content'>"
                                       + "<center><img id='imgLogoPreload' alt='' src='/" + logo + "'/><br/><img id='imgIDWhatever' alt='' src='/UploadImages/ajax-ripple.gif'/></center>"
                                    + "</div></div>";

                    var $divLoaderWrapper = $('<div />').attr('id', 'loader-wrapper');
                    var $divLoader = $('<div />').attr('id', 'loader');

                    var $divLoaderLeft = $('<div />').attr('class', 'loader-section section-left');
                    var $divLoaderRight = $('<div />').attr('class', 'loader-section section-right');
                    $divLoader.append($divStrContent);

                    $('.mainpage-main').append($divLoaderWrapper.append($divLoader, $divLoaderLeft, $divLoaderRight));

                    var getTime = 2 * 1000;

                    effectLogo();
                    setTimeout(function () {
                        $('body').addClass('loaded');
                    }, getTime);

                    function effectLogo() {
                        //$('#_show_logo').fadeIn("slow");
                        var cl_head = '.ads_head';
                        var cl_content = '.ads_content';
                        var cl_img = '.ads_content img';
                        var $cl_img = $('.ads_content img');
                        //Get the screen height and width
                        var maskHeight = $(document).height();
                        var maskWidth = $(window).width();
                        //Get the window height and width
                        var winH = $(window).height();
                        var loadW = $('#loader').width();
                        var loadH = $('#loader').height();
                        //var winH_id = $(document).height();
                        //var winW_id = $(document).width();
                        $cl_img.hide();
                        var img = $("img#imgLogoPreload");
                        img.bind('load', function () {
                            if (img.src != "") {
                                var heightimg = $(this).height();
                                var widthimg = $(this).width();
                                //alert(winH);
                                //alert(heightimg);


                                var StrMarginTop = (winH - heightimg) / 2;
                                //alert(StrMarginTop);
                                img.attr('style', 'margin-top:' + StrMarginTop + 'px');
                                //$(cl_img).addClass('_showimg');
                                $(cl_img).animate({
                                    opacity: 1,
                                    'max-width': 'auto', transform: 'scale(0.9, 0.9)',
                                    transition: 'all 0.9s ease-in-out',
                                    '-webkit-transition': 'all 0.9s ease-in-out',
                                    transform: 'scale(2, 0)', '-webkit-transform': 'scale(2, 0)',
                                    //marginTop: (loadH - ((loadH * 2) / 4)) / 2 + 'px',
                                    //            width: (loadW * 2) / 4 + 'px',

                                }, 200, "easeOutCubic", function () {

                                    //$cl_img.show('slow');
                                    //$(cl_img).stop().animate({
                                    //'max-width': 'auto', transform: 'scale(0.9, 0.9)',
                                    //transition: 'all 1s ease-in-out',
                                    //'-webkit-transition': 'all 1s ease-in-out',
                                    //transform: 'scale(2, 0)', '-webkit-transform': 'scale(2, 0)',
                                    //});
                                });

                            }
                        });
                    };
                }
            });
        </script>
        
