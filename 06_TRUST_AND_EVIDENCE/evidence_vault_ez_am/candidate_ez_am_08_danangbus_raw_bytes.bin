				<script type="text/javascript" defer>
					function CheckContact() {

						var valName = "Họ tên không được rỗng!";
						var valEmail = "Địa chỉ email không được rỗng!";
						var valEmailInvalid = "Email không hợp lệ!";
						var valPhone = "Điện thoại không được rỗng!";
						var valContent = "Nội dung không được rỗng!";
						
						if (document.getElementById("ctl00_Widget1970_Widget_ctl00_txtFullName").value.trim() == "") {
							alertTB(valName, document.getElementById("ctl00_Widget1970_Widget_ctl00_txtFullName").focus());

							return false;
						}
						if (document.getElementById("ctl00_Widget1970_Widget_ctl00_txtPhone").value.trim() == "") {
							alertTB(valPhone, document.getElementById("ctl00_Widget1970_Widget_ctl00_txtPhone").focus());

							return false;
						}
						if (document.getElementById("ctl00_Widget1970_Widget_ctl00_txtEmail").value.trim() == "") {
							alertTB(valEmail, document.getElementById("ctl00_Widget1970_Widget_ctl00_txtEmail").focus());

							return false;
						}
						if (!validateEmail(document.getElementById("ctl00_Widget1970_Widget_ctl00_txtEmail").value.trim())) {
							alertTB(valEmailInvalid, document.getElementById("ctl00_Widget1970_Widget_ctl00_txtEmail").focus());

							return false;
						}
						if (document.getElementById("ctl00_Widget1970_Widget_ctl00_txtContent").value.trim() == "") {
							alertTB(valContent, document.getElementById("ctl00_Widget1970_Widget_ctl00_txtContent").focus());

							return false;
						}
						//alert('1');
						return true;
					}

					function ResetForm() {
						document.getElementById("ctl00_Widget1970_Widget_ctl00_txtFullName").value = '';
						document.getElementById("ctl00_Widget1970_Widget_ctl00_txtEmail").value = '';
						document.getElementById("ctl00_Widget1970_Widget_ctl00_txtPhone").value = '';
						document.getElementById("ctl00_Widget1970_Widget_ctl00_txtContent").value = '';

					}
				</script>
