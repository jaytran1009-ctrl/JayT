   <script type="">
       // when form is submit
    grecaptcha.ready(function() {
            // do request for recaptcha token
            // response is promise with passed token
            grecaptcha.execute('6LfedbodAAAAAA0QSFpl7Y2m6WUCDZR__WRpAv2n', {action: 'create_comment'}).then(function(token) {

                console.log(token)
                // add token to form
                $('#recaptcha_value').prepend('<input type="hidden" name="g-recaptcha-response" value="' + token + '">');
                if($("#recaptcha").length> 0){
                     $('#recaptcha').prepend('<input type="hidden" name="g-recaptcha-response" value="' + token + '">');
                }
            });
        });
  </script>
