     <script>
       function openyoutube(link) {

           var srcTL = link;

           var str = "https://www.youtube.com/embed/" + srcTL + "?autoplay=1";

           var iframe = '<div class="iframe-trailer">' +
                     '<iframe src="' + str + '" allowfullscreen></iframe>' +
                     '</div>';

           $('.show-content').append(iframe);
           // Popup Display: block
           $('.popup-main').fadeIn(500);
           $('.popup-opacity').css('display', 'block');
           // Close popup.
           $('.popup-content .close-popup i').click(function () {
               $('.popup-main').fadeOut(0);
               $('.popup-opacity').css('display', 'none');
               $('.iframe-trailer').remove();
           });
       }
        window.onload = function() {
        $.post("PopupHome.aspx", function (data, status) {
           
            if(data == "0" && img != "")
            {
                var img = ''
                var link = ''
                var ytube=''
              
                if(ytube!="")
                {

                    openyoutube(ytube);
                    $.post("closePopupHome.aspx", function (data, status) {
                    
                    });
                    return false;
                }
         
                var video='<video poster="'+img+'" autoplay style="border: white 5px solid;"><source src="'+img+'" type="video/mp4"></video>'
                var imageposter = "<img src='" + img + "' style='border: white 5px solid;width:500px'/>";
                var imgs = "<a href=" + link + " target='_blank'><i class='close-popup'></i>"+imageposter+"</a>";
                $('.show-content-home').append(imgs);
                // Popup Display: block
                $('.popup-main-home').fadeIn(500);
                $('.popup-opacity-home').css('display', 'block');
                // Close popup.
                $('.popup-content-home .show-content-home .close-popup').click(function () {
                    $('.popup-main-home').fadeOut(0);
                    $('.popup-opacity-home').css('display', 'none');
                    $('.show-content-home').empty();
                    return false;

                });
               
            }
            $.post("closePopupHome.aspx", function (data, status) {
               
            });
        });
    }
   </script>

