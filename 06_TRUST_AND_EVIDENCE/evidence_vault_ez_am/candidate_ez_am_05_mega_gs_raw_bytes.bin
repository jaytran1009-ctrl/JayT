        function sumticket() {
            var sum = 0;
            $("tr.tmp").each(function () {
                var a = $(this).find("td:eq(3) span").html().replace(/,/g, '').replace('VND', '').trim();
                if (a == "0.00")
                    a = "0";
                sum += Number(a);

            });

            $("#PanelTK").find('.span-total').html(returnMoney(sum) + " VND");
        }

