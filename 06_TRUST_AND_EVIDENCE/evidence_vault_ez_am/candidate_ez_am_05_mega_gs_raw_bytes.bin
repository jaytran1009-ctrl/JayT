    <script>fbq('track', 'ViewContent');
        var tkold = [];
        var totalpercent = 0;
        var totalTK = [];
        var mv_strname = "";
        var Cinema_strID = "";

        $('#continue-tk').click(function () {
            $('#PanelerrOnepay').hide();
            $('#PanelTK').show();
            $("#PanelerrOnepay").remove();
        });
        getmemberLogin();
        function loadpopup() {

            $("#pop-up-booking").css("display", "block");
            $(".img-loading").css("display", "block");

        }
        function closeloadpopup() {
            $("#pop-up-booking").css("display", "none");
            $(".img-loading").css("display", "none");
        }
        $('#login-btn').click(function () {
            var captcha = grecaptcha.getResponse();
            if (captcha == "") {
                $("#error_login").html("Vui lòng xác nhận mã Captcha.");
                return false;
            }

            var user = $('#email').val().trim();
            var pass = $('#pass').val().trim();

            loadpopup();

            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/LoginVista",
                data: "{email:'" + user + "',pass:'" + pass + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {

                    var obj = JSON.parse(msg.d);
                    var rs = obj.Result
                    if (rs == 0) {
                        var fullname = obj.LoyaltyMember.FullName;
                        var email = obj.LoyaltyMember.Email;
                        var phone = obj.LoyaltyMember.MobilePhone;

                        $.ajax({
                            type: "POST",
                            url: "/Callajax.aspx/login",
                            data: "{fullname:'" + fullname + "',email:'" + email + "',phone:'" + phone + "',pass:'" + pass + "'}",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (msg) {

                                if (msg.d == "ok") {
                                    $(".box-member").css("display", "none");
                                    $("#hello").html("Xin chào: " + fullname);
                                    $("#txtCardName").val(fullname);
                                    $("#txtEmail").val(email);
                                    $("#txtCustPhone").val(phone);

                                }

                            }
                        });
                    }
                    else if (msg.d == "-100") {
                        $("#error_login").html("Vui lòng xác nhận mã Captcha.");

                    }
                    else {
                        $("#error_login").html("Thông tin user không chính xác.");
                    }
                    closeloadpopup();
                }
            });


        });

        function displayTicketType(txtSessionId, Cinema_strID) {
            loadpopup();
            $(".tmp").each(function (i) {
                $(this).remove();

            })
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/GetTicketTypeList",
                data: "{cinema:'" + Cinema_strID + "',SessionMV:'" + txtSessionId + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                    $("#tbl-type-ticket").attr("sessionMV", txtSessionId);
                    $("#tbl-type-ticket").attr("Cinema_strID", Cinema_strID);
                    var obj = $.parseXML(msg.d);
                    lstticketorder = [];
                    $('Table', obj).each(function (i) {

                        var a = $(this).find('AreaCat_strCode').text()
                        var name_vn = $(this).find('Price_strTicket_Type_Description_2').text();
                        var name = $(this).find('Price_strTicket_Type_Description').text();
                        let strHOCode = $(this).find('Price_strTicket_Type_Code').text(); 
                        if (arrHoCode.indexOf(strHOCode) !== -1) {
                            if (name_vn.indexOf("HSSV") !== -1) {
                                name_vn = name_vn.replace("HSSV", "HSSV/NGƯỜI CAO TUỔI");
                            }
                        }
                        if (name.toLowerCase().indexOf("123f") == -1 && name.toLowerCase().indexOf("mv") == -1 && name.toLowerCase().indexOf("mm") == -1 && name.toLowerCase().indexOf("vnp") == -1) {
                            var oder = i;
                            if (name.toLowerCase().indexOf("member") != -1) {
                                oder = 0; // Vé member luôn ở đầu
                            } else if (arrHoCode.indexOf(strHOCode) !== -1) {
                                var hoCodeIndex = arrHoCode.indexOf(strHOCode);
                                oder = 900 + hoCodeIndex; // Vé đặc biệt luôn ở cuối
                            }
                            var price = $(this).find('Price_intTicket_Price').text() + "0";
                            if(Cinema_strID == 'MCT'){
                                if(memberlogin){
                                    if(strHOCode == '0100' || strHOCode == '0097' || strHOCode == "0098"){
                                        var objtr = "<tr class='tmp' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                        objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                            "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                                "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                                "<td class='align-right'><span>0 VND</span></td>";
                                        objtr += "</tr>";
                                        isMemberDay = true;
                                        $("#tbl-type-ticket").addClass('member');
                                    }else{
                                        if(strHOCode != '0185' && strHOCode != "0184" && strHOCode !="0186"){
                                            var objtr = "<tr class='tmp it' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                                objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                                    "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                                        "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                                        "<td class='align-right'><span>0 VND</span></td>";
                                                objtr += "</tr>";
                                        }
                                        
                                    }
                                }else{
                                    // OKI
                                    console.log(strHOCode)
                                    if(strHOCode != '0185' && strHOCode != "0184" && strHOCode !="0186"){
                                        var objtr = "<tr class='tmp' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                        objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                            "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                                "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                                "<td class='align-right'><span>0 VND</span></td>";
                                        objtr += "</tr>";
                                    }   
                                }
                            }else{
                                if(memberlogin){
                                    if(strHOCode == "0025" || strHOCode == "0066"){
                                        var objtr = "<tr class='tmp' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                        objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                            "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                                "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                                "<td class='align-right'><span>0 VND</span></td>";
                                        objtr += "</tr>";
                                        isMemberDay = true;
                                        $("#tbl-type-ticket").addClass('member');
                                    }else{
                                        if(strHOCode != '0073' || strHOCode != "0074"){
                                            var objtr = "<tr class='tmp it' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                                objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                                    "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                                        "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                                        "<td class='align-right'><span>0 VND</span></td>";
                                                objtr += "</tr>";
                                        }                                        
                                        
                                    }
                                }else{
                                    if(strHOCode != "0073" && strHOCode != "0074"){
                                        var objtr = "<tr class='tmp' order='" + oder + "' price='" + price + "' name='" + name + "' arear=" + a + " strHOCode=" + strHOCode + ">";
                                    objtr += "<td>" + name_vn + "<br/><span style='font-size:12px'>" + name + "</span></td>" +
                                        "<td><div class='number-ticket'><i class='fa fa-minus-circle' onclick='minusticket($(this))'></i><span><input type='text' value='0' class='qualyti' readonly></span><i class='fa fa-plus-circle' onclick='plusticket($(this))'></i></div></td>" +
                                            "<td class='align-right'>" + returnMoney(price) + " VND</td>" +
                                            "<td class='align-right'><span>0 VND</span></td>";
                                    objtr += "</tr>";
                                    }
                                    console.log(strHOCode)
                                }
                            }
                            
                            //if (name.toLowerCase().indexOf("member") != -1)
                            //    lstticketorder.splice(0, 0, objtr);
                            //else
                            //    lstticketorder.push(objtr);
                            lstticketorder.push(objtr);

                        }

                    });
                    // Sắp xếp theo thứ tự ưu tiên (order)
                            lstticketorder.sort(function(a, b) {
                                var orderA = parseInt($(a).attr("order"));
                                var orderB = parseInt($(b).attr("order"));
                                return orderA - orderB;
                            });
                    //for (var m = 0; m < lstticketorder.length - 1; m++) {
                    //    for (var n = m + 1; n < lstticketorder.length; n++) {
                    //
                    //        var obj1 = lstticketorder[m];
                    //        var oder = $(obj1).attr("order");
                    //        if (oder != "0") {
                    //            var obj2 = lstticketorder[n];
                    //            var price1 = $(obj1).attr("price");
                    //            var price2 = $(obj2).attr("price");
                    //
                    //            if (parseInt(price1) > parseInt(price2)) {
                    //                var o = lstticketorder[m];
                    //                lstticketorder[m] = lstticketorder[n];
                    //                lstticketorder[n] = o;
                    //            }
                    //        }
                    //    }
                    //}
                    for (var j = 0; j < lstticketorder.length; j++) {
                        var o = lstticketorder[j];
                        $(o).insertBefore($("#tbl-total"));
                    }
                    closeloadpopup();
                    if (lticket.length > 0 && $("#PanelerrOnepay").hasClass("errOp")) {
                        $('.tmp').each(function (i) {

                            for (var x = 0; x < lticket.length; x++) {

                                var a = $(this).attr("strhocode");
                                if (a == lticket[x].TicketTypeCode) {
                                    var qly = lticket[x].Qly;
                                    var price = lticket[x].PriceCents + "0";
                                    var sum = parseInt(qly) * parseInt(price);
                                    $(this).find(".align-right span").html(returnMoney(sum));
                                    $(this).find("span input:text").val(qly);
                                    sumticket();
                                    break;
                                }
                            }
                            //if ($(this).find("span").attr("txtsessionid") == mvsession) {
                            //    bookingClick($(this).find("span"));
                            //}
                        });
                        $.ajax({
                            type: "POST",
                            url: "/callApiAjax.aspx/CancelOrder",
                            data: "{}",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (msg) {
                                lticket = [];
                            }
                        });

                    }

                }
            });
            showbooking();
            $("#errorbooking").remove();
        }

        function showbooking() {
            $("#hello").html("");
            // Popup Display: block
            $('.popup-main-booking').fadeIn(500);
            $('.popup-opacity-booking').css('display', 'block');
            // Close popup.
            $('.popup-content-booking .close-popup i').click(function () {
                if($("table#tbl-type-ticket").hasClass('member')){
                    $("table#tbl-type-ticket").removeClass('member');
                    isMemberDay = false;
                }
                $('.popup-main-booking').fadeOut(0);
                $('.popup-opacity-booking').css('display', 'none');
            });
        }

        function calculerTime(txtSessionId, cinema) {
            var r = true;
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/GetSessionDateTime",
                data: "{sessionMV:'" + txtSessionId + "', cinema:'" + cinema + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (msg) {

                    if (msg.d == "-1")
                        r = false;

                }
            });
            return r;

        }
        function closeerr() {

            $(".popup-opacity").hide();
            $(".popup-main-err").hide();
            $(".popup-main-err .show-content").html("");
        }



        function bookingClickCustom(obj) {
            let CinemaStrID = $(obj).attr("data-cinema");
            if(CinemaStrID != ""){
                $("#tbl-type-ticket").data('cinema', Cinema_strID);
            }
            console.log(CinemaStrID);
            var txtSessionId = $(obj).attr("txtSessionId");
            var t = calculerTime(txtSessionId, CinemaStrID);
            //t = true;
            console.log(t);
            if (t == false) {
                $(".popup-main-err .show-content").html("Đã quá thời hạn đặt vé cho suất chiếu này, vui lòng mua vé tại quầy.");
                $(".popup-opacity").show();
                $(".popup-main-err").show();
                return false;
            }
            var sub = $(obj).attr("submv");
            var imgmv = $(obj).attr("imgmv");
            localStorage.setItem("subtt", sub);
            localStorage.setItem("imgmv", imgmv);

            mv_strname = $(obj).attr("namemv");
			update_age_warning(sub + " - " + mv_strname);
            displayTicketType(txtSessionId, CinemaStrID);
        }


