        <div id="wrapper-main">
            
 <script>
        var list_Mv_Str = [];
        var listmvs;
        $(document).ready(function () {
           listmvs = [{"Id":13468,"image":"/media/77863/nhsnh_1.jpg","poster":null,"thumnail":"","rap":"1144,6277","tenPhim":"NGHỈ HÈ SỢ NGHỈ HƯU","Movie_strName":"NGHI HE SO NGHI HUU [T13]","NiceURL":"/nghi-he-so-nghi-huu/","tenTiengAnh":"","MetaTl":null,"MetaDes":null,"Metakey":null,"banner":null,"noiDung":"<p><span>Nghỉ Hè Sợ Nghỉ Hưu xoay quanh Trí Bình, một chàng trai Gen Z, trở về vùng quê hẻo lánh để trải qua kỳ nghỉ hè cùng ông nội là ông Thời - một cựu chiến binh sống đơn độc nhiều năm. Trí Bình liên tiếp chứng kiến hàng loạt hiện tượng kỳ lạ của ông nội và nhận được những lời cảnh báo rùng rợn từ mọi người. Khi bí mật về ông Thời dần được hé lộ, cậu buộc phải đối mặt với nỗi sợ hãi, vượt qua khoảng cách thế hệ để dần nhận ra các giá trị tưởng chừng đã bị lãng quên. Đan xen giữa tiếng cười, yếu tố tâm linh và những tình huống éo le, Nghỉ Hè Sợ Nghỉ Hưu là câu chuyện về gia đình, sự trưởng thành và hành trình đi tìm câu trả lời cho nỗi trăn trở: “Nếu cả đời này không rực rỡ thì sao?”.</span></p>\n<pre style=\"display: none;\">09:03:48 query returned open=false\n</pre>\n<pre style=\"display: none;\">03:32:18 query returned open=false\n</pre>\n<pre style=\"display: none;\">01:59:50 query returned open=false\n</pre>\n<pre style=\"display: none;\">03:25:37 query returned open=false\n</pre>","trailer":"bxv1cFxSPYM","thoiLuong":"117","theLoai":"Hài hước,Gia đình","khoiChieu":"8/21/2026 12:00:00 AM","tuyChon":"2D,T13","daoDien":"Huỳnh Lập","dienVien":"NSƯT Cao Minh, Cody Nam Võ, Huỳnh Lập, Tín Nguyễn","ngonNgu":"Tiếng Việt,Phụ đề Tiếng Anh","suatChieu":"Phim đang chiếu","phatHanh":"","imdb":"","promotion":"","hot":true,"newMv":false,"sneakShow":false,"hienThiNgay":true,"publish":null},{"Id":13516,"image":"/media/77911/quý-tử-vượt-giàu_470x700.jpg","poster":null,"thumnail":"","rap":"1144,6277","tenPhim":"QUÝ TỬ VƯỢT GIÀU","Movie_strName":"QUY TU VUOT GIAU [K]","NiceURL":"/quy-tu-vuot-giau/","tenTiengAnh":"","MetaTl":null,"MetaDes":null,"Metakey":null,"banner":null,"noiDung":"<p><span>Quý Tử Vượt Giàu xoay quanh gia đình ông Phát, bà Diệp và cậu con trai duy nhất Phú Quý. Để nuôi dạy con cái trưởng thành theo đúng ý mình, vợ chồng Phát - Diệp liên tục gây hoang mang khi tạo ra một cuộc sống lẫn lộn giữa giàu và nghèo, thật và giả. Thế nhưng, khi Phú Quý lớn lên với những lựa chọn khác với kỳ vọng của ba mẹ, hàng loạt tình huống dở khóc dở cười liên tiếp xảy ra, kéo theo những bí mật chưa từng được hé lộ. Ẩn sau màu sắc hài hước là câu chuyện về tình thân, khoảng cách thế hệ và hành trình để ba mẹ lẫn con cái học cách lắng nghe, thấu hiểu nhau.</span></p>\n<pre style=\"display: none;\">08:48:12 query returned open=false\n</pre>\n<pre style=\"display: none;\">08:52:57 query returned open=false\n</pre>\n<pre style=\"display: none;\">01:20:01 query returned open=false\n</pre>\n<pre style=\"display: none;\">03:59:34 query returned open=false\n</pre>","trailer":"dSlL5pEeUoY","thoiLuong":"118","theLoai":"Hài hước,Gia đình","khoiChieu":"8/28/2026 12:00:00 AM","tuyChon":"2D,K","daoDien":"Nguyễn Quang Dũng","dienVien":"Thu Trang, Tiến Luật, Ngô Kiến Huy, Ngân Quỳnh, Hạo Khang, Đình Dương, Thanh Thuỷ, Kiến An","ngonNgu":"Tiếng Việt,Phụ đề Tiếng Anh","suatChieu":"Phim đang chiếu","phatHanh":"","imdb":"","promotion":"","hot":false,"newMv":true,"sneakShow":false,"hienThiNgay":true,"publish":null},{"Id":13485,"image":"/media/77880/788214060_1405306125072705_5650992787147470357_n-1.jpg","poster":null,"thumnail":"","rap":"1144,6277","tenPhim":"HỘ LINH TRÁNG SĨ: BÍ ẨN MỘ VUA ĐINH (RÚT GỌN)","Movie_strName":"HO LINH TRANG SI [T13]","NiceURL":"/ho-linh-trang-si-bi-an-mo-vua-dinh-rut-gon/","tenTiengAnh":"","MetaTl":null,"MetaDes":null,"Metakey":null,"banner":null,"noiDung":"<p><span>Cuối triều Đinh, vua Đinh Tiên Hoàng đột ngột băng hà khiến triều đình rơi vào khủng hoảng. Thù trong chưa yên, giặc ngoài đã lăm le xăm lược. </span></p>\n<p><span>Những tử sĩ được giao nhiệm vụ đưa linh cữu nhà vua đến long mạch để an táng. Cuộc hành trình nhiều cam g