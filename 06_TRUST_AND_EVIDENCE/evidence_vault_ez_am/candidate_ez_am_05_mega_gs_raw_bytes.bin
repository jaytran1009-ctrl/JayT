        $('#submitSeat').click(function (evt) {
            evt.preventDefault();
            evt.stopPropagation();
            var flag = false;
            var totalTicket = 0
             $("#tbl-type-ticket .tmp").each(function (index) {
                var nb = $(this).find("td:nth-child(2) span").find("input[type=text]").val();
                totalTicket = totalTicket + parseInt(nb);
            })

            if(totalTicket <= 0){
                $("#hello").html("Vui lòng lựa chọn số lượng vé.");
                flag = true;
                return false;
            }
            if (flag) {
                return false;
            }
            $("#hello").html("");
            var token = $("#recaptcha_value input[name=g-recaptcha-response]").val();
            var buttonText = $(this).text();
            $(this).prop('disabled', true).html('<i class="fa fa-spin fa-spinner"></i>');
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/VerifyCaptcha",
                data: "{token:'" + token + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                    let obj = JSON.parse(msg.d);
                    console.log(typeof obj.success);
                    console.log(typeof obj.score);
                    if(obj.success != true || obj.score <= 0.5){
                        //$("#hello").html("Vui lòng xác nhận mã Captcha.");
                        return false;
                    }
                    $(this).prop('disabled', false).html(buttonText);
                }
            });

            cancelTK = false;
            totalTK = [];
            var totalcuoples = [];

            var sessionMV = $("#tbl-type-ticket").attr("sessionMV");
            Cinema_strID = $("#tbl-type-ticket").attr("Cinema_strID");

            $.ajax({
                type: "POST",
                url: "/Callajax.aspx/UpdateTitle",
                data: "{filmname:'" + mv_strname.replace(/'/g, '#') + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                    if (msg.d == false) {
                        //$("#hello").html("Vui lòng xác nhận mã Captcha.");
                    }
                    else {
                        $("#tbl-type-ticket .tmp").each(function (index) {
                            var nb = $(this).find("td:nth-child(2) span").find("input[type=text]").val();
                            if (Number(nb) > 0) {
                                var strHOCode = $(this).attr("strhocode");
                                var strArear = $(this).attr("arear");
                                var PriceInCents = Number($(this).find("td:nth-child(3)").html().replace(/,/g, '').replace('VND', '')) / 10;
                                var tk = {
                                    strHOCode: strHOCode,
                                    PriceInCents: PriceInCents,
                                    Qty: nb,
                                    arear: strArear
                                }
                                //if (strHOCode == "0090")
                                //    totalcuoples.push(tk);
                                //else
                                totalTK.push(tk);
                            }
                        });
                        var sumtk = 0;
                        for (var j = 0; j < totalTK.length; j++) {
                            var ve = parseInt(totalTK[j].Qty)
                            if (parseInt(totalTK[j].arear) == 3) {
                                ve = ve * 2;
                            }
                            sumtk += parseInt(ve);
                        }

                        if (sumtk > 10) {
                            $("#hello").html("Xin lỗi, mỗi lần đặt vé bạn chỉ được chọn tối đa 10 vé. Vui lòng chọn 10 ghế hoặc ít hơn.");
							$('#submitSeat').prop('disabled', false).html(buttonText);
                            closeloadpopup();
                            return false;
                        }
                        $.ajax({
                            type: "POST",
                            url: "/callApiAjax.aspx/CancelOrder",
                            data: "{}",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (msg) {
                                var objc = JSON.parse(msg.d);
                                if (objc.Result != 0 && objc.Result != 1)
                                    return false;
                                if (totalTK.length > 0) {
                                    loadpopup();
                                    var myJsonString = JSON.stringify(totalTK);
                                    $.ajax({
                                        type: "POST",
                                        url: "/callApiAjax.aspx/AddTicketsRequest",
                                        data: "{cinema:'" + Cinema_strID + "',SessionMV:'" + sessionMV + "',captcha:'" + token + "',listseat:'" + myJsonString + "'}",
                                        contentType: "application/json; charset=utf-8",
                                        dataType: "json",
                                        success: function (msg) {
                                            var obj = JSON.parse(msg.d);
                                            if (obj.Result == 0) {
                                                getseat(sessionMV)
                                            }
                                            else {

                                                $("#hello").html("Xin lỗi, hiện không có đủ ghế trống cho số vé đã chọn. Vui lòng chọn số ghế ít hơn hoặc giờ chiếu khác.");
												$('#submitSeat').prop('disabled', false).html(buttonText);
                                                try {

                                                    if (tkold.length > 0) {
                                                        var myJsonbk = JSON.stringify(tkold);
                                                        addTicketAgain(myJsonbk)
                                                    }
                                                }
                                                catch (ex) { }
                                                closeloadpopup();
                                            }
                                        }
                                    });

                                }
                            }
                        });
                    }
                }
            });
        });

        function addTicketAgain(myJsonString) {
            if (Cinema_strID == "")
            {
                Cinema_strID = $("#tbl-type-ticket").attr("Cinema_strID");
            }
