            var sessionMV = $("#tbl-type-ticket").attr("sessionMV");
            //alert("sessionMV: " + sessionMV);
            //alert("Cinema_strID: " + Cinema_strID);
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/AddTicketsRequest",
                data: "{cinema:'" + Cinema_strID + "',SessionMV:'" + sessionMV + "',captcha:'" + captcha + "',listseat:'" + myJsonString + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {

                }
            });
        }

        function getseat(a) {
            var sessionMV = $("#tbl-type-ticket").attr("sessionMV");
            Cinema_strID = $("#tbl-type-ticket").attr("Cinema_strID");
            console.log("a:"+a)
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/GetSessionSeatData",
                data: "{cinema:'" + Cinema_strID + "',SessionMV:'" + a + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                    var Seatfail = [];
                    var listAreas = [];
                    var obj = JSON.parse(msg.d);
                    console.log(obj)

                    for (var i = 0; i < obj.SeatLayoutData.AreaCategories.length; i++) {
                        var AreaCategoryCode = obj.SeatLayoutData.AreaCategories[i].AreaCategoryCode;
                        var SeatsNotAllocatedCount = obj.SeatLayoutData.AreaCategories[i].SeatsNotAllocatedCount;
                        var st = {
                            AreaCategoryCode: AreaCategoryCode,
                            SeatsNotAllocatedCount: SeatsNotAllocatedCount,
                            seatRemain: 0
                        }
                        listAreas.push(st);
                    }
                    for (var j = 0; j < listAreas.length; j++) {
                        if (obj.SeatLayoutData.Areas[j].AreaCategoryCode == listAreas[j].AreaCategoryCode) {

                            var ob = obj.SeatLayoutData.Areas[j].Rows;

                            for (var k = 0; k < ob.length; k++) {
                                if (ob[k].PhysicalName != null) {

                                    var count = 0;
                                    for (var m = 0; m < ob[k].Seats.length; m++) {
                                        if (ob[k].Seats[m].Status == 0) {
                                            count++;
                                        }
                                    }
                                    var SeatsNot = parseInt(count);
                                    var SeatsNotpost = parseInt(listAreas[j].SeatsNotAllocatedCount);
                                    var cal = SeatsNot - SeatsNotpost

                                    if (cal >= 0) {
                                        // console.log("ghe trong:" + cal);
                                    }
                                    else {
                                        listAreas[j].seatRemain = cal;
                                        Seatfail.push(listAreas[j])

                                    }
                                }
                            }
                        }
                    }
                    if (Seatfail.length > 0) {

                        var e = "";
                        for (var k = 0; k < Seatfail.length; k++) {
                            $("#tbl-type-ticket .tmp").each(function (index) {
                                var nb = $(this).find("td:nth-child(2) span").find("input[type=text]").val();
                                var AreaCa = $(this).attr("arear");
                                var tkname = $(this).attr("name");
                                if (AreaCa == Seatfail[k].AreaCategoryCode) {
                                    e += tkname + " thiếu:" + Seatfail[k].seatRemain + "<br>";
                                }

                            });
                        }
                        if (totalpercent == 0) {
                            $.ajax({
                                type: "POST",
                                url: "/callApiAjax.aspx/RemoveTickets",
                                data: "{}",
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function (msg) {

                                }
                            });
                        }

                        $("#hello").html(e);
                    }
                    else {
                        location.assign("/Booking.aspx?sessionMV=" + a + "&Cinema_strID=" + Cinema_strID);
                    }
                }
            });
        }

        function getmemberLogin() {

            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/GetMember",
                data: "{}",
                async: false,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {

                    var obj = JSON.parse(msg.d);
                    var Result = obj.Result;
                    if (Result == 0) {
                        memberlogin = true;
                        $('.block-link').hide();
                        $("#txtCardName").val(obj.LoyaltyMember.FullName);
                        $("#txtEmail").val(obj.LoyaltyMember.Email);
                        $("#txtCustPhone").val(obj.LoyaltyMember.MobilePhone);

                    }
                    else {
                        memberlogin = false;
                        $('.box-member').show();
                    }
                }
            });

        }
        function cancelOrderBuyed(vl) {
            $.ajax({
                type: "POST",
                url: "/callApiAjax.aspx/CancelOrder",
                data: "{}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                    if (vl == 2)
                        $("#errorbooking").remove();
                }
            });
        }
