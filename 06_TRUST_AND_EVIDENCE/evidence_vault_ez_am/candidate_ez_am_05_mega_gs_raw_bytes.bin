		function update_age_warning(str_movie_name)
		{
			$("#lbl_age_warning").show();
			
			str = "<p>Tôi xác nhận mua vé cho người đầy đủ _age_ tuổi trở lên và đồng ý cung cấp giấy tờ tùy thân để xác thực độ tuổi người xem. Rạp sẽ không hoàn tiền nếu người xem không đáp ứng đủ điều kiện. Tham khảo quy định của Bộ Văn Hóa, Thể Thao và Du Lịch.</p>";
			
			if (str_movie_name.includes("[T13]")) {
				str = str.replace("_age_", "13");
			} else if (str_movie_name.includes("[T16]")) {
				str = str.replace("_age_", "16");
			} else if (str_movie_name.includes("[T18]")) {
				str = str.replace("_age_", "18");
			} else if (str_movie_name.includes("[K]")) {
				str = "<p>Phim thể loại K người xem dưới 13 tuổi phải có người bảo hộ (bố, mẹ hoặc người thân đủ từ 18 tuổi trở lên) đi kèm. Tôi xác nhận rạp phim không được phép phục vụ khách hàng dưới 13 tuổi cho các suất chiếu kết thúc từ 22:00 và dưới 16 tuổi cho các suất chiếu kết thúc từ 23:00. Tôi đồng ý cung cấp giấy tờ tùy thân để xác thực độ tuổi người xem. Rạp sẽ không hoàn tiền nếu người xem không đáp ứng đủ điều kiện. Tham khảo quy định của Bộ Văn Hóa, Thể Thao và Du Lịch.</p>";
			} else {
				str = "";
				$("#lbl_age_warning").hide();
			}
			
			$("#lbl_age_warning").html(str);
		}
		
        function vemember() {
            var str = "Loại vé này chỉ dành cho Thành viên Mega+. <br><br>Vui lòng ";
            str += "<a href='/LtyHome.aspx'>Đăng nhập</a> hoặc "
            str += "<a href='/LtyCreateUser.aspx'>Đăng ký</a> để hưởng những ";
            str += "<a href='/uu-dai/'>Ưu đãi</a> đặc biệt.";
            $(".popup-main-err .show-content").html(str);
            $(".popup-opacity").show();

            $(".popup-main-err").show();
        }
        let arrHoCode = ['0187','0188','0189','0082','0190','0081','0083','0084'];
        let seniorPopupShown = {}; // Biến cờ để kiểm tra modal đã hiển thị hay chưa
        function minusticket(obj) {
            var ob = $(obj).parent().parent().parent();
            var hoCode = $(ob).attr("strhocode");
            var name = $(ob).attr("name").toLowerCase();
            if (name.indexOf("member") != -1) {
                if (!memberlogin) {
                    vemember();
                    return false;
                }
            }
            var Qlty = $(ob).find("td:eq(1) .qualyti").val();
            if (Number(Qlty) > 0) {
                var sl = Number(Qlty) - 1;
                var pr = $(ob).find("td:eq(2)").html().replace(/,/g, '').replace('VND', '').trim();
                $(ob).find("td:eq(1) .qualyti").val(sl);
                $(ob).find("td:eq(3) span").html(returnMoney(pr * sl) + " VND");
                sumticket();

                // Nếu số lượng giảm về 0, đặt lại trạng thái popup
                if (sl === 0 && arrHoCode.indexOf(hoCode) != -1) {
                    seniorPopupShown[hoCode] = false;
                    console.log("Đặt lại trạng thái popup cho hoCode: " + hoCode);
                }
            } 
        }
        function plusticket(obj) {
            var ob = $(obj).parent().parent().parent();
            var area = parseInt($(ob).attr("arear"));
            var hoCode = $(ob).attr("strhocode");
            var name = $(ob).attr("name").toLowerCase();
            if (name && name.indexOf("member") != -1) {
                if (!memberlogin) {
                    vemember();
                    return false;
                }
            }
            var Qlty = $(ob).find("td:eq(1) .qualyti").val();
            var sl = Number(Qlty) + 1;

            // Kiểm tra giới hạn số lượng
            if (area == 3 && sl > 5) {
                return false;
            }
            if (sl > 10) {
                return false;
            }

            // Lưu tham chiếu đến đối tượng hiện tại để sử dụng trong sự kiện click
            var currentObj = ob;
            
            // Kiểm tra và hiển thị modal nếu hoCode thuộc danh sách cần hiển thị popup và chưa hiển thị trước đó
            if (arrHoCode.indexOf(hoCode) != -1 && Number(Qlty) === 0) {
                if (!seniorPopupShown[hoCode]) {
                    // Lưu thông tin vào modal để sử dụng sau này
                    $('#popup-senior').attr('data-hocode', hoCode);
                    $('#popup-senior').data('currentObj', currentObj);
                    $('#popup-senior').modal('show');
                    $('div.popup-main-booking').addClass('isNeedHide');
                    return; // Không tăng số lượng ngay, đợi người dùng xác nhận
                }
            }
            
            // Nếu không cần hiển thị popup hoặc đã hiển thị trước đó, tăng số lượng ngay
            var pr = $(ob).find("td:eq(2)").html().replace(/,/g, '').replace('VND', '').trim();
            $(ob).find("td:eq(1) .qualyti").val(sl);
            $(ob).find("td:eq(3) span").html(returnMoney(pr * sl) + " VND");
            sumticket();
        }

        // Cập nhật sự kiện click nút "Đồng ý"
        $("#btnAgree").click(function (e) {
            e.preventDefault(); // Ngăn chặn hành vi mặc định của nút
            var hoCode = $("#popup-senior").attr('data-hocode'); // Lấy hoCode từ data attribute
            var currentObj = $("#popup-senior").data('currentObj'); // Lấy đối tượng hiện tại
            
            // Đánh dấu đã hiển thị popup cho hoCode này
            seniorPopupShown[hoCode] = true;
            
            // Đóng modal
            $("#popup-senior").modal("hide");
            
            // Tăng số lượng vé
            if (currentObj) {
                var Qlty = $(currentObj).find("td:eq(1) .qualyti").val();
                var sl = Number(Qlty) + 1;
                var pr = $(currentObj).find("td:eq(2)").html().replace(/,/g, '').replace('VND', '').trim();
                $(currentObj).find("td:eq(1) .qualyti").val(sl);
                $(currentObj).find("td:eq(3) span").html(returnMoney(pr * sl) + " VND");
                sumticket();
            }
        });

        // Cập nhật sự kiện click nút "Đóng"
        $("#btnCancel").click(function (evt) {
            evt.preventDefault(); // Ngăn chặn hành vi mặc định của nút
            // Không tăng số lượng, chỉ đóng modal
            $("#popup-senior").modal("hide");
            
            // Không đánh dấu đã hiển thị, để lần sau vẫn hiện popup
            var hoCode = $("#popup-senior").attr('data-hocode');
            seniorPopupShown[hoCode] = false;
        });

        $('#popup-senior').on('show.bs.modal', function (e) {
            // Thêm hiệu ứng fadeIn
            $(this).find('.modal-dialog').hide().fadeIn(500); // 500ms là thời gian hiệu ứng
        });

        $('#popup-senior').on('hide.bs.modal', function (e) {
            // Thêm hiệu ứng fadeOut
             $('div.popup-main-booking').removeClass('isNeedHide'); // Hiển thị modal
        });

        $(document).ready(function () {
                // Xử lý sự kiện click nút "Hủy"
