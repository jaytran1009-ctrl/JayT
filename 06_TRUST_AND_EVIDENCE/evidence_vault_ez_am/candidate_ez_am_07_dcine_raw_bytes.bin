<script>
    window.onload = function () {
        var modal = getCookie("key");
        if (modal != "") {

        } else {
            $.ajax({
                url: "/Home/GetAdsImage",
                type: "GET",
                traditional: true,
                dataType: "json",
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //alert(data);
                    if (data != null && data.ID != null && data.Avartar != null && data.Avartar!="") {
                        $("#adsImage").attr("src", data.Avartar);
                        $("#adsImageModal").modal('show');
                        sessionStorage.setItem("key", "modal");
                        var href = "#";
                        if (data.ID_Film != null && data.ID_Film != "") {
                            href = "/film/detail/" + data.ID_Film + ".html";
                        }
                        if (data.ID_Promotion != null && data.ID_Promotion != "") {
                            href = "/uu-dai/detail-" + data.ID_Promotion + ".html";
                        }
                        if (data.ID_Article != null && data.ID_Article != "") {
                            href = "/dich-vu/detail-" + data.ID_Article + ".html";
                        }
                        $("#adsImageHref").attr("href", href);
                        return false;
                    } else {

                        return false;
                    }
                },
                error: function () {
                    return false;
                }
            });
        }

    }
    function getCookie(cname) {
        var ca = sessionStorage.getItem(cname);
        if (ca == null || ca == "") {
            return "";
        }
        else
            return ca;
    }
</script>
