</div></div></div></main></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"res":{"listMovie":[{"id":"1313b952-017c-445a-8388-9c7d2b7da839","name_vn":"NGHỈ HÈ SỢ NGHỈ HƯU (T13)","name_en":"","director":"Huỳnh Lập","actor":"NSƯT Cao Minh, Cody Nam Võ, Huỳnh Lập, Tín Nguyễn","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,41eddd0c-c45b-43ff-9988-8e59921f0c1c","type_name_vn":"Hài, Gia đình","type_name_en":"Comedy, Family","release_date":"8/21/2026 12:00:00 AM","end_date":"10/3/2026 12:00:00 AM","brief_vn":"Nghỉ Hè Sợ Nghỉ Hưu xoay quanh Trí Bình, một chàng trai Gen Z, trở về vùng quê hẻo lánh để trải qua kỳ nghỉ hè cùng ông nội là ông Thời - một cựu chiến binh sống đơn độc nhiều năm. Trí Bình liên tiếp chứng kiến hàng loạt hiện tượng kỳ lạ của ông nội và nhận được những lời cảnh báo rùng rợn từ mọi người. Khi bí mật về ông Thời dần được hé lộ, cậu buộc phải đối mặt với nỗi sợ hãi, vượt qua khoảng cách thế hệ để dần nhận ra các giá trị tưởng chừng đã bị lãng quên. Đan xen giữa tiếng cười, yếu tố tâm linh và những tình huống éo le, Nghỉ Hè Sợ Nghỉ Hưu là câu chuyện về gia đình, sự trưởng thành và hành trình đi tìm câu trả lời cho nỗi trăn trở: “Nếu cả đời này không rực rỡ thì sao?”.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/nhsnh_1.jpg","himage":"","trailer":"BtnVSMZJgDg","status":"2","ratings":"","time":"117","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"1"},{"id":"97ea253e-282b-4742-a200-0b72b958d6b6","name_vn":"QUÝ TỬ VƯỢT GIÀU (K)","name_en":"","director":"Nguyễn Quang Dũng","actor":"Thu Trang, Tiến Luật, Đình Dương, Hạo Khang","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,41eddd0c-c45b-43ff-9988-8e59921f0c1c","type_name_vn":"Hài, Gia đình","type_name_en":"Comedy, Family","release_date":"8/28/2026 12:00:00 AM","end_date":"10/31/2026 12:00:00 AM","brief_vn":"Cùng chờ đón hành trình vượt giàu đầy “nổi loạn” nhưng nhiều ý nghĩa, nơi tiếng cười có thể trào đến bất chợt, những bất ngờ tạt ngang không báo trước và những câu chuyện gia đình khẽ chạm nhịp trái tim.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/qtvg.jpg","himage":"","trailer":"fJs5ybbxPys","status":"2","ratings":"","time":"118","limitage_id":"c697c844-1c87-42a9-b255-c675aa8874b0","limitage_vn":"K","limitage_en":"K","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"2"},{"id":"b90102bd-5da1-4bb7-ba16-43274b40dd89","name_vn":"QUỶ QUYỆT: RANH GIỚI VÔ ĐỊNH (T16)","name_en":"INSIDIOUS: OUT OF THE FURTHER (T16)","director":"Jacob Chase","actor":"Amelia Eve, Island Austin, Lin Shaye, Sam Spruell, Brandon Perea, and Masie Richardson- Sellers","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"8/21/2026 12:00:00 AM","end_date":"9/26/2026 12:00:00 AM","brief_vn":"Insidious:Quỷ Quyệt: Ranh Giới Vô Định xoay quanh Gemma (Amelia Eve), một bà mẹ trẻ trở về sống trong ngôi nhà thời thơ ấu cùng con gái và phát hiện mình có thể bước vào Cõi Vô Định, nơi giam giữ những linh hồn lạc lối. Nhưng Gemma không chỉ có thể bước vào Cõi Vô Định, cô còn sở hữu năng lực đưa những thực thể từ đó trở về thế giới thực. Khi các thế lực tà ác phát hiện ra sức mạnh này, ranh giới giữa hai thế giới dần sụp đổ, biến thế giới của người sống thành sân chơi của quỷ dữ.","brief_en":"In Insidious: Out of the Further, Amelia Eve stars as Gemma, a young mother raising her daughter in the house she grew up in who discovers she can travel into The Further, the purgatorial realm of lost souls at the heart of the Insidious universe. When something evil comes after her, Gemma discovers an ability that changes everything: she doesn’t just enter The Further, she can bring what lives there back to the real world. Once the demons realize her power, our world becomes their playground.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/insidious-poster.jpg","himage":"","trailer":"Wyi34oTVmu4","status":"2","ratings":"","time":"106","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"3"},{"id":"5451a720-c7c3-4d17-ae4d-c4c7e17fb608","name_vn":"PHIM SHIN – CẬU BÉ BÚT CHÌ: KỲ KỲ QUÁI QUÁI! KỲ NGHỈ YÊU QUÁI CỦA TỚ LT (P)","name_en":"CRAYON SHIN-CHAN THE MOVIE: SPOOKY! MY YOKAI VACATION DUB (P)","director":"Masaki Watanabe","actor":"Yumiko Kobayashi, Miki Narahashi, Toshiyuki Morikawa, Satomi Koorogi","country_id":"ab21efed-68c1-4fcc-a172-3496f0bf9539","country_name_vn":"Khác","country_name_en":"Other","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6","type_name_vn":"Hoạt hình","type_name_en":"Cartoon","release_date":"8/21/2026 12:00:00 AM","end_date":"8/29/2026 12:00:00 AM","brief_vn":"Lấy bối cảnh mùa hè tại Akita, bộ phim theo chân Shin và gia đình Nohara trong chuyến về quê đầy háo hức. Tuy nhiên, một sự kiện kỳ lạ đã đưa cả gia đình lạc vào Xứ sở Yêu quái bí ẩn – nơi con người không được phép đặt chân tới. \r\n\r\nTại đây, Shin và gia đình phải đối mặt với những thử thách chưa từng có, đồng thời gặp gỡ hàng loạt yêu quái độc đáo, hài hước và đáng yêu. Với sự kết hợp giữa yếu tố phiêu lưu, kỳ ảo, hài hước đặc trưng của Shin-chan cùng những thông điệp gia đình ấm áp, bộ phim hứa hẹn mang đến một hành trình giải trí hấp dẫn cho khán giả ở mọi lứa tuổi trong mùa hè này.","brief_en":"Set against the summer backdrop of Akita, the film follows Shin and the Nohara family as they excitedly return to their hometown for a vacation. However, a mysterious incident unexpectedly transports the entire family to a hidden Yokai Kingdom — a magical world where humans are forbidden to enter. \r\n\r\nThere, Shin and his family must overcome a series of unprecedented challenges while encountering a colorful cast of unique, funny, and lovable yokai. Blending adventure, fantasy, and the signature humor of the *Crayon Shin-chan* franchise with heartwarming family values, the film promises an entertaining and memorable journey for audiences of all ages this summer","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/shinn.jpg","himage":"","trailer":"GR_kHLWYASg","status":"2","ratings":"","time":"101","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"192bf4fb-4904-4f4c-8b52-8cbf760c234b","language_vn":"Lồng Tiếng","language_en":"VN","sortorder":"4"},{"id":"fa29aa3c-d64e-458e-b6b0-f3d8a936540b","name_vn":"CHIIKAWA: BÍ MẬT ĐẢO NGƯỜI CÁ\n LT","name_en":"CHIIKAWA THE MOVIE: THE SECRET OF THE MARMAID ISLAND DUB","director":"Kei Oikawa","actor":"Haruka Aoki, Makoto Tanaka, Ari Ozawa, Yuka Iguchi, Takayuki Asai, Yuma Uchida, Miyuri Shimabukuro, Momo Harumi","country_id":"ab21efed-68c1-4fcc-a172-3496f0bf9539","country_name_vn":"Khác","country_name_en":"Other","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6","type_name_vn":"Hoạt hình","type_name_en":"Cartoon","release_date":"8/28/2026 12:00:00 AM","end_date":"9/26/2026 12:00:00 AM","brief_vn":"Bộ ba Chiikawa, Hachiware và Usagi nhận được một lời mời tham gia chuyến đi đến hòn đảo đặc biệt với những phần thưởng và đồ ăn miễn phí. Cả nhóm cùng lên đường phiêu lưu ra đảo cùng với nhân vật Rakko – người vốn mang lòng hoài nghi về những lời hứa hẹn trong tờ rơi. Hòn đảo tưởng chừng vui vẻ này lại ẩn chứa nhiều điều kỳ bí và bí mật lâu đời liên quan đến người cá.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/chiikawa.jpg","himage":"","trailer":"NZazo4VtbOI","status":"2","ratings":"","time":"99","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"192bf4fb-4904-4f4c-8b52-8cbf760c234b","language_vn":"Lồng Tiếng","language_en":"VN","sortorder":"5"},{"id":"fe19c512-3fd3-4aa6-870c-10912bb8c0b0","name_vn":"HỘ LINH TRÁNG SĨ (T13): BÍ ẨN MỘ VUA ĐINH (TG)","name_en":"","director":"Nguyễn Phan Quang Bình","actor":"Tuấn Trần, Trần Thiên Tú, NSND Tự Long, ...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"8/28/2026 12:00:00 AM","end_date":"9/30/2026 12:00:00 AM","brief_vn":"Phim huyền sử Hộ linh tráng sĩ: Bí ẩn mộ vua Đinh (phiên bản thu gọn) mở đầu bằng trận chiến 12 sứ quân oanh liệt của Đinh Tiên Hoàng đế và về hành trình của 7 hộ linh tráng sĩ trong nhiệm vụ cuối cùng Tiên Đế giao. Họ phải chạy đua với thời gian, đối đầu với các thế lực thù địch, đưa 99 quan tài của vua đi theo 7 hướng khác nhau, đánh lừa kẻ thù âm mưu phá hoại lăng mộ - nơi được tin là cội nguồn vượng khí của dân tộc.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/ho-linh-trang-si-tg.jpg","himage":"","trailer":"mYuWqh8nSC4","status":"2","ratings":"","time":"135","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"6"},{"id":"b080b97d-c762-485c-89a1-ea6251dfa1e2","name_vn":"HỘ LINH TRÁNG SĨ: BÍ ẨN MỘ VUA ĐINH (T13)","name_en":"","director":"Nguyễn Phan Quang Bình","actor":"Tuấn Trần, Trần Thiên Tú, NSND Tự Long, ...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1332aedc-fea4-4bd9-97f9-3183b964f0b0,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Sử Thi, Hành Động","type_name_en":"Historical, Action","release_date":"8/28/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Phim huyền sử Hộ linh tráng sĩ: Bí ẩn mộ vua Đinh mở đầu bằng trận chiến 12 sứ quân oanh liệt của Đinh Tiên Hoàng đế và về hành trình của 7 hộ linh tráng sĩ trong nhiệm vụ cuối cùng Tiên Đế giao. Họ phải chạy đua với thời gian, đối đầu với các thế lực thù địch, đưa 99 quan tài của vua đi theo 7 hướng khác nhau, đánh lừa kẻ thù âm mưu phá hoại lăng mộ - nơi được tin là cội nguồn vượng khí của dân tộc.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/ho-linh-trang-si-poster.jpg","himage":"","trailer":"mYuWqh8nSC4","status":"2","ratings":"","time":"155","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"7"},{"id":"2950f27b-77c3-4c66-9637-dc2c21c2d3fe","name_vn":"TÀU BUÔN NGƯỜI (T18)","name_en":"MUTINY (T18)","director":"Jean-François Richet","actor":"Jason Statham\n, Annabelle Wallis, \nAdrian Lester","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"8/28/2026 12:00:00 AM","end_date":"9/19/2026 12:00:00 AM","brief_vn":"\"Mutiny (Tàu buồn người) kể về Cole Reed do Jason Statham thủ vai, sau khi tận mắt chứng kiến ông chủ tỷ phú của mình bị sát hại và bản thân trở thành kẻ thế thân bị vu oan, Cole Reed (Jason Statham) đã đột nhập lên một con tàu chở hàng để bắt đầu hành trình truy tìm sự thật và trả thù cho vị sếp cũ. Tuy nhiên, chuyến đi đơn độc này lại đẩy anh vào nguy hiểm khi Cole vô tình bóc trần một âm mưu quốc tế quy mô và cực kỳ nguy hiểm.","brief_en":"Mutiny follows Cole Reed, played by Jason Statham. After witnessing the brutal murder of his billionaire employer and being framed as the fall guy for the crime, Cole secretly boards a cargo ship to uncover the truth and avenge his former boss. But what begins as a lone mission for justice quickly turns into a fight for survival when he accidentally exposes a vast and highly dangerous international conspiracy.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/tau-buon-nguoi-poster.jpg","himage":"","trailer":"CH7AgfKEhW4","status":"2","ratings":"","time":"95","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"8"},{"id":"a9ac00a3-353d-4bce-80b9-bb5e33130778","name_vn":"HOPE VÙNG TỬ ĐỊA (T16)","name_en":"HOPE (T16)","director":"Na Hong-Jin","actor":"Hwang Jung-min, Zo In-sung, Hoyeon, Taylor Russell, Cameron Britton, Alicia Vikander, Michael Fassbender","country_id":"7489bd65-9802-42b5-ba2e-941baaefa44b","country_name_vn":"Hàn quốc","country_name_en":"Korea","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454,0a965518-4d8c-4483-b9a3-bb56424dcade","type_name_vn":"Hành Động, Khoa Học Viễn Tưởng","type_name_en":"Action, Science fiction","release_date":"9/4/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Tại Hope Harbor, một ngôi làng hẻo lánh nằm gần khu vực phi quân sự, cảnh sát trưởng Bum-seok đã nhận được tin báo khẩn cấp từ người dân địa phương về sự xuất hiện của một con hổ. Khi cả ngôi làng chìm trong hoảng loạn, Bum-seok ngỡ ngàng khi phát hiện một sự thật nằm ngoài sức tưởng tượng của con người.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/hope.jpg","himage":"","trailer":"aLdm8oL6PYg","status":"2","ratings":"","time":"99","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"9"},{"id":"c56bb75c-793d-4316-be58-50dd550dd778","name_vn":"MA TÙ (T18)","name_en":"GHOST IN THE CELL (T18)","director":"Joko Anwar","actor":"Abimana Aryasatya, Almanzo Konoralma, Aming Sugandhi,...","country_id":"0f7b6dc5-cb3d-4f4f-94fb-f1bc3505605f","country_name_vn":"Indonesia","country_name_en":"Indonesia","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"9/4/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Một tù nhân bí ẩn xuất hiện trong một nhà tù khét tiếng bạo lực nhất Indonesia, mang theo một thực thể siêu nhiên chỉ săn lùng những kẻ có năng lượng tiêu cực. Để sống sót, các tù nhân buộc phải cùng nhau làm việc thiện nhằm xóa bỏ bóng tối trong tâm hồn. Hoặc chết từng người một.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/ma-tu.jpg","himage":"","trailer":"","status":"2","ratings":"","time":"105","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"10"},{"id":"7e2391f4-e40b-45f9-88b6-debc10473aa7","name_vn":"SIÊU CHÓ ĐẠP GIÓ ĐÓN LỄ LT","name_en":"CHARLIE THE WONDERDOG DUB","director":"Shea Wageman","actor":"Owen Wilson, Vincent Tong, Tabitha St. Germain","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,01912ab9-7d92-4ae4-aee9-84e02b09b8ac,41eddd0c-c45b-43ff-9988-8e59921f0c1c","type_name_vn":"Hoạt hình, Hài, Gia đình","type_name_en":"Cartoon, Comedy, Family","release_date":"8/28/2026 12:00:00 AM","end_date":"9/26/2026 12:00:00 AM","brief_vn":"Charlie – chú chó cưng đáng yêu của Danny – bất ngờ bị người ngoài hành tinh bắt cóc và trao cho những siêu năng lực đặc biệt. Nhưng Charlie không phải là “siêu thú” duy nhất trong khu phố khi Puddy – chú mèo tinh quái nhà bên – cũng sở hữu những năng lực phi thường.\n\nCuộc đối đầu giữa hai “siêu thú” mở ra hàng loạt tình huống hài hước, bất ngờ và đầy thú vị, đồng thời mang đến những khoảnh khắc đáng yêu về tình bạn, tình cảm gia đình và tình yêu dành cho các loài vật. Liệu Charlie có thể làm chủ sức mạnh mới và vượt qua những thử thách đang chờ đợi phía trước?","brief_en":"Charlie, Danny’s adorable pet dog, is suddenly abducted by aliens and gifted with extraordinary superpowers. But Charlie isn’t the only “super pet” in the neighborhood. Puddy, the mischievous cat next door, also possesses extraordinary abilities.\r\n\r\nThe clash between these two “super pets” leads to a series of hilarious, unexpected, and entertaining adventures, while bringing heartwarming moments about friendship, family, and the love we share with our furry companions. Can Charlie master his newfound powers and overcome the challenges that await?","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/sieu-cho.jpg","himage":"","trailer":"lWwep5RZQa0","status":"2","ratings":"","time":"95","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"192bf4fb-4904-4f4c-8b52-8cbf760c234b","language_vn":"Lồng Tiếng","language_en":"VN","sortorder":"11"},{"id":"3ec815e5-5718-4388-8952-dda5e9d25780","name_vn":"HÀNH TRÌNH BẤT HẢO (T18)","name_en":"THE JOURNEY TO GYEONG-JU (T18)","director":"KIM MI-JO","actor":"LEE JUNG-EUN, KONG HYO-JIN, PARK SO-DAM \u0026 LEE YEON","country_id":"7489bd65-9802-42b5-ba2e-941baaefa44b","country_name_vn":"Hàn quốc","country_name_en":"Korea","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,41eddd0c-c45b-43ff-9988-8e59921f0c1c,39021e14-664c-4d4c-bb93-90f8aa1a0270","type_name_vn":"Hài, Gia đình, Phiêu Lưu","type_name_en":"Comedy, Family, Adventure","release_date":"9/4/2026 12:00:00 AM","end_date":"10/3/2026 12:00:00 AM","brief_vn":"Bị bóp nghẹt bởi nỗi đau mất đi đứa con gái út, bốn mẹ con quyết tâm thực hiện kế hoạch bắt cóc kẻ giết người vừa được tại ngoại sau 8 năm thụ án. Chuyến du lịch ‘chữa lành’ sẽ là chứng cứ ngoại phạm hoàn hảo hay sẽ là hành trình đầy sóng gió cho những “sát thủ nghiệp dư”?","brief_en":"A mother and her three daughters are still very sad about losing their youngest daughter. Now, the man who killed her has just gotten out of prison after 8 years. The mother and her daughters plan to kidnap him. Will this 'healing' family trip be the perfect alibi - or a bumpy road for these amateur 'killers'","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/hanh-trinh-bat-hao.jpg","himage":"","trailer":"_yoVSfZLV2E","status":"2","ratings":"","time":"111","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"12"},{"id":"7ffbbcbc-9282-4d7d-a807-5465829a2e7a","name_vn":"QUỶ MÓC MẮT (T18)","name_en":"THE DJINN'S CURSE 2 (T18)","director":"Kriangkrai Monwichit","actor":"Mim - Rattanawadee, Euro - Yotsawat Tawapee, Pammy - Sutida Buatik, Pin - Peeyarat Jatuporn,...","country_id":"6fdea6f9-c68b-4925-a1ab-f6b19b064fe2","country_name_vn":"Thái lan","country_name_en":"Thailan","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"8/21/2026 12:00:00 AM","end_date":"9/5/2026 12:00:00 AM","brief_vn":"Tại một ngôi làng nhỏ dưới chân núi Budo, Deana - một cô gái trẻ vừa mới kết hôn với Anas - bắt đầu có những biểu hiện kỳ lạ sau khi mất tích bí ẩn trong khu rừng Budo suốt hai đêm liền. Cô trở nên điên loạn, bạo lực và tấn công tất cả mọi người trong nhà, cho đến khi Baboding, anh trai của cô, phải can thiệp khống chế. Cuối cùng, để chấm dứt thảm kịch, Anas đã buộc phải đưa ra một quyết định đau đớn tột cùng: nổ súng bắn chết chính người vợ của mình. Không thể chấp nhận mất mát này, Anas tin rằng linh hồn của Deana vẫn đang bị giam cầm trong thế giới của quỷ Djinn. Anh quyết định hợp lực cùng em gái mình là Ya, tìm mọi cách để đưa Deana trở về. Cùng lúc đó, Lin - một nữ sinh viên đại học tại Narathiwat - đã rủ người bạn thân Banglee đến Thác Pajo để thu thập mẫu đá cho dự án nghiên cứu của giáo sư. Tuy nhiên, cả hai đã đi lạc và chia cắt nhau trong rừng sâu. Sự cố này đã vô tình dẫn Lin bước vào thế giới của quỷ Djinn — một cõi dị giới chuyên nuốt chửng linh hồn con người để thế mạng. Đến cuối cùng, tất cả đều phải đánh đổi và hy sinh để ngăn chặn thế lực tà ác đang chực chờ tàn phá từ núi Budo.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/quy-moc-mat.jpg","himage":"","trailer":"hl2auobxyVg","status":"2","ratings":"","time":"97","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"13"},{"id":"8bdf7f44-daff-49b5-85c5-18404c289f07","name_vn":"PAW PATROL: PHIM KHỦNG LONG LT (P)","name_en":"PAW PATROL: THE DINO MOVIE DUB (P)","director":"Cal Brunker","actor":"Cal Brunker \u0026 Bob Barlen","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,39021e14-664c-4d4c-bb93-90f8aa1a0270,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hoạt hình, Phiêu Lưu, Hành Động","type_name_en":"Cartoon, Adventure, Action","release_date":"8/14/2026 12:00:00 AM","end_date":"9/18/2026 12:00:00 AM","brief_vn":"Khi con tàu của Paw Patrol bị cuốn vào một cơn bão bí ẩn, đội cún cứu hộ vô tình lưu lạc đến một hòn đảo nhiệt đới vô danh, nơi sinh sống của nhiều loài khủng long cổ xưa. Họ gặp Rex, một chuyên gia về khủng long, đã mắc kẹt trên hòn đảo này trong nhiều năm. Mọi chuyện trở nên tệ hơn khi Thị trưởng Humdinger, đối thủ không đội trời chung của PAW Patrol rắp tâm khai thác nguồn tài nguyên thiên nhiên tại đây, và vô tình gây ra trận phun trào của một ngọn núi lửa khổng lồ. Đứng trước nguy cơ hòn đảo bị xóa sổ, đội cún cứu hộ phải thực hiện những nhiệm vụ quy mô \"khủng\" hơn bao giờ hết để ngăn chặn Humdinger và cứu các loài khủng long khỏi nạn tuyệt chủng.","brief_en":"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/paw-patrol.jpg","himage":"","trailer":"","status":"2","ratings":"","time":"89","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"192bf4fb-4904-4f4c-8b52-8cbf760c234b","language_vn":"Lồng Tiếng","language_en":"VN","sortorder":"14"},{"id":"dd3e4246-406b-4f69-a3c3-3c7dcaee2f7a","name_vn":"CÒI BÁO TỬ (T18)","name_en":"WHISTLE (T18)","director":"Corin Hardy","actor":"Dafne Keen, Sophie Nélisse, Sky Yang","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"8/21/2026 12:00:00 AM","end_date":"9/19/2026 12:00:00 AM","brief_vn":"Một nhóm học sinh cá biệt vô tình nhặt được một cổ vật Aztec bị nguyền rủa. Mỗi khi tiếng còi ám ảnh ấy cất lên, nó không chỉ xé tan không gian bằng âm thanh rợn người, mà còn đánh thức và triệu hồi chính \"cái chết trong tương lai\" của từng người tìm đến đi săn họ. Liệu nhóm bạn có thể giải mã bí ẩn của lời nguyền trước khi từng người một phải đối mặt với kết cục thảm khốc của chính mình?","brief_en":"A misfit group of high school students accidentally unearths a cursed Aztec artifact. They soon discover a horrifying truth: every time the haunting whistle is blown, its spine-chilling sound doesn't just shatter the silence—it awakens and summons their own future deaths to hunt them down. Can the group unravel the mystery of the curse before each of them faces their own grim fate?","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/coi-bao-tu-poster.jpg","himage":"","trailer":"D7bqlyS3h74","status":"2","ratings":"","time":"100","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"15"},{"id":"c5acbb16-2c4e-4acf-9af6-c8616eadcd8c","name_vn":"MỘT ĐÊM DUY NHẤT (T18)","name_en":"ONE NIGHT ONLY (T18)","director":"Will Gluck","actor":"Monica Barbaro, Callum Turner, Maya Hawke","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1bfe9d04-d045-405f-b2b0-22eb5be4c13b","type_name_vn":"Tình Cảm","type_name_en":"Romance","release_date":"9/4/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Sẽ ra sao nếu một đêm hỗn độn lại trở thành điều tuyệt vời nhất từng xảy ra trong đời bạn? Allie và Owen, hai kẻ xa lạ đang \"đói khát\" tình yêu, vô tình va vào nhau giữa lòng New York phiên bản được hư cấu đôi chút, vào đúng đêm duy nhất trong năm hội độc thân được phép \"làm chuyện ấy\". Chàng trai Owen vừa bị đá và cô nàng Allie mộng mơ có lẽ là hai kẻ độc thân duy nhất trong thành phố đang tìm kiếm điều gì đó ý nghĩa hơn là một cuộc tình chóng vánh. Cả hai dường như đã rung động ngay từ lần đầu gặp gỡ, nhưng hàng loạt tình huống dở khóc dở cười cùng những rắc rối phát sinh càng khiến đêm hôm đó trở nên phức tạp và đẩy họ ra xa nhau. Trong lúc mải miết đuổi theo rồi lại vuột mất nhau khắp thành phố, Owen và Allie dần nhận ra rằng, có lẽ điều bản thân khao khát nhất thực chất lại ở gần hơn họ tưởng","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/mot-dem-duy-nhat.jpg","himage":"","trailer":"R-wBJ6wmhMg","status":"2","ratings":"","time":"103","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"16"},{"id":"75df5e56-930e-4b02-94fc-dd873f92832d","name_vn":"ĐIỂM MÙ (T18)","name_en":"THE EYES (T18)","director":"YEOM Ji-ho","actor":"SHIN Min-A, KIM Nam-hee, LEE Seung-ryong, KIM Young-ah","country_id":"7489bd65-9802-42b5-ba2e-941baaefa44b","country_name_vn":"Hàn quốc","country_name_en":"Korea","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"8/14/2026 12:00:00 AM","end_date":"9/5/2026 12:00:00 AM","brief_vn":"Phát hiện người chị em song sinh qua đời bất thường dưới vỏ bọc tự sát, Seo-jin (Shin Min-A) quyết tâm dấn thân vào cuộc săn đuổi vạch mặt kẻ thủ ác. Đối mặt với căn bệnh di truyền đang rút cạn thị lực từng ngày và chính bản thân cô trở thành mục tiêu tiếp theo của kẻ sát nhân, hành trình giải mã ma trận tâm lý và truy lùng hung thủ của Seo-jin trở nên căng thẳng và nguy cấp hơn bao giờ hết.","brief_en":"Upon discovering her twin sister’s suspicious death disguised as a suicide, Seo-jin (Shin Min-A) becomes determined to embark on a hunt to unmask the killer. Facing a hereditary condition that steals her vision day by day while becoming the killer's next target, Seo-jin's journey to decode this psychological maze and track down the culprit grows more high-stakes and perilous than ever.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/the-eyes.jpg","himage":"","trailer":"","status":"2","ratings":"","time":"105","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"17"},{"id":"2071507c-55d1-4917-9037-1d1063ddbd68","name_vn":"KHÔNG CÒN CHÚNG TA (T13)","name_en":"CONCE WE WERE US (T13)","director":"Kim Do-Young","actor":"Koo Kyo-hwan, Moon Ga-young, Suyeon Ji","country_id":"7489bd65-9802-42b5-ba2e-941baaefa44b","country_name_vn":"Hàn quốc","country_name_en":"Korea","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1bfe9d04-d045-405f-b2b0-22eb5be4c13b,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Tình Cảm, Tâm Lý","type_name_en":"Romance, Drama","release_date":"8/21/2026 12:00:00 AM","end_date":"9/21/2026 12:00:00 AM","brief_vn":"Jeong-won và Eun-ho yêu nhau chân thành và sâu đậm bằng những tất cả những gì họ có ở khoảng thời gian đẹp nhất của thanh xuân. Nhưng tình yêu của tuổi trẻ không tránh khỏi sự non nớt, bồng bột để rồi họ chọn rời xa nhau. Nhiều năm sau gặp lại, họ nhận ra: chính những tháng năm đã yêu và đã đau ấy đã giúp họ trưởng thành hơn, hiểu được tình yêu và biết cách yêu thương hơn. Chỉ tiếc rằng khi ấy, yêu thương này họ không dành cho nhau được nữa…","brief_en":"Jeong-won and Eun-ho loved each other sincerely and deeply, with everything they had, during the most beautiful years of their youth. Yet the love of youth is inevitably marked by immaturity and impulsiveness, leading them to choose separation. Years later, when they meet again, they realize that those days of loving and hurting are what helped them grow to understand love, and to learn how to love better. Only then do they realize, sadly, that this love can no longer belong to each other.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/03-2026/khong-con-chung-ta.jpg","himage":"","trailer":"w7pJ3SsxRs0","status":"2","ratings":"","time":"114","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"18"},{"id":"b142bd97-610e-4c11-8d66-7b2193819d38","name_vn":"NGÀY TÀN CỦA PHỐ OAK (T13)","name_en":"THE END OF OAK STREET (T13)","director":"David Robert Mitchell","actor":"Anne Hathaway, Ewan McGregor, Maisy Stella, Christian Convery,...","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"8/14/2026 12:00:00 AM","end_date":"9/4/2026 12:00:00 AM","brief_vn":"Sau khi một thảm họa thiên nhiên xé toạc Phố Oak khỏi khu ngoại ô và đưa con phố đến một nơi xa lạ, gia đình Platt nhanh chóng nhận ra rằng chỉ bằng cách luôn đứng bên nhau, họ mới có thể vượt qua vận mệnh nghiệt ngã này.","brief_en":"After a mysterious cosmic event rips Oak Street from suburbia and transports their neighborhood to someplace unknown, the Platt family soon discovers that their very survival depends on them sticking together as they navigate their now unrecognizable surroundings.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/ngay-tan-cua-pho-oak.jpg","himage":"","trailer":"j-00yiX8Y4E","status":"2","ratings":"","time":"100","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"19"},{"id":"9f542a87-9d58-4331-b913-a89c09c7f9ed","name_vn":"ĐẠI CHIẾN NGƯỜI KHỔNG LỒ: LẦN TẤN CÔNG CUỐI CÙNG - Rerun (T16)","name_en":"ATTACK ON TITAN: THE LAST ATTACK - Rerun (T16)","director":"Hayashi Yuichiro","actor":"Yûki Kaji, Yui Ishikawa, Marina Inoue, Hiroshi Kamiya,...","country_id":"2bc76875-57b4-4aa2-8636-54d8d13c46a3","country_name_vn":"Nhật bản","country_name_en":"Japan","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"621bfc4a-f120-4c2d-8e8f-a56b4af6bbcb","type_name_vn":"Anime","type_name_en":"Anime","release_date":"8/14/2026 12:00:00 AM","end_date":"9/5/2026 12:00:00 AM","brief_vn":"Trong cuộc chiến cuối cùng định đoạt số phận thế giới, Eren Yeager đã giải phóng sức mạnh tối thượng của các Titan. Dẫn đầu đội quân Titan Đại hình khổng lồ, Eren quyết tâm hủy diệt mọi kẻ thù đe dọa đến quê hương Eldia. Thế nhưng, cuộc chiến này không chỉ là về sự sống còn, mà còn là cuộc đối đầu giữa lòng thù hận và hy vọng. Kết thúc khúc hùng ca đầy bi tráng, di sản của chiến tranh và những ám ảnh về tự do vẫn tiếp tục đeo bám nhân loại, để lại câu hỏi về giá trị của sự hy sinh và tự do thật sự.","brief_en":"The fate of the world hangs in the balance as Eren unleashes the ultimate power of the Titans. With a burning determination to eliminate all who threaten Eldia, he leads an unstoppable army of Colossal Titans towards Marley.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/titan.jpg","himage":"","trailer":"yNOaI09yFdg","status":"2","ratings":"","time":"144","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"20"},{"id":"98d46d2f-7f14-41d2-8bdc-9056c4dbd513","name_vn":"CHIIKAWA: BÍ MẬT ĐẢO NGƯỜI CÁ\n PĐ (P)","name_en":"CHIIKAWA THE MOVIE: THE SECRET OF THE MARMAID ISLAND SUB (P)","director":"Kei Oikawa","actor":"Haruka Aoki, Makoto Tanaka, Ari Ozawa, Yuka Iguchi, Takayuki Asai, Yuma Uchida, Miyuri Shimabukuro, Momo Harumi","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6","type_name_vn":"Hoạt hình","type_name_en":"Cartoon","release_date":"8/28/2026 12:00:00 AM","end_date":"9/26/2026 12:00:00 AM","brief_vn":"Bộ ba Chiikawa, Hachiware và Usagi nhận được một lời mời tham gia chuyến đi đến hòn đảo đặc biệt với những phần thưởng và đồ ăn miễn phí. Cả nhóm cùng lên đường phiêu lưu ra đảo cùng với nhân vật Rakko – người vốn mang lòng hoài nghi về những lời hứa hẹn trong tờ rơi. Hòn đảo tưởng chừng vui vẻ này lại ẩn chứa nhiều điều kỳ bí và bí mật lâu đời liên quan đến người cá.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/chiikawa.jpg","himage":"","trailer":"NZazo4VtbOI","status":"2","ratings":"","time":"99","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"21"},{"id":"b46c97b3-77e2-4825-af2a-d00f0a54562c","name_vn":"AGITO: CUỘC CHIẾN SIÊU NĂNG LỰC (T16)","name_en":"AGITO: PSYCHIC WAR (T16)","director":"Ryuta Tasaki","actor":"Jun Kaname - Yûchami - Touko Fujita","country_id":"2bc76875-57b4-4aa2-8636-54d8d13c46a3","country_name_vn":"Nhật bản","country_name_en":"Japan","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"af57ca9b-58f4-43d5-957e-9776f6cb4833,e4bb99c9-da30-4ce8-9840-a0864f988454,0a965518-4d8c-4483-b9a3-bb56424dcade","type_name_vn":"Siêu Anh Hùng, Hành Động, Khoa Học Viễn Tưởng","type_name_en":"Heroes, Action, Science fiction","release_date":"8/14/2026 12:00:00 AM","end_date":"9/26/2026 12:00:00 AM","brief_vn":"Một “tội ác bất khả thi” do những kẻ mang siêu năng lực mất kiểm soát đã đẩy mọi thứ đến bờ vực. Để đối đầu với mối đe dọa này, Ozawa Sumiko, Quản lý Đội G, đặt niềm tin vào Hikawa Makoto. Nhưng người hùng ấy lại đang bị giam cầm vì một tội danh chưa được hé lộ. Lựa chọn còn lại chỉ có Tsugami Shouichi - người từng dùng sức mạnh Agito để đối đầu với Unknown.. Thế nhưng... Sức mạnh Agito của anh đã biến mất từ lâu.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/agito.jpg","himage":"","trailer":"FqjgrSkIF7c","status":"2","ratings":"","time":"97","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"22"},{"id":"123adbf3-2359-4e92-b14d-732a78e2597e","name_vn":"NGƯỜI NHỆN: KHỞI ĐẦU MỚI (T13)","name_en":"SPIDER-MAN: BRAND NEW DAY (T13)","director":"Destin Daniel Cretton","actor":"Tom Holland, Zendaya, Sadie Sink","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"af57ca9b-58f4-43d5-957e-9776f6cb4833,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Siêu Anh Hùng, Hành Động","type_name_en":"Heroes, Action","release_date":"7/30/2026 12:00:00 AM","end_date":"8/28/2026 12:00:00 AM","brief_vn":"Không còn Tony Stark, MJ hay Ned kề cận, Peter buộc phải đơn thân độc mã đối diện với phe đối đầu bí ẩn. Tuy nhiên, khi áp lực ngày càng gia tăng, nó kích hoạt một sự biến đổi thể chất bất ngờ, đe dọa chính sự tồn tại của anh. Đồng thời, một chuỗi tội phạm bí ẩn mới xuất hiện, kéo theo một trong những mối đe dọa mạnh mẽ nhất mà Spider-Man từng đối mặt.","brief_en":"Peter Parker tries to focus on college and leave Spider-Man behind. But when a new threat endangers his friends, he must break his promise and suit up again, teaming with an unexpected ally to protect those he loves.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/07-2026/nguoi-nhen.jpg","himage":"","trailer":"urWZZcICSCg","status":"2","ratings":"","time":"145","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"23"},{"id":"01376aba-e62d-4d70-bc16-f0c0864b4252","name_vn":"THƯ TÌNH GỬI NGOẠI PĐ (T13)","name_en":"DEAR YOU SUB (T13)","director":"Lam Hồng Xuân","actor":"Lý Tư Đồng, Vương Ngạn Đồng, Ngô Thiếu Khanh","country_id":"5b498412-ac9b-4a93-88f3-46d400b1cd85","country_name_vn":"Hong Kong","country_name_en":"Hong Kong","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"41eddd0c-c45b-43ff-9988-8e59921f0c1c,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Gia đình, Tâm Lý","type_name_en":"Family, Drama","release_date":"8/7/2026 12:00:00 AM","end_date":"9/4/2026 12:00:00 AM","brief_vn":"Tác phẩm lấy bối cảnh Trung Quốc, Thái Lan từ thập niên 1950 tới hiện tại, nói về cuộc đời của bà Diệp Thục Như (Ngô Thiếu Khanh đóng). Xuất thân tiểu thư, bà trốn nhà đi theo chàng trai nghèo Trịnh Mộc Sinh (Vương Ngạn Đồng đóng), sinh ba người con. Vì biến cố chính trị, ông Mộc Sinh phiêu bạt tới Thái Lan, ở đây làm lụng kiếm tiền gửi về cho vợ con. Trịnh Mộc Sinh đầu óc nhanh nhạy, giỏi kiếm tiền, trợ cấp đủ đầy cho gia đình và một lòng một dạ với vợ. Đôi vợ chồng gửi gắm tình yêu qua những lá thư. Một ngày, Diệp Thục Như nhận bức ảnh chồng bên một phụ nữ và những đứa trẻ kèm tin ông đã qua đời.  Cháu của Diệp Thục Như trưởng thành, từ Trung Quốc tới Thái Lan tìm thân nhân của ông nội, từ đó mở ra câu chuyện ấm áp, giàu nghĩa tình sau những lá thư mà Trịnh Mộc Sinh gửi cho vợ.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/dear-you.jpg","himage":"","trailer":"8vawBqlETvE","status":"2","ratings":"","time":"117","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"24"},{"id":"c8d9c952-5535-41c6-893e-ee535cd27b87","name_vn":"SHIN – CẬU BÉ BÚT CHÌ: KỲ KỲ QUÁI QUÁI! KỲ NGHỈ YÊU QUÁI CỦA TỚ PĐ (P)","name_en":"CRAYON SHIN-CHAN THE MOVIE: SPOOKY! MY YOKAI VACATION SUB (P)","director":"Masaki Watanabe","actor":"Yumiko Kobayashi, Miki Narahashi, Toshiyuki Morikawa, Satomi Koorogi","country_id":"2bc76875-57b4-4aa2-8636-54d8d13c46a3","country_name_vn":"Nhật bản","country_name_en":"Japan","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,41eddd0c-c45b-43ff-9988-8e59921f0c1c","type_name_vn":"Hoạt hình, Gia đình","type_name_en":"Cartoon, Family","release_date":"8/21/2026 12:00:00 AM","end_date":"9/19/2026 12:00:00 AM","brief_vn":"Lấy bối cảnh mùa hè tại Akita, bộ phim theo chân Shin và gia đình Nohara trong chuyến về quê đầy háo hức. Tuy nhiên, một sự kiện kỳ lạ đã đưa cả gia đình lạc vào Xứ sở Yêu quái bí ẩn – nơi con người không được phép đặt chân tới. \r\n\r\nTại đây, Shin và gia đình phải đối mặt với những thử thách chưa từng có, đồng thời gặp gỡ hàng loạt yêu quái độc đáo, hài hước và đáng yêu. Với sự kết hợp giữa yếu tố phiêu lưu, kỳ ảo, hài hước đặc trưng của Shin-chan cùng những thông điệp gia đình ấm áp, bộ phim hứa hẹn mang đến một hành trình giải trí hấp dẫn cho khán giả ở mọi lứa tuổi trong mùa hè này.","brief_en":"Set against the summer backdrop of Akita, the film follows Shin and the Nohara family as they excitedly return to their hometown for a vacation. However, a mysterious incident unexpectedly transports the entire family to a hidden Yokai Kingdom — a magical world where humans are forbidden to enter. \r\n\r\nThere, Shin and his family must overcome a series of unprecedented challenges while encountering a colorful cast of unique, funny, and lovable yokai. Blending adventure, fantasy, and the signature humor of the *Crayon Shin-chan* franchise with heartwarming family values, the film promises an entertaining and memorable journey for audiences of all ages this summer","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/shinn.jpg","himage":"","trailer":"GR_kHLWYASg","status":"2","ratings":"","time":"101","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"25"},{"id":"37fe3991-8f81-422b-82a5-b7d4e324d9ad","name_vn":"PHÍ PHÔNG: QUỶ MÁU RỪNG THIÊNG (T16)","name_en":"THE BLOOD DEMON (T16)","director":"Đỗ Quốc Trung","actor":"Kiều Minh Tuấn, Nina Nutthacha Padovan, Diệp Bảo Ngọc, Đoàn Minh Anh, NSƯT Hạnh Thuý,...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"4/24/2026 12:00:00 AM","end_date":"5/30/2026 12:00:00 AM","brief_vn":"Bộ phim được lấy cảm hứng từ truyền thuyết dân gian về loài quỷ huyền bí “Phí Phông” - những người bình thường sống giữa cộng đồng, nhưng mang trong mình đặc tính chuyên hút máu hoặc hút sinh khí người. Hình tượng “Phí Phông” được lưu truyền qua nhiều thế hệ, gắn liền với đời sống tâm linh của cư dân vùng núi cao phía Bắc, gieo rắc nỗi ám ảnh trong ký ức dân gian.","brief_en":"Phi Phong, a blood-thirsty entity from highland folklore, has haunted generations with its terrifying legend. The film follows Con (Kieu Minh Tuan) and Duong (Minh Anh), two apprentice shamans who venture into the mountains to save a mother struck down by the curse of Phi Phong. At the same time, a series of gruesome deaths begin to unfold in a remote village. Suspicion falls on Mon (Diep Bao Ngoc) and her daughter Lua (Nina Nutthacha), whose mysterious traits closely resemble those of the legendary creature. Yet beneath the cursed forests and sacred lands, long-buried secrets begin to surface, dragging Con and Duong into an endless hunt for the truth behind Phi Phong.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/04-2026/phi-phong-teaser.jpg","himage":"","trailer":"AfTJQIdjAHc","status":"2","ratings":"","time":"120","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"26"},{"id":"8968f87d-e09b-4451-9146-897d91e6c77f","name_vn":"THƯ TÌNH GỬI NGOẠI LT (T13)","name_en":"DEAR YOU SUB (T13)","director":"Lam Hồng Xuân","actor":"Lý Tư Đồng Vương Ngạn Đồng Ngô Thiếu Khanh","country_id":"5b498412-ac9b-4a93-88f3-46d400b1cd85","country_name_vn":"Hong Kong","country_name_en":"Hong Kong","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"41eddd0c-c45b-43ff-9988-8e59921f0c1c,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Gia đình, Tâm Lý","type_name_en":"Family, Drama","release_date":"8/7/2026 12:00:00 AM","end_date":"9/5/2026 12:00:00 AM","brief_vn":"Tác phẩm lấy bối cảnh Trung Quốc, Thái Lan từ thập niên 1950 tới hiện tại, nói về cuộc đời của bà Diệp Thục Như (Ngô Thiếu Khanh đóng). Xuất thân tiểu thư, bà trốn nhà đi theo chàng trai nghèo Trịnh Mộc Sinh (Vương Ngạn Đồng đóng), sinh ba người con. Vì biến cố chính trị, ông Mộc Sinh phiêu bạt tới Thái Lan, ở đây làm lụng kiếm tiền gửi về cho vợ con. Trịnh Mộc Sinh đầu óc nhanh nhạy, giỏi kiếm tiền, trợ cấp đủ đầy cho gia đình và một lòng một dạ với vợ. Đôi vợ chồng gửi gắm tình yêu qua những lá thư. Một ngày, Diệp Thục Như nhận bức ảnh chồng bên một phụ nữ và những đứa trẻ kèm tin ông đã qua đời.  Cháu của Diệp Thục Như trưởng thành, từ Trung Quốc tới Thái Lan tìm thân nhân của ông nội, từ đó mở ra câu chuyện ấm áp, giàu nghĩa tình sau những lá thư mà Trịnh Mộc Sinh gửi cho vợ.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/dear-you.jpg","himage":"","trailer":"8vawBqlETvE","status":"2","ratings":"","time":"117","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"192bf4fb-4904-4f4c-8b52-8cbf760c234b","language_vn":"Lồng Tiếng","language_en":"VN","sortorder":"27"},{"id":"0727eff6-6f7c-44e3-a0a5-6dfc05257b18","name_vn":"HẸN EM NGÀY NHẬT THỰC (T16)","name_en":"MEET ME AT THE ECLIPSE (T16)","director":"Lê Thiện Viễn","actor":"Đoàn Thiên Ân, Khương Lê, NSND Lê Khanh, Huỳnh Phương, Nguyên Thảo,","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1bfe9d04-d045-405f-b2b0-22eb5be4c13b","type_name_vn":"Tình Cảm","type_name_en":"Romance","release_date":"3/30/2026 12:00:00 AM","end_date":"4/25/2026 12:00:00 AM","brief_vn":"Năm 1995, khi đang đứng trước một quyết định quan trọng của cuộc đời, Ân bất ngờ bị kéo trở lại quá khứ bởi những bức thư tình chưa từng trao tay. Hành trình tìm gặp Thiên - mối tình đầu từng khắc sâu trong tim - đưa cô về lại thôn xóm Trà Mây năm xưa, nơi những ký ức ngọt ngào xen lẫn tổn thương vẫn chưa hề nguôi ngoai. Trong khoảnh khắc định mệnh khi hai người bất ngờ chạm mặt, những bí mật bị che giấu suốt nhiều năm dần hé lộ, buộc Ân phải đối diện với sự thật và lựa chọn con đường cho riêng mình.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/04-2026/hen-em.jpg","himage":"","trailer":"","status":"2","ratings":"","time":"118","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"28"},{"id":"2a087d05-a90b-4848-9fc9-1f25f2b1dda7","name_vn":"PAW PATROL (P): PHIM KHỦNG LONG PĐ","name_en":"PAW PATROL (P): THE DINO MOVIE SUB","director":"Cal Brunker","actor":"Cal Brunker \u0026 Bob Barlen","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,39021e14-664c-4d4c-bb93-90f8aa1a0270","type_name_vn":"Hoạt hình, Phiêu Lưu","type_name_en":"Cartoon, Adventure","release_date":"8/14/2026 12:00:00 AM","end_date":"9/12/2026 12:00:00 AM","brief_vn":"Khi con tàu của Paw Patrol bị cuốn vào một cơn bão bí ẩn, đội cún cứu hộ vô tình lưu lạc đến một hòn đảo nhiệt đới vô danh, nơi sinh sống của nhiều loài khủng long cổ xưa. Họ gặp Rex, một chuyên gia về khủng long, đã mắc kẹt trên hòn đảo này trong nhiều năm. Mọi chuyện trở nên tệ hơn khi Thị trưởng Humdinger, đối thủ không đội trời chung của PAW Patrol rắp tâm khai thác nguồn tài nguyên thiên nhiên tại đây, và vô tình gây ra trận phun trào của một ngọn núi lửa khổng lồ. Đứng trước nguy cơ hòn đảo bị xóa sổ, đội cún cứu hộ phải thực hiện những nhiệm vụ quy mô \"khủng\" hơn bao giờ hết để ngăn chặn Humdinger và cứu các loài khủng long khỏi nạn tuyệt chủng.","brief_en":"After their ship gets caught in a mysterious storm, the PAW Patrol pups crash land on an uncharted tropical island filled with dinosaurs. They meet Rex, a pup who has been stranded on the island for years and has become an expert in all things dino-related. When the PAW Patrol's archrival, Mayor Humdinger, begins recklessly mining in hopes of exploiting the island for its natural resources, he inadvertently causes a huge, dormant volcano to erupt. The PAW Patrol pups are thrown into a series of high-stakes, dino-sized rescues bigger than anything they've done before, as they must stop Humdinger before everything on the island goes extinct.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/08-2026/paw-patrol.jpg","himage":"","trailer":"","status":"2","ratings":"","time":"89","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"29"},{"id":"bec5cf18-fc8e-4355-9504-2ac466814f8a","name_vn":"TRUY TÌM LONG DIÊN HƯƠNG (T16)","name_en":"","director":"Dương Minh Chiến","actor":"Quang Tuấn, Ma Ran Đô, Hoàng Tóc Dài, Nguyên Thảo,...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hài, Hành Động","type_name_en":"Comedy, Action","release_date":"11/14/2025 12:00:00 AM","end_date":"12/14/2025 12:00:00 AM","brief_vn":"Ngay trước thềm lễ hội lớn, bảo vật linh thiêng Long Diên Hương bất ngờ bị đánh cắp, kéo theo hai anh em Tâm - Tuấn cùng nhóm bạn vào chuyến hành trình nghẹt thở nhưng không kém phần hài hước khi họ phải chạm trán với các băng nhóm ngư dân xã hội đen cùng nhiều hiểm nguy.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/11-2025/truy-tien-long-dien-huong-poster.jpg","himage":"","trailer":"fO6X58qWA_s","status":"2","ratings":"","time":"103","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"30"},{"id":"2d0f4048-a965-42e4-934f-42af235cc5ca","name_vn":"CHỊ DÂU (T16)","name_en":"THE REAL SISTER (T16)","director":"Khương Ngọc","actor":"Việt Hương, Hồng Đào, Lê Khánh, Đinh Y Nhung, Ngọc Trinh","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"65a5cfea-d797-4fef-95d8-3dd057038f5b,01912ab9-7d92-4ae4-aee9-84e02b09b8ac","type_name_vn":"Drama, Hài","type_name_en":"Drama, Comedy","release_date":"11/21/2025 12:00:00 AM","end_date":"11/21/2025 12:00:00 AM","brief_vn":"Chuyện bắt đầu khi bà Nhị - con dâu cả của gia đình quyết định nhân dịp đám giỗ của mẹ chồng, tụ họp cả bốn chị em gái - con ruột trong nhà lại để thông báo chuyện sẽ tự bỏ tiền túi ra sửa sang căn nhà từ đường cũ kỹ trước khi bão về.\r\nVấn đề này khiến cho nội bộ gia đình bắt đầu có những lục đục, chị dâu và các em chồng cũng xảy ra mâu thuẫn, bất hoà. Dần dà những sự thật đằng sau việc \"bằng mặt mà không bằng lòng\" giữa các chị em cũng dần được hé lộ, những bí mật, nỗi đau sâu thẳm nhất trong mỗi cá nhân cũng dần được bóc tách.\r\nLiệu sợi dây liên kết vốn đã mong manh giữa các chị em có bị cắt đứt và liệu “căn nhà” vốn đã dột nát ấy có còn nguyên vẹn sau cơn bão lớn?","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/12-2024/chi-dau.png","himage":"","trailer":"WHmHpntEMbk","status":"2","ratings":"","time":"100","limitage_id":"8a4524a5-36aa-4354-af88-c56a191592ac","limitage_vn":"T16","limitage_en":"T16","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"31"},{"id":"370ce1ff-9b72-4f36-8f4e-503ad8b710ac","name_vn":"CỤC VÀNG CỦA NGOẠI (T13)","name_en":"MY LITTLE GRANDMA (T13)","director":"Khương Ngọc","actor":"Việt Hương, Hồng Đào, Lê Khánh, Băng Di, Lâm Thanh Mỹ, Hữu Châu, Tuấn Khải, Thư Đan, Panda","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"41eddd0c-c45b-43ff-9988-8e59921f0c1c,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Gia đình, Tâm Lý","type_name_en":"Family, Drama","release_date":"10/17/2025 12:00:00 AM","end_date":"11/15/2025 12:00:00 AM","brief_vn":"Lấy cảm hứng từ những ký ức tuổi thơ ngọt ngào, \"Cục Vàng Của Ngoại\" mang đến câu chuyện ấm áp về tình bà cháu trong một xóm nhỏ chan chứa nghĩa tình.\r\nBà Hậu – người phụ nữ cả đời tần tảo, nay trở thành chỗ dựa duy nhất của cháu ngoại khi con gái bỏ đi. Dẫu cuộc sống còn nhiều nhọc nhằn, tình thương bà dành cho cháu vẫn luôn trọn vẹn. Với bà, cháu là \"cục vàng\" – niềm vui, niềm an ủi và cũng là lẽ sống của đời mình.\r\nBộ phim nhẹ nhàng dẫn khán giả trở lại những khoảnh khắc quen thuộc nơi xóm nhỏ: nụ cười hồn nhiên của cháu, vòng tay chở che của bà và sự đùm bọc từ hàng xóm láng giềng. Tất cả cùng hòa thành một bức tranh đời thường ấm áp, gợi nhắc về tuổi thơ bình yên và tình người mộc mạc, chân thành","brief_en":"Inspired by the sweet memories of childhood, \"My Little Grandma\" tells a heartfelt story about the bond between a grandmother and her grandchild in a small, close-knit neighborhood.\r\nMrs. Hau – a woman who has spent her whole life working hard – suddenly becomes the only support for her young grandchild after her daughter leaves. Though life is full of struggles, her love never fades. To her, the child is her \"little treasure\" – her joy, her comfort, and the very reason she keeps going.\r\nThe film gently invites the audience into everyday moments of this small community: the child's innocent laughter, the grandmother's protective embrace, and the kindness of caring neighbors. Together, they weave a warm portrait of family, childhood, and the simple yet enduring beauty of human connection.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2025/cuc-vang-cua-ngoai-poster.jpg","himage":"","trailer":"adOwxsPorl8","status":"2","ratings":"","time":"119","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"32"}],"listComingMovie":[{"id":"41426706-8d0a-4468-8ced-2099b57222da","name_vn":"PHÁO HOA LÚC BÌNH MINH (P)","name_en":"A NEW DAWN (P)","director":"Yoshitoshi Shinomiya","actor":"","country_id":"2bc76875-57b4-4aa2-8636-54d8d13c46a3","country_name_vn":"Nhật bản","country_name_en":"Japan","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"621bfc4a-f120-4c2d-8e8f-a56b4af6bbcb","type_name_vn":"Anime","type_name_en":"Anime","release_date":"9/4/2026 12:00:00 AM","end_date":"9/2/2026 12:00:00 AM","brief_vn":"Khi xưởng pháo hoa Obinata đứng trước nguy cơ biến mất vì quá trình tái phát triển đô thị, Keitaro quyết tâm hoàn thành quả pháo hoa huyền thoại “Shuhari” mà cha mình để lại. Cùng người bạn thuở nhỏ Kaoru và anh trai Sentaro, cậu bước vào những ngày cuối cùng của mùa hè, nơi ba người một lần nữa đối diện với những ký ức, mối liên kết và những điều đã níu giữ họ ở lại nơi chốn này. Khi “Shuhari” bừng sáng giữa màn đêm, liệu họ sẽ lựa chọn ở lại với quá khứ, hay bước về phía một bình minh mới?","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/PHAO-HOA-LUC-BINH-MINH.jpg","himage":"","trailer":"IiIydHpK0PQ","status":"1","ratings":"","time":"76","limitage_id":"6a36700c-4059-4ed6-9302-44c0c0366e76","limitage_vn":"P","limitage_en":"P","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"b07925ab-2c6e-489f-903d-8a376b743c12","name_vn":"TRẠI BUÔN NGƯỜI","name_en":"","director":"Toni Dương Bảo Anh","actor":"Steven Nguyễn, Quách Ngọc Ngoan, NSND Như Quỳnh, NSƯT Tuyết Thu, Long Điền...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"9/10/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Lấy cảm hứng từ câu chuyện có thật về nạn buôn người và cuộc vượt ngục, sinh tồn nghẹt thở tại khu vực biên giới Tịnh Biên (An Giang) năm 2022","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/trai-buon-nguoi.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"3f8bdd1f-f2dd-4faf-84b1-400d3faf7cf9","name_vn":"MÃI NỢ MỘT LỜI TẠM BIỆT","name_en":"","director":"J. ROBERT SCHULZ","actor":"Kiều Chinh, Daniel K. Winn, Nguyễn Vũ Uy Nhân, Samuel An, Lê Anh Huy, Lan Thy và các diễn viên khác","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"41eddd0c-c45b-43ff-9988-8e59921f0c1c,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Gia đình, Tâm Lý","type_name_en":"Family, Drama","release_date":"9/11/2026 12:00:00 AM","end_date":"10/24/2026 12:00:00 AM","brief_vn":"):  Một tuổi thơ bị bỏ lại giữa những biến động. Một người bà vẫn ở lại trong ký ức. Một người đàn ông trưởng thành nhưng chưa từng thật sự bước ra khỏi quá khứ. Mãi Nợ Một Lời Tạm Biệt là hành trình Daniel tìm lại những mảnh ký ức đã mất, để đối diện với gia đình, mất mát và điều anh chưa kịp nói lời tạm biệt.","brief_en":"A childhood left behind amid life’s many changes. A grandmother who remains in memory. A grown man who has never truly escaped his past. Chrysalis (Mãi N? M?t L?i T?m Bi?t) follows Daniel’s journey to recover the missing pieces of his memory, as he confronts family, loss, and the farewell he never had the chance to say.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/mai-no_1.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"778f8171-20aa-4ea7-add6-43bf94392f27","name_vn":"VÙNG ĐẤT QUỶ DỮ","name_en":"RESIDENT EVIL","director":"Zach Cregger","actor":"Austin Abrams,Paul Walter Hauser, Zach Cherry, Kali Reis","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"9/11/2026 12:00:00 AM","end_date":"10/10/2026 12:00:00 AM","brief_vn":"Một phiên bản Resident Evil mới trở lại đầy kịch tính và kinh hoàng từ bộ óc quái kiệt của đạo diễn Zach Cregger đứng sau “Weapons” \u0026 “Barbarian”. Với cốt truyện hoàn toàn mới, phim xoay quanh Bryan (Austin Abrams), một nhân viên vận chuyển vật tư y tế vô tình bị cuốn vào cuộc chạy đua sinh tồn nghẹt thở và dồn dập trong một đêm định mệnh. Liên tiếp chuyện kinh hoàng bất ngờ đẩy anh vào giữa vòng xoáy hỗn loạn","brief_en":"From the mind of visionary filmmaker Zach Cregger (Weapons, Barbarian) comes a thrilling — and terrifying — reinvention of the Resident Evil franchise. In an all-new story, Resident Evil follows Bryan (Austin Abrams), a medical courier who unwittingly finds himself in an action-packed, non-stop race for survival as one fateful, horrifying night collapses around him in chaos","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/vung-dat-quy-du.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"18aa3129-b784-4f31-884a-86bce3cdeb04","name_vn":"TRÁI TIM QUÁI THÚ","name_en":"HEART OF THE BEAST","director":"David Ayer","actor":"Brad Pitt, J.K. Simmons, Anna Lambe","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"9/11/2026 12:00:00 AM","end_date":"10/31/2026 12:00:00 AM","brief_vn":"Sau một vụ tai nạn máy bay kinh hoàng, sĩ quan Lực lượng Đặc nhiệm James Belmont (Brad Pitt) và chú chó chiến đấu Odin bị mắc kẹt giữa vùng hoang dã sâu thẳm của Alaska. Từ đó, họ buộc phải cùng nhau bước vào cuộc chiến sinh tồn khốc liệt trước thiên nhiên khắc nghiệt. Từ đạo diễn danh tiếng David Ayer, Trái Tim Quái Thú là một bộ phim phiêu lưu đầy căng thẳng, khai thác mối gắn kết không thể tách rời giữa một người đàn ông và người bạn thân thiết nhất của mình, khi cả hai phải đối mặt với trận chiến lớn nhất cuộc đời.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/trai-tim-quai-thu.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"4fdd2185-0653-4413-889a-95f1e0dc8f00","name_vn":"LÊN HƯƠNG","name_en":"LUCK FOR SALE","director":"Khương Ngọc và Tấn Hoàng Thông","actor":"Hồng Đào, Võ Tấn Phát, Tuyết Thu, NSND Hồng Vân, Hạ Anh, Quốc Khánh, Thiếu Lan","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"41eddd0c-c45b-43ff-9988-8e59921f0c1c,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Gia đình, Tâm Lý","type_name_en":"Family, Drama","release_date":"9/18/2026 12:00:00 AM","end_date":"10/17/2026 12:00:00 AM","brief_vn":"Một bà chủ của trại hòm ế ẩm và một thanh niên cần tiền trang trải cuộc sống đã vô tình mắc vào một “giao kèo định mệnh\".","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/len-huong-poster.jpg","himage":"","trailer":"uVwMeluLLzk","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"2d3d37d4-32f1-4e9b-8bad-551ecb6545d1","name_vn":"HÒN ĐẢO QUÊN LÃNG","name_en":"FORGOTTEN ISLAND","director":"Joel Crawford; Januel Mercado","actor":"H.E.R., Liza Soberano, Dave Franco, Jenny Slate, Manny Jacinto, Dolly de Leon, Jo Koy, Ronny Chieng và Lea Salonga.","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,39021e14-664c-4d4c-bb93-90f8aa1a0270","type_name_vn":"Hoạt hình, Phiêu Lưu","type_name_en":"Cartoon, Adventure","release_date":"9/25/2026 12:00:00 AM","end_date":"10/17/2026 12:00:00 AM","brief_vn":"Một tình bạn đẹp thì luôn xứng đáng được bảo vệ. DreamWorks Animation – hãng phim đã mang đến những mối gắn kết khó quên giữa cậu bé và chú rồng trong Bí Kíp Luyện Rồng, giữa gã chằn tinh và chú lừa trong Shrek, hay giữa robot và chú ngỗng con trong Robot Hoang Dã, nay trở lại với một câu chuyện rực rỡ và đầy cảm xúc về hai người bạn thân từ thuở nhỏ, buộc phải sát cánh bên nhau trước khi họ dần rời xa trong Hòn Đảo Quên Lãng. Bộ phim được chắp bút và đạo diễn bởi hai đề cử Oscar® Joel Crawford và Januel Mercado, đồng thời được sản xuất bởi Mark Swift - cũng là đội ngũ đứng sau Mèo Đi Hia: Điều Ước Cuối Cùng. Trong đêm cuối cùng bên nhau, Jo và Raissa tình cờ phát hiện một cánh cổng bí ẩn đưa họ đến hòn đảo kỳ ảo Nakali – nơi tràn ngập những sinh vật thần thoại và phép thuật mà họ từng được nghe kể từ gia đình người Philippines của mình. Tại đây, có những sinh vật trở thành bạn đồng hành, nhưng cũng có những kẻ là mối đe dọa. Đồng hành cùng chú chó sói vụng về nhưng tốt bụng Raww và một nhóm bạn nhỏ nhưng “có võ”, Jo và Raissa phải đối mặt với The Dreaded Manananggal, sinh vật đáng sợ nhất trên đảo. Khi phát hiện rằng cái giá để trở về nhà chính là toàn bộ ký ức về tình bạn của mình, Jo và Raissa buộc phải chạy đua với thời gian để tìm cách rời khỏi hòn đảo trước khi họ quên mất nhau mãi mãi.","brief_en":"Your best friendship is worth fighting for. DreamWorks Animation, the studio that brought you unforgettable bonds between a boy and a dragon in How to Train Your Dragon, an ogre and a donkey in Shrek, and a robot and a gosling in The Wild Robot, now welcomes a dazzling and emotional story about two lifelong best friends who must come together before they drift apart in Forgotten Island. The new original film is written and directed by Academy Award® nominee Joel Crawford and Januel Mercado and is produced by Academy Award® nominee Mark Swift, the filmmaking team behind Puss in Boots: The Last Wish. While celebrating their last night together, Jo and Raissa stumble upon a mysterious portal that transports them to the fantastical island of Nakali, packed with magical and mythological creatures they grew up hearing stories about from their Filipino families. Some of these figures will become friends, some foes. Joined by well-meaning-but- hapless weredog Raww (Dave Franco) and a small-but-mighty pack of pals, Jo and Raissa must face The Dreaded Manananggal (Tony winning icon Lea Salonga), the most feared creature on the island. When they discover that the memories of their entire friendship are the price for returning home, Jo and Raissa will race to find a way to leave the island before they forget each other forever.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/hon-dao-quen-lang.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"d3742d45-e804-4143-9ca1-e6793889ed7c","name_vn":"ÚT LAN 2","name_en":"","director":"Trần Trọng Dần","actor":"Phương Nam, Kiều Oanh, NSUT Kim Phương, Kiều Diễm, Gia Tuệ, Tạ Lâm, Ngọc Phước, Khánh Tiên, Tấn Thi, Huỳnh Nhựt.","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"9/25/2026 12:00:00 AM","end_date":"11/21/2026 12:00:00 AM","brief_vn":"Từ lúc một con rắn hai đầu xuất hiện, ngôi làng ven sông liên tiếp xảy ra những cái chết bí ẩn. Khi những bí mật bị lãng quên dần trồi lên mặt nước, người dân nhận ra có những lời nguyền chưa bao giờ thực sự biến mất.","brief_en":"Since the appearance of a two-headed snake, a series of mysterious deaths has plagued the riverside village. As long-forgotten secrets gradually surface, the villagers realize that some curses never truly vanished.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/09-2026/ut-lan.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"077d9170-2c02-4a81-b277-1906d39ac1d2","name_vn":"DIGGER","name_en":"DIGGER","director":"Alejandro G. Iñárritu","actor":"Tom Cruise, Jesse Plemons, John Goodman, Riz Ahmed,...","country_id":"ab21efed-68c1-4fcc-a172-3496f0bf9539","country_name_vn":"Khác","country_name_en":"Other","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hài, Hành Động","type_name_en":"Comedy, Action","release_date":"10/2/2026 12:00:00 AM","end_date":"11/3/2026 12:00:00 AM","brief_vn":"Tom Cruise vào vai Digger Rockwell – Người đàn ông quyền lực nhất thế giới. Khi một thảm họa do chính mình gây ra đang đẩy nhân loại đến bờ vực diệt vong, Digger buộc phải chạy đua với thời gian để chứng minh mình là vị cứu tinh của nhân loại.","brief_en":"The most powerful man in the world embarks on a frantic mission to prove he is humanity's savior before the disaster he's unleashed destroys everything.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/digger-1.jpg","himage":"","trailer":"Dc1xkSO3Jq8","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"3b8d1a09-8a67-4bb5-add3-463bd8c83107","name_vn":"ÁN MẠNG KARAOKE","name_en":"","director":"Hoàng Lê","actor":"Đoàn Thiên Ân, Đại Nghĩa, Vân Dung và các diễn viên khác","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac","type_name_vn":"Hài","type_name_en":"Comedy","release_date":"10/2/2026 12:00:00 AM","end_date":"11/6/2026 12:00:00 AM","brief_vn":"Một người hàng xóm mê hát karaoke bất ngờ bị sát hại trong căn homestay thiền biệt lập trên núi, khiến chuyến hành hương của một xóm nhỏ bị biến thành trò chơi đầu trí bất đắc dĩ.","brief_en":"A karaoke-loving neighbor is suddenly murdered at a secluded mountain meditation retreat, turning a small neighborhood’s pilgrimage into an unexpected battle of wits.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/an-mang-karaoke.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"628aef99-3632-4449-8968-e59ec91d43a5","name_vn":"ÁN MẠNG XÉM HOÀN HẢO","name_en":"","director":"Đức Nguyễn","actor":"Anh Tú Atus, DJ Mie, Vũ Ngọc Anh, Huy Khánh, Thùy Giang, Long Đẹp Trai, Sỹ Toàn, Trịnh Tú Trung, Lương Gia Huy","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac","type_name_vn":"Hài","type_name_en":"Comedy","release_date":"10/9/2026 12:00:00 AM","end_date":"11/27/2026 12:00:00 AM","brief_vn":"Trinh, cô nàng TikToker ngôn tình triệu view, tỉnh dậy giữa phim trường lạnh lẽo với cái đầu đau như búa bổ, mất trí nhớ và phát hiện xác của Yến (diễn viên) – tình địch đang bị nghi ngờ có gì mờ ám với diễn viên Khang (chồng sắp cưới). Đại (thám tử) được Trinh thuê theo dõi vụ ngoại tình lẻn vào giúp thì vấp ngã để lại dấu vân tay lên tử thi và vô tình bị bảo vệ bắt quả tang. Kể từ đây, liên tiếp những tình huống oái oăm mà cặp đôi “đũa lệch” phải đối mặt: chạy trốn khỏi cảnh sát dí sát gót và sát thủ rình rập, vừa cãi nhau tóe khói vừa phá án. Song Song đó, cả hai vô tình lật tẩy bí mật động trời của showbiz","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/an-mang_1.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"fe6d22f0-3fce-4b6f-94fd-e9f416cc0e19","name_vn":"STREET FIGHTER","name_en":"STREET FIGHTER","director":"Kitao Sakurai","actor":"Noah Centineo, Andrew Koji, Callina Liang, Joe “Roman Reigns” Anoai, David Dastmalchian, Cody Rhodes, Andrew Schulz","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Hành Động","type_name_en":"Action","release_date":"10/16/2026 12:00:00 AM","end_date":"10/9/2026 12:00:00 AM","brief_vn":"Lấy bối cảnh năm 1993, Ryu và Ken, hai đấu sĩ từng xa cách bị kéo trở lại chiến đấu khi Chun-Li chiêu mộ họ tham gia giải Chiến Binh Thế Giới đầy khốc liệt. Nhưng đằng sau đó là một âm mưu chết chóc, buộc họ phải đối đầu với nhau và quá khứ của chính mình, nếu không tất cả sẽ CHẤM HẾT!","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/street-fighter.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"44c62959-d2ee-4b04-831c-2bb41b7d0ecb","name_vn":"CHỊ CHỊ EM EM 3","name_en":"SISTER SISTER 3","director":"Nguyễn Hữu Hoàng","actor":"Kỳ Duyên, Steven Nguyễn...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1bfe9d04-d045-405f-b2b0-22eb5be4c13b,65a5cfea-d797-4fef-95d8-3dd057038f5b,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Tình Cảm, Drama, Tâm Lý","type_name_en":"Romance, Drama, Drama","release_date":"10/16/2026 12:00:00 AM","end_date":"11/28/2026 12:00:00 AM","brief_vn":"Giữa xã hội Bắc Bộ cũ đầy lễ giáo và những khuôn phép khắt khe, Thị Mầu – tiểu thư nổi tiếng tài sắc nhất vùng – bước vào một thế giới nơi tình yêu chưa bao giờ là chuyện của riêng hai người.\r\nNhững rung động bị che giấu, những mối quan hệ chồng chéo và những lựa chọn trái với khuôn phép dần tạo nên một mạng nhện tình cảm rối ren, nơi mỗi người đều có một bí mật, một toan tính và một người không thể gọi tên.\r\nKhi tình yêu và danh dự không thể cùng tồn tại, liệu ai sẽ là người thoát khỏi mạng nhện ấy – và ai sẽ phải trả giá cho thứ tình cảm mình không thể cưỡng lại?","brief_en":"Set in traditional Northern Vietnam, where strict social norms prevail, Thi Mau - the region's most beautiful and talented young lady - finds herself caught in a tangled web of secret love and conflicting desires.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/ccee3.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"a454ecc9-168f-4c37-a03b-efc971cd420b","name_vn":"SỢI CHỈ ĐỎ","name_en":"","director":"Hàm Trần","actor":"Đoàn Minh Anh, Quang Tuấn, Ba Tây, Loube Nguyễn, Trần Nghĩa, Cao Thùy Linh, Gia Tuệ, Ngọc Phước, Thư Nguyễn,...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"10/16/2026 12:00:00 AM","end_date":"9/19/2026 12:00:00 AM","brief_vn":"Một kẻ cuồng tín sau cơn đau đầu dữ dội phát hiện ra mình có một con mắt dọc trên trán. Những vụ sát nhân hàng loạt. Những hồn ma bóng quỷ lẩn khuất trong đời sống. Những nỗi sợ rình rập từ ám ảnh quá khứ. Sợi Chỉ Đỏ là gì, và sẽ kết nối tất cả như thế nào?","brief_en":"After a severe headache, a fanatic discovers a vertical eye on his forehead. A series of brutal murders. Ghostly spirits lurking within everyday life. Fears stalking from the traumas of the past. What is the Red Thread, and how will it connect everything?","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/comingsoon.jpg","himage":"","trailer":"ar9bh1Fzyaw","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"94de0c0d-3632-4f54-9595-656b7cc227f3","name_vn":"CLAYFACE","name_en":"CLAYFACE","director":"James Watkins","actor":"Tom Rhys Harries, Naomi Ackie, David Dencik, Max Minghella, Eddie Marsan,...","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"10/23/2026 12:00:00 AM","end_date":"11/7/2026 12:00:00 AM","brief_vn":"Bộ phim kinh dị đầu tiên của DC Studios, “Clayface” do đạo diễn James Watkins thực hiện, với sự tham gia của Tom Rhys Harries trong vai chính, một nhân vật phản diện của thành phố Gotham. “Clayface” hé lộ sự sa ngã kinh hoàng của một người đàn ông từ ngôi sao Hollywood đang lên trở thành một con quái vật đầy thù hận, trong một câu chuyện khám phá sự mất mát bản sắc và nhân tính, tình yêu độc hại, và mặt tối của tham vọng khoa học.","brief_en":"DC Studios’ first-ever foray into the genre, “Clayface” is a horror thriller from director James Watkins, starring Tom Rhys Harries in the title role of the Gotham City villain. “Clayface” unravels one man’s horrifying descent from rising Hollywood star to revenge-filled monster in a story that explores the loss of one’s identity and humanity, corrosive love, and the dark underbelly of scientific ambition.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/clayface.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"53dc4345-efbb-420a-97f7-33c5121a96e3","name_vn":"MẸ MÌN","name_en":"","director":"Jack Carry On","actor":"Minh Hằng, Nhật Kim Anh, Rima Thanh Vy, Khương Lê, Đại Nghĩa, Bé Tư, Phát La","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"c76a5b3c-0090-44d8-9299-6b345de94265","type_name_vn":"Hồi Hộp","type_name_en":"Nervous","release_date":"10/23/2026 12:00:00 AM","end_date":"11/28/2026 12:00:00 AM","brief_vn":"MẸ MÌN – một nhân vật bí ẩn – có khả năng ban phát điều ước cho mọi người, nhưng điều ước nào cũng sẽ đi kèm điều kiện của nó.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/me-min.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"a402aa0c-4fb8-4f7f-ae7d-62223e5fe394","name_vn":"HUYẾT THỐNG","name_en":"","director":"Đinh Đức Thiện","actor":"Quách Ngọc Ngoan, Quang Tuấn,...","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"afc75f85-8fb4-4fae-bef5-f8202f5c6e95","type_name_vn":"Kinh Dị","type_name_en":"Horror","release_date":"10/30/2026 12:00:00 AM","end_date":"12/19/2026 12:00:00 AM","brief_vn":"Halloween này, đánh dấu sự trở lại của bộ đôi Quách Ngọc Ngoan và Quang Tuấn, Huyết Thống mang đến một câu chuyện kinh dị tâm linh vừa quỷ dị, ám ảnh, vừa chất chứa những cảm xúc sâu sắc xoay quanh hai chữ “huyết thống”.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/10-2026/huyet-thong.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"c25ef778-7dd2-4371-a854-11a7c502becc","limitage_vn":"T18","limitage_en":"T18","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"5f4c980c-13ec-4a1c-a41f-4f150e5c6233","name_vn":"CHÀNG MÈO MANG MŨ","name_en":"THE CAT IN THE HAT","director":"Alessandro Carloni, Erica Rivinoja","actor":"Bill Hader, Xochitl Gomez, Matt Berry, Quinta Brunson, Paula Pell,...","country_id":"ab21efed-68c1-4fcc-a172-3496f0bf9539","country_name_vn":"Khác","country_name_en":"Other","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"aec9797f-1f3b-403d-b55d-39b245e0e2a6,41eddd0c-c45b-43ff-9988-8e59921f0c1c,39021e14-664c-4d4c-bb93-90f8aa1a0270","type_name_vn":"Hoạt hình, Gia đình, Phiêu Lưu","type_name_en":"Cartoon, Family, Adventure","release_date":"11/6/2026 12:00:00 AM","end_date":"12/12/2026 12:00:00 AM","brief_vn":"Trong phim,Chàng Mèo Mang Mũ của chúng ta nhận nhiệm vụ khó khăn nhất từ trước đến nay từ tổ chức I.I.I.I. (Viện Sáng Tạo và Cảm Hứng, LLC): cổ vũ tinh thần cho Gabby và Sebastian, hai anh em đang vật lộn với việc thích nghi sau khi chuyển đến một thị trấn mới. Với \"thành tích\" thường xuyên làm quá mọi chuyện, lần này có thể sẽ là cơ hội cuối cùng để anh chàng chuyên gây rối này chứng minh bản thân nếu không muốn mất đi chiếc mũ thần kỳ!","brief_en":"In the film, our Cat In The Hat takes on his toughest assignment yet for the I.I.I.I. (Institute for the Institution of Imagination and Inspiration, LLC): to cheer Gabby and Sebastian, a pair of siblings struggling with their move to a new town. Known for taking things too far, this could be this agent of chaos’s last chance to prove himself...or lose his magical hat!","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/11-2026/meo.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"e4e5897c-cf98-40ba-a767-cd350a06bef7","name_vn":"BÒ SỮA BAY","name_en":"","director":"Nguyễn Phạm Thành Đạt","actor":"Nguyễn Hùng, Võ Điền Gia Huy, Ngọc Xuân, Tiểu Vy, Lãnh Thanh, Huy Tít","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac,e4bb99c9-da30-4ce8-9840-a0864f988454,a970a694-a823-4ca3-b6ea-cb8b3f44f2bd","type_name_vn":"Hài, Hành Động, Tâm Lý","type_name_en":"Comedy, Action, Drama","release_date":"11/6/2026 12:00:00 AM","end_date":"12/19/2026 12:00:00 AM","brief_vn":"Vào những năm 90, một trang trại bò sữa đang nghiên cứu một công thức sữa độc quyền có thể chữa lành vết thương, trẻ hóa và nhiều công dụng đặc biệt khác. Để thoát nghèo, một nhóm công nhân quyết định đánh cắp công thức sữa ấy, cho đến khi Trâu - tên đầu sỏ có cảm tình đặc biệt với người tạo nên công thức sữa.","brief_en":"In the 1990s, a dairy farm was working on a special milk formula that could heal wounds and make people look younger. To get out of poverty, a group of workers planned to steal it. But everything changed when their leader, Trau - started to fall for the person who created the formula","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/11-2026/bsb.jpg","himage":"","trailer":"QWamM7IZ5rU","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"8cccac51-8401-46b0-9807-711723da953c","language_vn":"VN","language_en":"EN","sortorder":"0"},{"id":"bbc79b65-730e-48ff-af5c-026859796f11","name_vn":"GẶP GỠ THÔNG GIA: DÂU MỚI TRÌNH LÀNG","name_en":"FOCKER IN-LAW","director":"John Hamburg","actor":"Robert De Niro, Ben Stiller, Ariana Grande, Owen Wilson, Blythe Danner, Teri Polo, Skyler Gisondo, Beanie Feldstein, Eduardo Franco","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"01912ab9-7d92-4ae4-aee9-84e02b09b8ac","type_name_vn":"Hài","type_name_en":"Comedy","release_date":"11/27/2026 12:00:00 AM","end_date":"12/26/2026 12:00:00 AM","brief_vn":"Henry, con trai của Greg Focker đưa bạn gái mình, một chuyên gia đàm phán con tin của FBI về ra mắt gia đình. Mọi chuyện bắt đầu trở nên rối rắm khi Henry tiết lộ kế hoạch cầu hôn, khiến Greg không khỏi lo lắng và kéo theo hàng loạt tình huống dở khóc dở cười.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/11-2026/foker-in-law.png","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"94a6522f-67a7-4453-9464-6cf6c888b20e","limitage_vn":"Chưa phân loại","limitage_en":"Uncategorized","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"bd01aace-eb90-4370-8296-e8d67269c86a","name_vn":"DUNE: HÀNH TINH CÁT - PHẦN BA","name_en":"DUNE: PART THREE","director":"Denis Villeneuve","actor":"Timothée Chalamet, Zendaya, Jason Momoa, Florence Pugh, Rebecca Ferguson, Isaach De Bankolé, Charlotte Rampling, Anya Taylor-Joy, Robert Pattinson, Javier Bardem,...","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"7fd1e879-f418-4e70-a1ba-2cf55336fc6a,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Thần Thoại, Hành Động","type_name_en":"Fantasy, Action","release_date":"12/18/2026 12:00:00 AM","end_date":"1/9/2027 12:00:00 AM","brief_vn":"Dune: Hành Tinh Cát - Phần Ba lấy bối cảnh gần hai thập kỷ sau khi Paul Atreides nắm quyền kiểm soát Đế chế. Giờ đây, khi đã trở thành một Hoàng đế tàn nhẫn, Paul phải đối mặt với những hậu quả từ chính sự cai trị của mình. Những đồng minh cũ trở lại, những mỗi đe dọa mới trỗi dậy, và cả sự phản bội luôn lẩn khuất trong bóng tối. Bị ám ảnh bởi viễn cảnh Đế chế sụp đổ cùng sự trở lại của một người anh từng yêu thương, Paul bị cuốn vào một âm mưu hủy diệt - mà trung tâm của bí mật ấy lại chính là Chani. Cuộc nổi dậy dần nhen nhóm, những kẻ thù ngày một áp sát. Chính lúc này đây, Paul sẽ phải đối diện với cái giá thực sự của quyền lực, đánh đổi bằng định mệnh của những người quan trọng nhất cuộc đời anh.","brief_en":"Dune: Part Three is set nearly two decades after Paul Atreides seized control of the Imperium. Now a ruthless Emperor, Paul must face the consequences of his reign as old allies return, terrifying new threats emerge, and betrayal lurks in every shadow. Haunted by visions of Imperial collapse and the reappearance of his long-lost love, Paul is drawn into a sweeping conspiracy, with Chani at the heart of its unfolding mystery. As rebellion brews and enemies close in, Paul must confront the true cost of power and the fate of those he loves the most.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/12-2026/dune-p3.jpg","himage":"","trailer":"","status":"1","ratings":"","time":"99","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"2d0ff8dc-7b2a-4b36-90f0-4c18bed87d99","name_vn":"AVENGERS: NGÀY TẬN THẾ","name_en":"ANVENGERS: DOOMSDAY","director":"Anthony Russo, Joe Russo","actor":"Robert Downey Jr., Chris Evans, Chris Hemsworth, Pedro Pascal, Paul Rudd, Anthony Mackie, Florence Pugh, Vanessa Kirby, Ebon Moss-Bachrach, Wyatt Russell, Channing Tatum, Simu Liu, Ian McKellen, Tom Hiddleston, James Marsden, Patrick Stewart, Joseph Quinn, Sebastian Stan, David Harbour, Letitia Wright, Lewis Pullman, Kelsey Grammer, Kathryn Newton, Danny Ramirez, Winston Duke, Alan Cumming, Hannah John-Kamen, Rebecca Romijn, Mabel Cadena, Tenoch Huerta Mejia","country_id":"13122406-a30e-46a5-a919-7f276a67a283","country_name_vn":"Hoa Kỳ","country_name_en":"American","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"af57ca9b-58f4-43d5-957e-9776f6cb4833,e4bb99c9-da30-4ce8-9840-a0864f988454,0a965518-4d8c-4483-b9a3-bb56424dcade","type_name_vn":"Siêu Anh Hùng, Hành Động, Khoa Học Viễn Tưởng","type_name_en":"Heroes, Action, Science fiction","release_date":"12/18/2026 12:00:00 AM","end_date":"1/23/2027 12:00:00 AM","brief_vn":"Avengers: Doomsday theo chân những người hùng được yêu mến đến từ ba vũ trụ khác nhau, khi họ bị cuốn vào một hành trình va chạm sinh tử và phải đối mặt với một mối đe dọa mang tính sống còn chưa từng có trong lịch sử.","brief_en":"Avengers: Doomsday follows beloved heroes from three distinct universes as they’re set on a deadly collision course and face an existential threat unlike anything they’ve ever encountered.","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/12-2026/doomsday.jpg","himage":"","trailer":"-bGVufP3uaQ","status":"1","ratings":"","time":"165","limitage_id":"16e1ac95-3413-4069-8852-3df676ee17e6","limitage_vn":"T13","limitage_en":"T13","language_id":"1db4ab93-0c22-44d5-96f1-f78f8e3a0ecb","language_vn":"Phụ Đề","language_en":"VN","sortorder":"0"},{"id":"a18c46f7-cc1a-48d7-af0b-f9228e0f8203","name_vn":"NGƯỜI MẸ XẤU","name_en":"","director":"Hoàng Tuấn Cường","actor":"","country_id":"e05acda1-df71-4578-a40b-6766a1ba8e23","country_name_vn":"Việt Nam","country_name_en":"VietNam","formats_id":"7835de0f-c073-43d4-a086-e1d9ae8dbed4","formats_name_vn":"2D","formats_name_en":"2D","type_id":"1bfe9d04-d045-405f-b2b0-22eb5be4c13b,e4bb99c9-da30-4ce8-9840-a0864f988454","type_name_vn":"Tình Cảm, Hành Động","type_name_en":"Romance, Action","release_date":"12/31/2026 12:00:00 AM","end_date":"1/30/2027 12:00:00 AM","brief_vn":"Một cuộc chạy trốn trong mưa. Một người mẹ không hoàn hảo. Một người con không thể quay đầu.\r\n\r\nSau thành công của Thiên Đường Máu, đạo diễn Hoàng Tuấn Cường chính thức trở lại với NGƯỜI MẸ XẤU, bộ phim hành động - tình cảm mang đậm màu sắc Việt Nam.","brief_en":"","desc_vn":"","desc_en":"","image":"https://api-website.cinestar.com.vn/media/wysiwyg/Posters/12-2026/nguoi-me-xau-firstlook.jpg","himage":""