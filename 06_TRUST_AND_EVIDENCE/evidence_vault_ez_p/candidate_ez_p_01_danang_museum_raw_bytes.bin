<button id="scrollToTopBtn" title="Cuộn lên đầu trang">
    <i class="fas fa-chevron-up"></i>
</button>


<script src="https://baotangdanang.vn/js/bootstrap.bundle.min.js" defer></script>
<script src="/js/app.js?id=4be44ce3ed3db42f9a4e18124e182462"></script>

<script>
    // Toàn bộ logic không dùng jQuery (Vanilla JS) chạy ngay khi DOM sẵn sàng
    document.addEventListener("DOMContentLoaded", function() {

        // Tự động thêm Alt cho ảnh (tốt cho SEO và PageSpeed)
        const defaultAlt = 'Bảo tàng Đà Nẵng';
        document.querySelectorAll("img").forEach(img => {
            if (!img.getAttribute("alt") || img.getAttribute("alt").trim() === "") {
                img.setAttribute("alt", defaultAlt);
            }
            // Thêm lazy load trực tiếp bằng JS cho các ảnh
            if (!img.hasAttribute("loading")) {
                img.setAttribute("loading", "lazy");
            }
        });

        // Nút cuộn lên đầu trang
        const mybutton = document.getElementById("scrollToTopBtn");
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                mybutton.style.display = "block";
            } else {
                mybutton.style.display = "none";
            }
        });
        mybutton.addEventListener("click", function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Xử lý Container Menu
        const elMenu = document.getElementById('main-menu');
        function handleResize() {
            if (elMenu) {
                if (window.innerWidth <= 1199) elMenu.classList.add('container');
                else elMenu.classList.remove('container');
            }
        }
        handleResize();
        window.addEventListener('resize', handleResize);

        // Logic Dropdown Menu Mobile (Không dùng jQuery)
        document.querySelectorAll('.dropdown-toggle, .dropdown-toggle-side').forEach(toggle => {
            toggle.addEventListener('click', function(e) {
                if (window.innerWidth < 1200) {
                    const nextMenu = this.nextElementSibling;
                    if (nextMenu && nextMenu.classList.contains('dropdown-menu')) {
                        e.preventDefault();
                        e.stopPropagation();
                        this.parentElement.parentElement.querySelectorAll(':scope > li > .dropdown-menu.show').forEach(openMenu => {
                            if (openMenu !== nextMenu) {
                                openMenu.classList.remove('show');
                                openMenu.parentElement.classList.remove('show');
                            }
                        });
                        nextMenu.classList.toggle('show');
                        this.parentElement.classList.toggle('show');
                    }
                }
            });
        });
    });

    // 4. LOGIC DÙNG JQUERY: Đợi window load để chắc chắn app.js (chứa jQuery) đã sẵn sàng
    window.addEventListener('load', function() {
        if (typeof jQuery !== 'undefined') {
            $(document).ready(function () {
                const $searchWrapper = $('#search-wrapper');
                const $searchSuggestions = $('#search-suggestions');
                const $mainSearchInput = $('#main-search');
                const $searchTypeInput = $('#search-type');
                const $searchForm = $('#search-form');
                const $triggerMobile = $('#trigger-search-mobile');

                function activateSearchType(typeValue) {
                    const $targetItem = $(`.suggestion-item[data-value="${typeValue}"]`);
                    if ($targetItem.length > 0) {
                        $('.suggestion-item').removeClass('active');
                        $targetItem.addClass('active');
                        const typeName = $targetItem.find('span').text();
                        $mainSearchInput.attr('placeholder', 'Tìm theo: ' + typeName);
                        $searchTypeInput.val(typeValue);
                    }
                }

                const urlParams = new URLSearchParams(window.location.search);
                const typeFromUrl = urlParams.get('search_type');
                if (typeFromUrl) activateSearchType(typeFromUrl);
                else {
                    const firstValue = $('.suggestion-item').first().data('value');
                    if (firstValue) activateSearchType(firstValue);
                }

                $('.suggestion-item').on('click', function (e) {
                    e.stopPropagation();
                    activateSearchType($(this).data('value'));
                    $searchSuggestions.fadeOut(200);
                });

                $mainSearchInput.on('click', function (e) {
                    e.stopPropagation();
                    $searchSuggestions.stop().fadeIn(200);
                });

                $triggerMobile.on('click', function (e) {
                    e.stopPropagation();
                    $searchWrapper.toggleClass('mobile-active');
                    if ($searchWrapper.hasClass('mobile-active')) $mainSearchInput.focus();
                });

                $searchForm.on('submit', function (e) {
                    if ($mainSearchInput.val().trim() === "") {
                        e.preventDefault();
                        alert("Vui lòng nhập từ khóa tìm kiếm!");
                        $mainSearchInput.focus();
                    }
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#search-suggestions, #main-search').length) {
                        $searchSuggestions.fadeOut(200);
                    }
                    if ($(window).width() < 768 && !$(e.target).closest('.search-container').length) {
                        $searchWrapper.removeClass('mobile-active');
                    }
                });
            });
        }
    });
</script>


    <script>
        $(document).ready(function(){
            $('.artifacts-carousel').slick({
                slidesToShow: 4,
                dots: false,
                centerMode: true,
                autoplay: true,
                autoplaySpeed: 3000,
                pauseOnHover: true,
                infinite: true,
                rows: true,
                responsive: [
                    {
                        breakpoint: 768,
                        settings: {
                            slidesToShow: 1,
                        }
                    },
                    {
                        breakpoint: 992,
                        settings: {
                            slidesToShow: 2,
                        }
                    }
                ]
            });
        });

        function openLink(select) {
            if (select.value) {
                window.open(select.value, '_blank');
                select.selectedIndex = 0;
            }
        }
    </script>
    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        let player;

        function getYoutubeId(url) {
            const regExp = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
            const match = url.match(regExp);
            return match ? match[1] : null;
        }

        function onYouTubeIframeAPIReady() {
            const firstItem = document.querySelector('.video-item');

            if (!firstItem) return;

            const videoUrl = firstItem.dataset.url;
            const videoId = getYoutubeId(videoUrl);

            player = new YT.Player('youtube-player-container', {
                videoId: videoId,
                playerVars: {
                    autoplay: 1,
                    mute: 1,       // ⚠️ autoplay bắt buộc mute
                    controls: 1,
                    rel: 0
                }
            });
        }

        document.addEventListener('click', function (e) {
            const item = e.target.closest('.video-item');
            if (!item || !player) return;

            const videoId = getYoutubeId(item.dataset.url);

            if (videoId) {
                player.loadVideoById(videoId);
                player.unMute();          // 🔊 ĐƯỢC PHÉP
                player.setVolume(100);

                document.querySelectorAll('.video-item').forEach(el => el.classList.remove('active'));
                item.classList.add('active');
            }
        });

        var $bannerVideos = $('.banner-video');
        var imageTimer = null;
        var SLIDE_INTERVAL = 5000;

        function getActiveVideo() {
            return $('#homeCarousel .carousel-item.active .banner-video')[0] || null;
        }

        function updateMuteIcon(video) {
            $('#icon-mute').toggleClass('fa-volume-off', video.muted).toggleClass('fa-volume-up', !video.muted);
        }

        function toggleBannerMute() {
            var v = getActiveVideo();
            if (!v) return;
            v.muted = !v.muted;
            updateMuteIcon(v);
        }

        function clearImageTimer() {
            if (imageTimer) { clearTimeout(imageTimer); imageTimer = null; }
        }

        function handleActiveSlide() {
            clearImageTimer();
            var activeVideo = getActiveVideo();
            if (activeVideo) {
                activeVideo.currentTime = 0;
                activeVideo.play().catch(function(){});
                $('#btn-toggle-mute').show();
                updateMuteIcon(activeVideo);
                $(activeVideo).off('ended').on('ended', function() {
                    $('#homeCarousel').carousel('next');
                });
            } else {
                $('#btn-toggle-mute').hide();
                imageTimer = setTimeout(function() {
                    $('#homeCarousel').carousel('next');
                }, SLIDE_INTERVAL);
            }
        }

        // Pause video khi rời slide
        $('#homeCarousel').on('slide.bs.carousel', function() {
            clearImageTimer();
            $bannerVideos.each(function() { this.pause(); });
        });

        $('#homeCarousel').on('slid.bs.carousel', handleActiveSlide);

        // Lần đầu tương tác bật âm thanh
        document.addEventListener('touchstart', function() {
            var v = getActiveVideo();
            if (v) { v.muted = false; updateMuteIcon(v); }
        }, { once: true });
        document.addEventListener('click', function() {
            var v = getActiveVideo();
            if (v) { v.muted = false; updateMuteIcon(v); }
        }, { once: true });

        handleActiveSlide();

        function show_banner(link, name) {
            close_banner();
            let html = `<div class="popup-banner">
                            <i class="fas fa-times" onclick="close_banner()"></i>
                            <iframe src="${link}" title="${name}" frameborder="0" loading="lazy" allowfullscreen></iframe>
                        </div>`;
            if (link != ''){
                $('body').append(html).css('overflow', 'hidden');
            }
        }

        function close_banner() {
            $('.popup-banner').remove();
            $('body').css('overflow', 'auto');
        }
    </script>

</body>
</html>
