                $("#homePhoto").each(function () {
                    $(this).attr("src", "/Images/blue/banner.jpg");
                });
            }
            else {
                $("#homePhoto").each(function () {
                    $(this).attr("src", "/Images/blue/banner.jpg");
                });
            }
        }

        $(window).on('load', function (e) {
            setHomePageImage();
        });


        $(window).resize(function (e) {
            setHomePageImage();
        });

    </script>




