</div>


<script>
    var standarSize = 13;
    var titleStandarSize = 20;
    function resizeText(number) {

        var titleSize = parseInt($('.titleBaiViet').css('font-size'));
        var descriptionSize = parseInt($('.trichyeuBaiViet').css('font-size'));
        var contentSize = parseInt($('.noidungBaiViet').css('font-size'));


        if (number > 0) {
            contentSize = contentSize + 1;
            titleSize = titleSize + 1;
            descriptionSize = descriptionSize + 1;
        } else if (number < 0) {
            contentSize = contentSize - 1;
            titleSize = titleSize - 1;
            descriptionSize = descriptionSize - 1;
        } else {
            contentSize = standarSize;
            titleSize = titleStandarSize;
            descriptionSize = standarSize;
        }
        $('.noidungBaiViet').css('font-size', contentSize + "px");
        $('.titleBaiViet').css('font-size', titleSize + "px");
        $('.trichyeuBaiViet').css('font-size', descriptionSize + "px");
        $('.trichyeuBaiViet p').css('font-size', descriptionSize + "px");
        $('.trichyeuBaiViet span').css('font-size', descriptionSize + "px");
    }


    function setContrast(vlContrast) {
        if (vlContrast == 3) {
            $(".div-body-news").css("background-color", "#FFF");
            $(".div-related-news").css("background-color", "#FFF");
        } else {
            if (vlContrast == 0) {
                $(".div-body-news").css("background-color", "#DCDCDC");
                $(".div-related-news").css("background-color", "#DCDCDC");
            } else {
                if (vlContrast == 1) {
                    $(".div-body-news").css("background-color", "#F5F5F5");
                    $(".div-related-news").css("background-color", "#F5F5F5");
                } else {
                    $(".div-body-news").css("background-color", "#F8F8FF");
                    $(".div-related-news").css("background-color", "#F8F8FF");
                }
            }
        }
    }

    var vl = 3;
    setContrast(vl);

    $("#giamContrast").click(function () {
        if (vl > 0) {
            vl = vl - 1;
            setContrast(vl);
        }
    });

    $("#tangContrast").click(function () {
        if (vl < 3) {
            vl = vl + 1;
            setContrast(vl);
        }
    });

    function openPrintWindow(url) {
        window.open(url, '', 'top=10,left=10,scrollbars=1,resizable=1');
    }


</script>
<script>


    $('.tts').before("<img id='loader' style='display: none' src='https://ttsvpubtp.danang.gov.vn/images/loader.gif'>");

    $('#btPlay').click(function () {
        let data = {
            'token': "5056167b-b990-4723-9f86-aac80a6a85fa",
            'content': $.trim($('.tts').text())
        }
        $.ajax({
            type: 'POST',
            url: 'https://ttsvpubtp.danang.gov.vn/api/getAudio',
            dataType: 'json',
            contentType: 'application/json',
            beforeSend: function () {
                $('#loader').show()
                $('#btPlay').hide()
            },
            success: function (data) {
                $('.tts').before("<br><audio controls autoplay src='" + data.src + "'></audio>")
            },
            complete: function () {
                $('#loader').hide();
            },
            data: JSON.stringify(data)
        });
    });





</script>

