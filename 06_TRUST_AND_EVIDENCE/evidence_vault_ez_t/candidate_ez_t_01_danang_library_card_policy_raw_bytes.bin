<script>

    var Client = Client || {};
    Client.Pulse = null;
    $(document).ready(function () {
        Client.Heartbeat();

    });




    /// Sends the heartbeat signal and retrieves the currently active user list
    Client.Heartbeat = function () {
        data = {
            UserName: '66de5b75-f1e7-431a-800d-0fc81cb3a5cc'
        };
        strdata = JSON.stringify(data)
        $.ajax({ //Send the signal and recieve the information about active users back
            url: '/api/HeartBeat/CheckActive',
            type: 'POST',
            contentType: 'application/json',
            data: strdata,
            success: function (response, sStatus, jqXHR) {
                Client.RenderActiveUsers(response);
                Client.Pulse = setTimeout(function () {
                    Client.Heartbeat();
                }, 300000); //300 second delay before next trigger
            } //success
        }); //$.ajax
    } //Heartbeat

    Client.RenderActiveUsers = function (response) {
        var numVisit = response.numVisit;
        var numOnline = response.numOnline;
        var strStatistic = '<b>Tổng cộng 009398' + numVisit.toString() +'</b>';
        var his = '<p>Hôm nay: ' + ViewBag.DailyCount.ToString() + '<br>' + 'Hôm qua: 26<br>' + 'Tuần này: 167<br>' + 'Tháng này:182<br>' + 'Tháng trước: 2344 <br>';
        $('#statistics').html(strStatistic + his);
    } //RenderActiveUsers
</script>