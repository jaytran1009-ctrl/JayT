    <section class="post-office-tracking" ng-controller="postOfficeCtrl">
    <div id="reloadPage" ng-show="reloadPage">
        <i class="fa fa-spinner fa-pulse fa-3x fa-fw"></i>
    </div>
    <div class="container container-form-tracking">
        <div id="reloadPage" ng-show="reloadPage">
            <i class="fa fa-spinner fa-pulse fa-3x fa-fw"></i>
        </div>
        <div class="row">
            <div class="col-xl-8 col-12">
                <div class="form-title text-capitalize text-left">
                    <img src="https://vnpost.vn/apps/frontend/images/svg/icon-tracking.svg" class="mr-2">
                    Theo Dõi Bưu Gửi
                </div>
                <form class="form-tracking w-100 d-flex justify-content-evenly pt-2 align-items-center" action=""
                    method="get">
                    <div class="div-tracking div-tracking-input">
                        <input type="text" ng-model="data.dataSearch.post_code" class="input-tracking w-100"
                            placeholder="Nhập mã bưu gửi/mã lô bưu gửi">
                        <span class="d-block text-danger"
                            ng-if="info_errors.errors['post_code']">{{ info_errors.errors['post_code'][0] }}</span>
                    </div>
                                        <div class="div-tracking d-flex justify-content-evenly with-tracking">
                        <div class="div-tracking-cap">
                            <input type="text" ng-model="data.dataSearch.captcha" placeholder="Mã xác nhận" class="input-tracking w-100">
                            <span class="d-block text-danger" ng-if="info_errors.errors['captcha']">{{ info_errors.errors['captcha'][0] }}</span>
                        </div>
                        <div class="d-flex img-cap w-100">
                            <div class="output-code align-items-center  justify-content-evenly" style="display:none" id="tra-cuu-captcha-block">
                                <img id="tra-cuu-captcha" alt="Captcha Image">
                                <div class="d-inline-block">
                                    <img class="undo reload-captcha" onclick="getcaptcha('tra-cuu-captcha')" src="https://vnpost.vn/apps/frontend/images/svg/undo.svg" alt="Tải lại Captcha">
                                </div>
                            </div>
                        </div>
                    </div>
                                        <button type="button" class="button-tracking" ng-click="actions.search()">
                        Theo dõi</button>
                </form>
            </div>
            <div class="col-xl-4 col-12 mt-xl-0 mt-3 post-office">
                <ul class="item-service">
                    <li>
                        <a href="ca-nhan/gui-tai-lieu-hang-hoa/gui-trong-nuoc/tim-kiem-buu-cuc">
                            <div class="icon">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/icon-fill.svg">
                            </div>
                            <div class="content text-capitalize">
                                Tìm Bưu Cục
                            </div>
                        </a>
                    </li>
                    <li>
                        <a href="ca-nhan/chuyen-phat/chuyen-phat-trong-nuoc#!?tab=uoc-tinh-cuoc-phi">
                            <div class="icon">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/icon-calculator.svg">
                            </div>
                            <div class="content text-capitalize">
                                Ước Tính Cước 
                            </div>
                        </a>
                    </li>
                    <li>
                        <a href="ca-nhan/tra-cuu-chuyen-tien">
                            <div class="icon">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/icon-postid.svg">
                            </div>
                            <div class="content text-capitalize">
                                Tra cứu mã tiền
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="container" id="post-office-search"ng-if="data.listInfo.info.LO_GUI==0 || info_errors.message" >
        <div class="row">
            <section class=" block-tab">
                <i class="fa fa-minus block-tab-icon" ng-click="actions.closeSearch()" aria-hidden="true"></i>
                <div class="lookup-result" ng-if="info_errors.message">
                    <div class="lookup-journey-content-solve mt-3">
                        <div class="lookup-journey-content-solve-block row no-gutters mt-4">
                            <div class="col-xl-12 col-12 text-center mb-3">
                                <span class="d-block text-danger">{{ info_errors.message }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="lookup-result" ng-if="data.listInfo.locate">
                    <div class="lookup-journey-content-solve mt-3" >
                        <div class="lookup-journey-content-solve-block row no-gutters mt-4">
                            <h6 class="text-uppercase f-default col-12">
                                <strong>Giải quyết khiếu nại</strong>
                            </h6>
                            <div class="lookup-journey-content-solve-block-code col-12 col-lg-4">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/solve-01.svg" alt="solve-01">
                                <span>Bưu gửi số : &nbsp;</span>
                                <b>{{ data.listInfo.info.ID }}</b>
                            </div>
                            <div class="lookup-journey-content-solve-block-code col-12 col-lg-4">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/solve-01.svg" alt="solve-01">
                                Khối lượng (gam) : &nbsp;
                                <b>{{ data.listInfo.info.Weight }}</b>
                            </div>
                            <div class="lookup-journey-content-solve-block-code col-12 col-lg-4">
                                <img src="https://vnpost.vn/apps/frontend/images/svg/solve-03.svg" alt="solve-03">
                                Trạng thái : &nbsp;<b>{{ data.listInfo.delivery.length > 0 ? data.listInfo.delivery[data.listInfo.delivery.length - 1].STATUSTEXT.split('.')[0] : '' }}
                                </b>
                            </div>
                        </div>

                        <div class="lookup-journey-content-solve-info ">
                            <div class="row">
                                <div class="col-12 col-md-4 d-flex pt-3">
                                    <div class="lookup-journey-content-solve-info-title">
                                        <p class="f-bold">
                                            <b>Nước chấp nhận:&nbsp;{{ data.listInfo.info.Nuoc_Chapnhan }}</b>
                                        </p>
                                        <p class="f-bold">
                                            <b>Bưu cục nhận:&nbsp;{{ data.listInfo.info.BC_GUI }}</b>
                                        </p>
                                    </div>
                                    <div class="lookup-journey-content-solve-info-desc">
                                        <p class="text-uppercase"></p>
                                        <p></p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 d-flex pt-0 pt-md-3 pt-xl-3">
                                    <div class="lookup-journey-content-solve-info-title">
                                        <p class="f-bold">
                                            <b>Nước phát:&nbsp;{{ data.listInfo.info.Nuoc_Phat }}</b>
                                        </p>
                                        <p class="f-bold">
                                            <b>Bưu cục phát:&nbsp;{{ data.listInfo.info.BC_PHAT }}</b>
                                        </p>
                                    </div>
                                    <div class="lookup-journey-content-solve-info-desc">
                                        <p class="text-uppercase"></p>
                                        <p></p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 d-flex pt-0 pt-md-3 pt-xl-3"
                                    ng-if="data.listInfo.info.isBHBG == 1">
                                    <div class="lookup-journey-content-solve-info-title" style="color: red">
                                        <p class="f-bold">
                                            <i>Có sử dụng Bảo hiểm bưu gửi</i>
                                        </p>
                                        <p class="f-bold">
                                            <i>Tra cứu hồ sơ&nbsp;
                                                <a href="https://mycontract.pti.com.vn/gcn" target="_blank"
                                                    style="color: red">
                                                    <b><u>tại đây</u></b>
                                                </a>
                                            </i>
                                        </p>
                                    </div>
                                    <div class="lookup-journey-content-solve-info-desc">
                                        <p class="text-uppercase"></p>
                                        <p></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lookup-journey-content-status mt-4">
                        <h6 class="text-uppercase f-default"><strong>Thông tin trạng thái</strong>
                        </h6>
                        <section class="timeline">
                            <div class="timeline__block" ng-repeat="item in data.listInfo.locate">
                                <div class="timeline__midpoint "></div>
                                <div class="timeline__content timeline__content--right">
                                    <div class="timeline__text--right">
                                        <div class="timeline__item-first ">
                                            <div class="date-time">{{ item.Date }} {{ item.TimeDetail }}
                                            </div>
                                            {{ item.StatusText }}
                                        </div>
                                        <div class="timeline__item-center custom-title-2 position-relative">
                                            <br>
                                            <span class="location">{{ item.VI_TRI }}</span>
                                            <i ng-if="actions.checkShowRow(item)"
                                                ng-click="actions.showDetalMap(item)"
                                                class="fa fa-location-arrow location-arrow text-primary"
                                                aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <h6 ng-if="data.listInfo.delivery.length>0" class="text-uppercase f-default mt-4"><strong>Thông tin phát</strong>
                        </h6>
                        <table ng-if="data.listInfo.delivery.length>0" class="table table-bordered">
                            <colgroup>
                            <col width="20%">
                            <col width="20%">
                            <col width="60%">
                            </colgroup>
                            <thead class="bg-light">
                                <tr>
                                    <th>Ngày</th>
                                    <th>Bưu cục</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in data.listInfo.delivery">
                                    <td>
                                        {{ item.NGAY_PHAT }}
                                    </td>
                                    <td>
                                        {{ item.VI_TRI}}
                                    </td>
                                    <td>
                                        {{ item.STATUSTEXT }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="text-uppercase mt-3  f-default"><strong>{{ data_map_detail.StatusText }}</strong>
                        </h6>
                        <div id="map_detail" ng-show="data_map_detail.POSCode"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
     <div class="container" id="post-office-search"ng-if="data.listInfo.info.LO_GUI==1 || info_errors.message" >
        <div class="row">
            <section class=" block-tab">
                <i class="fa fa-minus block-tab-icon" ng-click="actions.closeSearch()" aria-hidden="true"></i>
                <div class="lookup-result" ng-if="info_errors.message">
                    <div class="lookup-journey-content-solve mt-3">
                        <div class="lookup-journey-content-solve-block row no-gutters mt-4">
                            <div class="col-xl-12 col-12 text-center mb-3">
                                <span class="d-block text-danger">{{ info_errors.message }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        Số hiệu:&nbsp;{{ data.listInfo.info.LO }}
                    </div>
                    <div class="col-md-6">
                        Mã đơn hàng: &nbsp;{{ data.listInfo.info.DATACODE }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        Nước nhận: &nbsp;{{ data.listInfo.info.Nuoc_Chapnhan }}
                    </div>
                    <div class="col-md-6">
                        Nước phát: &nbsp;{{ data.listInfo.info.Nuoc_Phat }}
                    </div>
                    <div class="col-md-6">
                        Bưu cục chấp nhận: &nbsp;{{ data.listInfo.info.BC_GUI }}
                    </div>
                    <div class="col-md-6">
                        Bưu cục phát:&nbsp;{{ data.listInfo.info.BC_PHAT }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        Người gửi:&nbsp;{{ data.listInfo.info.HO_TEN_GUI }}
                    </div>
                    <div class="col-md-6">
                        Người nhận:&nbsp;{{ data.listInfo.info.HO_TEN_NHAN }}
                    </div>
                    <div class="col-md-6">
                        Địa chỉ gửi:&nbsp;{{ data.listInfo.info.DIA_CHI_GUI }}
                    </div>
                    <div class="col-md-6">
                        Địa chỉ nhận:&nbsp;{{ data.listInfo.info.DIA_CHI_NHAN }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        Nội dung gửi hàng
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        Cước chính:&nbsp;{{ data.listInfo.info.MainFreight }}
                    </div>
                    <div class="col-md-6">
                        Cước xăng dầu:&nbsp;{{ data.listInfo.info.FuelSurchargeFreight }}
                    </div>
                    <div class="col-md-6">
                        Cước vùng xa:&nbsp;{{ data.listInfo.info.FarRegionFreight }}
                    </div>
                    <div class="col-md-6">
                        Tổng cước GTGT: &nbsp;{{ data.listInfo.info.TotalFreightdiscountvat }}
                    </div>
                    <div class="col-md-6">
                        Tổng cước chưa bao gồm VAT: &nbsp;{{ data.listInfo.info.TotalFreight }}
                    </div>
                    <div class="col-md-6">
                        Khối lượng thực tế: &nbsp;{{ data.listInfo.info.Weight }}
                    </div>
                    <div class="col-md-6">
                        Khối lượng quy đổi: &nbsp;{{ data.listInfo.info.KL_QUI_DOI }}
                    </div>
                </div>

                <h6 class="text-uppercase f-default mt-4"><strong>Thông tin lô hàng</strong>
                </h6>
                <div style="max-height: 300px;overflow-y: auto;position: relative;">
                    <table class="table table-bordered table-sm">
                        <colgroup>
                            <col width="50px">
                            <col width="*">
                            <col width="15%">
                            <col width="15%">
                            <col width="12%">
                            <col width="10%">
                            <col width="12%">
                            <col width="15%">
                        </colgroup>
                        <thead class="bg-light" style="position: sticky; top: 0;">
                            <tr>
                                <th class="text-center align-middle">STT</th>
                                <th class="text-center align-middle">Số hiệu bưu gửi</th>
                                <th class="text-center align-middle">Địa chỉ</th>
                                <th class="text-center align-middle">Thông tin chi tiết trạng thái</th>
                                <th class="text-center align-middle">Ngày phát</th>
                                <th class="text-center align-middle">Bưu cục phát</th>
                                <th class="text-center align-middle">Bưu tá phát</th>
                                <th class="text-center align-middle">Người nhận/ Lý do</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="(index,item) in data.listInfo.packages1">
                                <td class="text-center">{{ index + 1 }}</td>
                                <td>{{ item.ID }}</td>
                                <td>{{ item.Address }}</td>
                                <td>{{ item.StatusName }}</td>
                                <td>{{ item.TraceDate | date: 'dd/MM/yyyy HH:mm:ss' }}</td>
                                <td>{{ item.POSCode }}</td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr ng-repeat="(index,item) in data.listInfo.packages">
                                <td>{{ index + 1 }}</td>
                                <td>{{ item.ID }}</td>
                                <td>{{ item.ReceiverAddress }}</td>
                                <td></td>
                                <td>{{ item.NGAY_PHAT }}</td>
                                <td>{{ item.BC_PHAT }}</td>
                                <td>{{ item.BTA_PHAT }}</td>
                                <td>{{ item.Delivery_Detail }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</section>
