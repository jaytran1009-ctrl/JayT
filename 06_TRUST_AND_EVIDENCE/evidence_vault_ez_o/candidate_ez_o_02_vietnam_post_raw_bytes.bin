<script>
    $.ajaxSetup({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        }
    });
    var UPLOAD_URL = 'https://vietnampost.vn/uploads';
    var UPLOAD_ALIAS = 'vnp';
    var captcha_driver = "mews";
    function getcaptcha(element) {
        var target = document.getElementById(element);
        if(target){
            fetch('/handle-captcha/refresh-captcha')
            .then(res => res.json())
            .then(data => {
                target.src = data.captcha
                var target_block = document.getElementById(element+'-block')
                if(target_block) target_block.style.display = 'flex'

            })
        }

    }
</script>
