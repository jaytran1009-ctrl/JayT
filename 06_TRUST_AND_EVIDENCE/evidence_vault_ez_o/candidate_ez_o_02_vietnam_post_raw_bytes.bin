    <section id="news" class="viewpoint" ng-controller="newsCtrl">
    <div class="container">
        <div class="row">
            <div class="col-xl-9 col-12 text-center mb-20">
                <a class="text-dark" href="https://vnpost.vn/vi/tin-tuc">
                    <h2 class="text-uppercase d-inline-block big-title mb-0 news-title-home">Tin tức
                    </h2>
                </a>
            </div>
            <div class="col-xl-9 col-12">
                <div class="text-center">
                    <ul class="d-flex flex-wrap justify-content-center mt-0 mb-5" style="padding-left: 0;">
                        <li class="li-item {{ item.id == data.activeCategory ? 'active' : '' }} cursor-pointer" ng-repeat="item in data.listCategory"
                            ng-click='data.activeCategory=item.id; actions.activeCategory()'>
                            <a class="li-item-a">
                                {{ item.name }}
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="row mt-3" style="overflow: hidden">
                    <div class="col-md-6 news-left">
                        <div class="news-content item" ng-if='item.is_show' ng-repeat="item in data.listArticle"
                            ng-click="actions.redirect(item)">
                            <div class="news-content-img">
                                <img ng-src="{{ actions.getPath(item.avatar_info.filepath) }}" alt="{{ item.title }}">
                            </div>
                            <p ng-click="actions.redirect(item)" class="news-title text-2-line mt-3 cursor-pointer">
                                {{ item.title }}</p>
                            <span class="item-date d-block">{{ actions.formatDate(item.date_time_post ? item.date_time_post : item.created_at) }}</span>
                            <p class="news-summary text-3-line">{{ item.summary }}</p>
                            <div class="see-more">
                                <a class="view-detail" href="">Xem thêm</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 news-right">
                        <div class="news-block d-flex mb-3 item" ng-if='!item.is_show'
                            ng-repeat="item in data.listArticle">
                            <div class="news-active " ng-click="actions.redirect(item)">
                                <div class="news-block-img">
                                    <img ng-src="{{ actions.getPath(item.avatar_info.filepath) }}" alt="{{ item.title }}">
                                </div>
                                <div class="news-block-item">
                                    <p class="item-title text-2-line cursor-pointer">
                                        {{ item.title }}
                                    </p>
                                    <span class="item-date d-block">{{ actions.formatDate(item.date_time_post ? item.date_time_post : item.created_at) }}</span>
                                    <p class="item-summary text-2-line m-0">{{ item.summary }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-12">
                <div class="img-banner-top">
                    <a id="add-32" href="https://nongsan.buudien.vn/" class="banner-advertisment">
                        <img src="https://vietnampost.vn/uploads/storage/vnp/2025/03/31/f7e39c0e0c205184b26a66bc9eb72d523f23e937.jpg"
                            class="w-100" alt="Nông sản">
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<br>
