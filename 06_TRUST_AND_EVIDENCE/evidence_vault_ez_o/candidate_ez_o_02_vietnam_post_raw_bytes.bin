                var servSlider = $(".owl-carousel.serv");
                servSlider.owlCarousel({
                    loop: true,
                    autoplay: true,
                    autoplayTimeout: 5000,
                    nav: true,
                    dots: false,
                    margin: 20,
                    autoplayHoverPause: true,
                    responsive: {
