    <script>
    //    $(document).ready(function() {
    //         var element_desktop = $('.container-desktop');
    //         var element_mobile = $('.container-mobile');
    //         var full_width = $(window).width();
    //         $(window).resize(function() {
    //             var width = $(window).width();
    //             if (width > 991) {
    //                 $(".container-mobile").remove();
    //                 $('.screen-res').append(element_desktop);
    //             } else {
    //                 $('.screen-res').append(element_mobile);
    //                 $(".container-desktop").remove();
    //             }
    //         })
    //         var width = $(window).width();
    //         if (width > 991) {
    //             $(".container-mobile").remove();
    //         } else {
    //             $(".container-desktop").remove();
    //         }
    //     })

        let showPO = false;
        let showNews = false;
        let showDigPost = false;
        let showImpressive = false;
        var windowHei = $(window).height();
        $(window).scroll(function() {
            var newsVP = $('#news.viewpoint')[0].getBoundingClientRect().top;
            var digiPostVP = $('.post-office-no.viewpoint')[0].getBoundingClientRect().top;
            var impressVP = $('.impressive-figures.viewpoint')[0].getBoundingClientRect().top;
            let scrollTop = $(this).scrollTop();
            // Post Offical
            if (scrollTop >= 700) {
                if (showPO) {
                    let hidePostOfficeAnime = anime({
                        targets: '.post-office-tracking .item-service li',
                        translateX: 0,
                        delay: anime.stagger(100)
                    });
                    showPO = false
                }
            }
            // Tin tức
            if (newsVP <= windowHei && newsVP >= -windowHei) {
                if (!showNews) {
                    let newsLeftAnime = anime({
                        targets: '.news-left .item',
                        translateX: 0,
                        delay: anime.stagger(100)
                    })
                    let newsRightAnime = anime({
                        targets: '.news-right .item',
                        translateX: 0,
                        delay: anime.stagger(100)
                    })
                    showNews = true
                }
            }
            // Bưu điện số
            if (digiPostVP <= windowHei && digiPostVP >= -windowHei) {
                if (!showDigPost) {
                    let digitalPostAnime_1 = anime({
                        targets: '.digital-post-list .digital-post_1',
                        translateX: 450,
                        delay: anime.stagger(100)
                    });
                    let digitalPostAnime_2 = anime({
                        targets: '.digital-post-list .digital-post_2',
                        translateX: -450,
                        delay: anime.stagger(100)
                    });
                    showDigPost = true
                }
            }
            // Số liệu ấn tượng
            if (impressVP <= 700) {
                if (!showImpressive) {
                    let impressiveDataAnime = anime({
                        targets: '.impressive-data .data',
                        translateY: -180,
                        delay: anime.stagger(100)
                    });
                    showImpressive = true
                }
            }
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const duration = 1000; // 10 giây

            function animateCountUp(els, maxNumber) {
                let startTime = null;

                function updateNumber(currentTime) {
                    if (!startTime) startTime = currentTime;
                    let progress = Math.min((currentTime - startTime) / duration, 1);

                    els.forEach(el => {
                        let end = parseInt(el.getAttribute("data-count").replace(/\./g, ""), 10);
                        let value = Math.floor(progress * end); // Cùng tốc độ để hoàn thành trong 10s
                        el.textContent = value.toLocaleString(); // Định dạng có dấu chấm
                    });

                    if (progress < 1) {
                        requestAnimationFrame(updateNumber);
                    }
                }

                requestAnimationFrame(updateNumber);
            }

            // Lấy danh sách tất cả phần tử cần đếm
            let elements = document.querySelectorAll(".count_data");

            // Tìm số lớn nhất trong tất cả phần tử
            let maxNumber = Math.max(...Array.from(elements).map(el =>
                parseInt(el.getAttribute("data-count").replace(/\./g, ""), 10)
            ));

            // Kiểm tra nếu phần tử hiển thị trên màn hình thì bắt đầu hiệu ứng
            let observer = new IntersectionObserver(
                (entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            animateCountUp(elements, maxNumber);
                            observer.disconnect(); // Chạy một lần rồi dừng
                        }
                    });
                },
                { threshold: 0.5 } // Chạy khi 50% phần tử xuất hiện trong viewport
            );

            elements.forEach(el => observer.observe(el));
        });
        </script>

