# JAYT CORP — CONTINUOUS CLOUD/HOST CRONTAB CONFIGURATION (047)
# Timezone: Asia/Ho_Chi_Minh (UTC+7)
# Principle: Zero-Mutation Boundary (Capture & Report Only, Never Auto-Unlock Production)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=Asia/Ho_Chi_Minh

# 1. DAILY MORNING (08:00 ICT) — Scan Food delivery, Lunch combos & E-com
0 8 * * * cd /var/www/jayt && /usr/bin/node 07_QUALITY_ASSURANCE/scheduler_tasks/cron_cloud_runner.js --cycle=DAILY_MORNING_0800 >> /var/log/jayt/scheduler.log 2>&1

# 2. DAILY EVENING (16:30 ICT) — Scan Evening cinema, Gold hours & Rush vouchers
30 16 * * * cd /var/www/jayt && /usr/bin/node 07_QUALITY_ASSURANCE/scheduler_tasks/cron_cloud_runner.js --cycle=DAILY_EVENING_1630 >> /var/log/jayt/scheduler.log 2>&1

# 3. WEEKLY LOCAL SCHEDULE (Monday 06:00 ICT) — 7-Day Local savings schedule
0 6 * * 1 cd /var/www/jayt && /usr/bin/node 07_QUALITY_ASSURANCE/scheduler_tasks/cron_cloud_runner.js --cycle=WEEKLY_LOCAL_SCHEDULE >> /var/log/jayt/scheduler.log 2>&1

# 4. MONTHLY GOVERNANCE AUDIT (1st of month 00:00 ICT) — Base policies & domain catalog
0 0 1 * * cd /var/www/jayt && /usr/bin/node 07_QUALITY_ASSURANCE/scheduler_tasks/cron_cloud_runner.js --cycle=MONTHLY_GOVERNANCE_AND_BASE_TERMS >> /var/log/jayt/scheduler.log 2>&1
