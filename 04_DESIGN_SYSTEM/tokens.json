{
  "system": "JayT Apex Design System 2026",
  "version": "1.1.0",
  "theme": "Obsidian Pine & Champagne Gold",
  "target_audience": "Người dân Đà Nẵng",
  "tokens": {
    "color": {
      "bg": {
        "primary": "#061a14",
        "surface": "#0d2820",
        "surface_elevated": "#11342a",
        "card": "#0d2a21",
        "overlay": "rgba(4, 16, 12, 0.85)"
      },
      "border": {
        "line": "rgba(212, 175, 55, 0.15)",
        "subtle": "rgba(255, 255, 255, 0.08)",
        "accent": "#d4af37",
        "focus": "#f3e5ab"
      },
      "text": {
        "primary": "#f0eee9",
        "muted": "#8fa298",
        "gold": "#d4af37",
        "gold_light": "#f3e5ab",
        "emerald": "#10b981",
        "danger": "#ef4444"
      },
      "shadow": {
        "pine_tint_subtle": "0 4px 16px rgba(3, 14, 10, 0.35)",
        "pine_tint_card": "0 6px 20px rgba(3, 14, 10, 0.35)",
        "pine_tint_decision": "0 12px 36px rgba(3, 14, 10, 0.45)",
        "pine_tint_modal": "0 24px 60px rgba(2, 10, 7, 0.7)",
        "gold_glow": "rgba(212, 175, 55, 0.25)",
        "emerald_glow": "rgba(16, 185, 129, 0.2)"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "14px",
      "lg": "20px",
      "xl": "32px"
    },
    "radius": {
      "sm": "8px",
      "md": "10px",
      "lg": "14px",
      "xl": "18px",
      "full": "9999px"
    },
    "touch_target": {
      "min_height": "44px",
      "min_width": "44px",
      "mobile_override_strict": true
    },
    "motion": {
      "ease_out_expo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "duration_hover": "220ms",
      "prefers_reduced_motion": "auto !important"
    },
    "typography": {
      "font_family_sans": "Outfit, sans-serif",
      "font_family_mono": "'JetBrains Mono', monospace",
      "font_size": {
        "xs": "10.5px",
        "sm": "12px",
        "md": "13.5px",
        "lg": "15px",
        "xl": "18px",
        "title": "22px"
      }
    },
    "bento": {
      "gap": {
        "sm": "12px",
        "md": "16px",
        "lg": "20px"
      },
      "columns": {
        "mobile": "1",
        "tablet": "2",
        "desktop": "4"
      },
      "spans": {
        "tile_1x1": { "col": 1, "row": 1 },
        "tile_1x2": { "col": 1, "row": 2 },
        "tile_2x1": { "col": 2, "row": 1 },
        "tile_2x2": { "col": 2, "row": 2 }
      }
    },
    "glass": {
      "surface": "rgba(18, 28, 22, 0.75)",
      "surface_elevated": "rgba(24, 38, 30, 0.85)",
      "border": "1px solid rgba(229, 195, 120, 0.22)",
      "border_subtle": "1px solid rgba(255, 255, 255, 0.08)",
      "blur": "16px",
      "blur_sm": "8px",
      "fallback_surface": "#0E1611",
      "fallback_elevated": "#14211A"
    },
    "verdict": {
      "states": {
        "BUY": {
          "label": "NÊN MUA",
          "color": "#10b981",
          "bg": "rgba(16, 185, 129, 0.12)",
          "border": "rgba(16, 185, 129, 0.3)"
        },
        "WAIT": {
          "label": "NÊN CHỜ",
          "color": "#f59e0b",
          "bg": "rgba(245, 158, 11, 0.12)",
          "border": "rgba(245, 158, 11, 0.3)"
        },
        "CHECK_CONDITIONS": {
          "label": "CẦN KIỂM TRA ĐIỀU KIỆN",
          "color": "#3b82f6",
          "bg": "rgba(59, 130, 246, 0.12)",
          "border": "rgba(59, 130, 246, 0.3)"
        },
        "NEUTRAL": {
          "label": "TRUNG TÍNH",
          "color": "#64748b",
          "bg": "rgba(100, 116, 139, 0.12)",
          "border": "rgba(100, 116, 139, 0.3)"
        }
      },
      "layers": ["KẾT LUẬN", "LÝ DO", "BẰNG CHỨNG"]
    },
    "savings_breakdown": {
      "fields": [
        "original_price",
        "current_price",
        "voucher_discount",
        "fee",
        "effective_price",
        "savings_amount"
      ],
      "classifications": ["VERIFIED", "ESTIMATED", "CONDITIONAL"]
    },
    "viewports": {
      "mobile": "390px",
      "tablet": "768px",
      "desktop": "1440px"
    }
  }
}