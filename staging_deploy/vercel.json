{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-JayT-Environment",
          "value": "STAGING_REVIEW"
        },
        {
          "key": "X-JayT-Version",
          "value": "v3.420.0-staging.ak"
        }
      ]
    }
  ]
}