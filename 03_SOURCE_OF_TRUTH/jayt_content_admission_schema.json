{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JayT Content Admission Schema JAYT-223",
  "description": "Strict validation schema for JayT Evidence Bundles and Published Content Manifest",
  "definitions": {
    "evidence_bundle": {
      "type": "object",
      "required": [
        "bundle_id",
        "card_id",
        "content_type",
        "brand_name",
        "source_url",
        "raw_capture_artifact_path",
        "raw_capture_sha256",
        "captured_at",
        "recheck_policy"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^BUNDLE_(DEAL|SOURCE|VENUE)_[A-Z0-9_]+$"
        },
        "card_id": {
          "type": "string",
          "pattern": "^CARD_[A-Z0-9_]+$"
        },
        "content_type": {
          "type": "string",
          "enum": ["OFFICIAL_DEAL", "OFFICIAL_SOURCE", "VERIFIED_VENUE", "COMMUNITY_UTILITY"]
        },
        "brand_name": {
          "type": "string",
          "minLength": 2
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "raw_capture_artifact_path": {
          "type": "string"
        },
        "raw_capture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_quote_exact": {
          "type": "string"
        },
        "terms": {
          "type": "string"
        },
        "validity": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "exact_media_relation": {
          "type": "object",
          "required": ["media_kind", "media_path", "media_sha256", "rights_basis"],
          "properties": {
            "media_kind": {
              "type": "string",
              "enum": ["EXACT_PROMOTION_POSTER", "BRAND_IDENTITY_LOGO", "VENUE_FACILITY_ASSET", "NONE"]
            },
            "media_path": {
              "type": "string"
            },
            "media_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rights_basis": {
              "type": "string"
            }
          }
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "recheck_policy": {
          "type": "object",
          "required": ["ttl_days", "recheck_cadence"],
          "properties": {
            "ttl_days": { "type": "integer", "minimum": 1 },
            "recheck_cadence": { "type": "string" }
          }
        }
      }
    }
  }
}
