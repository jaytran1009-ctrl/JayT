      }
      #lunch-arbitrage-module .app-calc-card {
        background: #FFFDF8 !important;
        border: 1.5px solid rgba(126, 91, 29, 0.2) !important;
        border-radius: 16px !important;
        padding: 14px 16px !important;
        box-shadow: 0 8px 24px rgba(74, 54, 22, 0.05) !important;
