function setVoucherPlatformTab(platId) {
  if (typeof state !== 'undefined') {
    state.activeVoucherPlatform = platId || 'ALL';
  }
  const shelf = document.getElementById('j401-hot-voucher-shelf');
  if (shelf) {
    const temp = document.createElement('div');
    temp.innerHTML = renderDailyHotVoucherBoard();
    shelf.replaceWith(temp.firstElementChild);
  }
}

function copyVoucherCodeToClipboard(code) {
  if (!code) return;
  if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(code).then(() => {
      showJaytToast('✅ Đã sao chép mã voucher [' + code + '] vào bộ nhớ tạm!');
    }).catch(() => {
      copyToClipboardFallback(code).then(() => {
        showJaytToast('✅ Đã sao chép mã voucher [' + code + ']!');
      }).catch(() => {});
    });
  } else {
    copyToClipboardFallback(code).then(() => {
      showJaytToast('✅ Đã sao chép mã voucher [' + code + ']!');
    }).catch(() => {});
  }
}

async function detectClipboardProductLink(triggeredByUser = false) {
  const input = document.getElementById('j401-voucher-input');
  const statusEl = document.getElementById('j401-clipboard-status');
  if (typeof navigator === 'undefined' || !navigator.clipboard || !navigator.clipboard.readText) {
    if (triggeredByUser && statusEl) {
      statusEl.innerHTML = '<span style="color:#F59E0B;">Trình duyệt hạn chế đọc tự động. Vui lòng dán thủ công (Ctrl+V) vào ô link.</span>';
    }
    return;
  }
  try {
    const text = (await navigator.clipboard.readText() || '').trim();
    if (text && (text.includes('shopee.vn') || text.includes('lazada.vn') || text.includes('tiktok.com') || text.includes('accesstrade.vn') || text.startsWith('http'))) {
      if (input) {
        input.value = text;
        if (statusEl) {
          statusEl.innerHTML = '<span style="color:#10B981; font-weight:600;">✨ Đã tự động nhận diện link từ bộ nhớ tạm! Đang quét radar...</span>';
        }
        handleVoucherLookup();
      }
    } else if (triggeredByUser && statusEl) {
      statusEl.innerHTML = '<span style="color:#A3B1A8;">Bộ nhớ tạm hiện không có liên kết Shopee/Lazada/TikTok. Vui lòng copy link sàn rồi thử lại!</span>';
    }
  } catch (err) {
    if (triggeredByUser && statusEl) {
      statusEl.innerHTML = '<span style="color:#F59E0B;">Vui lòng cấp quyền truy cập bộ nhớ tạm hoặc dán thủ công (Ctrl+V).</span>';
    }
  }
}

function setJaytContextChip(chipId) {
  state.activeContextChip = chipId || 'ALL';
  if (chipId === 'DORM') {
    state.selectedDormCategory = 'Gia dụng KTX';
  } else if (chipId === 'TECH') {
    state.selectedDormCategory = 'Học tập & Công nghệ';
  } else {
    state.selectedDormCategory = 'ALL';
  }
  const dormSec = document.getElementById('dorm-shopping-module');
  if (dormSec) {
    const temp = document.createElement('div');
    temp.innerHTML = renderDormShoppingModule();
    dormSec.replaceWith(temp.firstElementChild);
    attachAppEvents();
  }
  if (chipId === 'FNB') {
    const fnb = document.getElementById('fnb-hub-module') || document.getElementById('lunch-arbitrage-module');
    if (fnb) fnb.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}

function renderSmartContextChips() {
  const activeChip = state.activeContextChip || 'ALL';
  return `
    <div class="j401-context-chips-shelf" style="margin-bottom: 16px; padding: 14px 18px; border-radius: 14px; background: rgba(14,22,17,0.8); border: 1.5px solid rgba(229,195,120,0.3); box-shadow: 0 4px 16px rgba(0,0,0,0.18);">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:16px;">🏷️</span>
          <strong style="font-size:13.5px; color:#E5C378; text-transform:uppercase; letter-spacing:0.5px; font-family:'Playfair Display', Georgia, serif;">🏷️ CHỌN NHANH / SMART CONTEXT CHIPS</strong>
        </div>
        <span style="font-size:11px; background:rgba(229,195,120,0.15); color:#E5C378; border:1px solid rgba(229,195,120,0.4); padding:3px 10px; border-radius:999px; font-weight:700;">Phản hồi &le; 1ms · Đồng bộ Voucher &amp; Kệ Deal</span>
      </div>
      <div class="j401-context-chips-bar" role="tablist" style="display:flex; gap:8px; flex-wrap:wrap;">
        ${JAYT_CONTEXT_CHIPS.map(chip => {
          const isAct = activeChip === chip.id;
          return `
            <button
              type="button"
              class="btn-context-chip ${isAct ? 'is-active active' : ''}"
              data-context-chip="${chip.id}"
              onclick="setJaytContextChip('${chip.id}')"
              style="padding: 8px 14px; border-radius: 999px; font-size: 12.5px; font-weight: ${isAct ? '750' : '600'}; cursor: pointer; border: 1.5px solid ${isAct ? '#E5C378' : 'rgba(229,195,120,0.3)'}; background: ${isAct ? '#E5C378' : 'rgba(22,34,27,0.85)'}; color: ${isAct ? '#0A110D' : '#F4EFE6'}; min-height: 38px; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease;"
              title="${escapeHtml(chip.desc)}"
            >
              <span>${chip.label}</span>
            </button>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

