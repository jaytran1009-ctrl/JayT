    }
    body.theme-dark .j438-price {
      color: #E5C378 !important;
    }
    .j438-cond {
      font-weight: 450 !important;
      font-size: 12.5px !important;
      color: #786C5E !important;
      letter-spacing: 0.01em !important;
    }
    body.theme-dark .j438-cond {
      color: #A0988A !important;
    }

    /* 5. Tool Labels & Inputs Ergonomics */
    .input-field-group label,
    .split-input-field label,
    .calc-control-panel label,
    .calc-input-group label,
    .j406-terminal label {
      font-size: 15.5px !important;
      font-weight: 700 !important;
      line-height: 1.4 !important;
      color: #201C16 !important;
    }
    body.theme-dark .input-field-group label,
    body.theme-dark .split-input-field label,
    body.theme-dark .calc-control-panel label,
    body.theme-dark .calc-input-group label,
    body.theme-dark .j406-terminal label {
      color: #F1ECE2 !important;
    }
    input, select, textarea,
    .split-input, #j406-link-input, .calc-input, .calc-slider {
      min-height: 44px !important;
      font-size: 15px !important;
    }
    @media(max-width: 768px){
      .input-field-group label,
      .split-input-field label,
      .calc-control-panel label {
        font-size: 15px !important;
      }
      input, select, textarea,
      .split-input, #j406-link-input, .calc-input {
        min-height: 44px !important;
        font-size: 15px !important;
      }
    }

    /* 6. Continuous Utility Canvas (Lunch + Split Bill Seamless Flow) */
    #main-content > #lunch-arbitrage-module {
      margin-bottom: 0 !important;
      padding-bottom: clamp(24px, 2.8vw, 36px) !important;
      border-bottom: 0 !important;
    }
    body.theme-light #main-content > #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(244, 239, 229, 0.25) 24px, #F4EFE5 88px, #F4EFE5 100%) !important;
    }
    body.theme-dark #main-content > #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(14, 22, 18, 0.25) 24px, #0E1612 88px, #0E1612 100%) !important;
    }

    #main-content > #split-bill-module {
      margin-top: 0 !important;
      padding-top: clamp(28px, 3vw, 40px) !important;
      border-top: 1px dashed rgba(126, 91, 29, 0.2) !important;
      padding-bottom: clamp(56px, 6vw, 84px) !important;
    }
    body.theme-light #main-content > #split-bill-module {
      background: linear-gradient(180deg, #F4EFE5 0%, #F4EFE5 calc(100% - 88px), rgba(244, 239, 229, 0.25) calc(100% - 24px), transparent 100%) !important;
      border-top-color: rgba(126, 91, 29, 0.2) !important;
    }
    body.theme-dark #main-content > #split-bill-module {
      background: linear-gradient(180deg, #0E1612 0%, #0E1612 calc(100% - 88px), rgba(14, 22, 18, 0.25) calc(100% - 24px), transparent 100%) !important;
      border-top-color: rgba(197, 168, 128, 0.18) !important;
    }

    #split-bill-module > .container,
    body.theme-light #split-bill-module > .container,
    body.theme-dark #split-bill-module > .container {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      width: min(calc(100% - (var(--j430-gutter) * 2)), 1240px) !important;
      max-width: 1240px !important;
    }
    #lunch-arbitrage-module > .container,
    body.theme-light #lunch-arbitrage-module > .container,
    body.theme-dark #lunch-arbitrage-module > .container {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      width: min(calc(100% - (var(--j430-gutter) * 2)), 1240px) !important;
      max-width: 1240px !important;
    }
  </style>`;
}

