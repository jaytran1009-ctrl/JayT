    /* 4. Full-Bleed 88px Painterly Gradient Fade */
    body.theme-light #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(244, 239, 229, 0.25) 24px, #F4EFE5 88px, #F4EFE5 calc(100% - 88px), rgba(244, 239, 229, 0.25) calc(100% - 24px), transparent 100%) !important;
    }
    body.theme-dark #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(14, 22, 18, 0.25) 24px, #0E1612 88px, #0E1612 calc(100% - 88px), rgba(14, 22, 18, 0.25) calc(100% - 24px), transparent 100%) !important;
    }

    /* 5. Synchronized Split Bill & Lunch Arbitrage Width (Exact 1240px Container Alignment) */
    #main-content > #lunch-arbitrage-module,
    #main-content > #split-bill-module {
      max-width: 100% !important;
