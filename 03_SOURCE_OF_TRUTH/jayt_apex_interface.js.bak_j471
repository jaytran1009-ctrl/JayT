function getCashierHudBrand(brandId) {
  return J398_CASHIER_HUD.brands.find(function(brand) { return brand.id === brandId; }) || J398_CASHIER_HUD.brands[0];
}

function formatCashierVnd(amount) {
  return Math.max(0, Math.round(Number(amount) || 0)).toLocaleString('vi-VN') + 'đ';
}

function renderCashierHudStyles() {
  return `<style id="j398-cashier-hud-styles">
    .jayt-app-wrapper { padding-bottom: 76px; }
    .cashier-consumer-surface { background: #090D14; color: #F8FAFC; padding: 16px 0 8px; }
    .cashier-consumer-shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .cashier-kicker { margin: 0 0 6px; color: #6EE7B7; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .cashier-heading { margin: 0; color: #FFFFFF; font-size: clamp(26px, 5vw, 42px); line-height: 1.04; letter-spacing: -.05em; }
    .cashier-subhead { margin: 9px 0 16px; color: #94A3B8; font-size: 14px; line-height: 1.45; }
    #brand-instant-search { position: relative; padding: 12px; border: 1px solid rgba(255,255,255,.12); border-radius: 20px; background: rgba(15,23,42,.76); box-shadow: 0 18px 50px rgba(0,0,0,.24); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
    .cashier-search-row { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 14px; border: 1px solid rgba(255,255,255,.14); border-radius: 14px; background: rgba(9,13,20,.88); }
    .cashier-search-row:focus-within { border-color: #E5C378; box-shadow: 0 0 0 3px rgba(229,195,120,.14); }
    .cashier-search-row svg { flex: 0 0 auto; color: #6EE7B7; }
    #brand-instant-input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: #FFFFFF; font: inherit; font-size: 16px; }
    #brand-instant-input::placeholder { color: #94A3B8; }
    .cashier-brand-results { display: grid; grid-template-columns: repeat(auto-fit, minmax(138px, 1fr)); gap: 8px; margin-top: 10px; }
    .cashier-brand-result { display: flex; align-items: center; gap: 9px; min-height: 44px; padding: 6px 8px; text-align: left; color: #E2E8F0; background: rgba(30,41,59,.68); border: 1px solid rgba(255,255,255,.08); border-radius: 11px; cursor: pointer; transition: transform .16s ease, border-color .16s ease, background .16s ease; }
    .cashier-brand-result:hover, .cashier-brand-result:focus-visible { transform: translateY(-1px); border-color: #E5C378; background: rgba(229,195,120,.12); outline: none; }
    .cashier-brand-logo { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 32px; height: 32px; color: #FFFFFF; border-radius: 10px; font-size: 12px; font-weight: 900; letter-spacing: -.04em; }
    .cashier-brand-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 750; }
    .cashier-search-empty { grid-column: 1 / -1; padding: 12px; color: #94A3B8; font-size: 13px; }
    .cashier-pickup-action { width: 100%; min-height: 48px; margin-top: 10px; border: 0; border-radius: 13px; color: #0A110D; background: #E5C378; font: inherit; font-size: 14px; font-weight: 850; cursor: pointer; }
    .cashier-pickup-action:hover, .cashier-pickup-action:focus-visible { background: #6EE7B7; outline: none; }
    .cashier-quick-backdrop { position: fixed; inset: 0; z-index: 9999; overflow: auto; background: rgba(2,6,23,.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
    .cashier-quick-card { box-sizing: border-box; display: flex; flex-direction: column; min-height: 100dvh; width: 100%; padding: max(16px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)); background: radial-gradient(circle at 92% 0%, rgba(229,195,120,.16), transparent 32%), #0A110D; }
    .cashier-quick-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; width: min(620px, 100%); margin: 0 auto 12px; }
    .cashier-quick-close { display: inline-grid; place-items: center; width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.12); border-radius: 14px; color: #F8FAFC; background: rgba(255,255,255,.07); font-size: 22px; cursor: pointer; }
    .cashier-quick-body { display: flex; flex-direction: column; justify-content: flex-start; flex: 1; width: min(620px, 100%); margin: 0 auto; padding-top: 8px; }
    .cashier-quick-brand { display: flex; align-items: center; gap: 12px; color: #CBD5E1; font-size: 15px; font-weight: 800; }
    .cashier-quick-amount-label { margin: 10px 0 4px; color: #94A3B8; font-size: 13px; font-weight: 750; text-transform: uppercase; letter-spacing: .08em; }
    .cashier-quick-amount { color: #E5C378; font-size: clamp(40px, 13vw, 72px); font-weight: 900; letter-spacing: -.075em; line-height: 1.05; }
    .cashier-menu-input { width: 100%; max-width: 320px; margin-top: 14px; padding: 13px 14px; border: 1px solid rgba(229,195,120,.5); border-radius: 14px; color: #F7F0E3; background: rgba(10,17,13,.88); font: inherit; font-size: 18px; font-weight: 800; box-sizing: border-box; }
    .cashier-line { margin-top: 18px; padding: 16px 18px; border: 1px solid rgba(229,195,120,.42); border-radius: 16px; color: #F7F0E3; background: rgba(71,52,25,.42); font-size: 18px; font-weight: 750; line-height: 1.45; }
    .cashier-address { margin: 16px 0 0; color: #E2E8F0; font-size: 13px; line-height: 1.6; padding: 12px 14px; border-radius: 14px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09); display: flex; flex-direction: column; gap: 8px; }
    .cashier-address-text { display: flex; align-items: flex-start; gap: 8px; width: 100%; }
    .cashier-address-text span:last-child { color: #CBD5E1; line-height: 1.5; }
    .cashier-copy-btn { align-self: flex-end; min-width: 44px; min-height: 44px; padding: 0 16px; border: 1px solid rgba(229,195,120,.35); border-radius: 10px; color: #E5C378; background: rgba(229,195,120,.12); font: inherit; font-size: 13px; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: background .16s ease, border-color .16s ease; }
    .cashier-copy-btn:hover, .cashier-copy-btn:focus-visible { background: rgba(229,195,120,.18); border-color: #E5C378; outline: none; }
    .cashier-note { margin: 8px 0 0; color: #94A3B8; font-size: 13px; font-weight: 600; }
    .cashier-quick-bottom-action { margin-top: clamp(20px, 4vh, 36px); width: 100%; }
    .cashier-quick-bottom-close { width: 100%; min-height: 48px; border: 1px solid rgba(255,255,255,.14); border-radius: 14px; color: #FFFFFF; background: rgba(255,255,255,.08); font: inherit; font-size: 16px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .16s ease; }
    .cashier-quick-bottom-close:hover, .cashier-quick-bottom-close:focus-visible { background: rgba(255,255,255,.16); outline: none; }
    @media (max-width: 640px) {
      .cashier-consumer-surface { padding-top: 12px; }
      .cashier-consumer-shell { width: calc(100% - 24px); }
      .cashier-brand-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .counter-quick-dock.cashier-brand-dock { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px; align-items: center; overflow: hidden; padding: 4px 5px env(safe-area-inset-bottom); box-sizing: border-box; transition: transform .22s cubic-bezier(0.16, 1, 0.3, 1), opacity .18s ease; } .counter-quick-dock.dock-stowed { transform: translateY(100%); opacity: 0; pointer-events: none; }
      .cashier-brand-dock .quick-dock-btn { min-width: 0; min-height: 44px; padding: 2px 1px; border: 0; border-radius: 10px; color: #CBD5E1; background: transparent; font-size: 9.5px; font-weight: 750; cursor: pointer; } .cashier-brand-dock .quick-dock-btn span:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; letter-spacing: -.02em; display: block; }
      .cashier-brand-dock .quick-dock-btn:focus-visible { outline: 2px solid #E5C378; outline-offset: -2px; }
      .cashier-brand-dock .dock-icon { display: inline-flex; align-items: center; justify-content: center; width: 23px; height: 23px; margin: 0 auto 2px; border-radius: 8px; color: #FFFFFF; font-size: 9px; font-weight: 900; }
    }
    @media (min-width: 641px) {
      .cashier-quick-card { align-items: center; justify-content: center; min-height: 100dvh; padding: 32px; }
      .cashier-quick-body { flex: none; min-height: 560px; }
    }
  </style>`;
}

function renderCashierBrandButton(brand) {
  return '<button type="button" class="cashier-brand-result" data-cashier-brand-id="' + brand.id + '" aria-label="Mở nhanh ' + escapeHtml(brand.name) + '">' +
    '<span class="cashier-brand-logo" style="background:' + brand.accent + ';">' + brand.logo + '</span>' +
    '<span class="cashier-brand-name">' + escapeHtml(brand.shortName) + '</span>' +
  '</button>';
}

function renderBrandInstantSearch() {
  return [
    '<section class="cashier-consumer-surface" style="padding-top:0;" aria-label="Tìm thương hiệu tại quầy">',
    '  <div class="cashier-consumer-shell" style="width:100%;">',
    '    <div id="brand-instant-search" role="search">',
    '      <div class="cashier-search-row">',
    '        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>',
    '        <input id="brand-instant-input" type="search" autocomplete="off" placeholder="Tìm Metiz, Galaxy, Highlands…" aria-label="Tìm thương hiệu tại quầy">',
    '      </div>',
    '      <button type="button" id="btn-onsite-savings" class="cashier-pickup-action" style="margin:10px 0 12px;" onclick="openOnSiteSavingsHud()">⚡ Tự so sánh giá quầy &amp; Pick-up</button>',
    '      <div id="brand-instant-results" class="cashier-brand-results" aria-live="polite">',
    J398_CASHIER_HUD.brands.map(renderCashierBrandButton).join(''),
    '      </div>',
    '    </div>',
    '  </div>',
    '</section>'
  ].join('\n');
}

function openCashierQuickCard(brandId) {
  const startedAt = (typeof performance !== 'undefined') ? performance.now() : Date.now();
  const brand = getCashierHudBrand(brandId);
  const modal = document.getElementById('cashier-quick-modal');
  if (!modal) return;
  const fixedAmount = Number.isFinite(brand.verifiedAmount) ? brand.verifiedAmount : null;
  const amountText = fixedAmount === null ? 'Nhập giá menu' : formatCashierVnd(fixedAmount);
  const input = fixedAmount === null ? '<input id="cashier-menu-amount" class="cashier-menu-input" inputmode="numeric" type="number" min="0" step="1000" placeholder="Nhập giá trên menu" aria-label="Giá menu bạn đang thấy">' : '';
  let note = 'Nhập giá bạn đang thấy trên menu để tính đúng tại quầy.';
  if (fixedAmount !== null) {
    if (brand.id === 'galaxy_cinema') note = '/ vé 2D — Suất chiếu Thứ Ba hàng tuần';
    else if (brand.id === 'metiz_cinema') note = '/ vé 2D — Thẻ sinh viên & CCCD dưới 22 tuổi';
    else note = '/ suất — Mức giá ưu đãi đã xác thực';
  }
  modal.innerHTML = [
    '<div class="cashier-quick-backdrop" onclick="if(event.target === this) closeCashierQuickCard();">',
    '  <section class="cashier-quick-card" role="dialog" aria-modal="true" aria-labelledby="cashier-quick-title">',
    '    <div class="cashier-quick-top">',
    '      <div class="cashier-quick-brand"><span class="cashier-brand-logo" style="background:' + brand.accent + ';width:38px;height:38px;border-radius:12px;">' + brand.logo + '</span><span id="cashier-quick-title">' + escapeHtml(brand.name) + '</span></div>',
    '      <button type="button" class="cashier-quick-close" onclick="closeCashierQuickCard()" aria-label="Đóng Cashier HUD">×</button>',
    '    </div>',
    '    <div class="cashier-quick-body">',
    '      <div class="cashier-quick-amount-label">' + escapeHtml(brand.amountLabel) + '</div>',
    '      <div id="cashier-quick-amount" class="cashier-quick-amount">' + amountText + '</div>',
    input,
    '      <p class="cashier-note">' + escapeHtml(note) + '</p>',
    '      <div class="cashier-line">“' + escapeHtml(brand.cashierLine) + '”</div>',
    '      <div class="j456-counter-checklist" aria-label="Ba bước tự kiểm tra trước khi thanh toán">',
    '        <strong>Trước khi trả tiền, thử 3 bước này</strong>',
    '        <ol><li>Hỏi nhân viên về ưu đãi thành viên hoặc thẻ sinh viên đang được công bố.</li><li>Mở ứng dụng ví bạn dùng và tự kiểm tra ưu đãi hiện hành.</li><li>Nếu quán có tích điểm, đăng nhập tài khoản của bạn trước khi thanh toán.</li></ol>',
    '        <small>Ưu đãi tùy thời điểm và điều kiện của từng đơn; JayT không tự xác nhận mức giảm.</small>',
    '      </div>',
    '      <div class="cashier-address">',
    '        <div class="cashier-address-text"><span style="flex:0 0 auto;">📍</span><span>' + escapeHtml(brand.address) + '</span></div>',
    '        <button type="button" class="cashier-copy-btn" onclick="if(navigator.clipboard){navigator.clipboard.writeText(\'' + escapeHtml(brand.address).replace(/'/g, "\\'") + '\').then(function(){if(typeof showToast===\'function\')showToast(\'Đã sao chép địa chỉ quán!\');});}" aria-label="Sao chép địa chỉ"><span>📋 Sao chép</span></button>',
    '      </div>',
    '      <div class="cashier-quick-bottom-action">',
    '        <button type="button" class="cashier-quick-bottom-close" onclick="closeCashierQuickCard()" aria-label="Xong"><span>Xong</span></button>',
    '      </div>',
    '    </div>',
    '  </section>',
    '</div>'
  ].join('\n');
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
  const menuAmount = document.getElementById('cashier-menu-amount');
  if (menuAmount) {
    menuAmount.addEventListener('input', function() {
      const target = document.getElementById('cashier-quick-amount');
      if (target) target.textContent = menuAmount.value ? formatCashierVnd(menuAmount.value) : 'Nhập giá menu';
    });
    requestAnimationFrame(function() { menuAmount.focus({ preventScroll: true }); });
  }
  if (typeof window !== 'undefined') window.cashierQuickCardLastOpenMs = ((typeof performance !== 'undefined') ? performance.now() : Date.now()) - startedAt;
}

function closeCashierQuickCard() {
  const modal = document.getElementById('cashier-quick-modal');
  if (modal) {
    modal.style.display = 'none';
    modal.innerHTML = '';
  }
  document.body.style.overflow = '';
}

function attachCashierHudEvents() {
  const input = document.getElementById('brand-instant-input');
  const results = document.getElementById('brand-instant-results');
  if (!input || !results) return;
  const renderMatches = function(query) {
    const normalizedQuery = normalizeAccentInsensitive(query || '');
    const matches = J398_CASHIER_HUD.brands.filter(function(brand) {
      return !normalizedQuery || normalizeAccentInsensitive([brand.name, brand.shortName].concat(brand.searchTerms).join(' ')).includes(normalizedQuery);
    });
    results.innerHTML = matches.length ? matches.map(renderCashierBrandButton).join('') : '<div class="cashier-search-empty">Chưa có thương hiệu này. Hãy hỏi trực tiếp tại quầy trước khi thanh toán.</div>';
    results.querySelectorAll('[data-cashier-brand-id]').forEach(function(button) {
      button.addEventListener('click', function() { openCashierQuickCard(button.dataset.cashierBrandId); });
    });
  };
  input.addEventListener('input', function() { renderMatches(input.value); });
  input.addEventListener('keydown', function(event) {
    if (event.key === 'Enter') {
      const firstResult = results.querySelector('[data-cashier-brand-id]');
      if (firstResult) {
        event.preventDefault();
        openCashierQuickCard(firstResult.dataset.cashierBrandId);
      }
    }
  });
  renderMatches(input.value);
}

