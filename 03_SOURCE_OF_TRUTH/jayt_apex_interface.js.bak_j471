      margin-top: clamp(28px, 3.2vw, 42px) !important;
    }
  </style>`;
}

function renderJ436PinnaclePolishStyles() {
  return `<style id="j436-pinnacle-polish-styles">
    /* ==========================================================================
       JAYT-436: PINNACLE EDITORIAL MASTER POLISH
       ========================================================================== */

    /* 1. Header Inset (~10px each side inside Hero container) */
    .jayt-header {
      position: absolute !important;
      top: 14px !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: min(calc(100% - (var(--j430-gutter) * 2) - 20px), 1280px) !important;
      max-width: 1280px !important;
      border-radius: 18px !important;
      border: 1.5px solid rgba(197, 168, 128, 0.3) !important;
      background: rgba(10, 17, 13, 0.8) !important;
      backdrop-filter: blur(16px) saturate(130%) !important;
      -webkit-backdrop-filter: blur(16px) saturate(130%) !important;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3) !important;
      z-index: 1000 !important;
      padding: 0 22px !important;
      box-sizing: border-box !important;
    }
    body.theme-light .jayt-header {
      background: rgba(20, 30, 24, 0.78) !important;
      border: 1.5px solid rgba(229, 195, 120, 0.35) !important;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28) !important;
    }

    /* 2. Hero CTA Hierarchy: 1 Gold Beacon + 3 Champagne Outlines */
    .j411-quick-grid button:first-child {
      background: linear-gradient(135deg, #E5C378, #B98A36) !important;
      color: #21170A !important;
      border: 0 !important;
      font-weight: 750 !important;
      box-shadow: 0 4px 18px rgba(229,195,120,0.32) !important;
      min-height: 52px !important;
      font-size: 15.5px !important;
    }
    .j411-quick-grid button:not(:first-child) {
      background: rgba(255, 253, 248, 0.08) !important;
      border: 1.5px solid rgba(229, 195, 120, 0.38) !important;
      color: #F1ECE2 !important;
      backdrop-filter: blur(8px) !important;
      -webkit-backdrop-filter: blur(8px) !important;
      box-shadow: none !important;
      font-weight: 600 !important;
      min-height: 48px !important;
      font-size: 14.5px !important;
      padding: 12px 18px !important;
      transition: all .18s ease !important;
    }
    .j411-quick-grid button:not(:first-child):hover {
      background: rgba(229, 195, 120, 0.18) !important;
      border-color: #E5C378 !important;
      color: #FFFFFF !important;
      transform: translateY(-1px) !important;
    }

    /* 3. F&B 4 Wide Cards + 15% Peek of 5th Card */
    @media(min-width: 1024px){
      .j406-horizon {
        display: flex !important;
        gap: 16px !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        padding-bottom: 12px !important;
      }
      .j408-brand-card {
        flex: 0 0 calc((100% - (4 * 16px)) / 4.15) !important;
        min-width: 270px !important;
        max-width: 295px !important;
        scroll-snap-align: start !important;
        min-height: 220px !important;
        padding: 20px 22px !important;
      }
      .j408-brand-place {
        white-space: normal !important;
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        line-height: 1.45 !important;
        min-height: 38px !important;
        font-size: 13.5px !important;
      }
    }

    /* 4. Full-Width Band 56px Gradient Edge Transitions */
    #main-content > #lunch-arbitrage-module {
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      margin-top: 24px !important;
      margin-bottom: 0 !important;
      padding: 38px 0 28px 0 !important;
      box-sizing: border-box !important;
      height: auto !important;
      min-height: 0 !important;
      border-top: none !important;
      border-bottom: none !important;
    }
    body.theme-light #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(244, 239, 229, 0.4) 18px, #F4EFE5 56px, #F4EFE5 calc(100% - 56px), rgba(244, 239, 229, 0.4) calc(100% - 18px), transparent 100%) !important;
    }
    body.theme-dark #lunch-arbitrage-module {
      background: linear-gradient(180deg, transparent 0%, rgba(14, 22, 18, 0.4) 18px, #0E1612 56px, #0E1612 calc(100% - 56px), rgba(14, 22, 18, 0.4) calc(100% - 18px), transparent 100%) !important;
    }

    /* 5. Tightened Control -> App Cards Distance (~12px reduced) */
    #lunch-arbitrage-module .section-header {
      margin-bottom: 8px !important;
    }
    @media(min-width: 900px){
      #lunch-arbitrage-module .arbitrage-grid {
        gap: 10px !important;
      }
      #lunch-arbitrage-module .calc-control-panel {
        padding: 12px 20px !important;
        gap: 18px !important;
      }
    }

    /* 6. Desktop Secondary Typography Scale (+1 to +1.5px) */
    .j434-schedule-badge {
      font-size: 13px !important;
    }
    .j434-schedule-sub {
      font-size: 14px !important;
    }
    .j434-schedule-list li {
      font-size: 14.5px !important;
      line-height: 1.5 !important;
    }
    .j434-schedule-btn {
      font-size: 14px !important;
      padding: 11px 16px !important;
    }
    .input-field-group label,
    .split-input-field label,
    .app-calc-breakdown {
      font-size: 14.5px !important;
    }
    .section-desc, .j406-copy {
      font-size: 15.5px !important;
      line-height: 1.55 !important;
    }
  </style>`;
}

