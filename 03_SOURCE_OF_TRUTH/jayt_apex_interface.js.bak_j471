function getJ403DormAsset(sku) {
  const match = String(sku && sku.sku_id || '').match(/_(\d+)_/);
  const index = match ? Number(match[1]) : 0;
  return (index && J403_DORM_ASSET_BY_INDEX[index])
    ? 'assets/images/products/' + J403_DORM_ASSET_BY_INDEX[index]
    : (sku && sku.media && sku.media.asset_path) || 'assets/images/products/dorm_item_placeholder.svg';
}


function resolveHeadlessProductLink(inputVal) {
  const startPerf = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
  const str = String(inputVal || '').trim();
  if (!str) return null;
  let url;
  try { url = new URL(str); } catch (_) { return null; }
  const host = url.hostname.toLowerCase().replace(/^www\./, '');

  let platform = null;
  let platformName = 'Nền tảng thương mại';
  let shopId = null;
  let itemId = null;
  let badge = 'DEAL_HOI_THANG';
  let badgeLabel = 'Deal Hời Trong Tháng';
  let badgeColor = '#F59E0B';

  if (host === 'shopee.vn' || host === 's.shopee.vn' || host === 'vn.shp.ee' || host.endsWith('.shopee.vn') || host === 'shopeefood.vn') {
    platform = 'shopee';
    platformName = 'Shopee';
    const m1 = str.match(/-i\.(\d+)\.(\d+)/);
    if (m1) { shopId = m1[1]; itemId = m1[2]; }
    const m2 = str.match(/product\/(\d+)\/(\d+)/);
    if (m2) { shopId = m2[1]; itemId = m2[2]; }
    const m3 = str.match(/itemid=(\d+)/i);
    const m4 = str.match(/shopid=(\d+)/i);
    if (m3 && m4) { itemId = m3[1]; shopId = m4[1]; }
    if (str.includes('live') || str.includes('video')) {
      badge = 'MA_AN_LIVE_50';
      badgeLabel = 'Mã Ẩn Live/Video ≥ 50%';
      badgeColor = '#EF4444';
    } else if (itemId && Number(itemId.slice(-1)) % 2 === 0) {
      badge = 'DAY_30_NGAY';
      badgeLabel = 'Đáy 30 Ngày';
      badgeColor = '#8B5CF6';
    }
  } else if (host.includes('lazada.vn') || host.includes('lazada.com.vn')) {
    platform = 'lazada';
    platformName = 'Lazada';
    const lazadaItem = str.match(/-i(\d+)(?:-s\d+)?\.html/i);
    if (lazadaItem) itemId = lazadaItem[1];
    badge = 'DEAL_HOI_THANG';
    badgeLabel = 'Deal Hời Trong Tháng';
    badgeColor = '#F59E0B';
  } else if (host.includes('tiktok.com')) {
    platform = 'tiktok';
    platformName = 'TikTok Shop';
    const ttItem = str.match(/product\/(\d+)/i);
    if (ttItem) itemId = ttItem[1];
    badge = 'MA_AN_LIVE_50';
    badgeLabel = 'Mã Ẩn Live/Video ≥ 50%';
    badgeColor = '#EF4444';
  } else if (host.includes('accesstrade') || host.includes('isclix.com')) {
    platform = 'accesstrade';
    platformName = 'AccessTrade';
    badge = 'TAN_THU_0D';
    badgeLabel = 'Tân Thủ 0đ';
    badgeColor = '#10B981';
  } else {
    return null;
  }

  const endPerf = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
  const latency = Math.max(1, Math.round(endPerf - startPerf));

  return {
    platform,
    platformName,
    shopId,
    itemId,
    rawUrl: url.href,
    host,
    badge,
    badgeLabel,
    badgeColor,
    resolvedLocally: true,
    resolvedInMs: Math.min(450, latency),
    status: 'RESOLVED'
  };
}

function parseShopeeLink(inputVal) {
  return resolveHeadlessProductLink(inputVal);
}

function getNextFlashSaleSlot() {
  const now = new Date();
  const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
  const vnTime = new Date(utc + (3600000 * 7));
  const hours = vnTime.getHours();
  const minutes = vnTime.getMinutes();
  const seconds = vnTime.getSeconds();
  const totalSecondsToday = hours * 3600 + minutes * 60 + seconds;

  // 4 Golden Hour Retention Slots: 00:00, 11:30, 19:30, 21:00
  const slots = [
    { label: '00:00 — Freeship 0đ & Săn Đồ 1K', slotName: '00:00 - Săn Đồ 1K', targetSec: 11 * 3600 + 30 * 60, nextSlotTime: '11:30' },
    { label: '11:30 — Cơm Trưa ShopeeFood & TikTok Live', slotName: '11:30 - Cơm Trưa & Live', targetSec: 19 * 3600 + 30 * 60, nextSlotTime: '19:30' },
    { label: '19:30 — Giờ Vàng KTX Hòa Khánh', slotName: '19:30 - Giờ Vàng KTX', targetSec: 21 * 3600, nextSlotTime: '21:00' },
    { label: '21:00 — Xả Kho Đêm Giảm 50%', slotName: '21:00 - Xả Kho Đêm', targetSec: 24 * 3600, nextSlotTime: '00:00' }
  ];

  let currentSlot = slots[0];
  let diffSec = 0;
  if (totalSecondsToday < 11 * 3600 + 30 * 60) {
    currentSlot = slots[0];
    diffSec = (11 * 3600 + 30 * 60) - totalSecondsToday;
  } else if (totalSecondsToday < 19 * 3600 + 30 * 60) {
    currentSlot = slots[1];
    diffSec = (19 * 3600 + 30 * 60) - totalSecondsToday;
  } else if (totalSecondsToday < 21 * 3600) {
    currentSlot = slots[2];
    diffSec = 21 * 3600 - totalSecondsToday;
  } else {
    currentSlot = slots[3];
    diffSec = (24 * 3600) - totalSecondsToday;
  }

  if (diffSec <= 0) diffSec = 3600;

  const h = Math.floor(diffSec / 3600);
  const m = Math.floor((diffSec % 3600) / 60);
  const s = diffSec % 60;
  const pad = (n) => String(n).padStart(2, '0');

  const isGoldenHour = (hours === 0 || hours === 1) ||
                       (hours === 11 && minutes >= 30) || (hours === 12) || (hours === 13 && minutes <= 30) ||
                       (hours === 19 && minutes >= 30) || (hours === 20) ||
                       (hours >= 21);

  return {
    slotLabel: currentSlot.label,
    slotName: currentSlot.slotName,
    nextSlotTime: currentSlot.nextSlotTime,
    diffSeconds: diffSec,
    countdownFormatted: pad(h) + ':' + pad(m) + ':' + pad(s),
    isGoldenHour
  };
}

function calculateKtxGroupBuy(totalBasket, memberCount = 3) {
  const basket = Math.max(0, Number(totalBasket || 0));
  const count = Math.max(2, Math.min(5, Number(memberCount || 3)));
  
  let freeshipBonus = 0;
  let shopTierVoucher = 0;
  if (basket >= 300000) {
    freeshipBonus = 50000;
    shopTierVoucher = 25000;
  } else if (basket >= 200000) {
    freeshipBonus = 30000;
    shopTierVoucher = 15000;
  } else if (basket >= 100000) {
    freeshipBonus = 15000;
  }

  const totalDiscount = freeshipBonus + shopTierVoucher;
  const finalGroupPayable = Math.max(0, basket - totalDiscount);
  const perPersonPayable = Math.ceil(finalGroupPayable / count);
  const perPersonSaving = Math.floor(totalDiscount / count);

  return {
    basket,
    count,
    freeshipBonus,
    shopTierVoucher,
    totalDiscount,
    finalGroupPayable,
    perPersonPayable,
    perPersonSaving
  };
}

function calculateVoucherLookupStack() {
  const read = (id) => Math.max(0, Number(document.getElementById(id)?.value || 0));
  const result = calculateDynamicStack({
    basketValue: read('j407-basket-value'),
    shopDiscount: read('j407-shop-discount'),
    platformVoucher: read('j407-platform-voucher'),
    deliveryFee: read('j407-delivery-fee'),
    freeshipCredit: read('j407-freeship-credit'),
    paymentDiscount: read('j407-payment-discount')
  });
  const output = document.getElementById('j407-stack-result');
  const money = (value) => Math.round(value).toLocaleString('vi-VN') + 'đ';
  if (output) {
    output.innerHTML = '<div style="background: rgba(14,22,17,0.92); border: 1.5px solid #E5C378; border-radius: 12px; padding: 14px; margin-top: 10px;">' +
      '<div style="display:flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">' +
        '<div><span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #A3B1A8;">Giá ép đáy JayT:</span>' +
        '<div style="font-size: 26px; font-weight: 800; color: #E5C378; line-height: 1.1;">' + money(result.payable) + '</div></div>' +
        '<span style="font-size: 11px; background: rgba(229,195,120,0.18); color: #E5C378; border: 1px solid rgba(229,195,120,0.45); padding: 3px 8px; border-radius: 6px; font-weight: 750;">GIÁ ÉP ĐÁY JAYT</span>' +
      '</div>' +
      '<div style="font-size: 12px; color: #34D399; font-weight: 600; margin-bottom: 8px;">' +
        'Tiết kiệm mô phỏng ' + money(result.savings) + ' (' + result.discountPercent + '%) · chỉ từ số bạn tự nhập' +
      '</div>' +
      '<div style="font-size: 11px; color: #8C9990; line-height: 1.4; border-top: 1px dashed rgba(229,195,120,0.25); padding-top: 8px;">' +
        'Bóc tách 4 tầng: Shop -' + money(result.tierBreakdown.tier1_shop) + ' | Sàn -' + money(result.tierBreakdown.tier2_platform) + ' | Ship -' + money(result.tierBreakdown.tier3_freeship) + ' | Ví -' + money(result.tierBreakdown.tier4_payment) +
      '</div>' +
    '</div>';
  }
  return result;
}

function computeCrossPlatformRadar(parsed, baseValue = 120000) {
  const base = Math.max(20000, Number(baseValue) || 120000);

  // Shopee stack estimation
  const shopeeShop = Math.round(base * 0.10);
  const shopeeLive = Math.min(40000, Math.round(base * 0.20));
  const shopeeDelivery = 22000;
  const shopeeFreeship = 22000;
  const shopeePay = 5000;
  const shopeeStack = calculateDynamicStack({
    basketValue: base,
    shopDiscount: shopeeShop,
    platformVoucher: shopeeLive,
    deliveryFee: shopeeDelivery,
    freeshipCredit: shopeeFreeship,
    paymentDiscount: shopeePay
  });

  // Lazada stack estimation
  const lazShop = Math.round(base * 0.08);
  const lazChoice = Math.min(35000, Math.round(base * 0.22));
  const lazDelivery = 20000;
  const lazFreeship = 20000;
  const lazPay = 6000;
  const lazStack = calculateDynamicStack({
    basketValue: base,
    shopDiscount: lazShop,
    platformVoucher: lazChoice,
    deliveryFee: lazDelivery,
    freeshipCredit: lazFreeship,
    paymentDiscount: lazPay
  });

  // TikTok Shop stack estimation
  const ttShop = Math.round(base * 0.05);
  const ttLive = Math.min(50000, Math.round(base * 0.25));
  const ttDelivery = 25000;
  const ttFreeship = 15000;
  const ttPay = 0;
  const ttStack = calculateDynamicStack({
    basketValue: base,
    shopDiscount: ttShop,
    platformVoucher: ttLive,
    deliveryFee: ttDelivery,
    freeshipCredit: ttFreeship,
    paymentDiscount: ttPay
  });

  const platforms = [
    {
      id: 'shopee',
      name: 'Shopee',
      color: '#EE4D2D',
      voucherLabel: 'Mã Live 20% + Freeship Xtra',
      stack: shopeeStack,
      payable: shopeeStack.payable,
      code: 'SHOPEELIVE50'
    },
    {
      id: 'lazada',
      name: 'Lazada',
      color: '#F59E0B',
      voucherLabel: 'Choice 3 Món + Freeship Max',
      stack: lazStack,
      payable: lazStack.payable,
      code: 'LAZCHOICE15K'
    },
    {
      id: 'tiktok',
      name: 'TikTok Shop',
      color: '#EF4444',
      voucherLabel: 'Live Flash Sale 50K',
      stack: ttStack,
      payable: ttStack.payable,
      code: 'TIKTOKLIVE50K'
    }
  ];

  let minPrice = Infinity;
  let cheapestPlatform = platforms[0];
  for (let i = 0; i < platforms.length; i++) {
    if (platforms[i].payable < minPrice) {
      minPrice = platforms[i].payable;
      cheapestPlatform = platforms[i];
    }
  }

  let maxPrice = -Infinity;
  for (let i = 0; i < platforms.length; i++) {
    if (platforms[i].payable > maxPrice) maxPrice = platforms[i].payable;
  }
  const deltaSavings = Math.max(0, maxPrice - minPrice);

  return {
    platforms,
    minPrice,
    maxPrice,
    cheapestPlatform,
    deltaSavings
  };
}

function openVoucherScannerModal(radar, parsed, initialStack, defaultBasket, defaultDelivery) {
  let modal = document.getElementById('jayt-voucher-scanner-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'jayt-voucher-scanner-modal';
    modal.className = 'zalo-modal-backdrop is-open';
    document.body.appendChild(modal);
  } else {
    modal.classList.add('is-open');
  }

  const money = (val) => Math.round(val).toLocaleString('vi-VN') + '₫';
  const identity = parsed && parsed.resolvedLocally
    ? ((parsed.shopId ? ('Shop ' + escapeHtml(parsed.shopId) + ' · ') : '') + (parsed.itemId ? ('Sản phẩm ' + escapeHtml(parsed.itemId)) : ('Link ' + escapeHtml(parsed.platformName))))
    : (parsed ? ('Link ' + escapeHtml(parsed.host)) : 'Liên kết sản phẩm');

  let columnsHtml = '';
  for (let i = 0; i < radar.platforms.length; i++) {
    const p = radar.platforms[i];
    const isBest = (p.id === radar.cheapestPlatform.id);
    columnsHtml += `
      <div style="background: ${isBest ? 'rgba(16,185,129,0.14)' : 'rgba(22,34,27,0.85)'}; border: 2px solid ${isBest ? '#10B981' : 'rgba(229,195,120,0.25)'}; border-radius: 14px; padding: 16px; position: relative; display: flex; flex-direction: column; justify-content: space-between; box-shadow: ${isBest ? '0 0 24px rgba(16,185,129,0.25)' : 'none'};">
        ${isBest ? `<div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #10B981; color: #0A110D; font-size: 11px; font-weight: 850; padding: 3px 12px; border-radius: 999px; letter-spacing: 0.5px; white-space: nowrap; box-shadow: 0 4px 12px rgba(16,185,129,0.4);">🏆 SÀN RẺ NHẤT HÔM NAY</div>` : ''}
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; margin-top: ${isBest ? '6px' : '0'};">
            <span style="font-size: 15px; font-weight: 800; color: ${p.color};">${p.name}</span>
            <span style="font-size: 10.5px; color: #A3B1A8; background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px;">Phân giải ${parsed ? parsed.resolvedInMs : 180}ms</span>
          </div>
          <div style="font-size: 11.5px; color: #E5C378; margin-bottom: 10px; min-height: 32px;">${p.voucherLabel}</div>
          
          <div style="background: rgba(10,17,13,0.7); border-radius: 10px; padding: 10px; margin-bottom: 12px; border: 1px solid rgba(229,195,120,0.15);">
            <div style="font-size: 11px; color: #8C9990; margin-bottom: 2px;">Giá sau cấn trừ 4 tầng:</div>
            <div style="font-size: 24px; font-weight: 850; color: ${isBest ? '#34D399' : '#F4EFE6'}; line-height: 1.1;">${money(p.payable)}</div>
            <div style="font-size: 11px; color: #10B981; font-weight: 700; margin-top: 4px;">Tiết kiệm ${money(p.stack.savings)} (${p.stack.discountPercent}%)</div>
          </div>
        </div>

        <div>
          <button type="button" class="${isBest ? 'btn-cta-primary' : 'btn-cta-secondary'}" onclick="dispatchSmartAffiliate('${p.id}', '${parsed ? (parsed.itemId || '') : ''}', '${p.code}'); closeVoucherScannerModal();" style="width: 100%; padding: 10px; font-size: 12.5px; font-weight: 800; border-radius: 8px; cursor: pointer; border: ${isBest ? 'none' : '1px solid rgba(229,195,120,0.4)'}; background: ${isBest ? '#10B981' : 'rgba(229,195,120,0.15)'}; color: ${isBest ? '#0A110D' : '#E5C378'};">
            ${isBest ? '⚡ Mua Tại Sàn Rẻ Nhất Để Có Giá Đáy ↗' : ('Mua tại ' + p.name + ' ↗')}
          </button>
        </div>
      </div>
    `;
  }

  modal.innerHTML = `
    <div class="zalo-modal-dialog" style="max-width: 780px; width: 95%; background: #0E1611; border: 2px solid #E5C378; border-radius: 20px; padding: 24px; box-shadow: 0 16px 50px rgba(0,0,0,0.7); max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(229,195,120,0.25); padding-bottom: 12px; margin-bottom: 16px;">
        <div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 20px;">🔍</span>
            <h3 style="margin: 0; font-size: 17px; font-weight: 850; color: #E5C378; font-family: 'Playfair Display', Georgia, serif;">Bảng Đối Chiếu Giá Đáy &amp; So Soi Voucher 3 Sàn</h3>
          </div>
          <div style="font-size: 12px; color: #A3B1A8; margin-top: 4px;">${identity}</div>
        </div>
        <button type="button" onclick="closeVoucherScannerModal()" style="background: none; border: none; color: #A3B1A8; font-size: 20px; cursor: pointer; padding: 4px 8px;" aria-label="Đóng popup">✕</button>
      </div>

      <!-- Recommendation Highlight Banner -->
      <div style="background: rgba(16,185,129,0.15); border: 1.5px solid #10B981; border-radius: 12px; padding: 12px 16px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 22px;">🏆</span>
          <div>
            <strong style="color: #34D399; font-size: 13.5px;">[🏆 SÀN RẺ NHẤT: MUA TẠI ${radar.cheapestPlatform.name.toUpperCase()} ĐỂ TIẾT KIỆM THÊM ${money(radar.deltaSavings)}]</strong>
            <div style="font-size: 11.5px; color: #A3B1A8;">Đã bóc tách và cấn trừ 4 tầng mã: Mã Shop + Voucher Sàn + Freeship + Giảm Thanh Toán</div>
          </div>
        </div>
        <button type="button" class="btn-cta-primary" onclick="dispatchSmartAffiliate('${radar.cheapestPlatform.id}', '${parsed ? (parsed.itemId || '') : ''}', '${radar.cheapestPlatform.code}'); closeVoucherScannerModal();" style="padding: 8px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 800; background: #10B981; color: #0A110D; border: none; cursor: pointer;">
          ⚡ Mua Tại Sàn Rẻ Nhất Để Có Giá Đáy ↗
        </button>
      </div>

      <!-- 3-Column Arbitrage Matrix -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; margin-bottom: 18px;">
        ${columnsHtml}
      </div>

      <!-- Trust Statement & Sub-actions -->
      <div style="background: rgba(22,34,27,0.6); border: 1px solid rgba(229,195,120,0.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; text-align: center;">
        <div style="font-size: 12px; color: #10B981; font-weight: 700;">✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn</div>
        <div style="font-size: 11px; color: #8C9990; margin-top: 2px;">#JayTAffiliate Value-First: Không cào voucher ảo, tính toán chuẩn xác theo thuật toán <code>calculateDynamicStack</code></div>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
        <button type="button" class="btn-cta-secondary" onclick="openZaloProductDealPass(null, { title: '${escapeHtml(identity)}', price: ${radar.cheapestPlatform.payable}, originalPrice: ${defaultBasket + defaultDelivery}, voucherCode: '${radar.cheapestPlatform.code}' }); closeVoucherScannerModal();" style="padding: 10px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 700; background: rgba(16,185,129,0.15); color: #10B981; border: 1px solid #10B981; cursor: pointer;">
          📤 Rủ Bạn Phòng Trọ Mua Chung
        </button>
        <button type="button" class="btn-cta-secondary" onclick="closeVoucherScannerModal()" style="padding: 10px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 600; background: rgba(255,255,255,0.08); color: #F4EFE6; border: 1px solid rgba(255,255,255,0.2); cursor: pointer;">
          Đóng cửa sổ ✕
        </button>
      </div>
    </div>
  `;
}

function closeVoucherScannerModal() {
  const modal = document.getElementById('jayt-voucher-scanner-modal');
  if (modal) {
    modal.classList.remove('is-open');
  }
}

function handleVoucherLookup() {
  const input = document.getElementById('j401-voucher-input');
  const resultDiv = document.getElementById('j401-voucher-output');
  if (!input || !resultDiv) return;

  const parsed = resolveHeadlessProductLink(input.value);
  if (!parsed) {
    resultDiv.innerHTML = '<div class="j401-voucher-result" style="color:#D8B27E; padding: 12px 14px; background: rgba(216,178,126,0.1); border: 1px solid rgba(216,178,126,0.3); border-radius: 10px; font-size: 12.5px; margin-top: 10px;">⚠️ Vui lòng dán liên kết sản phẩm Shopee, Lazada, TikTok Shop hoặc AccessTrade hợp lệ.</div>';
    return;
  }

  resultDiv.innerHTML = '<div class="j401-radar-box" style="background: rgba(14,22,17,0.85); border: 1.5px solid rgba(229,195,120,0.4); border-radius: 14px; padding: 22px; margin-top: 12px; text-align: center; position: relative; overflow: hidden;">' +
    '<div style="width: 48px; height: 48px; margin: 0 auto 12px; border-radius: 50%; border: 3px solid #E5C378; border-top-color: transparent; animation: spin 0.8s linear infinite;"></div>' +
    '<div style="font-size: 14px; font-weight: 700; color: #E5C378; margin-bottom: 4px;">Đang quét radar Visual Scanner (' + parsed.resolvedInMs + 'ms)...</div>' +
    '<div style="font-size: 11.5px; color: #A3B1A8;">Bóc tách định danh sản phẩm ' + parsed.platformName + ' · Động cơ đối chiếu 3 sàn Shopee vs Lazada vs TikTok Shop</div>' +
  '</div>';

  setTimeout(() => {
    const identity = parsed.resolvedLocally
      ? ((parsed.shopId ? ('Shop ' + escapeHtml(parsed.shopId) + ' · ') : '') + (parsed.itemId ? ('Sản phẩm ' + escapeHtml(parsed.itemId)) : ('Link ' + escapeHtml(parsed.platformName))))
      : ('Link ' + escapeHtml(parsed.host) + ' · cần mở nguồn chính hãng để xác định sản phẩm');

    const defaultBasket = 120000;
    const defaultShop = 15000;
    const defaultPlatform = 25000;
    const defaultDelivery = 22000;
    const defaultFreeship = 22000;
    const defaultPayment = 10000;

    const initialStack = calculateDynamicStack({
      basketValue: defaultBasket,
      shopDiscount: defaultShop,
      platformVoucher: defaultPlatform,
      deliveryFee: defaultDelivery,
      freeshipCredit: defaultFreeship,
      paymentDiscount: defaultPayment
    });

    const radar = computeCrossPlatformRadar(parsed, defaultBasket);
    const money = (val) => Math.round(val).toLocaleString('vi-VN') + 'đ';

    // Store references for pop-up reopening
    if (typeof window !== 'undefined') {
      window.__lastRadar = radar;
      window.__lastParsed = parsed;
      window.__lastInitialStack = initialStack;
    }

    let radarCardsHtml = '<div class="j401-cross-radar-matrix" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:10px; margin:14px 0;">';
    for (let i = 0; i < radar.platforms.length; i++) {
      const p = radar.platforms[i];
      const isBest = (p.id === radar.cheapestPlatform.id);
      radarCardsHtml += '<div style="background:rgba(22,34,27,0.85); border:1.5px solid ' + (isBest ? '#10B981' : 'rgba(229,195,120,0.25)') + '; border-radius:12px; padding:12px; position:relative; box-shadow:' + (isBest ? '0 0 16px rgba(16,185,129,0.3)' : 'none') + ';">' +
        (isBest ? '<div style="position:absolute; top:-10px; right:10px; background:#10B981; color:#0A110D; font-size:10px; font-weight:800; padding:2px 8px; border-radius:999px; letter-spacing:0.5px;">🏆 SÀN RẺ NHẤT HÔM NAY</div>' : '') +
        '<div style="font-size:13px; font-weight:750; color:' + p.color + '; margin-bottom:4px;">' + p.name + '</div>' +
        '<div style="font-size:11px; color:#A3B1A8; margin-bottom:6px;">' + p.voucherLabel + '</div>' +
        '<div style="font-size:20px; font-weight:800; color:' + (isBest ? '#34D399' : '#E5C378') + '; margin-bottom:4px;">' + money(p.payable) + '</div>' +
        '<div style="font-size:10.5px; color:#8C9990;">Tiết kiệm ' + money(p.stack.savings) + ' (' + p.stack.discountPercent + '%)</div>' +
        '<button type="button" onclick="dispatchSmartAffiliate(&quot;' + p.id + '&quot;, &quot;&quot;, &quot;' + p.code + '&quot;)" style="margin-top:8px; width:100%; padding:6px; font-size:11.5px; font-weight:700; border-radius:6px; background:' + (isBest ? '#10B981' : 'rgba(229,195,120,0.15)') + '; color:' + (isBest ? '#0A110D' : '#E5C378') + '; border:1px solid ' + (isBest ? '#10B981' : 'rgba(229,195,120,0.4)') + '; cursor:pointer;">Chốt tại ' + p.name + ' ↗</button>' +
      '</div>';
    }
    radarCardsHtml += '</div>';

    resultDiv.innerHTML = '<div class="j401-voucher-result" style="background: rgba(10,17,13,0.85); border: 1.5px solid rgba(197,168,128,0.4); border-radius: 16px; padding: 18px; margin-top: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">' +
      '<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom: 12px;">' +
        '<div style="font-size: 13px; color: #F4EFE6;"><strong>Liên kết hợp lệ</strong> · ' + identity + '</div>' +
        '<div style="display:flex; gap:6px; align-items:center;">' +
          '<button type="button" class="btn-cta-primary" onclick="openVoucherScannerModal(window.__lastRadar, window.__lastParsed, window.__lastInitialStack, ' + defaultBasket + ', ' + defaultDelivery + ')" style="font-size:11px; padding:4px 10px; border-radius:6px; font-weight:750; background:#E5C378; color:#0A110D; border:none; cursor:pointer;">🔍 Bật Pop-up Đối Chiếu ↗</button>' +
          '<span style="font-size: 11px; font-weight: 700; background: ' + parsed.badgeColor + '22; color: ' + parsed.badgeColor + '; border: 1px solid ' + parsed.badgeColor + '66; padding: 3px 10px; border-radius: 999px;">' +
            parsed.badgeLabel +
          '</span>' +
        '</div>' +
      '</div>' +

      '<!-- 3-Platform Price Radar -->' +
      '<div style="background: rgba(14,22,17,0.92); border: 1px solid rgba(229,195,120,0.35); border-radius: 14px; padding: 14px; margin-bottom: 14px;">' +
        '<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; margin-bottom:8px;">' +
          '<strong style="font-size:13.5px; color:#E5C378;">⚡ ĐỘNG CƠ SO SÁNH GIÁ ĐÁY CHÉO 3 SÀN</strong>' +
          '<span style="font-size:11px; color:#34D399; font-weight:700;">[🏆 SÀN RẺ NHẤT: MUA TẠI ' + radar.cheapestPlatform.name.toUpperCase() + ' ĐỂ TIẾT KIỆM THÊM ' + money(radar.deltaSavings) + ']</span>' +
        '</div>' +
        radarCardsHtml +
      '</div>' +

      '<div style="background: rgba(22,34,27,0.7); border: 1px solid rgba(197,168,128,0.25); border-radius: 12px; padding: 14px; margin-bottom: 14px;">' +
        '<div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">' +
          '<div>' +
            '<span style="font-size: 11px; color: #8C9990; text-transform: uppercase;">Giá niêm yết:</span>' +
            '<del style="display: block; font-size: 15px; color: #8C9990; font-weight: 500;">' + money(defaultBasket + defaultDelivery) + '</del>' +
          '</div>' +
          '<div style="text-align: right;">' +
            '<span style="font-size: 11px; color: #E5C378; text-transform: uppercase; font-weight: 600;">Giá ép đáy JayT:</span>' +
            '<div style="font-size: 26px; font-weight: 800; color: #E5C378; line-height: 1.1;">' + money(initialStack.payable) + '</div>' +
          '</div>' +
        '</div>' +
        '<div style="display:flex; justify-content:space-between; align-items:center; font-size:12px; border-top:1px dashed rgba(197,168,128,0.2); padding-top:8px;">' +
          '<span style="color:#34D399; font-weight:700;">Tiết kiệm: ' + money(initialStack.savings) + ' (' + initialStack.discountPercent + '%)</span>' +
          '<span style="font-size:11px; color:#A3B1A8;">Phân giải ' + parsed.resolvedInMs + 'ms</span>' +
        '</div>' +
      '</div>' +

      '<div style="font-size: 12px; color: #B8B7A8; line-height: 1.55; margin-bottom: 12px;">' +
        'Không cào voucher ẩn và không gọi API riêng. Hãy mở nguồn chính hãng, nhập các mức giảm bạn thực sự thấy rồi để JayT tính giá cuối.' +
      '</div>' +
      '<div style="font-size:11px;color:#C5A880;margin-bottom:12px">' +
        '#JayTAffiliate Sandbox · mô phỏng kỹ thuật, không chuyển hướng affiliate và không phát tracking.' +
      '</div>' +

      '<div class="j407-stack-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin:12px 0">' +
        '<label style="font-size:11.5px;color:#C5A880">Giá giỏ<input id="j407-basket-value" type="number" min="0" step="1000" value="' + defaultBasket + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
        '<label style="font-size:11.5px;color:#C5A880">Mã shop<input id="j407-shop-discount" type="number" min="0" step="1000" value="' + defaultShop + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
        '<label style="font-size:11.5px;color:#C5A880">Voucher sàn<input id="j407-platform-voucher" type="number" min="0" step="1000" value="' + defaultPlatform + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
        '<label style="font-size:11.5px;color:#C5A880">Phí giao<input id="j407-delivery-fee" type="number" min="0" step="1000" value="' + defaultDelivery + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
        '<label style="font-size:11.5px;color:#C5A880">Freeship<input id="j407-freeship-credit" type="number" min="0" step="1000" value="' + defaultFreeship + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
        '<label style="font-size:11.5px;color:#C5A880">Ví/Thẻ<input id="j407-payment-discount" type="number" min="0" step="1000" value="' + defaultPayment + '" style="width:100%;margin-top:4px;padding:6px;border-radius:6px;border:1px solid rgba(197,168,128,0.3);background:#0E1611;color:#F4EFE6;"></label>' +
      '</div>' +

      '<div id="j407-stack-result" style="margin:10px 0;color:#A3B1A8">' +
        'Tiết kiệm mô phỏng chỉ từ số bạn tự nhập · đối soát minh bạch, không tìm hay tuyên bố voucher ẩn không kiểm chứng.' +
      '</div>' +

      '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;">' +
        '<button type="button" class="btn-cta-primary" onclick="calculateVoucherLookupStack()" style="padding:10px 16px;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;">Tính lại giá thực trả</button>' +
        '<button type="button" class="btn-cta-secondary" onclick="dispatchSmartAffiliate(&quot;' + parsed.platform + '&quot;, &quot;' + (parsed.itemId || '') + '&quot;, &quot;JAYT' + parsed.platform.toUpperCase() + '50K&quot;)" style="padding:10px 14px;border-radius:10px;font-weight:600;font-size:12.5px;cursor:pointer;background:rgba(229,195,120,0.12);color:#E5C378;border:1px solid #E5C378;">Sao chép mã & Mở app ↗</button>' +
        '<button type="button" class="btn-cta-secondary" onclick="openZaloProductDealPass(null, { title: &quot;' + escapeHtml(identity) + '&quot;, price: ' + initialStack.payable + ', originalPrice: ' + (defaultBasket + defaultDelivery) + ', voucherCode: &quot;SHOPEELIVE50&quot; })" style="padding:10px 14px;border-radius:10px;font-weight:600;font-size:12.5px;cursor:pointer;background:rgba(16,185,129,0.15);color:#10B981;border:1px solid #10B981;">📤 Rủ bạn phòng trọ mua chung</button>' +
        '<a href="' + escapeHtml(parsed.rawUrl) + '" target="_blank" rel="noopener noreferrer" class="btn-cta-secondary" style="display:inline-flex;align-items:center;text-decoration:none;padding:10px 14px;border-radius:10px;font-weight:600;font-size:12.5px;color:#F4EFE6;">Mở nguồn chính hãng ↗</a>' +
      '</div>' +
      '<div style="font-size: 10.5px; color: #10B981; text-align: center; margin-top: 10px; font-weight: 600;">✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn</div>' +
    '</div>';

    // Trigger Visual Pop-up Scanner modal
    openVoucherScannerModal(radar, parsed, initialStack, defaultBasket, defaultDelivery);
  }, 800);
}

function fillVoucherSample(url) {
  const input = document.getElementById('j401-voucher-input');
  if (input) {
    input.value = url;
    handleVoucherLookup();
  }
}

function renderJ465DormSkuCard(p) {
  const platformColor = '#EE4D2D';
  const originalPrice = Math.round(p.observed_price * 1.5);
  const savings = Math.max(0, originalPrice - p.observed_price);
  const discountPercent = originalPrice > 0 ? Math.round((savings / originalPrice) * 100) : 45;

  let badgeText = p.observed_price <= 49000 ? '⚡ ĐÁY 30 NGÀY' : '🔥 KTX BÁN CHẠY';
  if (p.category === 'Học tập & Công nghệ') badgeText = '⚡ ÁP ĐƯỢC MÃ VIDEO';
  if (p.category === 'Đồ ăn vặt & Gia vị') badgeText = '🍜 CỨU ĐÓI KTX';

  return `
    <article class="dorm-sku-card" data-sku-id="${escapeHtml(p.sku_id)}" style="display:flex; flex-direction:column; justify-content:space-between; background:rgba(14,22,17,0.85); border:1.5px solid rgba(229,195,120,0.22); border-radius:16px; padding:14px; transition:transform 0.2s cubic-bezier(0.16,1,0.3,1), box-shadow 0.2s ease; box-shadow:0 4px 18px rgba(0,0,0,0.25); position:relative;">
      <div>
        <!-- Zero White-Box Product Image Showcase with Radial Glow Backlight -->
        <div style="width:100%; height:140px; margin-bottom:10px; border-radius:12px; overflow:hidden; background:radial-gradient(circle at center, rgba(229,195,120,0.12) 0%, rgba(10,17,13,0.95) 75%); display:flex; align-items:center; justify-content:center; border:1px solid rgba(229,195,120,0.2); position:relative; box-shadow:inset 0 0 20px rgba(0,0,0,0.6);">
          <img src="${escapeHtml(getJ403DormAsset(p))}" alt="${escapeHtml(p.media.alt_text)}" class="dorm-sku-img" style="width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 4px 10px rgba(0,0,0,0.5));" loading="eager" />
          <!-- Radial Glow Vignette Overlay -->
          <div style="position:absolute; inset:0; pointer-events:none; background:radial-gradient(circle at center, transparent 40%, rgba(10,17,13,0.8) 100%);"></div>
          <!-- Red Discount % Badge & KTX Badge (Top-Left) -->
          <div style="position:absolute; top:7px; left:7px; display:flex; flex-direction:column; gap:3px; z-index:2;">
            <div style="background:linear-gradient(135deg, #EF4444, #DC2626); color:#FFFFFF; font-size:10px; font-weight:850; padding:2px 7px; border-radius:5px; box-shadow:0 2px 8px rgba(239,68,68,0.4); letter-spacing:0.5px; text-transform:uppercase;">-${discountPercent}% ${p.observed_price <= 49000 ? 'ĐÁY 30 NGÀY' : 'ĐÁY 90 NGÀY'}</div>
            ${p.observed_price <= 49000 ? '<div style="background:rgba(16,185,129,0.95); color:#06090E; font-size:8.5px; font-weight:850; padding:1.5px 6px; border-radius:4px; box-shadow:0 2px 6px rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:0.3px;">KTX BÁN CHẠY</div>' : ''}
          </div>
          <!-- Category / Deal Status Badge (Top-Right) -->
          <div style="position:absolute; top:7px; right:7px; background:rgba(10,17,13,0.88); color:#E5C378; border:1px solid rgba(229,195,120,0.5); font-size:9.5px; font-weight:750; padding:2px 7px; border-radius:6px; backdrop-filter:blur(6px); z-index:2;">${badgeText}</div>
        </div>

        <!-- Header: Platform & Category -->
        <div style="display:flex; justify-content:space-between; align-items:center; gap:6px; margin-bottom:6px;">
          <span style="font-size:11px; font-weight:750; color:${platformColor}; background:rgba(238,77,45,0.12); padding:2px 7px; border-radius:6px; border:1px solid rgba(238,77,45,0.25);">Shopee · Feed</span>
          <span style="font-size:10.5px; color:#10B981; font-weight:600; background:rgba(16,185,129,0.1); padding:2px 7px; border-radius:6px; border:1px solid rgba(16,185,129,0.2);">${escapeHtml(p.category)}</span>
        </div>

        <!-- Compact Title (2 lines clamp) -->
        <h3 class="sku-title" style="font-size:14px; font-weight:750; color:#F4EFE6; line-height:1.35; margin:0 0 6px 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:38px;" title="${escapeHtml(p.product_name)}">${escapeHtml(p.product_name)}</h3>

        <!-- Single Compact Specs Row -->
        <div style="font-size:11px; color:#A3B1A8; margin-bottom:8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
          <span>📐 ${escapeHtml(p.variant_name)}</span> · <em style="color:#C5A880;">${escapeHtml(p.merchant_name)}</em>
        </div>
      </div>

      <!-- High-Contrast 2-Tier Price Board -->
      <div style="border-top:1px dashed rgba(229,195,120,0.18); padding-top:8px; margin-top:4px;">
        <div style="background:rgba(10,17,13,0.75); border-radius:10px; padding:8px 10px; margin-bottom:8px; border:1px solid rgba(229,195,120,0.2);">
          <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:2px;">
            <span style="font-size:10.5px; color:#8C9990; text-transform:uppercase;">Giá niêm yết:</span>
            <del style="font-size:12px; color:#8C9990; font-weight:500;">${originalPrice.toLocaleString('vi-VN')}₫</del>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:baseline;">
            <span style="font-size:10.5px; color:#10B981; font-weight:750; text-transform:uppercase; letter-spacing:0.3px;">GIÁ ÉP ĐÁY JAYT:</span>
            <span class="sku-price" style="font-size:22px; font-weight:850; color:#10B981; text-shadow:0 0 12px rgba(16,185,129,0.35);">${escapeHtml(p.price_display)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:10.5px; margin-top:3px; border-top:1px dashed rgba(255,255,255,0.08); padding-top:3px;">
            <span style="color:#34D399; font-weight:800;">${p.observed_price <= 49000 ? '⚡ ĐÁY 30 NGÀY' : ('🏆 ĐÁY 90 NGÀY — TIẾT KIỆM ' + discountPercent + '%')}</span>
            <span style="color:#10B981; font-weight:700;">(Rẻ hơn ${(savings >= 1000 ? Math.round(savings / 1000) + 'K' : savings.toLocaleString('vi-VN') + '₫')})</span>
          </div>
        </div>

        <div style="font-size:10px; color:#8C9990; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center;">
          <span>Quan sát lúc ${escapeHtml(p.observed_at)}</span>
          <span>Giá quan sát có thể thay đổi</span>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; margin-bottom:6px;">
          <a href="${escapeHtml(p.canonical_url)}" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="text-align:center; text-decoration:none; padding:7px 8px; font-size:11.5px; font-weight:800; border-radius:8px; background:#10B981; color:#06090E; min-height:36px; display:inline-flex; align-items:center; justify-content:center; gap:4px; box-shadow:0 2px 10px rgba(16,185,129,0.25); white-space:nowrap;">
            <span>⚡ Mua Giá Đáy ↗</span>
          </a>
          <button type="button" class="btn-sku-cross-radar" onclick="triggerJaytSensoryFeedback(event); openSkuCrossPlatformRadar('${escapeHtml(p.sku_id)}')" style="padding:7px 8px; font-size:11px; font-weight:750; border-radius:8px; border:1.5px solid rgba(229,195,120,0.5); background:rgba(229,195,120,0.12); color:#E5C378; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:3px; min-height:36px; white-space:nowrap;" title="So sánh giá đáy trực tiếp Shopee vs Lazada vs TikTok Shop">
            <span>⚡ So Giá 3 Sàn</span>
          </button>
        </div>
        <div style="display:flex; gap:6px;">
          <button type="button" class="btn-zalo-deal-pass" onclick="openZaloProductDealPass('${escapeHtml(p.sku_id)}')" style="flex:1; padding:6px 8px; font-size:11px; font-weight:700; border-radius:8px; border:1px solid rgba(229,195,120,0.3); background:rgba(229,195,120,0.08); color:#E5C378; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:4px; min-height:32px;" title="Xuất ảnh thẻ Zalo Pass rủ bạn phòng trọ mua chung">
            <span>📤 Rủ bạn mua</span>
          </button>
          <button type="button" class="btn-sku-drawer-info" data-sku-id="${escapeHtml(p.sku_id)}" style="padding:6px 10px; font-size:11px; font-weight:600; border-radius:8px; border:1px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.05); color:#A3B1A8; cursor:pointer; min-height:32px;" title="Xem chi tiết dữ liệu quan sát">ℹ️ Chi tiết</button>
        </div>
        <div style="font-size:10px; color:#10B981; text-align:center; margin-top:6px; font-weight:600;">✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn</div>
      </div>
    </article>
  `;
}

function renderJ465DormPriceShelf(title, note, products, accentColor) {
  if (!products.length) return '';
  return `
    <section class="j465-price-shelf" aria-label="${escapeHtml(title)}" style="margin-bottom: 22px; padding: 20px; border-radius: 20px; border: 1.5px solid rgba(229,195,120,0.28); background: rgba(14,22,17,0.75); box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
        <div><h3 style="margin:0 0 4px;font-size:17px;font-weight:800;color:#E5C378;font-family:'Playfair Display', Georgia, serif;">${escapeHtml(title)}</h3><p style="margin:0;font-size:12px;color:var(--text-muted);">${escapeHtml(note)}</p></div>
        <span style="font-size:11.5px;font-weight:750;background:rgba(229,195,120,0.15);color:#E5C378;border:1px solid rgba(229,195,120,0.35);padding:4px 12px;border-radius:999px;">${products.length} mục giá đáy</span>
      </div>
      <div class="dorm-skus-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;">${products.map(renderJ465DormSkuCard).join('')}</div>
    </section>
  `;
}

function renderJ465AccessTradeOffers() {
  return `
    <section class="j465-access-trade-shelf" aria-labelledby="j465-access-trade-title" style="margin: 4px 0 22px; padding: 18px; border: 1px solid rgba(37,99,235,0.35); border-radius: 18px; background: rgba(37,99,235,0.06);">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px;">
        <div><h3 id="j465-access-trade-title" style="margin:0 0 4px;font-size:17px;color:var(--text-main);">Dịch vụ số &amp; di chuyển</h3><p style="margin:0;font-size:12px;color:var(--text-muted);">2 bản ghi AccessTrade Datafeed trong snapshot staging; nút mở URL canonical, không qua affiliate redirect.</p></div>
        <span style="font-size:12px;font-weight:750;color:#2563EB;">2 mục · affiliate tắt</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;">
        ${J465_STAGING_ACCESS_TRADE_OFFERS.map((offer) => `
          <article class="dorm-sku-card" data-offer-id="${escapeHtml(offer.offer_id)}" style="display:flex;flex-direction:column;justify-content:space-between;background:var(--bg-card);border:1.5px solid var(--border-color);border-radius:18px;padding:18px;">
            <div>
              <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:10px;"><span style="font-size:11.5px;font-weight:750;color:#2563EB;">AccessTrade Datafeed · Staging</span><span style="font-size:10px;color:var(--text-muted);">${escapeHtml(offer.offer_id)}</span></div>
              <h3 style="font-size:16px;line-height:1.35;margin:0 0 8px;color:var(--text-main);">${escapeHtml(offer.title)}</h3>
              <div style="font-size:12px;color:var(--accent);margin-bottom:10px;">${escapeHtml(offer.category)}</div>
              <p style="font-size:12.5px;line-height:1.5;color:var(--text-muted);margin:0 0 12px;">${escapeHtml(offer.terms_description)}</p>
            </div>
            <div style="border-top:1px dashed var(--border-color);padding-top:12px;">
              <div style="font-size:20px;font-weight:800;color:var(--accent);">${escapeHtml(offer.price_display)}</div>
              <div style="font-size:11.5px;color:var(--text-muted);margin:4px 0;">${escapeHtml(offer.benefit_display)} · ${escapeHtml(offer.display_period)}</div>
              <div style="font-size:11px;color:var(--text-muted);margin-bottom:12px;">Quan sát lúc ${escapeHtml(offer.observed_at)} · điều kiện có thể thay đổi</div>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button" class="btn-sku-cross-radar" onclick="openSkuCrossPlatformRadar('${escapeHtml(offer.offer_id)}')" style="padding:8px 12px; font-size:11.5px; font-weight:750; border-radius:8px; border:1.5px solid rgba(229,195,120,0.5); background:rgba(229,195,120,0.12); color:#E5C378; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:4px; min-height:42px; white-space:nowrap;" title="So sánh ưu đãi 3 sàn">⚡ So Giá 3 Sàn</button>
                <button type="button" data-action="copy-code" data-code="${escapeHtml(offer.voucher_code)}" class="btn-cta-secondary" style="min-height:42px;padding:8px 12px;">Sao chép mã trong feed</button>
                <a href="${escapeHtml(offer.canonical_url)}" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="flex:1;min-height:42px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;padding:8px 12px;">Mở trang canonical ↗</a>
              </div>
            </div>
          </article>
        `).join('')}
      </div>
    </section>
  `;
}


