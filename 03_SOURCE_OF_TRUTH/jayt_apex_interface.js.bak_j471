window._selectedFnbCluster = 'hoa_khanh';
window._quickSplitBill = 120000;
window._quickSplitCount = 3;

function openCounterQuickSheet(brandId) {
  const brand = J397_FNB_DIRECTORY.chains.find(function(b) { return b.id === brandId; }) || J397_FNB_DIRECTORY.chains[0];
  const modal = document.getElementById('counter-3sec-modal');
  if (!modal || !brand) return;

  const clusterKeys = Object.keys(brand.clusters);
  let branchesHtml = '';
  clusterKeys.forEach(function(cKey) {
    const clusterName = cKey === 'hoa_khanh' ? 'Hòa Khánh' : (cKey === 'ngu_hanh_son' ? 'Ngũ Hành Sơn' : 'Hải Châu / Thanh Khê');
    branchesHtml += '<div style="margin-bottom: 8px;"><strong style="color: var(--accent); font-size: 13px;">' + clusterName + ':</strong><ul style="margin: 4px 0 0 16px; padding: 0; font-size: 12px; color: #94A3B8;">';
    brand.clusters[cKey].forEach(function(addr) {
      branchesHtml += '<li>' + addr + '</li>';
    });
    branchesHtml += '</ul></div>';
  });

  modal.innerHTML = [
    '<div class="counter-sheet-backdrop" onclick="if(event.target === this) closeCounterQuickSheet();">',
    '  <div class="counter-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="c3s-title">',
    '    <div class="counter-sheet-handle"></div>',
    '    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">',
    '      <div style="display: flex; align-items: center; gap: 10px;">',
    '        <span style="font-size: 28px;">' + brand.icon_symbol + '</span>',
    '        <div>',
    '          <h3 id="c3s-title" style="font-size: 18px; font-weight: 800; color: #FFFFFF; margin: 0;">' + brand.name + '</h3>',
    '          <span style="font-size: 12px; color: var(--accent); font-weight: 600;">' + brand.category + '</span>',
    '        </div>',
    '      </div>',
    '      <button type="button" onclick="closeCounterQuickSheet()" style="background: rgba(255,255,255,0.08); border: none; border-radius: 50%; width: 36px; height: 36px; color: #FFF; font-size: 18px; cursor: pointer;">&times;</button>',
    '    </div>',
    '    <div class="counter-script-callout">',
    '      <div class="counter-script-tag">⚡ CÂU ĐỌC MẪU CHO THU NGÂN (3 GIÂY)</div>',
    '      <div class="counter-script-text">"' + brand.quick_cashier_script + '"</div>',
    '      <button type="button" onclick="navigator.clipboard.writeText(\'' + brand.quick_cashier_script.replace(/'/g, "\\'") + '\').then(function() { showToast(\'Đã sao chép câu đọc cho thu ngân!\'); })" ',
    '              style="margin-top: 10px; padding: 8px 16px; background: var(--accent); color: #022C22; font-weight: 800; border: none; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 13px;">',
    '        📋 Sao chép câu đọc',
    '      </button>',
    '    </div>',
    '    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px;">',
    '      <div style="background: rgba(15,23,42,0.6); padding: 10px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">',
    '        <div style="font-size: 11px; color: #64748B; text-transform: uppercase;">Giá niêm yết</div>',
    '        <div style="font-size: 18px; font-weight: 900; color: #E5C378; margin-top: 4px;">' + brand.price_note + '</div>',
    '      </div>',
    '      <div style="background: rgba(15,23,42,0.6); padding: 10px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">',
    '        <div style="font-size: 11px; color: #64748B; text-transform: uppercase;">Thông tin cần kiểm tra</div>',
    '        <div style="font-size: 12px; font-weight: 700; color: #F1F5F9; margin-top: 4px;">' + brand.operating_hours + '</div>',
    '      </div>',
    '    </div>',
    '    <div style="background: rgba(15,23,42,0.5); padding: 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); margin-bottom: 14px;">',
    '      <div style="font-size: 12px; font-weight: 700; color: #94A3B8; margin-bottom: 8px;">📍 ĐỊA CHỈ CHI NHÁNH TẠI ĐÀ NẴNG</div>',
    branchesHtml,
    '    </div>',
    '    <button type="button" onclick="closeCounterQuickSheet()" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.08); color: #FFF; font-weight: 700; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; cursor: pointer;">',
    '      Đóng lại',
    '    </button>',
    '  </div>',
    '</div>'
  ].join('\n');

  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
}

function closeCounterQuickSheet() {
  const modal = document.getElementById('counter-3sec-modal');
  if (modal) {
    modal.style.display = 'none';
    modal.innerHTML = '';
  }
  document.body.style.overflow = '';
}

function openOnSiteSavingsHud() {
  const startedAt = (typeof performance !== 'undefined') ? performance.now() : Date.now();
  const modal = document.getElementById('counter-3sec-modal');
  if (!modal) return;
  modal.innerHTML = '<div class="counter-sheet-backdrop" onclick="if(event.target===this) closeCounterQuickSheet()"><div class="counter-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="onsite-savings-title" style="max-width:430px;"><div class="counter-sheet-handle"></div><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;"><div><div class="counter-script-tag">⚡ CỨU VÍ TẠI QUẦY</div><h2 id="onsite-savings-title" style="font-size:20px;margin:6px 0 0;color:#FFFFFF;">Đang ở quán?</h2></div><button type="button" onclick="closeCounterQuickSheet()" aria-label="Đóng" style="min-width:44px;min-height:44px;border:0;border-radius:12px;background:#1E293B;color:#fff;font-size:18px;cursor:pointer;">×</button></div><label style="display:block;font-size:12px;color:#CBD5E1;margin-bottom:10px;">Thương hiệu<select id="onsite-brand-choice" style="display:block;width:100%;min-height:44px;margin-top:4px;padding:8px;border-radius:10px;background:#0F172A;color:#FFFFFF;border:1px solid #334155;"><option>Phúc Long</option><option>Highlands Coffee</option><option>Phê La</option><option>Cơm gà</option><option>Trà sữa</option></select></label><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;"><label style="font-size:12px;color:#CBD5E1;">Giá tại quầy<input id="onsite-counter-price" type="number" min="0" step="1000" value="50000" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;padding:8px;border-radius:10px;background:#0F172A;color:#FFFFFF;border:1px solid #334155;"></label><label style="font-size:12px;color:#CBD5E1;">Giá trên app<input id="onsite-pickup-price" type="number" min="0" step="1000" value="50000" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;padding:8px;border-radius:10px;background:#0F172A;color:#FFFFFF;border:1px solid #334155;"></label><label style="font-size:12px;color:#CBD5E1;">Phí lấy hàng<input id="onsite-pickup-fee" type="number" min="0" step="1000" value="0" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;padding:8px;border-radius:10px;background:#0F172A;color:#FFFFFF;border:1px solid #334155;"></label><label style="font-size:12px;color:#CBD5E1;">Voucher app<input id="onsite-pickup-voucher" type="number" min="0" step="1000" value="0" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;padding:8px;border-radius:10px;background:#0F172A;color:#FFFFFF;border:1px solid #334155;"></label></div><div id="onsite-savings-result" class="counter-script-callout" style="margin-top:12px;"></div><div style="font-size:11px;color:#94A3B8;margin-top:10px;">Chỉ tính từ số liệu bạn đang thấy; JayT không tự xác nhận voucher hay phí của quán/app.</div></div></div>';
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
  const format = (value) => Math.max(0, Math.round(value)).toLocaleString('vi-VN') + 'đ';
  const refresh = () => {
    const counter = Math.max(0, parseInt(document.getElementById('onsite-counter-price')?.value, 10) || 0);
    const pickup = Math.max(0, parseInt(document.getElementById('onsite-pickup-price')?.value, 10) || 0);
    const fee = Math.max(0, parseInt(document.getElementById('onsite-pickup-fee')?.value, 10) || 0);
    const voucher = Math.min(pickup + fee, Math.max(0, parseInt(document.getElementById('onsite-pickup-voucher')?.value, 10) || 0));
    const pickupTotal = pickup + fee - voucher;
    const saving = Math.abs(counter - pickupTotal);
    const winner = counter <= pickupTotal ? 'Tại quầy' : 'Pick-up trên app';
    const result = document.getElementById('onsite-savings-result');
    if (result) result.innerHTML = '<div style="font-size:12px;color:#CBD5E1;">Kết quả cho <strong>' + (document.getElementById('onsite-brand-choice')?.value || 'quán đang chọn') + '</strong></div><div style="font-size:28px;font-weight:900;color:#E5C378;margin:8px 0;">' + format(Math.min(counter, pickupTotal)) + '</div><div style="font-size:13px;color:#E2E8F0;">Tiết kiệm ' + format(saving) + ' · Chọn: <strong>' + winner + '</strong></div>';
  };
  ['onsite-brand-choice', 'onsite-counter-price', 'onsite-pickup-price', 'onsite-pickup-fee', 'onsite-pickup-voucher'].forEach((id) => document.getElementById(id)?.addEventListener('input', refresh));
  document.getElementById('onsite-brand-choice')?.addEventListener('change', refresh);
  refresh();
  if (typeof window !== 'undefined') window.counterOnSiteHudLastOpenMs = ((typeof performance !== 'undefined') ? performance.now() : Date.now()) - startedAt;
}

function openCounterQuickHud(mode) {
  const startedAt = (typeof performance !== 'undefined') ? performance.now() : Date.now();
  // J465 keeps the HUD host in the functional render contract.  Recover it if
  // another interaction has replaced a legacy modal subtree before this click.
  let modal = document.getElementById('counter-3sec-modal');
  if (!modal) {
    const shell = document.querySelector('.jayt-app-shell') || document.getElementById('jayt-app-root');
    if (shell) {
      modal = document.createElement('div');
      modal.id = 'counter-3sec-modal';
      modal.style.display = 'none';
      shell.appendChild(modal);
    }
  }
  if (!modal) return;
  const quick = {
    metiz: { title: 'Metiz Cinema Helio', price: '55.000đ', condition: 'Thẻ thành viên + CCCD, từ 22 tuổi trở xuống.' },
    galaxy: { title: 'Galaxy Cinema Đà Nẵng', price: '45.000đ', condition: 'Happy Day — Thứ Ba hàng tuần.' },
    lunch: { title: 'Bữa trưa tự nhập', price: 'Tự nhập', condition: 'Nhập giá món, phí giao và voucher bạn đang thấy.' }
  };
  const close = 'closeCounterQuickSheet()';
  let body = '';
  if (mode === 'split') {
    const split = calculateIntegerSplit(100000, 2);
    body = '<div class="counter-script-callout"><div class="counter-script-tag">CHIA BILL NHANH</div><div id="counter-quick-split-result" style="font-size:28px;font-weight:900;color:#E5C378;margin:8px 0;">' + split.higherShare.toLocaleString('vi-VN') + 'đ / người</div><div id="counter-quick-split-note" style="font-size:12px;color:#CBD5E1;">Chia đều, không lệch tiền lẻ.</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;"><label style="font-size:12px;color:#CBD5E1;">Tổng bill<input id="counter-quick-split-total" type="number" min="0" step="1000" value="100000" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;"></label><label style="font-size:12px;color:#CBD5E1;">Số người<input id="counter-quick-split-count" type="number" min="1" max="50" value="2" style="width:100%;min-height:44px;box-sizing:border-box;margin-top:4px;"></label></div></div>';
  } else {
    const item = quick[mode];
    body = '<div class="counter-script-callout"><div class="counter-script-tag">THÔNG TIN TẠI QUẦY</div><div style="font-size:28px;font-weight:900;color:#E5C378;margin:8px 0;">' + item.price + '</div><div style="font-size:12px;color:#CBD5E1;line-height:1.4;">' + item.condition + '</div>' + (mode === 'lunch' ? '<button type="button" onclick="closeCounterQuickSheet();document.getElementById(\'lunch-arbitrage-module\').scrollIntoView({behavior:\'smooth\',block:\'start\'});" style="min-height:44px;width:100%;margin-top:12px;border:0;border-radius:10px;background:#E5C378;color:#0A110D;font-weight:800;cursor:pointer;">Mở bàn tính thực trả</button>' : '') + '</div>';
  }
  modal.innerHTML = '<div class="counter-sheet-backdrop" onclick="if(event.target===this)' + close + '"><div class="counter-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="counter-hud-title" style="max-width:430px;"><div class="counter-sheet-handle"></div><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;"><h2 id="counter-hud-title" style="font-size:17px;margin:0;color:#FFFFFF;">' + (mode === 'split' ? 'Chia bill nhanh' : quick[mode].title) + '</h2><button type="button" onclick="' + close + '" aria-label="Đóng" style="min-width:44px;min-height:44px;border:0;border-radius:12px;background:#1E293B;color:#fff;font-size:18px;cursor:pointer;">×</button></div>' + body + '</div></div>';
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
  const refresh = () => {
    const total = Math.max(0, parseInt(document.getElementById('counter-quick-split-total')?.value, 10) || 0);
    const people = Math.max(1, Math.min(50, parseInt(document.getElementById('counter-quick-split-count')?.value, 10) || 1));
    const split = calculateIntegerSplit(total, people);
    const result = document.getElementById('counter-quick-split-result');
    const note = document.getElementById('counter-quick-split-note');
    if (result) result.textContent = split.higherShare.toLocaleString('vi-VN') + 'đ / người';
    if (note) note.textContent = split.remainder ? split.higherCount + ' bạn thêm 1đ để đủ tổng.' : 'Chia đều, không lệch tiền lẻ.';
  };
  document.getElementById('counter-quick-split-total')?.addEventListener('input', refresh);
  document.getElementById('counter-quick-split-count')?.addEventListener('input', refresh);
  if (typeof window !== 'undefined') window.counterQuickHudLastOpenMs = ((typeof performance !== 'undefined') ? performance.now() : Date.now()) - startedAt;
}

function selectFnbCluster(clusterId) {
  window._selectedFnbCluster = clusterId;
  const hub = document.getElementById('danang-fnb-hub-container');
  if (hub) {
    hub.outerHTML = renderDaNangFnbHub();
  }
}


function renderCinemaPowerSection() {
  return [
    '<section class="cinema-power-section bento-section" id="cinema-power-hub" style="margin: 24px 0;">',
    '  <div class="container">',
    '    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">',
    '      <div>',
    '        <div style="display: flex; align-items: center; gap: 8px;">',
    '          <span style="font-size: 20px;">🎬</span>',
    '          <h2 class="section-title" style="font-size: 18px; font-weight: 800; color: #F4EFE6; margin: 0; font-family: \'Playfair Display\', Georgia, serif;">THẺ QUYỀN LỰC VÉ RẠP ĐÀ NẴNG</h2>',
    '        </div>',
    '        <p style="font-size: 12px; color: #A3B1A8; margin: 4px 0 0 0;">Đồng giá sinh viên trực tiếp tại quầy — Đọc câu mẫu nhận ngay vé</p>',
    '      </div>',
    '      <span style="background: rgba(197,168,128,0.12); color: #D8B27E; border: 1px solid rgba(197,168,128,0.25); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 8px;">BẢO CHỨNG QUẦY</span>',
    '    </div>',
    '    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">',
    '      <!-- Metiz Helio Power Card -->',
    '      <div class="cinema-power-card" style="background: #1E2B24; border: 1px solid rgba(197,168,128,0.22); border-radius: 14px; padding: 18px;">',
    '        <div style="display: flex; justify-content: space-between; align-items: flex-start;">',
    '          <div>',
    '            <span class="cinema-badge-verified" style="font-size: 10.5px; font-weight: 700; color: #C5A880; letter-spacing: 0.05em;">HELIOCENTER ĐÀ NẴNG</span>',
    '            <h3 style="font-size: 17px; font-weight: 700; color: #F4EFE6; margin: 6px 0 2px 0; font-family: \'Playfair Display\', Georgia, serif;">Metiz Cinema Đà Nẵng</h3>',
    '            <div style="font-size: 11.5px; color: #A3B1A8;">Tầng 1 Helio Center, Đ. 2 Tháng 9, Hải Châu</div>',
    '          </div>',
    '          <div class="cinema-price-display" style="text-align: right;">',
    '            <div class="cinema-price-val" style="font-size: 22px; font-weight: 800; color: #D8B27E;">55.000đ</div>',
    '            <div class="cinema-price-label" style="font-size: 11px; color: #A3B1A8;">Đồng giá U22</div>',
    '          </div>',
    '        </div>',
    '        <div class="cinema-rule-box" style="margin: 12px 0; padding: 10px; background: rgba(0,0,0,0.2); border-radius: 8px; font-size: 12px; color: #CBD5E1; line-height: 1.45;">',
    '          <strong style="color: #D8B27E;">⚡ Điều kiện tại quầy:</strong> Áp dụng Thứ Ba Đến Thứ Năm cho người dưới 22 tuổi hoặc mang Thẻ Học Sinh / Sinh Viên.',
    '        </div>',
    '        <button type="button" class="btn-cta-primary" style="width: 100%; min-height: 42px; border-radius: 8px; cursor: pointer;" onclick="openCashierQuickCard(\'metiz_cinema\')">',
    '          ⚡ Mở câu đọc cho thu ngân (3s)',
    '        </button>',
    '      </div>',
    '      <!-- Galaxy Danang Power Card -->',
    '      <div class="cinema-power-card" style="background: #1E2B24; border: 1px solid rgba(197,168,128,0.22); border-radius: 14px; padding: 18px;">',
    '        <div style="display: flex; justify-content: space-between; align-items: flex-start;">',
    '          <div>',
    '            <span class="cinema-badge-verified" style="font-size: 10.5px; font-weight: 700; color: #C5A880; letter-spacing: 0.05em;">CO.OPMART ĐÀ NẴNG</span>',
    '            <h3 style="font-size: 17px; font-weight: 700; color: #F4EFE6; margin: 6px 0 2px 0; font-family: \'Playfair Display\', Georgia, serif;">Galaxy Cinema Đà Nẵng</h3>',
    '            <div style="font-size: 11.5px; color: #A3B1A8;">Galaxy Cinema Đà Nẵng — kiểm tra cơ sở và suất chiếu trên trang chính hãng</div>',
    '          </div>',
    '          <div class="cinema-price-display" style="text-align: right;">',
    '            <div class="cinema-price-val" style="font-size: 22px; font-weight: 800; color: #D8B27E;">45.000đ</div>',
    '            <div class="cinema-price-label" style="font-size: 11px; color: #A3B1A8;">Happy Day Thứ 3</div>',
    '          </div>',
    '        </div>',
    '        <div class="cinema-rule-box" style="margin: 12px 0; padding: 10px; background: rgba(0,0,0,0.2); border-radius: 8px; font-size: 12px; color: #CBD5E1; line-height: 1.45;">',
    '          <strong style="color: #D8B27E;">⚡ Điều kiện tại quầy:</strong> Áp dụng trọn ngày Thứ Ba hàng tuần (Ngày Tri Ân Thành Viên Galaxy Đà Nẵng).',
    '        </div>',
    '        <button type="button" class="btn-cta-primary" style="width: 100%; min-height: 42px; border-radius: 8px; cursor: pointer;" onclick="openCashierQuickCard(\'galaxy_cinema\')">',
    '          ⚡ Xem quy tắc quầy Galaxy (3s)',
    '        </button>',
    '      </div>',
    '    </div>',
    '  </div>',
    '</section>'
  ].join('\n');
}

function renderDaNangFnbHub() {
  const currentCluster = window._selectedFnbCluster || 'hoa_khanh';
  let cardsHtml = '';

  J397_FNB_DIRECTORY.chains.forEach(function(brand) {
    const addresses = brand.clusters[currentCluster] || brand.clusters.hoa_khanh || [];
    const firstAddr = addresses[0] || 'Khu vực Đà Nẵng';

    cardsHtml += [
      '<div class="fnb-brand-card" style="background: #1E2B24; border: 1px solid rgba(197,168,128,0.22); border-radius: 14px; padding: 16px;">',
      '  <div style="display: flex; justify-content: space-between; align-items: flex-start;">',
      '    <div style="display: flex; align-items: center; gap: 8px;">',
      '      <span style="font-size: 24px;">' + brand.icon_symbol + '</span>',
      '      <div>',
      '        <h4 style="font-size: 15px; font-weight: 700; color: #F4EFE6; margin: 0; font-family: \'Playfair Display\', Georgia, serif;">' + brand.name + '</h4>',
      '        <div style="font-size: 11px; color: #C5A880;">' + brand.category + '</div>',
      '      </div>',
      '    </div>',
      '    <div style="text-align: right;">',
      '      <div style="font-size: 13px; font-weight: 750; color: #D8B27E;">' + brand.price_note + '</div>',
      '      <div style="font-size: 10px; color: #A3B1A8;">Giá tham khảo</div>',
      '    </div>',
      '  </div>',
      '  <div style="margin: 10px 0 8px 0; font-size: 12px; color: #E2E8F0; line-height: 1.45;">',
      '    <strong style="color: #D8B27E;">Gợi ý kiểm tra:</strong> ' + brand.neutral_tip,
      '  </div>',
      '  <div style="font-size: 11px; color: #A3B1A8; margin-bottom: 12px; display: flex; align-items: center; gap: 4px;">',
      '    <span>📍 ' + firstAddr + '</span>',
      '  </div>',
      '  <button type="button" class="btn-cta-secondary" style="width: 100%; min-height: 38px; border-radius: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer;" onclick="openCashierQuickCard(\'' + brand.id + '\')">',
      '    ⚡ Câu đọc thu ngân 3s',
      '  </button>',
      '</div>'
    ].join('\n');
  });

  return [
    '<section class="danang-fnb-hub bento-section" id="danang-fnb-hub-container" style="margin: 24px 0;">',
    '  <div class="container">',
    '    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">',
    '      <div>',
    '        <div style="display: flex; align-items: center; gap: 8px;">',
    '          <span style="font-size: 20px;">☕</span>',
    '          <h2 class="section-title" style="font-size: 18px; font-weight: 800; color: #F4EFE6; margin: 0; font-family: \'Playfair Display\', Georgia, serif;">10 CHUỖI F&amp;B ĐÀ NẴNG PHỔ BIẾN</h2>',
    '        </div>',
    '        <p style="font-size: 12px; color: #A3B1A8; margin: 4px 0 0 0;">Tra cứu nhanh câu đọc hỏi ưu đãi thu ngân &amp; địa chỉ gần các cơ sở trường học</p>',
    '      </div>',
    '      <div class="fnb-cluster-pills" style="display: flex; gap: 6px; flex-wrap: wrap;">',
    '        <button type="button" class="campus-dock-btn ' + (currentCluster === 'hoa_khanh' ? 'is-active' : '') + '" onclick="selectFnbCluster(\'hoa_khanh\')" style="padding: 4px 10px; font-size: 12px; min-height: 32px;">Hòa Khánh · DUT/UED</button>',
    '        <button type="button" class="campus-dock-btn ' + (currentCluster === 'ngu_hanh_son' ? 'is-active' : '') + '" onclick="selectFnbCluster(\'ngu_hanh_son\')" style="padding: 4px 10px; font-size: 12px; min-height: 32px;">Ngũ Hành Sơn · DUE/VKU</button>',
    '        <button type="button" class="campus-dock-btn ' + (currentCluster === 'hai_chau' ? 'is-active' : '') + '" onclick="selectFnbCluster(\'hai_chau\')" style="padding: 4px 10px; font-size: 12px; min-height: 32px;">Hải Châu · DTU/UFL</button>',
    '      </div>',
    '    </div>',
    '    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">',
    cardsHtml,
    '    </div>',
    '  </div>',
    '</section>'
  ].join('\n');
}

function renderCounterQuickDock() {
  return `
    <nav id="counter-quick-dock" class="counter-quick-dock" role="toolbar" aria-label="Thanh tác vụ nhanh tại quầy">
      <div class="counter-dock-grid">
        <button type="button" class="counter-dock-btn" onclick="openCounterQuickHud('metiz')" aria-label="Mở Metiz 55K">
          <span class="dock-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C5A880" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg></span>
          <span>Metiz 55K</span>
        </button>
        <button type="button" class="counter-dock-btn" onclick="openCounterQuickHud('galaxy')" aria-label="Mở Galaxy 45K">
          <span class="dock-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C5A880" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
          <span>Galaxy 45K</span>
        </button>
        <button type="button" class="counter-dock-btn" onclick="openCounterQuickHud('lunch')" aria-label="Mở bàn tính bữa trưa">
          <span class="dock-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C5A880" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg></span>
          <span>Bữa trưa</span>
        </button>
        <button type="button" class="counter-dock-btn" onclick="openCounterQuickHud('split')" aria-label="Mở chia tiền bàn">
          <span class="dock-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C5A880" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="8" x2="16" y1="10" y2="10"/><line x1="8" x2="12" y1="14" y2="14"/><path d="m16 17 2-2-2-2"/></svg></span>
          <span>Chia bill</span>
        </button>
      </div>
    </nav>
  `;
}

function renderJ400ToolsHost() {
  return '<div id="j400-tools-host" style="display:none"></div>';
}

function renderJ400ToolsBody() {
  const lunch = J400_TOOL_STATE.mode === 'lunch';
  return '<div class="j400-modal" role="dialog" aria-modal="true" aria-labelledby="j400-tools-title" onclick="if(event.target===this)closeJ400Tools()"><div class="j400-card j400-modal-card"><div class="j400-modal-head"><h2 id="j400-tools-title">Công cụ tại bàn</h2><button class="j400-close" onclick="closeJ400Tools()" aria-label="Đóng">×</button></div><div class="j400-tool-tabs"><button class="' + (lunch?'is-active':'') + '" onclick="switchJ400Tool(\'lunch\')">So bữa trưa</button><button class="' + (!lunch?'is-active':'') + '" onclick="switchJ400Tool(\'split\')">Chia bill</button></div>' + (lunch ? '<div class="j400-fields"><label>Giá món<input id="j400-food" inputmode="numeric" value="35000" oninput="updateJ400Lunch()"></label><label>Phí giao<input id="j400-delivery" inputmode="numeric" value="16000" oninput="updateJ400Lunch()"></label><label>Voucher<input id="j400-voucher" inputmode="numeric" value="15000" oninput="updateJ400Lunch()"></label></div><div class="j400-result" id="j400-lunch-result">36.000đ thực trả</div><p class="j400-lead">Bạn nhập số đang thấy trên ứng dụng. JayT chỉ tính: món + giao − voucher.</p>' : '<div class="j400-fields split"><label>Tổng hóa đơn<input id="j400-total" inputmode="numeric" value="120000" oninput="updateJ400Split()"></label><label>Số người<input id="j400-people" type="number" min="1" max="50" value="3" oninput="updateJ400Split()"></label></div><div class="j400-result" id="j400-split-result">40.000đ / người</div><div class="j400-qr" id="j400-qr" aria-label="Mã QR chia bill"></div>') + '</div></div>';
}

function filterJ400Brands(value) {
  const q = String(value || '').trim().toLocaleLowerCase('vi-VN');
  document.querySelectorAll('[data-j400-name]').forEach(function(b) {
    b.hidden = q && !b.dataset.j400Name.includes(q);
  });
}

function selectJ400Tab(id) {
  J399_STATE.activeTab = ['counter', 'today', 'pass'].includes(id) ? id : 'counter';
  document.querySelectorAll('[data-j400-tab]').forEach(function(b) {
    const a = b.dataset.j400Tab === J399_STATE.activeTab;
    b.classList.toggle('is-active', a);
    b.setAttribute('aria-selected', String(a));
  });
  document.querySelectorAll('.j400-panel').forEach(function(p) {
    p.classList.toggle('is-active', p.id === 'j400-panel-' + J399_STATE.activeTab);
  });
  if (id === 'today') {
    recalcJ402Lunch();
  }
  if (id === 'pass') {
    renderJaytPassQr();
    recalcJ402Split();
  }
  window.scrollTo({ top: 0, left: 0 });
}

function selectJ400Campus(id) {
  J399_STATE.campus = id;
  document.querySelectorAll('[data-j400-campus]').forEach(function(b) {
    b.classList.toggle('is-active', b.dataset.j400Campus === id);
  });
}

function updateJ402LunchPrice(val) {
  const price = Math.max(10000, Math.min(300000, parseInt(String(val).replace(/\D/g, ''), 10) || 35000));
  J402_LUNCH_STATE.dishPrice = price;
  const slider = document.getElementById('j402-dish-slider');
  const input = document.getElementById('j402-dish-input');
  if (slider && Number(slider.value) !== price) slider.value = price;
  if (input && Number(input.value.replace(/\D/g, '')) !== price) input.value = price.toLocaleString('vi-VN');
  recalcJ402Lunch();
}

function updateJ402AppFee(app, field, val) {
  const num = Math.max(0, parseInt(String(val).replace(/\D/g, ''), 10) || 0);
  if (J402_LUNCH_STATE[app]) {
    J402_LUNCH_STATE[app][field] = num;
  }
  recalcJ402Lunch();
}

function recalcJ402Lunch() {
  const p = J402_LUNCH_STATE.dishPrice;
  const sTotal = Math.max(0, p + J402_LUNCH_STATE.shopee.fee - J402_LUNCH_STATE.shopee.voucher);
  const gTotal = Math.max(0, p + J402_LUNCH_STATE.grab.fee - J402_LUNCH_STATE.grab.voucher);
  const bTotal = Math.max(0, p + J402_LUNCH_STATE.be.fee - J402_LUNCH_STATE.be.voucher);
  
  const minTotal = Math.min(sTotal, gTotal, bTotal);
  
  const sEl = document.getElementById('j402-lunch-shopee-total');
  const gEl = document.getElementById('j402-lunch-grab-total');
  const bEl = document.getElementById('j402-lunch-be-total');
  
  if (sEl) sEl.textContent = sTotal.toLocaleString('vi-VN') + 'đ';
  if (gEl) gEl.textContent = gTotal.toLocaleString('vi-VN') + 'đ';
  if (bEl) bEl.textContent = bTotal.toLocaleString('vi-VN') + 'đ';

  const sBadge = document.getElementById('j402-shopee-badge');
  const gBadge = document.getElementById('j402-grab-badge');
  const bBadge = document.getElementById('j402-be-badge');

  if (sBadge) sBadge.style.display = (sTotal === minTotal) ? 'inline-block' : 'none';
  if (gBadge) gBadge.style.display = (gTotal === minTotal) ? 'inline-block' : 'none';
  if (bBadge) bBadge.style.display = (bTotal === minTotal) ? 'inline-block' : 'none';
}

function updateJ402SplitTotal(val) {
  const total = Math.max(0, parseInt(String(val).replace(/\D/g, ''), 10) || 0);
  J402_SPLIT_STATE.total = total;
  recalcJ402Split();
}

function updateJ402SplitPeople(val) {
  const people = Math.max(1, Math.min(50, parseInt(val, 10) || 1));
  J402_SPLIT_STATE.people = people;
  recalcJ402Split();
}

function recalcJ402Split() {
  const each = Math.ceil(J402_SPLIT_STATE.total / J402_SPLIT_STATE.people);
  const resEl = document.getElementById('j402-split-result-val');
  if (resEl) resEl.textContent = each.toLocaleString('vi-VN') + 'đ';
  const qrHost = document.getElementById('j402-split-qr-host');
  if (qrHost && typeof window.qrcode === 'function') {
    const qr = window.qrcode(0, 'M');
    qr.addData('JAYT_SPLIT|EACH=' + each + '|PEOPLE=' + J402_SPLIT_STATE.people + '|TOTAL=' + J402_SPLIT_STATE.total);
    qr.make();
    qrHost.innerHTML = qr.createTableTag(3, 0);
  }
}

function openFnbDirectoryModal() {
  const modal = document.getElementById('j402-fnb-modal');
  if (modal) {
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
}

function closeFnbDirectoryModal() {
  const modal = document.getElementById('j402-fnb-modal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

function openDormCatalogModal() {
  const modal = document.getElementById('j402-dorm-modal');
  if (modal) {
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
}

function closeDormCatalogModal() {
  const modal = document.getElementById('j402-dorm-modal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

function openJ400Tools(mode) {
  J400_TOOL_STATE.mode = mode === 'split' ? 'split' : 'lunch';
  const h = document.getElementById('j400-tools-host');
  if (!h) return;
  h.style.display = 'block';
  h.innerHTML = renderJ400ToolsBody();
  if (J400_TOOL_STATE.mode === 'split') updateJ400Split();
}

function closeJ400Tools() {
  const h = document.getElementById('j400-tools-host');
  if (h) {
    h.style.display = 'none';
    h.innerHTML = '';
  }
}

function switchJ400Tool(mode) {
  openJ400Tools(mode);
}

function j400Number(id) {
  const n = document.getElementById(id);
  return Math.max(0, parseInt(String(n ? n.value : '').replace(/\D/g, ''), 10) || 0);
}

function updateJ400Lunch() {
  const total = Math.max(0, j400Number('j400-food') + j400Number('j400-delivery') - j400Number('j400-voucher'));
  const n = document.getElementById('j400-lunch-result');
  if (n) n.textContent = total.toLocaleString('vi-VN') + 'đ thực trả';
}

function updateJ400Split() {
  const total = j400Number('j400-total');
  const people = Math.max(1, j400Number('j400-people'));
  const each = Math.ceil(total / people);
  const n = document.getElementById('j400-split-result');
  if (n) n.textContent = each.toLocaleString('vi-VN') + 'đ / người';
  const q = document.getElementById('j400-qr');
  if (q && typeof window.qrcode === 'function') {
    const qr = window.qrcode(0, 'M');
    qr.addData('JAYT|AMOUNT=' + each + '|PEOPLE=' + people);
    qr.make();
    q.innerHTML = qr.createTableTag(3, 0);
  }
}

if (typeof window !== 'undefined') {
  if (typeof toggleJaytPassFlip === 'function') window.toggleJaytPassFlip = toggleJaytPassFlip;
  if (typeof updatePassHolderName === 'function') window.updatePassHolderName = updatePassHolderName;
  if (typeof handleVoucherLookup === 'function') window.handleVoucherLookup = handleVoucherLookup;
  if (typeof fillVoucherSample === 'function') window.fillVoucherSample = fillVoucherSample;
  if (typeof getJaytGoldMonogramSvg === 'function') window.getJaytGoldMonogramSvg = getJaytGoldMonogramSvg;
  if (typeof openFnbDirectoryModal === 'function') window.openFnbDirectoryModal = openFnbDirectoryModal;
  if (typeof closeFnbDirectoryModal === 'function') window.closeFnbDirectoryModal = closeFnbDirectoryModal;
  if (typeof openDormCatalogModal === 'function') window.openDormCatalogModal = openDormCatalogModal;
  if (typeof closeDormCatalogModal === 'function') window.closeDormCatalogModal = closeDormCatalogModal;
  if (typeof updateJ402LunchPrice === 'function') window.updateJ402LunchPrice = updateJ402LunchPrice;
  if (typeof updateJ402AppFee === 'function') window.updateJ402AppFee = updateJ402AppFee;
  if (typeof updateJ402SplitTotal === 'function') window.updateJ402SplitTotal = updateJ402SplitTotal;
  if (typeof updateJ402SplitPeople === 'function') window.updateJ402SplitPeople = updateJ402SplitPeople;
}

function renderJ403LuxuryStyles() {
  return `<style id="j403-luxury-tokens">
    @keyframes pulse-fomo {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
      50% { transform: scale(1.05); box-shadow: 0 0 12px 2px rgba(239, 68, 68, 0.7); }
    }

    :root {
      --j403-forest: #141C16;
      --j403-card: #1E2B24;
      --j403-card-raised: #24362D;
      --j403-gold: #D8B27E;
      --j403-champagne: #C5A880;
      --j403-gold-deep: #D4AF37;
      --j403-ink: #F8F4EC;
      --j403-muted: #B8B7A8;
      --j403-line: rgba(197,168,128,.30);
      --j403-shadow: 0 16px 42px rgba(0,0,0,.22);
    }
    html, body { background: var(--j403-forest) !important; }
    body.j403-gold-forest { color: var(--j403-ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    body.j403-gold-forest .j403-shell { min-height: 100vh; background: var(--j403-forest); color: var(--j403-ink); padding-bottom: 64px; }
    .j403-shell *, .j403-shell *::before, .j403-shell *::after { border-color: var(--j403-line); }
    .j403-shell .container, .j403-shell .onsite-counter-search-inner { max-width: 1180px; }
    .j403-shell .jayt-header, .j403-shell .jayt-header-sticky { background: rgba(20,28,22,.90) !important; border-bottom-color: var(--j403-line) !important; }
    .j403-shell .brand-symbol { width: 38px; height: 38px; border: 1px solid var(--j403-champagne); border-radius: 12px; background: linear-gradient(145deg, #2C3D31, #141C16); color: var(--j403-gold); }
    .j403-shell .brand-symbol svg { display:none; }
    .j403-shell .brand-symbol::after { content: "JT"; display:block; font: 800 14px/38px Georgia, serif; letter-spacing: .04em; text-align:center; color: var(--j403-gold); }
    .j403-shell .brand-title, .j403-shell h1, .j403-shell h2, .j403-shell h3 { font-family: "Playfair Display", Georgia, serif; }
    .j403-shell .brand-title { color: var(--j403-gold); letter-spacing: .04em; }
    .j403-shell .brand-subtitle, .j403-shell .section-desc, .j403-shell .hero-subhead, .j403-shell .footer-content, .j403-shell .schedule-active-desc { color: var(--j403-muted) !important; }
    .j403-shell .hero-section { background: linear-gradient(180deg, rgba(30,43,36,.86), rgba(20,28,22,.30)) !important; border-bottom: 1px solid var(--j403-line); }
    .j403-shell .hero-headline { color: var(--j403-ink) !important; }
    .j403-shell .hero-tag, .j403-shell .section-header, .j403-shell .cluster-info-card, .j403-shell .bento-card, .j403-shell .bento-section > .container, .j403-shell .schedule-rhythm-section, .j403-shell .cinema-schedule-block, .j403-shell .dorm-sku-card, .j403-shell .dorm-skus-explorer, .j403-shell .jayt-pass-banner, .j403-shell .fnb-brand-card, .j403-shell .cinema-power-card { background-color: var(--j403-card) !important; color: var(--j403-ink) !important; border-color: var(--j403-line) !important; box-shadow: var(--j403-shadow); }
    .j403-shell .bento-section { background: transparent !important; }
    .j403-shell .btn-cta-primary, .j403-shell .btn-onsite-split-cta, .j403-shell .fnb-trigger-btn, .j403-shell .cinema-action-btn { background: var(--j403-gold) !important; color: var(--j403-forest) !important; border-color: var(--j403-gold) !important; }
    .j403-shell .btn-cta-secondary, .j403-shell .btn-cta-secondary:hover { background: transparent !important; color: var(--j403-gold) !important; border-color: var(--j403-champagne) !important; }
    .j403-shell .campus-dock-sticky-wrap { background: rgba(20,28,22,.96) !important; border-bottom-color: var(--j403-line) !important; }
    .j403-shell .campus-dock-btn, .j403-shell .cluster-pill, .j403-shell .schedule-slot-chip, .j403-shell .btn-cinema-day, .j403-shell .btn-dorm-cat, .j403-shell .btn-ecosystem-tab { background: rgba(30,43,36,.90) !important; color: var(--j403-ink) !important; border-color: var(--j403-line) !important; }
    .j403-shell .campus-dock-btn.is-active, .j403-shell .cluster-pill.active, .j403-shell .schedule-slot-chip.is-active, .j403-shell .btn-cinema-day.is-active, .j403-shell .btn-dorm-cat.is-active, .j403-shell .btn-ecosystem-tab.is-active { background: var(--j403-gold) !important; color: var(--j403-forest) !important; border-color: var(--j403-gold) !important; }
    .j403-shell .visual-deal-card, .j403-shell .visual-card-body, .j403-shell .visual-card-media-wrap { background: var(--j403-card) !important; border-color: var(--j403-line) !important; color: var(--j403-ink) !important; }
    .j403-shell .visual-card-price, .j403-shell .cinema-price-val, .j403-shell .split-big-number, .j403-shell .sku-price { color: var(--j403-gold) !important; }
    .j403-shell input, .j403-shell select, .j403-shell textarea { background: #17251D !important; color: var(--j403-ink) !important; border-color: var(--j403-line) !important; }
    .j403-shell .on-the-spot-bar { background: transparent !important; }
    .j403-shell .on-the-spot-reflex-btn { border-color: var(--j403-champagne) !important; background: linear-gradient(135deg, #273B2F, #1E2B24) !important; color: var(--j403-gold) !important; }
    .j403-shell .counter-quick-dock { height:56px; min-height:56px; left:0; right:0; bottom:0; width:100%; max-width:none; transform:none; border:0; border-top:1px solid var(--j403-champagne); border-radius:0; padding:4px 8px env(safe-area-inset-bottom); display:block; z-index:90; background: rgba(9,13,14,.94) !important; }
    .j403-shell .counter-dock-grid { height:100%; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; max-width:640px; margin:0 auto; }
    .j403-shell .counter-dock-btn { min-height:44px; border-radius:10px; color:var(--j403-ink); background:transparent; border:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; font-size:11px; font-weight:750; }
    .j403-shell .counter-dock-btn:hover, .j403-shell .counter-dock-btn:focus-visible { background:rgba(197,168,128,.16); color:var(--j403-gold); outline:none; }
    .j403-shell .counter-dock-btn .dock-icon { font-size:18px; line-height:1; }
    .j403-shell .jayt-footer { background: #101A14 !important; border-top-color: var(--j403-line) !important; }
    .j403-shell .offer-drawer-backdrop, .j403-shell .zalo-modal-backdrop, .j403-shell .counter-sheet-backdrop { background: rgba(7,12,9,.78) !important; }
    @media (max-width: 640px) {
      .j403-shell .container { padding-left: 12px; padding-right: 12px; }
      .j403-shell .hero-grid { grid-template-columns: 1fr !important; gap: 16px !important; }
      .j403-shell .hero-media-wrapper { min-height: 180px; }
      .j403-shell .visual-deals-grid, .j403-shell .dorm-skus-grid { grid-template-columns: repeat(2, minmax(0,1fr)) !important; gap: 10px !important; }
      .j403-shell .dorm-sku-card { padding: 10px !important; border-radius: 14px !important; }
      .j403-shell .dorm-sku-img { height: 108px !important; }
      .j403-shell .sku-title { font-size: 13px !important; }
      .j403-shell .section-title { font-size: 22px !important; }
      .j403-shell .cinema-power-card, .j403-shell .fnb-brand-card { padding: 14px !important; }
      .j403-shell .onsite-counter-search-inner { flex-wrap: wrap; }
    }
  </style>`;
}

function renderJ405PinnacleStyles() {
  return `<style id="j405-pinnacle-design-system">
    :root {
      --j405-night: #0A110D;
      --j405-forest: #141E17;
      --j405-olive: #1A261E;
      --j405-olive-raised: #223128;
      --j405-champagne: #C5A880;
      --j405-gold: #E5C378;
      --j405-gold-deep: #D4AF37;
      --j405-ivory: #F7F0E3;
      --j405-mist: #B9B9AA;
      --j405-line: rgba(197,168,128,.35);
      --j405-line-soft: rgba(197,168,128,.18);
      --j405-radius-card: 20px;
      --j405-radius-control: 12px;
      --j405-shadow-1: 0 12px 36px rgba(0,0,0,.24);
      --j405-shadow-2: 0 26px 70px rgba(0,0,0,.36);
      --accent: var(--j405-gold);
      --accent-hover: #F2D692;
      --text-main: var(--j405-ivory);
      --text-muted: var(--j405-mist);
      --bg-page: var(--j405-night);
      --bg-surface: var(--j405-forest);
      --bg-card: var(--j405-olive);
      --border-color: var(--j405-line);
    }
    html { background: var(--j405-night) !important; color-scheme: dark; }
    body.j405-pinnacle {
      background:
        radial-gradient(circle at 78% -5%, rgba(197,168,128,.12), transparent 34rem),
        radial-gradient(circle at -5% 24%, rgba(49,78,58,.26), transparent 38rem),
        linear-gradient(160deg, var(--j405-night), var(--j405-forest) 48%, #0C1510) fixed !important;
      color: var(--j405-ivory);
    }
    .j405-shell { min-height:100vh; background:transparent !important; color:var(--j405-ivory); }
    .j405-shell *, .j405-shell *::before, .j405-shell *::after { box-sizing:border-box; }
    .j405-shell [style*="dashed"] { border-style:solid !important; border-color:var(--j405-line-soft) !important; }
    .j405-shell .counter-evidence-note, .j405-shell .shared-fees-box, .j405-shell .qr-unconfirmed-placeholder { border-style:solid !important; border-color:var(--j405-line-soft) !important; background:rgba(197,168,128,.045) !important; }
    .j405-shell .jayt-header {
      background:rgba(10,17,13,.84) !important;
      border-bottom:1px solid var(--j405-line-soft) !important;
      box-shadow:0 8px 30px rgba(0,0,0,.18);
      backdrop-filter:blur(20px) saturate(135%);
    }
    .j405-shell .brand-symbol { width:42px; height:42px; padding:0; border:0 !important; background:transparent !important; box-shadow:0 8px 24px rgba(212,175,55,.12); }
    .j405-shell .brand-symbol::after { display:none !important; content:none !important; }
    .j405-shell .brand-symbol svg { display:block !important; width:42px; height:42px; }
    .j405-shell .brand-title { color:var(--j405-ivory) !important; font:700 18px/1.1 "Playfair Display",Georgia,serif !important; letter-spacing:.035em !important; }
    .j405-shell .brand-subtitle { color:var(--j405-champagne) !important; font-size:9px !important; letter-spacing:.13em !important; }
    .j405-shell h1, .j405-shell h2, .j405-shell h3, .j405-shell h4 { color:var(--j405-ivory) !important; letter-spacing:-.018em; }
    .j405-shell .hero-section {
      background:linear-gradient(145deg,rgba(26,38,30,.96),rgba(10,17,13,.72)) !important;
      border-block:1px solid var(--j405-line-soft) !important;
    }
    .j405-shell .hero-media-wrapper { border:1px solid var(--j405-line) !important; box-shadow:var(--j405-shadow-2), inset 0 1px rgba(255,255,255,.08); }
    .j405-shell .hero-media-wrapper::after { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(135deg,rgba(229,195,120,.12),transparent 38%,rgba(10,17,13,.22)); }
    .j405-shell .hero-tag, .j405-shell [class*="badge"], .j405-shell [class*="chip"] {
      border:1px solid var(--j405-line-soft) !important;
      background:rgba(197,168,128,.08) !important;
      color:var(--j405-champagne) !important;
      box-shadow:none !important;
    }
    .j405-shell .container { max-width:1160px; }
    .j405-shell .bento-section { background:transparent !important; }
    .j405-shell .bento-section > .container,
    .j405-shell .bento-card,
    .j405-shell .cinema-power-card,
    .j405-shell .fnb-brand-card,
    .j405-shell .visual-deal-card,
    .j405-shell .dorm-sku-card,
    .j405-shell .cluster-info-card,
    .j405-shell .schedule-rhythm-section,
    .j405-shell .cinema-schedule-block,
    .j405-shell .j402-modal-card,
    .j405-shell .drawer-section-card {
      background:linear-gradient(145deg,rgba(34,49,40,.94),rgba(22,33,26,.96)) !important;
      border:1px solid var(--j405-line-soft) !important;
      border-radius:var(--j405-radius-card) !important;
      box-shadow:var(--j405-shadow-1), inset 0 1px rgba(255,255,255,.035) !important;
    }
    .j405-shell .cinema-power-card:hover, .j405-shell .fnb-brand-card:hover, .j405-shell .dorm-sku-card:hover { transform:translateY(-2px); border-color:var(--j405-line) !important; box-shadow:var(--j405-shadow-2),0 0 0 1px rgba(229,195,120,.08) !important; }
    .j405-shell .section-header { background:transparent !important; border:0 !important; box-shadow:none !important; }
    .j405-shell .section-title { font:700 clamp(24px,3vw,36px)/1.12 "Playfair Display",Georgia,serif !important; }
    .j405-shell .section-desc { max-width:66ch; color:var(--j405-mist) !important; line-height:1.65 !important; }
    .j405-shell button, .j405-shell a { -webkit-tap-highlight-color:transparent; }
    .j405-shell .btn-cta-primary, .j405-shell .btn-onsite-split-cta, .j405-shell .fnb-trigger-btn, .j405-shell .cinema-action-btn {
      background:linear-gradient(135deg,#F0D28E,var(--j405-gold-deep)) !important;
      color:var(--j405-night) !important;
      border:1px solid rgba(255,240,193,.44) !important;
      border-radius:var(--j405-radius-control) !important;
      box-shadow:0 8px 22px rgba(125,91,35,.22),inset 0 1px rgba(255,255,255,.35) !important;
    }
    .j405-shell .btn-cta-secondary, .j405-shell .counter-dock-btn, .j405-shell .nav-btn {
      color:var(--j405-champagne) !important;
      border-color:var(--j405-line) !important;
      background:rgba(197,168,128,.055) !important;
    }
    .j405-shell .btn-cta-primary:hover, .j405-shell .btn-cta-primary:focus-visible { filter:brightness(1.08); transform:translateY(-1px); }
    .j405-shell input, .j405-shell select, .j405-shell textarea {
      min-height:46px;
      background:rgba(8,14,10,.68) !important;
      color:var(--j405-ivory) !important;
      border:1px solid var(--j405-line-soft) !important;
      border-radius:var(--j405-radius-control) !important;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.025) !important;
    }
    .j405-shell input:focus, .j405-shell select:focus, .j405-shell textarea:focus { outline:none !important; border-color:var(--j405-champagne) !important; box-shadow:0 0 0 3px rgba(197,168,128,.12) !important; }
    .j405-shell input[type="range"] { appearance:none; min-height:32px; border:0 !important; background:transparent !important; box-shadow:none !important; }
    .j405-shell input[type="range"]::-webkit-slider-runnable-track { height:4px; border-radius:99px; background:linear-gradient(90deg,#8D6B36,var(--j405-gold),rgba(197,168,128,.22)); }
    .j405-shell input[type="range"]::-webkit-slider-thumb { appearance:none; width:22px; height:22px; margin-top:-9px; border-radius:50%; border:2px solid #F8E8BD; background:var(--j405-gold-deep); box-shadow:0 5px 15px rgba(0,0,0,.35); }
    .j405-shell .visual-card-price, .j405-shell .cinema-price-val, .j405-shell .split-big-number, .j405-shell .sku-price, .j405-shell .cashier-quick-amount { color:var(--j405-gold) !important; text-shadow:0 4px 22px rgba(212,175,55,.16); }
    .j405-shell .counter-quick-dock { background:rgba(7,12,9,.92) !important; border-top:1px solid var(--j405-line) !important; backdrop-filter:blur(22px) saturate(140%); }
    .j405-shell .counter-dock-btn { border:0 !important; background:transparent !important; }
    .j405-shell .counter-dock-btn:hover, .j405-shell .counter-dock-btn:focus-visible { color:var(--j405-gold) !important; background:rgba(197,168,128,.10) !important; }
    .j405-shell .campus-dock-sticky-wrap { background:rgba(10,17,13,.90) !important; backdrop-filter:blur(18px); }
    .j405-shell .campus-dock-btn.is-active, .j405-shell .cluster-pill.active, .j405-shell .schedule-slot-chip.is-active, .j405-shell .btn-cinema-day.is-active, .j405-shell .btn-dorm-cat.is-active, .j405-shell .btn-ecosystem-tab.is-active { background:linear-gradient(135deg,#E8CA86,#B88A43) !important; color:var(--j405-night) !important; }
    .j405-shell .j401-voucher-box { position:relative; overflow:hidden; padding:22px !important; border-color:var(--j405-line) !important; background:linear-gradient(135deg,rgba(34,49,40,.98),rgba(10,17,13,.92)) !important; }
    .j405-shell .j401-voucher-box::before { content:"TERMINAL 03S"; position:absolute; top:0; right:0; padding:7px 11px; border:1px solid var(--j405-line-soft); border-width:0 0 1px 1px; border-radius:0 0 0 12px; color:var(--j405-champagne); font-size:9px; letter-spacing:.14em; }
    .j405-pass-layout { display:grid; grid-template-columns:minmax(0,.8fr) minmax(320px,1.2fr); gap:22px; align-items:center; }
    .j405-pass-copy { padding:28px; border:1px solid var(--j405-line-soft); border-radius:var(--j405-radius-card); background:rgba(26,38,30,.72); }
    .j405-pass-kicker { color:var(--j405-champagne); font-size:10px; font-weight:800; letter-spacing:.17em; text-transform:uppercase; }
    .j405-pass-stage { perspective:1200px; }
    .j405-pass-card { position:relative; width:100%; min-height:250px; transform-style:preserve-3d; transition:transform .62s cubic-bezier(.2,.75,.2,1); cursor:pointer; }
    .j405-pass-card.is-flipped { transform:rotateY(180deg); }
    .j405-pass-face { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:24px; overflow:hidden; backface-visibility:hidden; border:1px solid rgba(229,195,120,.48); border-radius:24px; background-color:#344232; background-position:center; background-size:cover; box-shadow:0 32px 70px rgba(0,0,0,.42),inset 0 1px rgba(255,255,255,.11); }
    .j405-pass-front { background-image:url('/assets/brand/Name_Card_JayT_Mat_Truoc.png'); }
    .j405-pass-back { background-image:linear-gradient(rgba(10,17,13,.16),rgba(10,17,13,.16)),url('/assets/brand/Name_Card_JayT_Mat_Sau.png'); }
    .j405-pass-front > * { opacity:0; pointer-events:none; }
    .j405-pass-face::after { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(112deg,transparent 16%,rgba(255,255,255,.09) 32%,transparent 47%); transform:translateX(-70%); transition:transform .8s ease; }
    .j405-pass-card:hover .j405-pass-face::after { transform:translateX(75%); }
    .j405-pass-back { transform:rotateY(180deg); flex-direction:row; align-items:flex-end; justify-content:flex-start; gap:22px; }
    .j405-pass-qr { width:136px; min-width:136px; min-height:136px; display:grid; place-items:center; padding:8px; border-radius:14px; background:#FFFDF6; }
    .j405-pass-qr table { width:120px !important; height:120px !important; border-collapse:collapse; }
    .j405-pass-meta { position:relative; z-index:1; }
    .j405-pass-back .j405-pass-meta { display:none; }
    .j405-pass-number { color:var(--j405-champagne); font:600 12px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.12em; }
    .j405-pass-flip-btn { min-height:44px; margin-top:12px; width:100%; border:1px solid var(--j405-line); border-radius:12px; color:var(--j405-gold); background:rgba(197,168,128,.06); font-weight:750; cursor:pointer; }
    .j405-shell .offer-drawer-panel, .j405-shell .counter-sheet-panel, .j405-shell .onsite-split-panel { background:linear-gradient(150deg,#17231B,#090F0B) !important; border-color:var(--j405-line) !important; }
    @media (max-width:760px) {
      .j405-pass-layout { grid-template-columns:1fr; }
      .j405-pass-copy { padding:20px; }
      .j405-pass-card { min-height:224px; }
      .j405-pass-face { padding:20px; border-radius:20px; }
      .j405-pass-back { gap:14px; }
      .j405-pass-qr { width:112px; min-width:112px; min-height:112px; }
      .j405-pass-qr table { width:96px !important; height:96px !important; }
    }
    @media (prefers-reduced-motion:reduce) {
      .j405-shell *, .j405-shell *::before, .j405-shell *::after { scroll-behavior:auto !important; transition-duration:.01ms !important; animation-duration:.01ms !important; }
    }
  </style>`;
}


function renderFnbDirectoryModal() {
  const chains = (typeof J397_FNB_DIRECTORY !== 'undefined' && J397_FNB_DIRECTORY.chains) ? J397_FNB_DIRECTORY.chains : [];
  return '<div id="j402-fnb-modal" class="j402-modal" style="display:none;" onclick="if(event.target===this)closeFnbDirectoryModal()">' +
    '<div class="j402-modal-card" style="background:#1E2B24; border: 1px solid rgba(197,168,128,0.25); border-radius: 16px; max-width: 500px; margin: 40px auto; padding: 20px;">' +
    '  <div class="j402-modal-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">' +
    '    <h2 style="margin:0; font-family:var(--font-serif); font-size:18px; color:#F4EFE6;">Danh bạ 10 Chuỗi F&amp;B Đà Nẵng</h2>' +
    '    <button type="button" onclick="closeFnbDirectoryModal()" style="background:transparent; border:none; color:#F4EFE6; font-size:22px; cursor:pointer;" aria-label="Đóng">×</button>' +
    '  </div>' +
    '  <div class="j402-modal-body" style="max-height:60vh; overflow-y:auto;">' +
    chains.map(function(c) {
      const clusterKey = window._selectedFnbCluster || 'hoa_khanh';
      const addrList = (c.clusters && (c.clusters[clusterKey] || c.clusters.hoa_khanh || c.clusters.hai_chau)) || [];
      const addrText = Array.isArray(addrList) ? addrList.join(' • ') : String(addrList);
      return '<div class="j402-chain-item" style="padding:12px; margin-bottom:10px; background:rgba(0,0,0,0.2); border-radius:10px; border:1px solid rgba(197,168,128,0.15);">' +
        '<div style="display:flex; justify-content:space-between; align-items:center;"><span style="font-weight:700; color:#F4EFE6;">' + escapeHtml(c.name) + '</span><span style="font-size:11px; color:#C5A880;">' + escapeHtml(c.category) + '</span></div>' +
        '<div style="font-size:11.5px; color:#A3B1A8; margin:4px 0;">🕒 ' + escapeHtml(c.operating_hours || '08:00 - 22:30') + '</div>' +
        '<div style="font-size:11.5px; color:#CBD5E1; margin-bottom:6px;">📍 ' + escapeHtml(addrText) + '</div>' +
        '<div style="font-size:12px; font-style:italic; color:#D8B27E; margin-bottom:8px;">“' + escapeHtml(c.quick_cashier_script || 'Bạn kiểm tra giúp mình ưu đãi sinh viên nhé.') + '”</div>' +
        '<button type="button" class="btn-cta-secondary" style="font-size:11px; padding:4px 10px; border-radius:6px; cursor:pointer;" onclick="closeFnbDirectoryModal();openCashierQuickCard(\'' + c.id + '\')">⚡ Mở câu đọc quầy 3s</button>' +
        '</div>';
    }).join('') +
    '  </div>' +
    '</div>' +
    '</div>';
}

function renderDormCatalogModal() {
  const skus = typeof J387_DORM_SKUS !== 'undefined' ? J387_DORM_SKUS : [];
  return '<div id="j402-dorm-modal" class="j402-modal" style="display:none;" onclick="if(event.target===this)closeDormCatalogModal()">' +
    '<div class="j402-modal-card" style="background:#1E2B24; border: 1px solid rgba(197,168,128,0.25); border-radius: 16px; max-width: 600px; margin: 40px auto; padding: 20px;">' +
    '  <div class="j402-modal-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">' +
    '    <h2 style="margin:0; font-family:var(--font-serif); font-size:18px; color:#F4EFE6;">Kho Vật Dụng Thiết Yếu KTX (20 SKUs Feed Hòa Khánh)</h2>' +
    '    <button type="button" onclick="closeDormCatalogModal()" style="background:transparent; border:none; color:#F4EFE6; font-size:22px; cursor:pointer;" aria-label="Đóng">×</button>' +
    '  </div>' +
    '  <div class="j402-modal-body" style="max-height:60vh; overflow-y:auto;">' +
    skus.map(function(item) {
      const name = item.product_name || item.name || 'Sản phẩm KTX';
      const price = item.price_display || (Number.isFinite(item.observed_price) ? item.observed_price.toLocaleString('vi-VN') + 'đ' : 'Xem giá');
      const merchant = item.merchant_name || item.brand || 'Mall chính hãng';
      const link = item.official_partner_url || item.canonical_url || '#';
      return '<div style="display:flex; justify-content:space-between; align-items:center; padding:10px; margin-bottom:8px; background:rgba(0,0,0,0.2); border-radius:8px; border:1px solid rgba(197,168,128,0.15);">' +
        '<div><div style="font-size:11px; color:#C5A880;">' + escapeHtml(item.category) + ' • ' + escapeHtml(merchant) + '</div><div style="font-size:13px; font-weight:700; color:#F4EFE6;">' + escapeHtml(name) + '</div><div style="font-size:14px; font-weight:800; color:#D8B27E;">' + escapeHtml(price) + '</div></div>' +
        '<a href="' + escapeHtml(link) + '" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="text-decoration:none; padding:6px 12px; font-size:11px; border-radius:6px;">Xem tại Mall ↗</a>' +
        '</div>';
    }).join('') +
    '  </div>' +
    '</div>' +
    '</div>';
}

function renderLocalMonetizationRowLegacy() {
  return '<section class="jayt-pass-banner" aria-label="JayT Pass và gian hàng đối tác" style="margin:24px 0;">' +
    '<div class="j403-pass-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;">' +
      '<article class="j403-pass-card" style="padding:20px;border:1px solid var(--j403-line);border-radius:18px;background:#1E2B24;">' +
        '<div style="font-size:12px;letter-spacing:.08em;color:#C5A880;font-weight:800;text-transform:uppercase;">Gian hàng đối tác</div>' +
        '<h3 style="margin:8px 0;color:#F8F4EC;">Ưu đãi địa phương, rõ điều kiện</h3>' +
        '<p style="margin:0 0 14px;color:#B8B7A8;font-size:13px;line-height:1.5;">Dành cho quán ăn và thương hiệu tại Đà Nẵng muốn gửi chương trình chính thức đến cộng đồng.</p>' +
        '<button type="button" class="btn-cta-secondary" onclick="showToast(\'Kênh đối tác sẽ mở đăng ký sau khi xác minh thông tin.\')">Đăng ký quan tâm</button>' +
      '</article>' +
      '<article class="j403-pass-card" style="padding:20px;border:1px solid var(--j403-line);border-radius:18px;background:#1E2B24;">' +
        '<div style="font-size:12px;letter-spacing:.08em;color:#C5A880;font-weight:800;text-transform:uppercase;">JAYT PASS</div>' +
        '<h3 style="margin:8px 0;color:#F8F4EC;">Thẻ tiện ích sinh viên</h3>' +
        '<p style="margin:0 0 14px;color:#B8B7A8;font-size:13px;line-height:1.5;">Lưu nhanh deal đã kiểm tra, lịch rạp và các công cụ chia tiền ngay trên điện thoại.</p>' +
        '<button type="button" class="btn-cta-primary" onclick="showToast(\'JayT Pass đang được hoàn thiện cho sinh viên Đà Nẵng.\')">Khám phá JayT Pass</button>' +
      '</article>' +
    '</div>' +
  '</section>';
}

function updateCounterDockVisibilityLegacy() {
  const dock = document.getElementById('counter-quick-dock');
  if (dock) dock.classList.remove('dock-stowed');
}

function openOnsiteBillSplitModal() {
  onsiteState.billModalOpen = true;
  renderApp();
  if (typeof updateVietQRDisplay === 'function') updateVietQRDisplay();
}

function closeOnsiteBillSplitModal() {
  onsiteState.billModalOpen = false;
  renderApp();
}

function openFnbDirectoryModal() {
  const m = document.getElementById('j402-fnb-modal');
  if (m) m.style.display = 'block';
}
function closeFnbDirectoryModal() {
  const m = document.getElementById('j402-fnb-modal');
  if (m) m.style.display = 'none';
}
function openDormCatalogModal() {
  const m = document.getElementById('j402-dorm-modal');
  if (m) m.style.display = 'block';
}
function closeDormCatalogModal() {
  const m = document.getElementById('j402-dorm-modal');
  if (m) m.style.display = 'none';
}

function openOnTheSpotSavingsModal() {
  if (typeof openOnSiteSavingsHud === 'function') return openOnSiteSavingsHud();
}
function closeOnTheSpotSavingsModal() {
  const m = document.getElementById('on-the-spot-modal');
  if (m) m.style.display = 'none';
}
function selectOnTheSpotTab(tab) {}
function selectOnTheSpotBrand(brand) {}
function updateArbitrageInputs() {}
function setVoucherPreset(preset) {}


function renderLocalMonetizationRow() {
  return [
    '<section class="jayt-pass-banner bento-section" aria-labelledby="j405-pass-title" style="margin: 32px 0;">',
    '  <div class="container">',
    '    <div class="j405-pass-layout">',
    '      <div class="j405-pass-copy">',
    '        <div class="j405-pass-kicker">JayT Pass · Đà Nẵng</div>',
    '        <h2 id="j405-pass-title" style="margin:10px 0 12px;font-size:clamp(28px,4vw,46px);">Một chiếc thẻ cho những quyết định nhẹ ví.</h2>',
    '        <p style="margin:0 0 18px;color:#B9B9AA;line-height:1.65;">Lưu ưu đãi đã kiểm tra, mở nhanh công cụ chia tiền và mang câu đọc quầy theo bên mình. Mã QR hiện là mã nhận diện bản thử nghiệm, không phải mã thanh toán.</p>',
    '        <button type="button" class="btn-cta-secondary" onclick="showToast(\'JayT Pass đang mở danh sách quan tâm tại Đà Nẵng.\')">Đăng ký quan tâm</button>',
    '      </div>',
    '      <div class="j405-pass-stage">',
    '        <div id="j405-pass-card" class="j405-pass-card" role="group" aria-label="Thẻ hội viên số JayT Pass hai mặt">',
    '          <div class="j405-pass-face j405-pass-front">',
    '            <div style="display:flex;align-items:flex-start;justify-content:space-between;position:relative;z-index:1;">',
    '              <div>' + getJaytGoldMonogramSvg(58) + '</div>',
    '              <span class="j405-pass-kicker">Founding Edition</span>',
    '            </div>',
    '            <div class="j405-pass-meta">',
    '              <div style="font:700 30px/1.05 \'Playfair Display\',Georgia,serif;color:#F7F0E3;">JAYT PASS</div>',
    '              <div style="margin-top:8px;color:#C5A880;font-size:12px;letter-spacing:.08em;">CẨM NANG TIỆN ÍCH &amp; ĐỜI SỐNG SỐ</div>',
    '            </div>',
    '            <div class="j405-pass-number">MEMBER · DANANG · 2026</div>',
    '          </div>',
    '          <div class="j405-pass-face j405-pass-back">',
    '            <div id="j405-pass-qr" class="j405-pass-qr" aria-label="Mã QR nhận diện JayT Pass"></div>',
    '            <div class="j405-pass-meta">',
    '              <div class="j405-pass-kicker">Member Identity</div>',
    '              <h3 style="margin:8px 0 6px;font-size:24px;">JayT Đà Nẵng</h3>',
    '              <p style="margin:0;color:#B9B9AA;font-size:12px;line-height:1.5;">Mã nhận diện nội bộ bản thử nghiệm. Không chứa tài khoản ngân hàng hoặc dữ liệu cá nhân.</p>',
    '            </div>',
    '          </div>',
    '        </div>',
    '        <button id="j405-pass-flip" type="button" class="j405-pass-flip-btn" aria-pressed="false" onclick="toggleJ405PassCard()">Lật thẻ · xem mã nhận diện</button>',
    '      </div>',
    '    </div>',
    '  </div>',
    '</section>'
  ].join('\n');
}

function hydrateJ405PassQr() {
  const host = document.getElementById('j405-pass-qr');
  if (!host || host.childElementCount || typeof window.qrcode !== 'function') return;
  const qr = window.qrcode(0, 'M');
  qr.addData('JAYT_PASS|DANANG|FOUNDING_EDITION|NO_PAYMENT_DATA');
  qr.make();
  host.innerHTML = qr.createTableTag(3, 0);
}

function toggleJ405PassCard() {
  const card = document.getElementById('j405-pass-card');
  const button = document.getElementById('j405-pass-flip');
  if (!card || !button) return;
  const flipped = card.classList.toggle('is-flipped');
  button.setAttribute('aria-pressed', String(flipped));
  button.textContent = flipped ? 'Trở lại mặt trước' : 'Lật thẻ · xem mã nhận diện';
  if (flipped) hydrateJ405PassQr();
}


function updateCounterDockVisibility() {
  const dock = document.getElementById('counter-quick-dock');
  if (!dock) return;
  dock.style.display = 'block';
}

function renderJ406ConciergeStyles() {
  return `<style id="j406-concierge-styles">
    .j406-concierge { max-width:1180px; margin:0 auto; padding:22px 18px 92px; color:#F6F0E6; }
    /* J445: every production surface participates in the normal document flow. */
    .j405-shell > .jayt-footer { display:none !important; }
    #main-content > #campus-dock-section,
    #main-content > #deals-vault-module,
    #main-content > #lunch-arbitrage-module,
    #main-content > #split-bill-module { display:block !important; max-width:1180px; margin:28px auto 0 !important; padding-inline:18px; }
    #deals-vault-module .section-header,#deals-vault-module #cinema-schedule-container { display:block !important; }
    #deals-vault-module #cluster-summary-box,#deals-vault-module .ecosystem-filter-bar,#deals-vault-module #schedule-rhythm-container,#deals-vault-module #campus-offers-container,#deals-vault-module #pagination-container { display:none !important; }
    #lunch-arbitrage-module .bento-card,#split-bill-module .bento-card,#cinema-schedule-container { border:1px solid rgba(197,168,128,.34) !important; border-radius:22px !important; background:linear-gradient(145deg,#1E2B24,#101812) !important; box-shadow:0 20px 50px rgba(0,0,0,.22) !important; }
    .j406-pass-stage .j405-pass-card,.j406-pass-stage .j405-pass-card.is-flipped { transform:none !important; }
    .j406-pass-stage .j405-pass-back { display:none; transform:none !important; align-items:center; justify-content:center; padding:18px; }
    .j406-pass-stage .j405-pass-card.is-flipped .j405-pass-front { display:none; }
    .j406-pass-stage .j405-pass-card.is-flipped .j405-pass-back { display:flex; }
    .j406-pass-stage .j405-pass-qr { width:104px; min-width:104px; min-height:104px; margin:0; box-shadow:0 0 0 6px rgba(197,168,128,.22); }
    .j406-hero { display:grid; grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr); gap:28px; align-items:center; min-height:480px; padding:34px; border:1px solid rgba(197,168,128,.42); border-radius:30px; background:radial-gradient(circle at 80% 10%,rgba(216,178,126,.16),transparent 34%),linear-gradient(145deg,#1E2B24,#0C130F); box-shadow:0 30px 80px rgba(0,0,0,.34); }
    .j406-kicker { color:#C5A880; font-size:11px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; }
    .j406-title { margin:12px 0 14px; max-width:640px; font:600 clamp(38px,6vw,72px)/.98 'Playfair Display',Georgia,serif; letter-spacing:-.035em; }
    .j406-copy { max-width:560px; color:#B9B8AE; font-size:15px; line-height:1.75; }
    .j406-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:22px; }
    .j406-action { min-height:48px; padding:0 18px; border:1px solid #C5A880; border-radius:14px; color:#101710; background:linear-gradient(135deg,#F0D58F,#C6A249); font-weight:800; cursor:pointer; }
    .j406-action.secondary { color:#D8B27E; background:rgba(197,168,128,.06); }
    .j406-pass-stage { perspective:1200px; }
    .j406-pass-stage .j405-pass-card { aspect-ratio:1.76/1; min-height:0; }
    .j406-section { margin-top:26px; }
    .j406-head { display:flex; justify-content:space-between; gap:16px; align-items:end; margin-bottom:12px; }
    .j406-head h2 { margin:0; font:600 clamp(24px,4vw,38px)/1.1 'Playfair Display',Georgia,serif; }
    .j406-head span { color:#9FA99F; font-size:12px; }
    .j406-horizon { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(230px,29%); gap:12px; overflow-x:auto; padding:2px 2px 12px; scroll-snap-type:x mandatory; scrollbar-width:thin; }
    .j406-card { scroll-snap-align:start; min-height:154px; padding:18px; border:1px solid rgba(197,168,128,.32); border-radius:20px; background:linear-gradient(145deg,rgba(34,48,39,.96),rgba(16,25,19,.96)); box-shadow:inset 0 1px rgba(255,255,255,.05); }
    .j406-card strong { display:block; color:#D8B27E; font:700 30px/1 'Playfair Display',Georgia,serif; margin:18px 0 7px; }
    .j406-card p { margin:0; color:#AEB5AE; font-size:12px; line-height:1.45; }
    .j406-card button { width:100%; min-height:44px; margin-top:14px; border:1px solid rgba(197,168,128,.46); border-radius:12px; background:rgba(197,168,128,.07); color:#E2C48D; font-weight:750; cursor:pointer; }
    .j406-terminal { display:grid; grid-template-columns:1fr auto; gap:10px; padding:22px; border:1px solid rgba(197,168,128,.42); border-radius:22px; background:#101A14; }
    .j406-terminal h2,.j406-terminal p,.j406-terminal-output { grid-column:1/-1; }
    .j406-terminal input { min-height:50px; padding:0 15px; border:1px solid rgba(197,168,128,.35); border-radius:13px; background:#09100C; color:#F6F0E6; font-size:14px; }
    .j406-terminal button { min-height:50px; padding:0 18px; border:1px solid #C5A880; border-radius:13px; background:#D8B27E; color:#111810; font-weight:800; cursor:pointer; }
    .j406-terminal-output { color:#AEB5AE; font-size:13px; }
    .j406-hint-row { grid-column:1/-1; display:flex; gap:8px; overflow-x:auto; }
    .j406-hint { min-height:38px; padding:0 12px; white-space:nowrap; border:1px solid rgba(197,168,128,.3) !important; background:rgba(197,168,128,.06) !important; color:#D8B27E !important; }
    @media(min-width:1024px){ #counter-quick-dock{display:none !important;} body{padding-bottom:0 !important;} }
    @media(max-width:760px){
      .j406-concierge{padding:12px 12px 84px}.j406-hero{grid-template-columns:1fr;min-height:0;padding:22px;border-radius:24px;gap:20px}.j406-title{font-size:40px}.j406-copy{font-size:13px}.j406-horizon{grid-auto-columns:78%}.j406-terminal{grid-template-columns:1fr}.j406-terminal button{width:100%}.j406-pass-stage{order:-1}.j406-pass-stage .j405-pass-card{min-height:190px}
    }
  </style>`;
}

function inspectJ406Link() {
  const input = document.getElementById('j406-link-input');
  const output = document.getElementById('j406-link-output');
  if (!input || !output) return;
  const parsed = parseShopeeLink(input.value);
  if (!parsed) { output.textContent = 'Chỉ chấp nhận liên kết Shopee, Lazada hoặc ShopeeFood hợp lệ.'; return; }
  const identity = parsed.itemId ? ('Mã sản phẩm ' + parsed.itemId + (parsed.shopId ? ' · Shop ' + parsed.shopId : '')) : 'Link rút gọn: mở nguồn chính hãng để xác định sản phẩm';
  output.innerHTML = '<strong style="color:#D8B27E">' + escapeHtml(identity) + '</strong> · JayT không đoán voucher. <a style="color:#E5C378" target="_blank" rel="noopener noreferrer" href="' + escapeHtml(parsed.rawUrl) + '">Mở nguồn chính hãng ↗</a>';
}

function setJ406VoucherHint(label) {
  const output = document.getElementById('j406-link-output');
  if (output) output.textContent = label + ': chỉ nhập mức giảm đang hiển thị trong ứng dụng chính hãng; JayT không xác nhận mã thay cho sàn.';
}

function renderJ408CraftStyles() {
  return `<style id="j408-craft-styles">
    :root { --j408-velvet:#111813; --j408-ink:#0B0F0C; --j408-olive:#1B2820; --j408-gold:#E5C378; --j408-champagne:#C5A880; --j408-ivory:#F3EEE4; --j408-muted:#A7A99F; }
    body.j403-gold-forest { background:radial-gradient(circle at 82% -8%,rgba(197,168,128,.09),transparent 28%),linear-gradient(180deg,var(--j408-velvet),var(--j408-ink)) !important; }
    .j406-concierge { padding-top:34px; }
    .j406-hero { position:relative; grid-template-columns:minmax(0,.86fr) minmax(390px,1.14fr); min-height:570px; padding:62px 44px; overflow:visible; border:0; border-radius:0; background:none; box-shadow:none; }
    .j406-hero::before { content:""; position:absolute; inset:7% 1% 4%; z-index:-1; background:radial-gradient(ellipse at 72% 42%,rgba(197,168,128,.13),transparent 42%); filter:blur(14px); }
    .j406-kicker { color:var(--j408-champagne); letter-spacing:.24em; }
    .j406-title { font-size:clamp(48px,6.4vw,82px); line-height:.94; font-weight:500; color:var(--j408-ivory); }
    .j406-copy { max-width:470px; color:var(--j408-muted); font-size:16px; line-height:1.65; }
    .j406-pass-stage { position:relative; width:100%; min-width:0; padding:26px 4px 38px; perspective:1400px; box-sizing:border-box; }
    .j406-pass-stage::after { content:""; position:absolute; left:12%; right:12%; bottom:20px; height:28px; z-index:-1; border-radius:50%; background:rgba(0,0,0,.72); filter:blur(19px); }
    .j406-pass-stage .j405-pass-card { will-change:transform; transform:perspective(1100px) rotateX(var(--j408-rx,0deg)) rotateY(var(--j408-ry,0deg)) translateY(-3px) !important; transition:transform .18s ease-out,filter .18s ease; filter:drop-shadow(0 34px 36px rgba(0,0,0,.44)); }
    .j406-pass-stage .j405-pass-card.is-flipped { transform:perspective(1100px) rotateX(var(--j408-rx,0deg)) rotateY(var(--j408-ry,0deg)) translateY(-3px) !important; }
    .j406-pass-stage .j405-pass-card::after { content:""; position:absolute; inset:0; z-index:4; pointer-events:none; border-radius:inherit; background:linear-gradient(var(--j408-shine,115deg),transparent 24%,rgba(255,239,186,.18) 47%,transparent 67%); mix-blend-mode:screen; }
    .j405-pass-flip-btn { border:0 !important; background:transparent !important; color:var(--j408-champagne) !important; letter-spacing:.08em; }
    .j406-actions { margin-top:30px; }
    .j406-action { border-radius:999px; padding-inline:24px; }
    .j406-section { margin-top:72px; padding-top:28px; border-top:1px solid rgba(197,168,128,.19); }
    .j406-head { margin-bottom:22px; }
    .j406-head h2 { font-weight:500; letter-spacing:-.02em; }
    .j406-horizon { gap:18px; padding:4px 2px 24px; scrollbar-width:none; }
    .j406-horizon::-webkit-scrollbar { display:none; }
    .j406-card { position:relative; min-height:188px; padding:24px; overflow:hidden; border:0; border-radius:2px; background:linear-gradient(145deg,rgba(28,41,32,.82),rgba(10,16,12,.68)); box-shadow:none; }
    .j406-card::after { content:""; position:absolute; inset:auto 0 0; height:1px; background:linear-gradient(90deg,transparent,rgba(197,168,128,.5),transparent); }
    .j406-card strong { color:var(--j408-gold); font-size:38px; font-variant-numeric:tabular-nums lining-nums; text-shadow:0 1px 0 #5D4824,0 8px 24px rgba(229,195,120,.12); }
    .j406-card button { width:auto; padding:0; border:0; border-radius:0; background:transparent; color:var(--j408-champagne); text-align:left; letter-spacing:.03em; }
    .j408-brand-card { min-height:218px; display:flex; flex-direction:column; justify-content:flex-end; isolation:isolate; }
    .j408-brand-card::before { content:""; position:absolute; width:150px; height:150px; right:-28px; top:-30px; z-index:-1; border-radius:50%; background:radial-gradient(circle,var(--brand-glow),transparent 68%); opacity:.55; }
    .j408-brand-mark { width:66px; height:66px; display:grid; place-items:center; margin-bottom:auto; border:1px solid color-mix(in srgb,var(--brand-glow) 55%,transparent); border-radius:50%; background:color-mix(in srgb,var(--brand-glow) 12%,transparent); color:var(--j408-ivory); font:600 20px/1 Georgia,serif; letter-spacing:-.04em; box-shadow:0 0 34px color-mix(in srgb,var(--brand-glow) 25%,transparent),inset 0 0 20px rgba(255,255,255,.025); }
    .j408-brand-name { color:var(--j408-ivory) !important; font-size:25px !important; margin:16px 0 3px !important; text-shadow:none !important; }
    .j408-brand-card p { color:#8F978F; }
    .j406-terminal { margin-top:72px; padding:30px 0 36px; border:0; border-top:1px solid rgba(197,168,128,.2); border-bottom:1px solid rgba(197,168,128,.2); border-radius:0; background:transparent; }
    .j406-terminal h2 { font:500 clamp(28px,4vw,42px)/1.08 'Playfair Display',Georgia,serif; }
    .j406-terminal input { border-color:rgba(197,168,128,.45); border-radius:0; background:rgba(5,10,7,.52); }
    .j406-terminal > button { border-radius:0; }
    .j406-hint { border-radius:999px !important; }
    #main-content > #campus-dock-section,#main-content > #deals-vault-module,#main-content > #lunch-arbitrage-module,#main-content > #split-bill-module { margin-top:72px !important; }
    #campus-dock-section,#deals-vault-module,#lunch-arbitrage-module,#split-bill-module { border-top:1px solid rgba(197,168,128,.18); padding-top:34px !important; }
    #lunch-arbitrage-module .bento-card,#split-bill-module .bento-card,#cinema-schedule-container { border:0 !important; border-radius:2px !important; background:linear-gradient(145deg,rgba(29,43,34,.58),rgba(10,16,12,.5)) !important; box-shadow:none !important; }
    @media(max-width:760px){
      .j406-concierge{padding:10px 16px 84px}.j406-hero{grid-template-columns:minmax(0,1fr);padding:18px 0 34px;gap:30px}.j406-pass-stage{padding:14px 0 28px}.j406-title{font-size:48px}.j406-copy{font-size:15px}.j406-section{margin-top:54px}.j406-horizon{grid-auto-columns:84%}.j406-card{padding:22px}.j408-brand-card{min-height:204px}.j406-terminal{padding:28px 0}
    }
    @media(prefers-reduced-motion:reduce){ .j406-pass-stage .j405-pass-card{transition:none !important;transform:none !important;} }
  </style>`;
}

function initJ408MetalPass() {
  const stage = document.querySelector('.j406-pass-stage');
  const card = stage?.querySelector('.j405-pass-card');
  if (!stage || !card || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const move = (clientX, clientY) => {
    const r = stage.getBoundingClientRect();
    const x = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
    const y = Math.max(0, Math.min(1, (clientY - r.top) / r.height));
    card.style.setProperty('--j408-ry', ((x - .5) * 8).toFixed(2) + 'deg');
    card.style.setProperty('--j408-rx', ((.5 - y) * 7).toFixed(2) + 'deg');
    card.style.setProperty('--j408-shine', (80 + x * 70).toFixed(0) + 'deg');
  };
  stage.addEventListener('pointermove', (event) => move(event.clientX, event.clientY), { passive:true });
  stage.addEventListener('pointerleave', () => { card.style.setProperty('--j408-rx','0deg'); card.style.setProperty('--j408-ry','0deg'); });
}

function renderJ410DanangStyles() {
  return `<style id="j410-danang-styles">
    body.j403-gold-forest::before { content:""; position:fixed; inset:0; z-index:-2; background:linear-gradient(180deg,rgba(8,15,10,.48),rgba(8,14,10,.94) 58%,#080E0A),url('/assets/images/danang_4k_han_river_bridge_master.jpg') center top/cover no-repeat; opacity:.58; }
    body.j403-gold-forest::after { content:""; position:fixed; inset:0; z-index:-1; pointer-events:none; background:radial-gradient(ellipse at 50% 9%,rgba(229,195,120,.12),transparent 38%),linear-gradient(90deg,rgba(4,9,6,.72),transparent 35%,rgba(4,9,6,.5)); }
    .j406-hero { min-height:620px; background:linear-gradient(90deg,rgba(8,15,10,.94) 0%,rgba(8,15,10,.78) 44%,rgba(8,15,10,.28) 100%),url('/assets/images/danang_4k_han_river_bridge_master.jpg') center/cover no-repeat; }
    .j410-place-line { display:flex; gap:9px; align-items:center; margin-top:16px; color:#B6AE9D; font-size:13px; }
    .j410-place-line::before { content:""; width:28px; height:1px; background:#C5A880; }
    .j408-brand-mark { width:72px; height:72px; color:#F5E8CD; }
    .j408-brand-mark svg { width:28px; height:28px; }
    .j408-brand-place { display:block; margin-top:5px; color:#C5A880; font-size:11px; letter-spacing:.04em; }
    .j410-local-ribbon { margin:58px 0 0; display:grid; grid-template-columns:repeat(3,1fr); border-block:1px solid rgba(197,168,128,.2); }
    .j410-local-ribbon span { padding:17px 12px; color:#D7C39C; font:500 13px/1.3 Georgia,serif; text-align:center; }
    .j410-local-ribbon span+span { border-left:1px solid rgba(197,168,128,.16); }
    @media(max-width:760px){ body.j403-gold-forest::before{background-position:58% top}.j406-hero{min-height:0;background:linear-gradient(180deg,rgba(8,15,10,.34),rgba(8,15,10,.96) 53%),url('/assets/images/danang_4k_han_river_bridge_master.jpg') center top/auto 58% no-repeat}.j410-local-ribbon{grid-template-columns:1fr;margin-top:40px}.j410-local-ribbon span+span{border-left:0;border-top:1px solid rgba(197,168,128,.16)} }
  </style>`;
}

function getJ411CityPulse() {
  const hour = new Date().getHours();
  if (hour < 10) return { eyebrow:'Buổi sáng bên sông Hàn', title:'Đà Nẵng sáng nay, bắt đầu thật hời.', action:'Tìm quán gần trường' };
  if (hour < 14) return { eyebrow:'Giờ trưa Đà Nẵng', title:'Đà Nẵng trưa nay ăn gì?', action:'So bữa trưa' };
  if (hour < 18) return { eyebrow:'Chiều tan học · tan ca', title:'Ghé quán nào, trả vừa ví?', action:'Xem lựa chọn tại quầy' };
  return { eyebrow:'Đà Nẵng lên đèn', title:'Tối nay xem rạp nào rẻ?', action:'Xem vé tối nay' };
}

function renderJ411Styles() {
  return `<style id="j411-styles">
    .j406-hero{display:block;min-height:610px;padding:clamp(34px,7vw,84px);background:linear-gradient(90deg,rgba(4,10,6,.9),rgba(4,10,6,.5) 54%,rgba(4,10,6,.12)),url('/assets/images/danang_4k_dragon_bridge_master.jpg') center/cover no-repeat}
    .j411-radar{max-width:680px;display:flex;min-height:430px;flex-direction:column;justify-content:flex-end}.j411-pulse{display:inline-flex;width:max-content;align-items:center;gap:9px;margin-bottom:18px;color:#E6D1A4;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.j411-pulse::before{content:"";width:8px;height:8px;border-radius:50%;background:#E5C378;box-shadow:0 0 0 6px rgba(229,195,120,.12);animation:j411Pulse 2.2s ease-in-out infinite}.j411-radar .j406-title{max-width:650px;margin:0 0 18px;text-wrap:balance}.j411-radar .j406-copy{color:#D0D1C7}.j411-quick-grid{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.j411-quick-grid button{min-height:46px;padding:0 17px;border:1px solid rgba(197,168,128,.42);border-radius:999px;background:rgba(6,12,8,.58);color:#E7D2A6;backdrop-filter:blur(12px);font-weight:750;cursor:pointer}.j411-quick-grid button:first-child{background:#E5C378;color:#0A110D}
    .j408-brand-card::before{display:none}.j408-brand-mark{border-color:rgba(197,168,128,.42);background:#111A14;box-shadow:inset 0 0 0 1px rgba(255,255,255,.025);color:#E8D2A6}.j408-brand-card{background:linear-gradient(145deg,rgba(25,38,29,.92),rgba(9,15,11,.88))}
    @keyframes j411Pulse{50%{opacity:.55;transform:scale(.84)}}
    @media(max-width:760px){.j406-hero{min-height:650px;padding:36px 20px;background:linear-gradient(180deg,rgba(3,8,5,.18),rgba(3,8,5,.9) 48%,#07100A 100%),url('/assets/images/danang_4k_dragon_bridge_master.jpg') 58% top/auto 64% no-repeat}.j411-radar{min-height:570px}.j411-radar .j406-title{font-size:47px}.j411-quick-grid button{flex:1 1 46%;padding-inline:10px}}
    @media(prefers-reduced-motion:reduce){.j411-pulse::before{animation:none}}
  </style>`;
}

function renderJ406PrivateConcierge() {
  const pulse = getJ411CityPulse();
  const brandIds = ['highlands_coffee','phe_la','phuc_long','metiz_cinema','galaxy_cinema','lotteria','jollibee','gong_cha','the_coffee_house','kfc_danang'];
  const brandCards = brandIds.map((id) => getCashierHudBrand(id));
  const campusForBrand = (brandId) => ({
    highlands_coffee: 'Hải Châu', phe_la: 'Hải Châu', phuc_long: 'Hải Châu',
    metiz_cinema: 'Ngũ Hành Sơn', galaxy_cinema: 'Hải Châu', lotteria: 'Toàn thành phố',
    jollibee: 'Hòa Khánh', gong_cha: 'Hòa Khánh', the_coffee_house: 'Ngũ Hành Sơn',
    kfc_danang: 'Toàn thành phố'
  }[brandId] || 'Toàn thành phố');
  return `<section id="j406-private-concierge" class="j406-concierge" aria-labelledby="j406-title">
    <div class="j406-hero">
      <div class="j411-radar"><div class="j411-pulse">${pulse.eyebrow}</div><div class="j406-kicker">JAYT ĐÀ NẴNG · NHỊP SỐNG HÔM NAY</div><h1 id="j406-title" class="j406-title">ĐÀ NẴNG — NHỊP PHỐ &amp; ĐẶC QUYỀN QUẦY</h1><p id="j425-pulse-copy" class="j406-copy">Sáng ven sông, trưa gần trường, chiều hẹn quán, tối xem phim — chọn đúng cách trả ngay trước lượt của bạn.</p><div class="j425-dayparts" role="group" aria-label="Chọn nhịp sống Đà Nẵng"><button class="is-active" onclick="setJ425Daypart(this,'Sáng cà phê bên sông Hàn · mở thẻ tại quầy để hỏi ưu đãi đang áp dụng.')">Sáng ven sông</button><button onclick="setJ425Daypart(this,'Trưa gần trường và công sở · so ba ứng dụng bằng số bạn đang thấy.')">Trưa gần trường</button><button onclick="setJ425Daypart(this,'Chiều Nguyễn Văn Linh · kiểm tra ưu đãi thanh toán ngay tại quầy.')">Chiều hẹn quán</button><button onclick="setJ425Daypart(this,'Tối Helio và Điện Biên Phủ · mở lịch rạp và câu đọc quầy 3 giây.')">Tối xem phim</button></div><div class="j411-quick-grid"><button onclick="openCounterQuickSheet()">${pulse.action}</button><button onclick="document.getElementById('cinema-schedule-container')?.scrollIntoView({behavior:'smooth'})">Lịch rạp 7 ngày</button><button onclick="document.getElementById('lunch-arbitrage-module')?.scrollIntoView({behavior:'smooth'})">So bữa trưa</button><button onclick="openOnsiteBillSplitModal()">Chia bill VietQR</button></div></div>
    </div>
    <div class="j406-section j434-cinema-section"><div class="j406-head"><h2>Vé rạp đã kiểm tra &amp; Lịch tuần</h2><span class="j406-scroll-cue">3 lựa chọn tuần này &rarr;</span></div><div class="j434-cinema-layout"><div class="j434-cinema-tickets-col"><article class="j406-card j427-ticket-card"><div class="j406-kicker">Metiz Helio</div><strong>55.000đ</strong><p>U22 2D · xuất trình CCCD theo điều kiện rạp.</p><button onclick="openCashierQuickCard('metiz_cinema')">Mở câu đọc quầy 3 giây &rarr;</button></article><article class="j406-card j427-ticket-card"><div class="j406-kicker">Galaxy Đà Nẵng</div><strong>45.000đ</strong><p>Happy Day · Thứ Ba hằng tuần, trừ ngày lễ/Tết.</p><button onclick="openCashierQuickCard('galaxy_cinema')">Mở câu đọc quầy 3 giây &rarr;</button></article></div><aside class="j434-cinema-quick-schedule" aria-label="Tóm tắt lịch rạp Đà Nẵng tuần này"><div class="j434-schedule-header"><span class="j434-schedule-badge">🎬 LỊCH RẠP TUẦN NÀY</span><span class="j434-schedule-sub">Ưu đãi cố định đã xác thực</span></div><ul class="j434-schedule-list"><li><span class="j434-dot"></span><span><strong class="j438-venue">Metiz Helio:</strong> <span class="j438-price">55.000đ</span> <span class="j438-cond">· U22 cả ngày T2–T6</span></span></li><li><span class="j434-dot"></span><span><strong class="j438-venue">Galaxy Đà Nẵng:</strong> <span class="j438-price">45.000đ</span> <span class="j438-cond">· Happy Day Thứ 3</span></span></li><li><span class="j434-dot"></span><span><strong class="j438-venue">CGV Vĩnh Trung:</strong> <span class="j438-price">Ưu đãi U22</span> <span class="j438-cond">· Thành viên T2–T6</span></span></li></ul><button type="button" class="j434-schedule-btn" onclick="document.getElementById('cinema-schedule-container')?.scrollIntoView({behavior:'smooth'})">Mở bảng lịch 7 ngày chi tiết &darr;</button></aside></div></div>
    <div class="j410-local-ribbon" aria-label="Nhịp sống Đà Nẵng"><span>Hòa Khánh · nhịp sinh viên</span><span>Hải Châu · phố cà phê</span><span>Sông Hàn · thành phố lên đèn</span></div>
    <div class="j406-section"><div class="j406-head"><h2>Quán quen Đà Nẵng</h2><span class="j406-scroll-cue">10 điểm chạm thành phố &rarr;</span></div><div class="j439-horizon-wrap"><div class="j406-horizon">${brandCards.map((b)=>`<article class="j406-card j408-brand-card" style="--brand-glow:${b.accent}"><div class="j408-brand-mark" aria-hidden="true">${b.logo}</div><span class="j445-campus-tag">${campusForBrand(b.id)}</span><strong class="j408-brand-name">${b.shortName}</strong><span class="j408-brand-place">${escapeHtml(b.address.split(',').slice(0,2).join(','))}</span><button onclick="openCashierQuickCard('${b.id}')">Mở thẻ tại quầy →</button></article>`).join('')}</div></div>
    <div class="j406-section j406-terminal"><h2>Hộp kẹp mã KTX</h2><p class="j406-copy">Dán liên kết sản phẩm để nhận diện đúng gian hàng và tự đối chiếu ưu đãi đang hiện trên ứng dụng.</p><div class="j406-hint-row" aria-label="Gợi ý tra cứu KTX"><button class="j406-hint" onclick="setJ406VoucherHint('Kiểm tra voucher 50K nếu ứng dụng đang hiển thị')">Kiểm tra voucher 50K</button><button class="j406-hint" onclick="setJ406VoucherHint('Kiểm tra Freeship nếu ứng dụng đang hiển thị')">Kiểm tra Freeship</button><button class="j406-hint" onclick="setJ406VoucherHint('Đồ điện thiết yếu cho KTX')">Đồ điện KTX</button></div><input id="j406-link-input" type="url" placeholder="Dán link Shopee hoặc Lazada"><button type="button" onclick="inspectJ406Link()">Soi liên kết</button><div id="j406-link-output" class="j406-terminal-output" aria-live="polite">Dữ liệu ở lại trên thiết bị của bạn.</div></div>
  </section>`;
}

function renderJ421Styles() {
  return `<style id="j421-styles">
    :root{--j420-forest:#111813;--j420-charcoal:#0B0F0C;--j420-olive:#1E2B24;--j420-gold:#C5A880;--j420-value:#E5C378}
    body.j403-gold-forest{background:linear-gradient(155deg,var(--j420-forest),var(--j420-charcoal) 72%);color:#F1ECE2}
    .jayt-header{background:rgba(11,15,12,.88)!important;border-bottom:1px solid rgba(197,168,128,.25)!important;backdrop-filter:blur(18px) saturate(120%)}
    .jayt-header .brand-title{color:var(--j420-gold)!important;font-family:'Playfair Display',Georgia,serif!important}
    .jayt-header .brand-subtitle{display:block!important;font-size:10px!important;color:#E6DFD1!important;letter-spacing:.035em!important;line-height:1.2!important;white-space:nowrap!important;text-transform:none!important}
    
    /* Editorial Edge-to-Edge Hero with Sunset Dragon Bridge & Directional Vignette */
    .j406-hero{min-height:580px;padding:clamp(32px,6vw,72px)!important;background:linear-gradient(90deg,rgba(7,13,9,.94) 0%,rgba(7,13,9,.68) 42%,rgba(7,13,9,.16) 72%,transparent 100%),url('/assets/images/dragon_bridge_hero_sunset_fire.jpg') center right/cover no-repeat!important;box-shadow:inset 0 0 0 1px rgba(197,168,128,.22),0 32px 90px rgba(0,0,0,.42);border-radius:18px}
    .j411-radar{max-width:640px;background:transparent!important;border:none!important;box-shadow:none!important;padding:0!important;text-shadow:0 2px 20px rgba(0,0,0,.88)}
    .j406-kicker{color:#C5A880!important;font-family:'Playfair Display',Georgia,serif!important;font-size:12px!important;letter-spacing:.14em!important;font-weight:600!important;text-transform:uppercase!important;margin-bottom:10px}
    .j406-title{color:#F5E8CD!important;font-family:'Playfair Display',Georgia,serif!important;font-weight:700!important;letter-spacing:-.01em!important}
    .j406-copy{color:#D5D8CF!important;font-size:14.5px!important;line-height:1.6!important}
    
    /* Hero CTA Hierarchy */
    .j411-quick-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
    .j411-quick-grid button{min-height:44px;padding:0 18px;border-radius:999px;cursor:pointer;font-size:13px;transition:all .2s ease}
    .j411-quick-grid button:first-child{background:linear-gradient(135deg,#E5C378,#C5A880)!important;color:#070D09!important;font-weight:750!important;border:none!important;box-shadow:0 4px 18px rgba(229,195,120,.3)!important}
    .j411-quick-grid button:not(:first-child){background:rgba(14,22,17,.55)!important;border:1px solid rgba(197,168,128,.32)!important;color:#E6DFD1!important;font-weight:600!important;backdrop-filter:blur(10px)}
    .j411-quick-grid button:not(:first-child):hover{background:rgba(25,38,29,.75)!important;border-color:rgba(197,168,128,.55)!important;color:#FFF!important}
    
    /* Concierge Continuity: Seamless flow between Hero and Cinema Section */
    .j406-concierge > .j406-section:first-of-type{margin-top:28px!important;padding-top:0!important;border-top:none!important}
    
    /* Card surfaces & luxury styling */
    .j406-card,.cashier-brand-card,.cinema-deal-card{border-color:rgba(197,168,128,.25)!important;background:linear-gradient(145deg,rgba(30,43,36,.96),rgba(11,15,12,.94))!important}
    .j406-card strong,.deal-price,.cashier-price{color:var(--j420-value)!important;text-shadow:0 1px 16px rgba(229,195,120,.16)}
    .j408-brand-mark{background:#17231B!important;border-color:rgba(197,168,128,.38)!important;filter:none!important}
    
    /* Bottom Dock Champagne SVGs */
    #counter-quick-dock{border-top:1px solid rgba(197,168,128,.25)!important;background:rgba(11,15,12,.94)!important;backdrop-filter:blur(16px)}
    #counter-quick-dock .counter-dock-btn{color:#C5A880!important}
    #counter-quick-dock .dock-icon{display:inline-flex;align-items:center;justify-content:center;color:#C5A880;margin-bottom:2px}
    #counter-quick-dock .counter-dock-btn span:last-child{color:#E6DFD1;font-size:10.5px;font-weight:600;letter-spacing:.02em}
    
    @media(max-width:760px){
      .j406-hero{min-height:560px!important;padding:28px 18px!important;background:linear-gradient(180deg,rgba(7,13,9,.22) 0%,rgba(7,13,9,.86) 50%,#070D09 100%),url('/assets/images/dragon_bridge_hero_sunset_fire.jpg') 65% top/cover no-repeat!important}
      .j411-radar{min-height:500px!important;background:transparent!important;padding:0!important}
      .j411-radar .j406-title{font-size:clamp(28px,7.8vw,33px)!important;line-height:1.22!important}
      .j411-quick-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px!important}
      .j411-quick-grid button{min-width:0;min-height:38px!important;padding:0 4px!important;font-size:11px!important;font-weight:600!important;line-height:1.15;text-align:center}
      .j411-quick-grid button:first-child{grid-column:1/-1;min-height:46px!important;font-size:13px!important;font-weight:700!important}
    }
  </style>`;
}

function setJ425Daypart(button, copy) {
  document.querySelectorAll('.j425-dayparts button').forEach((item) => item.classList.toggle('is-active', item === button));
  const output = document.getElementById('j425-pulse-copy');
  if (output) output.textContent = copy;
}

function renderJ428Styles() {
  return `<style id="j428-styles">
    :root{--j425-velvet:#0D1612;--j425-depth:#070C0A;--j425-gold:#D4AF37;--j425-sun:#E27D42;--j425-value:#E5C378}
    body.j403-gold-forest{background:radial-gradient(circle at 84% 7%,rgba(226,125,66,.07),transparent 24%),linear-gradient(160deg,var(--j425-velvet),var(--j425-depth) 72%)!important}
    
    /* Global Typography Standard: Body text >= 14.5px, readable contrast */
    body, p, .disclaimer-note, .deal-terms, .brand-text-block span:last-child{font-size:14.5px!important;line-height:1.6!important}
    .brand-title{font-size:18px!important}
    .nav-btn{font-size:14px!important;font-weight:600!important;color:#E6DFD1!important}
    .j406-kicker{text-transform:none!important;font-size:13px!important;letter-spacing:.07em!important;font-weight:600!important;margin-bottom:8px!important}
    .j408-brand-place{font-size:13.5px!important;color:#B6AE9D!important}
    
    /* Layout Max Width */
    .j406-concierge, .bento-section > .container{max-width:1240px!important}
    
    /* 1. Nén nhịp dọc thống nhất (Giảm 35-45% khoảng đệm rời rạc) */
    .j406-concierge{padding-bottom:24px!important}
    .j406-section{margin-top:36px!important;padding-top:16px!important;border-top:0!important}
    .j406-hero + .j406-section{margin-top:18px!important;padding-top:0!important;border-top:none!important}
    
    /* 4. Campus Dock gắn sát tiêu đề Ưu Đãi Sinh Viên */
    #campus-dock-section{margin-top:36px!important;margin-bottom:0!important;padding:0!important;border:none!important;background:transparent!important}
    #campus-dock-section .container{padding:0 16px!important}
    #campus-dock-section + #deals-vault-module{margin-top:8px!important;padding-top:12px!important;border-top:none!important}
    
    /* Section containers unified spacing */
    #deals-vault-module, #lunch-arbitrage-module, #split-bill-module{
      margin-top:36px!important;
      padding-top:20px!important;
      padding-bottom:24px!important;
      border-top:1px solid rgba(212,175,55,.16)!important;
      background:transparent!important;
    }
    
    /* 3. Hero Desktop Golden Ratio 5/7 (42% Content / 58% Landscape) */
    .j406-hero{
      border-radius:26px!important;
      border:1px solid rgba(212,175,55,.3)!important;
      box-shadow:0 36px 100px rgba(0,0,0,.48)!important;
    }
    @media(min-width:1024px){
      .j406-hero{
        min-height:580px!important;
        padding:48px 42px!important;
        background:linear-gradient(90deg, rgba(7,13,9,.96) 0%, rgba(7,13,9,.86) 38%, rgba(7,13,9,.2) 55%, transparent 72%), url('/assets/images/dragon_bridge_hero_sunset_fire.jpg') center right/cover no-repeat!important;
      }
      .j411-radar{width:42%!important;max-width:490px!important}
      .j411-radar .j406-title{max-width:460px!important;font-size:36px!important;line-height:1.15!important}
    }
    
    /* Hero Description contrast protection */
    #j425-pulse-copy,.j406-copy{color:#E8E5DD!important;text-shadow:0 1px 3px rgba(0,0,0,.95),0 2px 14px rgba(0,0,0,.9),0 0 28px rgba(7,13,9,.95)!important;font-weight:450!important}

    /* Dayparts Slender Text-Tabs */
    .j425-dayparts{display:flex;flex-wrap:wrap;gap:4px;margin:16px 0 6px;border-bottom:1px solid rgba(212,175,55,.18);padding-bottom:2px}
    .j425-dayparts button{min-height:32px;padding:6px 12px;border:none!important;border-bottom:2px solid transparent!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;color:#B6AE9D;font:500 12px/1.2 system-ui;cursor:pointer;white-space:nowrap;transition:all .2s ease}
    .j425-dayparts button:hover{color:#E6DFD1}
    .j425-dayparts button.is-active{border-bottom:2px solid #D4AF37!important;color:#F7E8C8!important;font-weight:700!important;text-shadow:0 1px 8px rgba(212,175,55,.35);box-shadow:none!important;background:transparent!important}

    /* Cinema Ticket Stub */
    .j427-ticket-card{position:relative!important;overflow:visible!important;border-radius:14px!important;background:linear-gradient(145deg,rgba(28,40,32,.95),rgba(9,14,11,.92))!important;border:1px solid rgba(212,175,55,.28)!important;box-shadow:0 16px 40px rgba(0,0,0,.3)!important}
    .j427-ticket-card::before,.j427-ticket-card::after{content:"";position:absolute;top:54%;width:14px;height:14px;border-radius:50%;background:#070C0A;z-index:3;pointer-events:none}
    .j427-ticket-card::before{left:-8px;box-shadow:inset -1px 0 0 rgba(212,175,55,.32)}
    .j427-ticket-card::after{right:-8px;box-shadow:inset 1px 0 0 rgba(212,175,55,.32)}
    .j427-ticket-card p{position:relative;margin-top:10px!important;padding-top:10px!important;border-top:1px dashed rgba(212,175,55,.24)!important}

    /* Concierge Cards */
    .j406-card{position:relative;border:0!important;border-top:1px solid rgba(212,175,55,.3)!important;border-radius:4px 24px 4px 24px!important;background:linear-gradient(145deg,rgba(30,43,36,.82),rgba(7,12,10,.56))!important;box-shadow:0 18px 50px rgba(0,0,0,.22)!important}
    .j406-card:nth-child(even){border-radius:24px 4px 24px 4px!important;background:linear-gradient(155deg,rgba(35,34,24,.76),rgba(7,12,10,.62))!important}
    .j406-card strong{font-size:clamp(34px,5vw,56px)!important;color:var(--j425-value)!important;font-family:'Playfair Display',Georgia,serif!important}
    .j408-brand-card strong{font-size:22px!important}
    .j408-brand-mark{width:48px!important;height:48px!important;border:1px solid rgba(229,195,120,.52)!important;border-radius:14px!important;background:linear-gradient(145deg,#263428,#0B110D)!important;color:#E5C378!important;box-shadow:inset 1px 1px 0 rgba(255,255,255,.1),inset -3px -3px 8px rgba(0,0,0,.5),0 8px 22px rgba(0,0,0,.28)!important}

    /* 2. Tái thiết 3 module dưới: triệt tiêu hộp xanh đặc / dashboard */
    .bento-card, .cluster-info-card, .split-result-panel, .split-breakdown-box{
      background:linear-gradient(155deg,rgba(20,32,24,.7),rgba(8,13,10,.88))!important;
      border:1px solid rgba(212,175,55,.2)!important;
      border-radius:16px!important;
      box-shadow:0 16px 44px rgba(0,0,0,.3)!important;
      color:#F1ECE2!important;
    }
    .split-breakdown-box{
      background:rgba(11,17,13,.7)!important;
      border:1px solid rgba(212,175,55,.18)!important;
    }
    .split-result-panel{
      background:linear-gradient(155deg,rgba(28,40,32,.85),rgba(9,14,11,.92))!important;
      border:1px solid rgba(212,175,55,.28)!important;
    }
    .split-input, #j406-link-input, .calc-input{
      border-color:rgba(212,175,55,.28)!important;
      background:rgba(9,16,12,.75)!important;
      color:#F5E8CD!important;
    }
    .split-input:focus, #j406-link-input:focus{
      border-color:rgba(212,175,55,.6)!important;
      outline:none;
      box-shadow:0 0 0 2px rgba(212,175,55,.15);
    }
    
    /* Feed & Filter Buttons: Triệt tiêu xanh lá neon, dùng Champagne Gold */
    .btn-feed-mode.is-active, .btn-ecosystem-tab.is-active, .campus-dock-btn.is-active{
      background:linear-gradient(135deg,#E5C378,#C5A880)!important;
      color:#070D09!important;
      font-weight:700!important;
      border:none!important;
      box-shadow:0 4px 16px rgba(229,195,120,.25)!important;
    }
    .btn-feed-mode, .btn-ecosystem-tab, .campus-dock-btn{
      background:rgba(14,22,17,.55)!important;
      border:1px solid rgba(212,175,55,.22)!important;
      color:#D8D6CC!important;
      font-size:13.5px!important;
      font-weight:500!important;
    }
    .btn-feed-mode:hover, .btn-ecosystem-tab:hover, .campus-dock-btn:hover{
      background:rgba(25,38,29,.75)!important;
      border-color:rgba(212,175,55,.45)!important;
      color:#FFF!important;
    }

    #cinema-schedule-container{border:1px solid rgba(212,175,55,.25)!important;background:linear-gradient(110deg,rgba(30,43,36,.72),rgba(7,12,10,.42))!important;box-shadow:none!important;border-radius:16px!important}

    @media(max-width:760px){
      .j406-hero{border-radius:20px!important;min-height:520px!important;padding:24px 16px!important}
      .j411-radar .j406-title{font-size:clamp(23px,6.6vw,28px)!important;line-height:1.16!important;letter-spacing:-.02em!important}
      .j425-dayparts{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:2px!important;margin:12px 0 6px!important}
      .j425-dayparts button{padding:6px 2px!important;font-size:11px!important;text-align:center}
      .j411-quick-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin-top:18px!important}
      .j411-quick-grid button{min-width:0;min-height:36px!important;padding:0 4px!important;font-size:11px!important;font-weight:600!important;border-radius:999px!important;text-align:center;line-height:1.15}
      .j411-quick-grid button:first-child{grid-column:1/-1!important;min-height:44px!important;font-size:13px!important;font-weight:750!important}
      .j406-hero + .j406-section{margin-top:16px!important;padding-top:0!important}
      .j406-card strong{font-size:38px!important}
    }
  </style>`;
}

function renderJ429LightStyles() {
  return `<style id="j429-light-styles">
    body.theme-light{
      --j425-velvet:#F4EFE4;--j425-depth:#E9E0D1;--j425-gold:#9A6B18;--j425-value:#8B5E12;
      --text-main:#201C16;--text-muted:#6E6253;--bg-page:#F4EFE4;--bg-surface:#FBF8F1;
      --bg-card:#FFFDF8;--bg-surface-subtle:#EFE7D9;--border-color:rgba(126,91,29,.24);
      --accent:#9A6B18;
      background:radial-gradient(circle at 82% 5%,rgba(197,168,128,.2),transparent 28%),linear-gradient(160deg,#F8F4EC,#E9E0D1 78%)!important;
      color:#201C16!important;
    }
    body.theme-light .jayt-app-shell{color:#201C16!important}
    body.theme-light .jayt-header{background:rgba(250,246,237,.9)!important;border-bottom-color:rgba(126,91,29,.22)!important;box-shadow:0 8px 28px rgba(74,54,22,.08)!important}
    body.theme-light .jayt-header .brand-title{color:#795315!important}
    body.theme-light .jayt-header .brand-subtitle,body.theme-light .nav-btn{color:#554A3C!important}
    body.theme-light .theme-toggle-btn,body.theme-light #btn-mobile-menu{background:#FFFDF8!important;border-color:rgba(126,91,29,.28)!important;color:#795315!important}
    body.theme-light .j406-section h2,body.theme-light #deals-heading,body.theme-light #title-lunch-module,body.theme-light #title-split-module{color:#2C241A!important}
    body.theme-light .j406-head>span,body.theme-light .j408-brand-place,body.theme-light .disclaimer-note,body.theme-light .deal-terms{color:#716555!important}
    body.theme-light .j406-card,body.theme-light .cashier-brand-card,body.theme-light .cinema-deal-card{
      background:linear-gradient(145deg,rgba(255,253,248,.98),rgba(238,230,215,.94))!important;
      border-color:rgba(126,91,29,.27)!important;box-shadow:0 16px 38px rgba(74,54,22,.1)!important;color:#211C15!important;
    }
    body.theme-light .j406-card:nth-child(even){background:linear-gradient(155deg,#F8F1E5,#FFFDF8)!important}
    body.theme-light .j406-card strong,body.theme-light .deal-price,body.theme-light .cashier-price{color:#8B5E12!important;text-shadow:none!important}
    body.theme-light .j408-brand-mark{background:linear-gradient(145deg,#FFF9EC,#E8D9BD)!important;border-color:rgba(126,91,29,.38)!important;color:#795315!important;box-shadow:inset 1px 1px 0 #fff,0 8px 20px rgba(74,54,22,.1)!important}
    body.theme-light .j410-local-ribbon{border-color:rgba(126,91,29,.18)!important;color:#6E6253!important}
    body.theme-light .j406-terminal,body.theme-light #deals-vault-module,body.theme-light #lunch-arbitrage-module,body.theme-light #split-bill-module{color:#211C15!important}
    body.theme-light .bento-card,body.theme-light .cluster-info-card,body.theme-light .split-result-panel,body.theme-light .split-breakdown-box,body.theme-light #cinema-schedule-container{
      background:linear-gradient(155deg,rgba(255,253,248,.98),rgba(236,227,211,.9))!important;
      border-color:rgba(126,91,29,.23)!important;box-shadow:0 16px 36px rgba(74,54,22,.09)!important;color:#211C15!important;
    }
    body.theme-light .split-input,body.theme-light #j406-link-input,body.theme-light .calc-input,body.theme-light input,body.theme-light textarea,body.theme-light select{
      background:#FFFDF8!important;border-color:rgba(126,91,29,.3)!important;color:#211C15!important;
    }
    body.theme-light .btn-feed-mode,body.theme-light .btn-ecosystem-tab,body.theme-light .campus-dock-btn,body.theme-light .j406-hint{
      background:rgba(255,253,248,.82)!important;border-color:rgba(126,91,29,.24)!important;color:#554A3C!important;
    }
    body.theme-light .btn-feed-mode.is-active,body.theme-light .btn-ecosystem-tab.is-active,body.theme-light .campus-dock-btn.is-active{
      background:linear-gradient(135deg,#D9B86C,#B98932)!important;color:#21170A!important;
    }
    body.theme-light #counter-quick-dock{background:rgba(250,246,237,.95)!important;border-top-color:rgba(126,91,29,.25)!important;box-shadow:0 -12px 32px rgba(74,54,22,.1)!important}
    body.theme-light #counter-quick-dock .counter-dock-btn,body.theme-light #counter-quick-dock .dock-icon,body.theme-light #counter-quick-dock .counter-dock-btn span:last-child{color:#795315!important}
    body.theme-light .j427-ticket-card::before,body.theme-light .j427-ticket-card::after{background:#F4EFE4!important}
    body.theme-light footer{background:transparent!important;color:#6E6253!important;border-color:rgba(126,91,29,.18)!important}
    @media (prefers-reduced-motion:reduce){body.theme-light *{transition:none!important}}
  </style>`;
}










function renderJ441LightEditorialStyles() {
  return `<style id="j441-light-editorial-styles">
    /* ==========================================================================
       JAYT-441: LIGHT MODE EDITORIAL CONTRAST & WARM CHAMPAGNE BOUNDARIES
       ========================================================================== */

    /* 1. Light Mode Secondary Typography Contrast (#685E50 / #746B5C) */
    body.theme-light .section-desc,
    body.theme-light #deals-vault-module .section-desc,
    body.theme-light #lunch-arbitrage-module .section-desc,
    body.theme-light #split-bill-module .section-desc,
    body.theme-light .j406-copy,
    body.theme-light p.section-desc {
      color: #685E50 !important;
      opacity: 1 !important;
    }
    body.theme-light .j408-brand-card .j408-brand-place,
    body.theme-light .j408-brand-place,
    body.theme-light .j408-brand-card address,
    body.theme-light .j408-brand-card span {
      color: #746B5C !important;
      opacity: 1 !important;
      font-size: 13.5px !important;
      font-weight: 550 !important;
    }
    body.theme-light .j438-cond,
    body.theme-light .j434-cinema-cond,
    body.theme-light .j406-schedule-meta,
    body.theme-light .cinema-card-time,
    body.theme-light .j406-section.j434-cinema-section .j438-cond {
      color: #746B5C !important;
      opacity: 1 !important;
      font-size: 13.5px !important;
      font-weight: 550 !important;
    }
    body.theme-light .disclaimer-note,
    body.theme-light .disclaimer-note span,
    body.theme-light .app-calc-breakdown,
    body.theme-light .calc-note,
    body.theme-light .field-hint,
    body.theme-light .split-helper-note,
    body.theme-light .split-input-unit {
      color: #685E50 !important;
      opacity: 1 !important;
    }

    /* 2. Warm Champagne Boundaries & Subtle Ambient Glow for Tool Blocks */
    body.theme-light #lunch-arbitrage-module .calc-control-panel,
    body.theme-light #lunch-arbitrage-module .app-calc-card,
    body.theme-light #split-bill-module .split-controls,
    body.theme-light #cinema-schedule-container {
      border: 1.5px solid rgba(185, 138, 54, 0.38) !important;
      box-shadow: 0 12px 32px rgba(126, 91, 29, 0.08), 0 2px 6px rgba(74, 54, 22, 0.04) !important;
    }
    body.theme-light .j408-brand-card {
      border: 1.5px solid rgba(185, 138, 54, 0.32) !important;
      box-shadow: 0 8px 24px rgba(126, 91, 29, 0.06) !important;
    }

    /* 3. Compact Deals -> Lunch Vertical Spacing (-18px: 113px -> 95px) */
    #deals-vault-module #cinema-schedule-container {
      margin-bottom: 2px !important;
    }
    #deals-vault-module > .container {
      padding-bottom: 2px !important;
    }
    #main-content > #lunch-arbitrage-module {
      margin-top: 4px !important;
      padding-top: clamp(52px, 4.5vw, 62px) !important;
    }

    /* 4. F&B Carousel Right Edge Fade Overlay (28-32px) */
    .j439-horizon-wrap {
      position: relative !important;
    }
    .j439-horizon-wrap::after {
      content: "" !important;
      position: absolute !important;
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 32px !important;
      pointer-events: none !important;
      z-index: 10 !important;
    }
    body.theme-light .j439-horizon-wrap::after {
      background: linear-gradient(to right, rgba(244, 239, 229, 0) 0%, rgba(244, 239, 229, 0.95) 75%, #F4EFE5 100%) !important;
    }
    body.theme-dark .j439-horizon-wrap::after {
      background: linear-gradient(to right, rgba(14, 22, 18, 0) 0%, rgba(14, 22, 18, 0.95) 75%, #0E1612 100%) !important;
    }

    /* 5. Visible Frosted Pill for Native Share Button (44px Hit Area) */
    #split-bill-module #btn-share-split-native,
    #split-bill-module .split-actions button#btn-share-split-native,
    #btn-share-split-native,
    #btn-share-zalo-native {
      min-height: 44px !important;
      height: 44px !important;
      min-width: 44px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 10px 20px !important;
      box-sizing: border-box !important;
      border-radius: 999px !important;
      transition: all 0.2s ease !important;
    }
    body.theme-light #split-bill-module .split-actions button#btn-share-split-native,
    body.theme-light #btn-share-split-native {
      border: 1.5px solid rgba(185, 138, 54, 0.48) !important;
      background: rgba(185, 138, 54, 0.08) !important;
      color: #7A5418 !important;
      font-weight: 700 !important;
      box-shadow: 0 2px 8px rgba(126, 91, 29, 0.08) !important;
    }
    body.theme-light #split-bill-module .split-actions button#btn-share-split-native:hover,
    body.theme-light #btn-share-split-native:hover {
      background: rgba(185, 138, 54, 0.16) !important;
      border-color: rgba(185, 138, 54, 0.75) !important;
      transform: translateY(-1px) !important;
    }
    body.theme-dark #split-bill-module .split-actions button#btn-share-split-native,
    body.theme-dark #btn-share-split-native {
      border: 1.5px solid rgba(229, 195, 120, 0.35) !important;
      background: rgba(197, 168, 128, 0.1) !important;
      color: #E5C378 !important;
      font-weight: 700 !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
    }
    body.theme-dark #split-bill-module .split-actions button#btn-share-split-native:hover,
    body.theme-dark #btn-share-split-native:hover {
      background: rgba(197, 168, 128, 0.18) !important;
      border-color: rgba(229, 195, 120, 0.6) !important;
      transform: translateY(-1px) !important;
    }
  </style>`;
}

function renderJ440QuietLuxuryStyles() {
  return `<style id="j440-quiet-luxury-styles">
    /* ==========================================================================
       JAYT-440: DARK MODE QUIET LUXURY & HIGH-CONTRAST ACCESSIBILITY POLISH
       ========================================================================== */

    /* 1. Elevated Secondary Text (#A8B2AA) & WCAG AAA Contrast (>=7:1) */
    body.theme-dark .section-desc,
    body.theme-dark .j406-copy,
    body.theme-dark .j406-lead,
    body.theme-dark p.section-desc {
      color: #A8B2AA !important;
      opacity: 0.95 !important;
    }
    body.theme-dark .j408-brand-place,
    body.theme-dark .j408-brand-card address,
    body.theme-dark .j408-brand-card span {
      color: #A8B2AA !important;
      opacity: 0.92 !important;
      font-size: 13.5px !important;
    }
    body.theme-dark .j438-cond,
    body.theme-dark .j434-cinema-cond,
    body.theme-dark .j406-schedule-meta,
    body.theme-dark .cinema-card-time,
    body.theme-dark .cinema-card-meta,
    body.theme-dark .j406-section.j434-cinema-section .j438-cond {
      color: #A8B2AA !important;
      opacity: 0.88 !important;
    }
    body.theme-dark .disclaimer-note,
    body.theme-dark .disclaimer-note span,
    body.theme-dark .app-calc-breakdown,
    body.theme-dark .calc-note,
    body.theme-dark .field-hint,
    body.theme-dark .split-helper-note,
    body.theme-dark .split-input-unit {
      color: #A8B2AA !important;
      opacity: 0.88 !important;
    }

    /* 2. Compact Deals -> Lunch Vertical Spacing (Exact -29px reduction: 147px -> 118px) */
    #deals-vault-module > .container {
      padding-bottom: 2px !important;
    }
    #deals-vault-module #cinema-schedule-container {
      margin-bottom: 2px !important;
    }
    #main-content > #lunch-arbitrage-module {
      margin-top: 4px !important;
      padding-top: clamp(52px, 4.5vw, 62px) !important;
    }
    #lunch-arbitrage-module .section-header {
      padding-top: 10px !important;
      margin-bottom: 20px !important;
    }

    /* 3. Three Lunch Input Boxes: Enhanced Border & Golden Focus State */
    body.theme-dark #lunch-arbitrage-module .app-calc-card input.split-input,
    body.theme-dark #lunch-arbitrage-module .app-calc-card input,
    body.theme-dark .app-calc-card input {
      border: 1.5px solid rgba(197, 168, 128, 0.22) !important;
      border-color: rgba(197, 168, 128, 0.22) !important;
      background: rgba(10, 16, 12, 0.75) !important;
      color: #F1ECE2 !important;
      border-radius: 11px !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease !important;
    }
    body.theme-dark #lunch-arbitrage-module .app-calc-card input.split-input:focus,
    body.theme-dark #lunch-arbitrage-module .app-calc-card input:focus,
    body.theme-dark .app-calc-card input:focus {
      border: 1.5px solid #E5C378 !important;
      border-color: #E5C378 !important;
      background: rgba(14, 22, 17, 0.95) !important;
      box-shadow: 0 0 0 3px rgba(229, 195, 120, 0.28) !important;
      outline: none !important;
    }
    body.theme-light #lunch-arbitrage-module .app-calc-card input.split-input,
    body.theme-light #lunch-arbitrage-module .app-calc-card input,
    body.theme-light .app-calc-card input {
      background: #FFFFFF !important;
      border: 1.5px solid rgba(126, 91, 29, 0.22) !important;
      border-color: rgba(126, 91, 29, 0.22) !important;
      color: #201C16 !important;
      border-radius: 11px !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
    }
    body.theme-light #lunch-arbitrage-module .app-calc-card input.split-input:focus,
    body.theme-light #lunch-arbitrage-module .app-calc-card input:focus,
    body.theme-light .app-calc-card input:focus {
      border: 1.5px solid #B98A36 !important;
      border-color: #B98A36 !important;
      box-shadow: 0 0 0 3px rgba(185, 138, 54, 0.22) !important;
      outline: none !important;
    }

    /* 4. Split Bill Breathing Room (padding-bottom 34-40px across themes) */
    #split-bill-module > .container,
    body.theme-dark #split-bill-module > .container,
    body.theme-light #split-bill-module > .container {
      padding-bottom: clamp(34px, 3.5vw, 40px) !important;
    }
    #split-bill-module .split-result-panel,
    #split-bill-module .split-controls {
      padding-bottom: clamp(28px, 2.8vw, 36px) !important;
    }
    #main-content > #split-bill-module {
      padding-bottom: clamp(24px, 2.5vw, 36px) !important;
    }

    /* 5. Split Share Button 44px Minimum Touch Target Gate */
    #split-bill-module #btn-share-split-native,
    #split-bill-module .split-actions button#btn-share-split-native,
    #btn-share-split-native,
    #btn-share-zalo-native {
      min-height: 44px !important;
      height: 44px !important;
      min-width: 44px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 10px 18px !important;
      box-sizing: border-box !important;
    }
  </style>`;
}

function renderJ439DesignFreezeStyles() {
  return `<style id="j439-design-freeze-styles">
    /* ==========================================================================
       JAYT-439: DESIGN FREEZE MASTER POLISH
       ========================================================================== */

    /* 1. Chia Bill Eyebrow Layout Fix (No Clipping, Perfect Left Alignment) */
    #split-bill-module .section-header {
      padding-top: 20px !important;
      margin-bottom: 22px !important;
      overflow: visible !important;
    }
    #split-bill-module .j406-kicker {
      display: block !important;
      font-family: var(--j430-sans) !important;
      font-size: 13.5px !important;
      font-weight: 750 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      line-height: 1.5 !important;
      color: #7A5418 !important;
      margin-bottom: 8px !important;
      padding: 0 !important;
      overflow: visible !important;
    }
    body.theme-dark #split-bill-module .j406-kicker {
      color: #E5C378 !important;
    }
    #split-bill-module > .container {
      overflow: visible !important;
    }
    #split-bill-module > .container::before {
      display: none !important;
    }
    #main-content > #split-bill-module {
      border-top: 0 !important;
    }

    /* 2. F&B Carousel 36px Right Fade-Mask & 16% Peek */
    .j439-horizon-wrap {
      position: relative !important;
      width: 100% !important;
      overflow: hidden !important;
      mask-image: linear-gradient(to right, black 0%, black calc(100% - 36px), transparent 100%) !important;
      -webkit-mask-image: linear-gradient(to right, black 0%, black calc(100% - 36px), transparent 100%) !important;
    }
    .j406-horizon {
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }

    /* 3. Compact Deals -> Lunch Vertical Spacing (-28px) */
    #deals-vault-module #pagination-container {
      margin: 0 !important;
      padding: 0 !important;
    }
    #deals-vault-module > .container {
      padding-bottom: clamp(16px, 2vw, 22px) !important;
    }
    #main-content > #lunch-arbitrage-module {
      margin-top: clamp(8px, 1.2vw, 16px) !important;
    }

    /* 4. Form Labels & Description Scale (+1px for High-DPI Screens) */
    .section-desc {
      font-size: 16px !important;
      line-height: 1.58 !important;
    }
    .input-field-group label,
    .split-input-field label,
    .calc-control-panel label,
    .calc-input-group label,
    .j406-terminal label {
      font-size: 16px !important;
      font-weight: 700 !important;
      line-height: 1.4 !important;
      color: #201C16 !important;
    }
    body.theme-dark .input-field-group label,
    body.theme-dark .split-input-field label,
    body.theme-dark .calc-control-panel label,
    body.theme-dark .calc-input-group label,
    body.theme-dark .j406-terminal label {
      color: #F1ECE2 !important;
    }
    input, select, textarea,
    .split-input, #j406-link-input, .calc-input, .calc-slider {
      min-height: 46px !important;
      font-size: 15.5px !important;
    }

    /* 5. Mobile Ergonomics & Touch Target Gate (>=44x44px) */
    @media(max-width: 768px){
      .j425-dayparts button {
        min-height: 44px !important;
        padding: 10px 14px !important;
        font-size: 13.5px !important;
      }
      .j434-schedule-btn {
        min-height: 44px !important;
      }
      .bridge-btn {
        min-height: 44px !important;
      }
      .btn-cta-primary,
      .btn-cta-secondary {
        min-height: 44px !important;
      }
      .btn-modal-close {
        min-width: 44px !important;
        min-height: 44px !important;
      }
      .input-field-group label,
      .split-input-field label,
      .calc-control-panel label {
        font-size: 15.5px !important;
      }
    }
  </style>`;
}

function renderJ438MasterPolishStyles() {
  return `<style id="j438-master-polish-styles">
    /* ==========================================================================
       JAYT-438: FINAL EDITORIAL MASTER POLISH
       ========================================================================== */

    /* 1. Compressed KTX -> Campus Dock Spacing (Target: 44-48px) */
    #main-content > #campus-dock-section {
      margin-top: clamp(16px, 1.8vw, 24px) !important;
    }

    /* 2. Expanded Lunch Padding-Top (+26px breathing room for kicker & title) */
    #main-content > #lunch-arbitrage-module {
      padding-top: clamp(62px, 5.5vw, 78px) !important;
    }
    #lunch-arbitrage-module .section-header {
      padding-top: 10px !important;
      margin-bottom: 22px !important;
    }
    #lunch-arbitrage-module .section-header .j406-kicker {
      margin-bottom: 6px !important;
      letter-spacing: 0.12em !important;
    }

    /* 3. F&B Carousel 32px Right Fade-Mask */
