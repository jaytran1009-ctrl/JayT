    /* 5. Calibrated Distance: Lunch Arbitrage -> Split Bill (48–56px) */
    #main-content > #split-bill-module {
      margin-top: clamp(48px, 3.5vw, 56px) !important;
    }
  </style>`;
}
function renderJ434MasterStyles() {
  return `<style id="j434-master-styles">
