function getFnbGoldenHourStatus() {
  try {
    const now = new Date();
    const formatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Ho_Chi_Minh',
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
      hour12: false
    });
    const parts = formatter.formatToParts(now);
    const h = parseInt(parts.find(p => p.type === 'hour').value, 10);
    const m = parseInt(parts.find(p => p.type === 'minute').value, 10);
    const s = parseInt(parts.find(p => p.type === 'second').value, 10);
    const currentMins = h * 60 + m;

    // Slot 1: Lunch 11:00 - 12:30 (660 - 750 mins)
    // Slot 2: Dinner 16:30 - 18:30 (990 - 1110 mins)
    if (currentMins >= 660 && currentMins <= 750) {
      const remainingSecs = (750 - currentMins) * 60 - s;
      const remM = Math.floor(remainingSecs / 60);
      const remS = remainingSecs % 60;
      return {
        isActive: true,
        label: '🔥 ĐANG TRONG GIỜ VÀNG TRƯA (11:00–12:30)',
        badgeColor: '#EF4444',
        countdown: String(remM).padStart(2, '0') + ':' + String(remS).padStart(2, '0'),
        note: 'Ưu đãi ShopeeFood & GrabFood đang kích hoạt mức giảm tối đa'
      };
    }
    if (currentMins >= 990 && currentMins <= 1110) {
      const remainingSecs = (1110 - currentMins) * 60 - s;
      const remM = Math.floor(remainingSecs / 60);
      const remS = remainingSecs % 60;
      return {
        isActive: true,
        label: '🔥 ĐANG TRONG GIỜ VÀNG CHIỀU TỐI (16:30–18:30)',
        badgeColor: '#EF4444',
        countdown: String(remM).padStart(2, '0') + ':' + String(remS).padStart(2, '0'),
        note: 'Săn mã ăn tối & trà sữa giải nhiệt giờ tan tầm'
      };
    }

    // Outside golden hours: determine next slot
    let nextSlotLabel = 'Trưa 11:00';
    let minsToNext = 0;
    if (currentMins < 660) {
      minsToNext = 660 - currentMins;
      nextSlotLabel = 'Trưa 11:00';
    } else if (currentMins < 990) {
      minsToNext = 990 - currentMins;
      nextSlotLabel = 'Chiều 16:30';
    } else {
      minsToNext = (24 * 60 - currentMins) + 660;
      nextSlotLabel = 'Trưa mai 11:00';
    }
    const hToNext = Math.floor(minsToNext / 60);
    const mToNext = minsToNext % 60;
    return {
      isActive: false,
      label: '⏳ ĐÓN CHỜ GIỜ VÀNG F&B TIẾP THEO: ' + nextSlotLabel,
      badgeColor: '#F59E0B',
      countdown: String(hToNext).padStart(2, '0') + 'h ' + String(mToNext).padStart(2, '0') + 'm',
      note: 'Chuẩn bị săn mã độc quyền cùng 320.000 sinh viên & văn phòng Đà Nẵng'
    };
  } catch (e) {
    return {
      isActive: false,
      label: '⏳ GIỜ VÀNG F&B ĐÀ NẴNG (11:00–12:30 & 16:30–18:30)',
      badgeColor: '#F59E0B',
      countdown: '11:00 & 16:30',
      note: 'Áp dụng cố định 2 phiên mỗi ngày'
    };
  }
}

function renderFnbGoldenHourBar() {
  const status = getFnbGoldenHourStatus();
  return `
    <div id="jayt-fnb-golden-hour" class="fnb-golden-hour-container" style="background: var(--bg-card); border: 1.5px solid ${status.isActive ? 'rgba(239, 68, 68, 0.4)' : 'var(--border-color)'}; border-radius: 16px; padding: 16px; margin-bottom: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; border-bottom: 1px dashed var(--border-color); padding-bottom: 10px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 20px;">${status.isActive ? '🔥' : '⏰'}</span>
          <div>
            <div style="font-size: 13.5px; font-weight: 800; color: ${status.badgeColor}; letter-spacing: -.01em;">${status.label}</div>
            <div style="font-size: 12px; color: var(--text-muted);">${status.note}</div>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; background: rgba(0,0,0,0.04); padding: 4px 10px; border-radius: 20px; font-size: 13px; font-weight: 800; color: var(--text-main);">
          <span>Đếm lùi:</span>
          <span style="color: ${status.badgeColor}; font-family: monospace;">${status.countdown}</span>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px;">
        ${JAYT_FNB_GOLDEN_HOURS.vouchers.map(v => `
          <div style="display: flex; flex-direction: column; justify-content: space-between; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <span style="font-size: 11px; font-weight: 800; color: #EA580C; background: rgba(234, 88, 12, 0.1); padding: 2px 6px; border-radius: 6px;">${escapeHtml(v.platform)}</span>
                <span style="font-size: 11px; font-weight: 750; color: #10B981;">${escapeHtml(v.badge)}</span>
              </div>
              <div style="font-size: 13px; font-weight: 750; color: var(--text-main); line-height: 1.35; margin-bottom: 4px;">${escapeHtml(v.title)}</div>
              <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4; margin-bottom: 8px;">${escapeHtml(v.terms)}</div>
            </div>
            <div style="display: flex; gap: 6px; margin-top: auto; padding-top: 8px; border-top: 1px solid var(--border-color);">
              <button type="button" class="btn-cta-secondary" data-action="copy-code" data-code="${escapeHtml(v.code)}" style="flex: 1; min-height: 38px; font-size: 12px; padding: 6px 8px; border-radius: 8px; cursor: pointer;">
                Sao chép mã ${escapeHtml(v.code)}
              </button>
              <a href="${escapeHtml(v.actionUrl)}" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="flex: 1; min-height: 38px; font-size: 12px; padding: 6px 8px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
                Mở app ${escapeHtml(v.platform)} ↗
              </a>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

function renderRescueDeals25kSection() {
  const currentClusterId = state.selectedClusterId || 'BK_SP_HOAKHANH';
  const clusterData = JAYT_RESCUE_DEALS_25K.find(c => c.clusterId === currentClusterId) || JAYT_RESCUE_DEALS_25K[0];

  return `
    <div id="rescue-deals-25k-container" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 16px; margin-top: 20px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
        <div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-size: 18px;">⚡</span>
            <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: var(--text-main);">Radar Deal Cứu Đói ≤ 25K Quanh 4 Cụm Đại Học Đà Nẵng</h3>
          </div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Món ăn bình dân cứu đói sinh viên, bán kính đi bộ &lt; 800m từ cổng trường</div>
        </div>
        <span style="background: rgba(16, 185, 129, 0.12); color: #10B981; font-size: 11.5px; font-weight: 800; padding: 3px 8px; border-radius: 12px;">Bữa ăn tiết kiệm ≤ 25K</span>
      </div>

      <div class="rescue-cluster-tabs" role="tablist" style="display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 12px;">
        ${JAYT_RESCUE_DEALS_25K.map(c => {
          const isAct = (c.clusterId === currentClusterId);
          return `
            <button 
              type="button" 
              class="btn-rescue-cluster ${isAct ? 'is-active' : ''}" 
              data-rescue-cluster="${c.clusterId}"
              role="tab"
              aria-selected="${isAct ? 'true' : 'false'}"
              style="padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: ${isAct ? '750' : '500'}; white-space: nowrap; cursor: pointer; border: 1px solid ${isAct ? 'var(--accent)' : 'var(--border-color)'}; background: ${isAct ? 'var(--accent)' : 'transparent'}; color: ${isAct ? '#ffffff' : 'var(--text-main)'}; min-height: 38px;"
            >
              ${escapeHtml(c.clusterName.split('(')[0].trim())}
            </button>
          `;
        }).join('')}
      </div>

      <div class="rescue-items-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
        ${clusterData.items.map(item => `
          <div style="background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 4px;">
                <div style="font-size: 13.5px; font-weight: 750; color: var(--text-main); line-height: 1.35;">${escapeHtml(item.name)}</div>
                <div style="font-size: 15px; font-weight: 800; color: #10B981; white-space: nowrap;">${escapeHtml(item.priceDisplay)}</div>
              </div>
              <div style="font-size: 11.5px; color: var(--accent); margin-bottom: 4px;">📍 ${escapeHtml(item.spot)}</div>
              <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">ℹ️ ${escapeHtml(item.note)}</div>
            </div>
            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--border-color); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 11px; color: var(--text-muted);">Khoảng cách: Đi bộ 2–5 phút</span>
              <button type="button" class="btn-cta-secondary" data-action="copy-code" data-code="${escapeHtml(item.spot)}" style="min-height: 32px; font-size: 11px; padding: 4px 8px; border-radius: 6px;">
                Sao chép địa chỉ
              </button>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

function renderMobilityHubModule() {
  return `
    <section id="mobility-hub-module" class="bento-section" aria-labelledby="title-mobility-hub">
      <div class="container">
        <div class="section-header">
          <div class="j406-kicker">Trục đi lại &amp; di chuyển thông minh</div>
          <h2 id="title-mobility-hub" class="section-title">🛵 Trạm Săn Mã Di Chuyển Sinh Viên</h2>
          <p class="section-desc">Bóc tách mã ưu đãi cuốc xe Xanh SM, BeBike, GrabBike theo thời gian thực &amp; hướng dẫn xe buýt trợ giá DanaBus nối KTX Hòa Khánh về trung tâm.</p>
        </div>

        <!-- 1. Real-time Ride Hailing Vouchers Grid -->
        <div class="bento-card" style="margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">⚡</span>
              <div>
                <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text-main);">Kho Mã Giảm Giá Cuốc Xe Theo Thời Gian Thực</h3>
                <span style="font-size: 12px; color: var(--text-muted);">Ưu tiên mã tân thủ 50% &amp; mã chống kẹt xe giờ cao điểm</span>
              </div>
            </div>
            <div style="background: rgba(37,99,235,0.1); color: #2563EB; padding: 4px 10px; border-radius: 16px; font-size: 12px; font-weight: 750;">
              Cập nhật tháng 09/2026
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
            ${JAYT_MOBILITY_HUB_DATA.vouchers.map(v => `
              <div style="background: rgba(0,0,0,0.02); border: 1.5px solid var(--border-color); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 13.5px; font-weight: 800; color: var(--text-main);">${escapeHtml(v.brand)}</span>
                    <span style="font-size: 11px; font-weight: 800; color: ${v.badgeColor}; background: rgba(0,0,0,0.05); padding: 2px 8px; border-radius: 8px;">${escapeHtml(v.badge)}</span>
                  </div>
                  <div style="font-size: 16px; font-weight: 800; color: var(--accent); margin-bottom: 4px;">${escapeHtml(v.discount)}</div>
                  <div style="font-size: 12px; color: var(--text-muted); line-height: 1.45; margin-bottom: 12px;">${escapeHtml(v.terms)}</div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: auto; padding-top: 10px; border-top: 1px dashed var(--border-color);">
                  <button type="button" class="btn-cta-secondary" data-action="copy-code" data-code="${escapeHtml(v.code)}" style="flex: 1; min-height: 40px; font-size: 12.5px; padding: 6px 10px; border-radius: 8px; cursor: pointer;">
                    Sao chép mã ${escapeHtml(v.code)}
                  </button>
                  <a href="${escapeHtml(v.actionUrl)}" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="flex: 1; min-height: 40px; font-size: 12.5px; padding: 6px 10px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
                    Mở app xe ↗
                  </a>
                </div>
              </div>
            `).join('')}
          </div>

          <!-- Peak hours anti-surge notice -->
          <div style="margin-top: 14px; background: rgba(245, 158, 11, 0.08); border: 1px dashed rgba(245, 158, 11, 0.4); border-radius: 10px; padding: 10px 14px; font-size: 12.5px; color: var(--text-main); line-height: 1.5;">
            ⚠️ <strong>Lưu ý kẹt xe giờ cao điểm Đà Nẵng (07:00–08:30 &amp; 16:30–18:00):</strong> Giá cước xe công nghệ có thể tăng 20%–40% do hệ số nhu cầu tại nút giao Ngã Ba Huế, Cầu Rồng và Cầu Sông Hàn. Hãy nhập trước mã chống kẹt xe hoặc chọn giải pháp xe buýt trợ giá DanaBus để giữ chi phí cố định.
          </div>
        </div>

        <!-- 2. DanaBus Subsidized Transit Diagram & Guide -->
        <div class="bento-card" style="margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">🚌</span>
              <div>
                <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text-main);">Sơ Đồ Xe Buýt Trợ Giá DanaBus Kết Nối KTX Hòa Khánh</h3>
                <span style="font-size: 12px; color: var(--text-muted);">Vé tháng học sinh sinh viên chỉ 130.000₫/tháng không giới hạn số lượt đi</span>
              </div>
            </div>
            <a href="https://danangbus.vn/" target="_blank" rel="noopener noreferrer" class="btn-cta-secondary" style="min-height: 38px; font-size: 12.5px; padding: 6px 12px; display: inline-flex; align-items: center; text-decoration: none;">
              Xem lộ trình DanaBus ↗
            </a>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
            ${JAYT_MOBILITY_HUB_DATA.danabusRoutes.map(r => `
              <div style="background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 14px; font-weight: 800; color: #2563EB;">${escapeHtml(r.routeNumber)}</span>
                  <span style="font-size: 11.5px; color: var(--text-muted);">${escapeHtml(r.frequency)}</span>
                </div>
                <div style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 6px; line-height: 1.4;">${escapeHtml(r.title)}</div>
                <div style="font-size: 12px; color: #10B981; font-weight: 700; margin-bottom: 6px;">🎟️ ${escapeHtml(r.fareStudent)}</div>
                <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">ℹ️ ${escapeHtml(r.highlights)}</div>
              </div>
            `).join('')}
          </div>

          <!-- 3-step guide to get student monthly pass -->
          <div style="margin-top: 14px; padding: 12px 14px; background: rgba(0,0,0,0.02); border-radius: 10px; border-left: 3px solid #2563EB;">
            <div style="font-size: 13px; font-weight: 750; color: var(--text-main); margin-bottom: 4px;">Quy trình 3 bước đăng ký vé tháng DanaBus HSSV số QR:</div>
            <ol style="margin: 0; padding-left: 18px; font-size: 12px; color: var(--text-muted); line-height: 1.6;">
              <li>Chuẩn bị ảnh chụp Thẻ Sinh Viên còn hiệu lực (hoặc Giấy xác nhận sinh viên) + ảnh thẻ 3x4.</li>
              <li>Truy cập cổng điện tử <strong>danangbus.vn</strong> mục Đăng ký vé tháng ưu tiên hoặc tới quầy vé Bến xe Đà Nẵng.</li>
              <li>Nhận mã vé tháng QR điện tử lưu trên điện thoại — Quét vé 1 giây khi lên mọi tuyến buýt trợ giá nội đô.</li>
            </ol>
          </div>
        </div>

        <!-- 3. TNGo Student Public Bike-Share Station Locator -->
        <div class="bento-card">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">🚲</span>
              <div>
                <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text-main);">Trạm Xe Đạp Công Cộng TNGo Thân Thiện Sinh Viên</h3>
                <span style="font-size: 12px; color: var(--text-muted);">Chỉ 5.000₫ / 30 phút — Phương tiện kết nối xanh chặng cuối từ trạm buýt về KTX</span>
              </div>
            </div>
            <span style="font-size: 12px; color: #10B981; font-weight: 750; background: rgba(16, 185, 129, 0.1); padding: 3px 8px; border-radius: 12px;">4 Trạm Cổng Trường ĐH</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px;">
            ${JAYT_MOBILITY_HUB_DATA.bikeShareStations.map(s => `
              <div style="background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); border-radius: 10px; padding: 12px;">
                <div style="font-size: 13px; font-weight: 750; color: var(--text-main); margin-bottom: 2px;">${escapeHtml(s.name)}</div>
                <div style="font-size: 11.5px; color: var(--accent); margin-bottom: 4px;">📍 ${escapeHtml(s.address)}</div>
                <div style="font-size: 11px; color: var(--text-muted);">Quy mô: ${escapeHtml(s.bikes)} · Quét QR mở khoá 3s</div>
              </div>
            `).join('')}
          </div>
        </div>
      </div>
    </section>
  `;
}

function renderLunchArbitrageModule() {
  const comparison = calculateLunchComparison(state.dishPrice);

  return `
    <section id="lunch-arbitrage-module" class="bento-section" aria-labelledby="title-lunch-module">
      <div class="container">
        <div class="section-header">
          <div class="j406-kicker">Cân đối chi tiêu hằng ngày</div><h2 id="title-lunch-module" class="section-title">So Sánh Bữa Trưa 3 Ứng Dụng</h2>
          <p class="section-desc"><strong>BÀN TÍNH THỰC TRẢ TỰ NHẬP — ĐỐI SOÁT TRỰC TIẾP VỚI GIÁ BẠN ĐANG THẤY TRÊN APP.</strong></p>
          <p class="section-desc">Nhập số đang thấy trong từng ứng dụng để tự đối chiếu tổng thanh toán. JayT không suy đoán phí, mã giảm giá hay dịch vụ rẻ nhất.</p>
        </div>

        <!-- F&B Golden Hours Vault (11:00-12:30 & 16:30-18:30) -->
        ${renderFnbGoldenHourBar()}

        <!-- Pick-up 20k-30k Savings Callout -->
        <div class="pickup-savings-callout" style="background: rgba(16, 185, 129, 0.08); border: 1.5px solid rgba(16, 185, 129, 0.3); border-radius: 14px; padding: 14px 16px; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div>
              <div style="font-size: 11px; font-weight: 800; color: #10B981; letter-spacing: .06em; text-transform: uppercase;">💡 Giải pháp tiết kiệm vượt trội cho sinh viên &amp; văn phòng</div>
              <div style="font-size: 15px; font-weight: 800; color: var(--text-main); margin: 2px 0;">Pick-up (Tự Đến Lấy Quán Gần KTX &lt; 500m)</div>
            </div>
            <div style="background: #10B981; color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 800;">
              Tiết kiệm 20.000₫ – 30.000₫ / bữa
            </div>
          </div>
          <p style="font-size: 12.5px; color: var(--text-muted); margin: 6px 0 0; line-height: 1.5;">
            Cắt giảm hoàn toàn phí giao hàng (15.000₫–25.000₫) và phụ phí thời tiết/cao điểm (5.000₫–10.000₫). Với 25 bữa trưa/tháng, sinh viên tiết kiệm trực tiếp <strong>500.000₫ – 750.000₫</strong> vào ngân sách sinh hoạt.
          </p>
        </div>

        <div class="bento-card">
          <div class="arbitrage-grid">
            <div class="calc-control-panel">
              <div class="input-field-group">
                <label for="slider-dish-price" style="font-weight: 700; font-size: 0.9rem; display: flex; justify-content: space-between;">
                  <span>1. Giá món bạn đang so sánh:</span>
                  <span id="label-dish-price-val" style="color: var(--accent); font-size: 1.05rem;">${Number(state.dishPrice).toLocaleString('vi-VN')} ₫</span>
                </label>
                <input 
                  type="range" 
                  id="slider-dish-price" 
                  class="calc-slider"
                  min="20000" 
                  max="200000" 
                  step="5000" 
                  value="${state.dishPrice}"
                  style="width: 100%; min-height: 44px; accent-color: var(--accent); cursor: pointer;"
                  aria-label="Thanh trượt giá món từ 20.000₫ đến 200.000₫"
                />
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-top: -6px;">
                  <span>20.000₫</span>
                  <span>100.000₫</span>
                  <span>200.000₫</span>
                </div>
              </div>

              <div class="input-field-group">
                <label style="font-weight: 700; font-size: 0.9rem;">2. Nhắc bạn đối chiếu trong app:</label>
                <div class="bridge-btn-group">
                  <button 
                    type="button"
                    class="bridge-btn ${state.lunchScenario.peakTime ? 'active' : ''}" 
                    data-lunch-scenario="peakTime"
                    aria-pressed="${state.lunchScenario.peakTime}"
                  >
                    Giờ cao điểm 11:30–12:30
                  </button>
                  <button 
                    type="button"
                    class="bridge-btn ${state.lunchScenario.bridgeRoute ? 'active' : ''}" 
                    data-lunch-scenario="bridgeRoute"
                    aria-pressed="${state.lunchScenario.bridgeRoute}"
                  >
                    Lộ trình qua cầu
                  </button>
                </div>
              </div>

              <div class="disclaimer-note" style="background: rgba(0,0,0,0.02); border: 1px dashed var(--border-color); border-radius: var(--radius-control); padding: 8px 12px; font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                <span>ℹ️</span>
                <span>${state.lunchScenario.peakTime || state.lunchScenario.bridgeRoute ? 'Đây là lời nhắc: hãy nhập đúng phí đang hiển thị trong ứng dụng trước khi đặt. JayT không ước tính phụ phí.' : 'Chỉ sử dụng số tiền bạn thấy trong ứng dụng. Không có giá, phí hay ưu đãi nhà cung cấp được nạp sẵn.'}</span>
              </div>
            </div>

            <div class="arbitrage-comparison-cards">
              ${Object.entries(comparison.items).map(([key, app]) => `
                <div class="app-calc-card">
                  <div class="app-calc-title" style="color: ${app.color}">
                    ${app.name}
                  </div>
                  <label class="app-calc-breakdown" style="display:block; margin:8px 0;">Phí giao bạn nhập
                    <input type="number" min="0" step="1000" inputmode="numeric" data-lunch-app="${key}" data-lunch-field="deliveryFee" value="${app.deliveryFee}" aria-label="Phí giao bạn nhập cho ${app.name}" class="split-input" />
                  </label>
                  <label class="app-calc-breakdown" style="display:block; margin:8px 0;">Voucher bạn nhập
                    <input type="number" min="0" step="1000" inputmode="numeric" data-lunch-app="${key}" data-lunch-field="voucher" value="${app.voucher}" aria-label="Voucher bạn nhập cho ${app.name}" class="split-input" />
                  </label>
                  <div class="app-calc-total">${Number(app.total).toLocaleString('vi-VN')} ₫</div>
                  <div class="app-calc-breakdown">Giá món + phí giao bạn nhập − voucher bạn nhập</div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>

        <!-- Radar Deal Cứu Đói <= 25K Quanh 4 Cụm Trường -->
        ${renderRescueDeals25kSection()}
      </div>
    </section>
  `;
}

function renderStudentSavingsModule() {
  const stack = calculateDynamicStack();
  const fields = [
    ['basketValue', 'Giá trị đơn hàng bạn nhập'],
    ['shopDiscount', 'Mã giảm của shop bạn nhập'],
    ['platformVoucher', 'Voucher sàn bạn nhập'],
    ['deliveryFee', 'Phí giao hàng bạn nhập'],
    ['freeshipCredit', 'Ưu đãi phí giao bạn nhập']
  ];

  return `
    <section id="student-savings-module" class="bento-section" aria-labelledby="title-student-savings">
      <div class="container">
        <div class="section-header">
          <h2 id="title-student-savings" class="section-title">🎓 Đặc quyền sinh viên</h2>
          <p class="section-desc">Tính thử đơn hàng theo các mức giảm bạn tự nhập và xem điều kiện Spotify Student.</p>
        </div>
        <div class="arbitrage-grid">
          <div class="bento-card calc-control-panel">
            <h3 style="margin-top:0;">Tính thử đơn hàng KTX</h3>
            <p class="section-desc" style="margin-top:0;">Mô phỏng cục bộ, không phải mã giảm giá hoặc ưu đãi được JayT xác nhận.</p>
            ${fields.map(([field, label]) => `
              <label class="input-field-group" style="display:block; font-weight:700; font-size:.9rem;">${label}
                <input type="number" min="0" step="1000" inputmode="numeric" data-stack-input="${field}" value="${stack[field]}" aria-label="${label}" class="split-input" />
              </label>
            `).join('')}
          </div>
          <div class="bento-card split-result-panel">
            <div>
              <div style="font-size:.85rem; font-weight:700; color:var(--text-muted);">THANH TOÁN MÔ PHỎNG</div>
              <div class="split-big-number">${Number(stack.payable).toLocaleString('vi-VN')} ₫</div>
              <div class="split-breakdown-box">
                <div>Giá đơn: ${Number(stack.basketValue).toLocaleString('vi-VN')}₫</div>
                <div>Giảm bạn nhập: −${Number(stack.shopDiscount + stack.platformVoucher).toLocaleString('vi-VN')}₫</div>
                <div>Phí giao sau ưu đãi bạn nhập: ${Number(stack.deliveryAfterFreeship).toLocaleString('vi-VN')}₫</div>
                <div style="margin-top:6px; color:#D4AF37; font-weight:700;">Tổng mức giảm bạn nhập: ${Number(stack.savings).toLocaleString('vi-VN')}₫</div>
              </div>
            </div>
            <div class="disclaimer-note"><span>ℹ️</span><span>Hãy đối chiếu điều kiện thực tế trong ứng dụng trước khi thanh toán.</span></div>
          </div>
        </div>
        <div class="bento-card" style="margin-top:16px;">
          <h3 style="margin-top:0;">Spotify Premium Student tại Việt Nam</h3>
          <p class="section-desc">33.000₫/tháng thay vì gói Cá nhân 65.000₫/tháng; chênh lệch 32.000₫/tháng chỉ áp dụng cho sinh viên đủ điều kiện.</p>
          <p class="section-desc">Cần đang theo học tại cơ sở giáo dục được công nhận, xác minh qua SheerID; ưu đãi sinh viên có thời hạn tối đa 4 năm. Điều khoản có thể thay đổi.</p>
          <a href="https://www.spotify.com/vn-vi/student/" target="_blank" rel="noopener noreferrer" class="btn-cta-secondary">Xem điều kiện Spotify Student ↗</a>
          <p style="font-size:.75rem; color:var(--text-muted); margin-bottom:0;">Nội dung đang được kiểm thử trên Staging; không có liên kết tiếp thị liên kết.</p>
        </div>
        <div class="bento-card" style="margin-top:16px;">
          <h3 style="margin-top:0;">🚌 Thẻ vé tháng DanaBus cho HSSV</h3>
          <p class="section-desc">Tham khảo quy trình đăng ký vé tháng, hồ sơ ưu tiên HSSV và hình thức thẻ vé số QR trên cổng DanaBus chính thức.</p>
          <ol style="margin:12px 0 0 20px; color:var(--text-muted); font-size:.9rem; line-height:1.7;">
            <li>Kiểm tra hướng dẫn đăng ký và giấy tờ ưu tiên HSSV trên trang chính thức.</li>
            <li>Hoàn tất thông tin theo quy trình được DanaBus công bố.</li>
            <li>Đối chiếu điều kiện và thông tin QR trước khi sử dụng.</li>
          </ol>
