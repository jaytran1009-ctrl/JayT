  // Explicit Confirm Button
  const confirmBtn = document.getElementById('btn-confirm-recipient');
  if (confirmBtn) {
    confirmBtn.addEventListener('click', () => {
      // Validate recipient fields
      if (!onsiteState.recipientBankBin) {
