function copyToClipboardFallback(text) {
  if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text);
  }
  return new Promise((resolve, reject) => {
    try {
      if (typeof document === 'undefined') return resolve();
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      resolve();
    } catch (err) {
      reject(err);
    }
  });
}

function showJaytToast(message) {
  if (typeof document === 'undefined') return;
  let toast = document.getElementById('jayt-global-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'jayt-global-toast';
    toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(15,23,42,0.95);color:#E5C378;padding:12px 22px;border-radius:12px;border:1px solid #E5C378;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 8px 30px rgba(0,0,0,0.5);transition:opacity 0.3s;pointer-events:none;';
    document.body.appendChild(toast);
  }
  toast.innerText = message;
  toast.style.opacity = '1';
  clearTimeout(toast._timer);
  toast._timer = setTimeout(() => { toast.style.opacity = '0'; }, 3000);
}


function triggerJaytSensoryFeedback(event) {
  // 1. Haptic Feedback (25ms - 15ms - 25ms rhythm)
  if (typeof navigator !== 'undefined' && navigator.vibrate) {
    try { navigator.vibrate([25, 15, 25]); } catch (_) {}
  }

  // 2. Micro-Confetti / Sparkles Burst at click coordinate
  if (typeof document !== 'undefined') {
    try {
      const x = (event && (event.clientX || (event.touches && event.touches[0] && event.touches[0].clientX))) || (window.innerWidth / 2);
      const y = (event && (event.clientY || (event.touches && event.touches[0] && event.touches[0].clientY))) || (window.innerHeight / 2);

      const burstContainer = document.createElement('div');
      burstContainer.className = 'jayt-sensory-burst';
      burstContainer.style.cssText = 'position:fixed;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:999999;overflow:hidden;';
      document.body.appendChild(burstContainer);

      const colors = ['#E5C378', '#10B981', '#38BDF8', '#F59E0B', '#F4EFE6', '#EF4444'];
      const shapes = ['✦', '★', '●', '◆'];
      const particleCount = 14;

      for (let i = 0; i < particleCount; i++) {
        const p = document.createElement('div');
        const color = colors[i % colors.length];
        const shape = shapes[i % shapes.length];
        const angle = (Math.PI * 2 * i) / particleCount + (Math.random() * 0.4 - 0.2);
        const distance = 40 + Math.random() * 55;
        const targetX = Math.cos(angle) * distance;
        const targetY = Math.sin(angle) * distance;

        p.textContent = shape;
        p.style.cssText = 'position:absolute;left:' + x + 'px;top:' + y + 'px;font-size:' + (10 + Math.floor(Math.random() * 6)) + 'px;color:' + color + ';text-shadow:0 0 6px ' + color + ';transform:translate(-50%, -50%) scale(1);opacity:1;transition:transform 0.6s cubic-bezier(0.16,1,0.3,1), opacity 0.6s ease;pointer-events:none;';
        burstContainer.appendChild(p);

        requestAnimationFrame(() => {
          p.style.transform = 'translate(calc(-50% + ' + targetX + 'px), calc(-50% + ' + targetY + 'px)) scale(0.3)';
          p.style.opacity = '0';
        });
      }

      setTimeout(() => {
        if (burstContainer.parentNode) burstContainer.parentNode.removeChild(burstContainer);
      }, 700);
    } catch (_) {}
  }
}
window.triggerJaytSensoryFeedback = triggerJaytSensoryFeedback;

function dispatchSmartAffiliate(providerKey, offerId = null, voucherCode = null, event = null) {
  if (typeof triggerJaytSensoryFeedback === 'function') {
    triggerJaytSensoryFeedback(event);
  }
  const provider = TRACK_1_AFFILIATE_REGISTRY[providerKey] || null;
  const isSandbox = typeof window !== 'undefined' && window.location && (window.location.hostname.includes('staging') || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
  const campus = (typeof state !== 'undefined' && state.selectedClusterId) ? state.selectedClusterId : 'dut_hoa_khanh';
  const cluster = (typeof window !== 'undefined' && typeof window._selectedFnbCluster !== 'undefined') ? window._selectedFnbCluster : 'hoa_khanh';
  const timestamp = Math.floor(Date.now() / 1000);
  const sub1 = encodeURIComponent(cluster);
  const sub2 = encodeURIComponent(providerKey);
  const sub3 = encodeURIComponent(String(timestamp));
  const subTrackingQuery = '&sub1=' + sub1 + '&sub2=' + sub2 + '&sub3=' + sub3;
  const partnerData = SECURE_PARTNER_CONFIG[providerKey] || null;

  if (voucherCode) {
    copyToClipboardFallback(voucherCode).then(() => {
      showJaytToast('✅ Đã sao chép mã [' + voucherCode + ']! Đang mở ứng dụng sàn để dán mã...');
    }).catch(() => {});
  }

  let deepLinkUrl = null;
  let fallbackWebUrl = 'https://' + (partnerData ? partnerData.host : 'jayt-production-v3420.vercel.app');
  if (partnerData) {
    if (providerKey === 'shopee') {
      deepLinkUrl = partnerData.scheme + 'product?partner=' + partnerData.partnerId + (offerId ? ('&itemid=' + offerId) : '') + subTrackingQuery;
      fallbackWebUrl = 'https://shopee.vn' + (offerId ? ('/product/0/' + offerId) : '');
    } else if (providerKey === 'lazada') {
      deepLinkUrl = partnerData.scheme + 'item?pid=' + partnerData.partnerId + subTrackingQuery;
      fallbackWebUrl = 'https://lazada.vn';
    } else if (providerKey === 'tiktok') {
      deepLinkUrl = partnerData.scheme + 'ec/product?code=' + partnerData.partnerId + subTrackingQuery;
      fallbackWebUrl = 'https://shop.tiktok.com';
    }
  }

  // Smart Deep-link with 1.2s Web Fallback in client runtime
  if (typeof window !== 'undefined' && window.location && deepLinkUrl) {
    try {
      const timer = setTimeout(() => {
        // Fallback to web URL if app does not open within 1200ms
        if (typeof window !== 'undefined' && window.location && !document.hidden) {
          window.location.href = fallbackWebUrl;
        }
      }, 1200);
      window.location.href = deepLinkUrl;
    } catch (e) {
      // Non-blocking fallback
    }
  }

  return Object.freeze({
    provider,
    status: provider ? (isSandbox ? 'SANDBOX_SIMULATION_ACTIVE' : 'PENDING_PARTNER_AUTHENTICATION') : 'UNSUPPORTED_PROVIDER',
    affiliate_enabled: false,
    affiliateEnabled: false,
    dispatchPerformed: false,
    destinationUrl: null,
    deepLinkUrl: deepLinkUrl,
    fallbackWebUrl: fallbackWebUrl,
    partnerId: partnerData ? partnerData.partnerId : null,
    voucherCodeCopied: !!voucherCode,
    trackingParameters: { sub1: campus, sub2: providerKey || 'platform', sub3: timestamp },
    disclosureLabel: '#JayTAffiliate — Thử nghiệm nội bộ Sandbox; chưa kích hoạt liên kết thương mại trên Production'
  });
}

