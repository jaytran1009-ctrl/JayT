      mask-image: linear-gradient(to right, black 0%, black calc(100% - 32px), transparent 100%) !important;
      -webkit-mask-image: linear-gradient(to right, black 0%, black calc(100% - 32px), transparent 100%) !important;
    }

    /* 4. Cinema Weekly Schedule Hierarchy */
    .j434-schedule-list li {
      font-size: 13.5px !important;
