      }
    }

    /* 3. Cinema Power Hub: 2/3 Tickets + 1/3 Quick Schedule */
    @media(min-width: 900px){
      .j434-cinema-layout{
        display: grid !important;
        grid-template-columns: 2fr 1fr !important;
        gap: 16px !important;
        align-items: stretch !important;
      }
      .j434-cinema-tickets-col{
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 16px !important;
      }
      .j434-cinema-tickets-col .j427-ticket-card{
        width: 100% !important;
        min-height: 220px !important;
        margin: 0 !important;
      }
      .j434-cinema-quick-schedule{
        background: #FFFDF8 !important;
        border: 1.5px solid rgba(126, 91, 29, 0.22) !important;
        border-radius: 16px !important;
        padding: 22px 24px !important;
        box-shadow: 0 8px 24px rgba(74, 54, 22, 0.06) !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
      }
      body.theme-dark .j434-cinema-quick-schedule{
        background: linear-gradient(145deg, rgba(25, 38, 29, 0.92), rgba(9, 15, 11, 0.88)) !important;
        border: 1px solid rgba(197, 168, 128, 0.25) !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3) !important;
      }
    }
    @media(max-width: 899px){
      .j434-cinema-layout{
        display: flex !important;
        flex-direction: column !important;
        gap: 14px !important;
      }
      .j434-cinema-tickets-col{
        display: flex !important;
        gap: 12px !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
      }
      .j434-cinema-tickets-col .j427-ticket-card{
        flex: 0 0 82vw !important;
        max-width: 320px !important;
        scroll-snap-align: start !important;
      }
      .j434-cinema-quick-schedule{
        background: #FFFDF8 !important;
        border: 1.5px solid rgba(126, 91, 29, 0.22) !important;
        border-radius: 16px !important;
        padding: 18px 20px !important;
      }
      body.theme-dark .j434-cinema-quick-schedule{
        background: linear-gradient(145deg, rgba(25, 38, 29, 0.92), rgba(9, 15, 11, 0.88)) !important;
        border: 1px solid rgba(197, 168, 128, 0.25) !important;
      }
    }
    .j434-schedule-header{
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 14px;
    }
    .j434-schedule-badge{
      font-size: 12px;
      font-weight: 750;
      letter-spacing: 0.08em;
      color: #A07828;
    }
    body.theme-dark .j434-schedule-badge{
      color: #E5C378;
    }
    .j434-schedule-sub{
      font-size: 13px;
      color: #6E6253;
    }
    body.theme-dark .j434-schedule-sub{
      color: #A2B1A6;
    }
    .j434-schedule-list{
      list-style: none;
      padding: 0;
      margin: 0 0 16px 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .j434-schedule-list li{
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 13.5px;
      line-height: 1.45;
      color: #383024;
    }
    body.theme-dark .j434-schedule-list li{
      color: #E6DFD1;
    }
    .j434-dot{
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #B98A36;
      margin-top: 6px;
      flex-shrink: 0;
    }
    .j434-schedule-btn{
      background: rgba(255, 253, 248, 0.9) !important;
      border: 1.5px solid rgba(126, 91, 29, 0.32) !important;
      color: #6B4A18 !important;
      border-radius: 12px !important;
      padding: 10px 16px !important;
      font-size: 13.5px !important;
      font-weight: 650 !important;
      cursor: pointer !important;
      transition: all .18s ease !important;
      width: 100% !important;
      text-align: center !important;
    }
    body.theme-dark .j434-schedule-btn{
      background: rgba(20, 30, 23, 0.6) !important;
      border-color: rgba(197, 168, 128, 0.3) !important;
      color: #E5C378 !important;
    }
    .j434-schedule-btn:hover{
      background: #FFFDF8 !important;
      color: #21170A !important;
      border-color: #B98A36 !important;
    }
    body.theme-dark .j434-schedule-btn:hover{
      background: rgba(30, 45, 35, 0.8) !important;
      color: #FFFFFF !important;
    }

    /* 4. F&B 4 Wide Cards Layout */
    @media(min-width: 1024px){
      .j408-brand-card{
        flex: 0 0 calc((100% - (3 * 16px)) / 4) !important;
        min-width: 285px !important;
        max-width: 325px !important;
        min-height: 220px !important;
        padding: 20px 22px !important;
      }
      .j408-brand-place{
        white-space: normal !important;
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        overflow: hidden !important;
        line-height: 1.4 !important;
        min-height: 34px !important;
      }
    }

    /* 5. Full-Bleed Editorial Band for Lunch Arbitrage & Height Reduction */
    #lunch-arbitrage-module{
      width: 100vw !important;
      margin-left: calc(50% - 50vw) !important;
      margin-right: calc(50% - 50vw) !important;
      max-width: 100vw !important;
      padding: clamp(38px, 4.5vw, 56px) 0 !important;
      box-sizing: border-box !important;
      border-top: 1px solid rgba(126, 91, 29, 0.18) !important;
      border-bottom: 1px solid rgba(126, 91, 29, 0.18) !important;
    }
    body.theme-light #lunch-arbitrage-module{
      background: #F3EDE2 !important; /* Linen ngà cao cấp */
    }
    body.theme-dark #lunch-arbitrage-module{
      background: #0E1612 !important; /* Royal forest charcoal */
      border-top-color: rgba(197, 168, 128, 0.15) !important;
      border-bottom-color: rgba(197, 168, 128, 0.15) !important;
    }
    #lunch-arbitrage-module > .container{
      width: min(calc(100% - (var(--j430-gutter) * 2)), 1300px) !important;
      margin-inline: auto !important;
      padding: 0 !important;
    }
    #lunch-arbitrage-module .bento-card{
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }
    @media(min-width: 900px){
      #lunch-arbitrage-module .arbitrage-grid{
        display: flex !important;
        flex-direction: column !important;
        gap: 22px !important;
      }
      #lunch-arbitrage-module .calc-control-panel{
        display: grid !important;
        grid-template-columns: 1.15fr 0.85fr !important;
        gap: 28px !important;
        align-items: center !important;
        background: #FFFDF8 !important;
        border: 1.5px solid rgba(126, 91, 29, 0.2) !important;
        border-radius: 18px !important;
        padding: 22px 28px !important;
        box-shadow: 0 8px 24px rgba(74, 54, 22, 0.05) !important;
      }
      body.theme-dark #lunch-arbitrage-module .calc-control-panel{
        background: rgba(22, 34, 26, 0.7) !important;
        border-color: rgba(197, 168, 128, 0.2) !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
      }
      #lunch-arbitrage-module .arbitrage-comparison-cards{
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 18px !important;
      }
      #lunch-arbitrage-module .app-calc-card{
        background: #FFFDF8 !important;
        border: 1.5px solid rgba(126, 91, 29, 0.2) !important;
        border-radius: 18px !important;
        padding: 22px !important;
        box-shadow: 0 8px 24px rgba(74, 54, 22, 0.05) !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
      }
      body.theme-dark #lunch-arbitrage-module .app-calc-card{
        background: rgba(22, 34, 26, 0.7) !important;
        border-color: rgba(197, 168, 128, 0.2) !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
      }
    }
  </style>`;
}

function renderJ433MasterStyles() {
  return `<style id="j433-master-styles">
    /* 1. Desktop 1300px Content Framework */
    :root{
      --j430-content: 1300px !important;
      --j430-section: clamp(18px, 2.5vw, 28px) !important;
      --j430-gutter: clamp(16px, 2.8vw, 32px) !important;
    }
    .j406-concierge,
    #campus-dock-section>.container,
    #deals-vault-module>.container,
    #lunch-arbitrage-module>.container,
    #split-bill-module>.container{
      width: min(calc(100% - (var(--j430-gutter) * 2)), 1300px) !important;
      margin-inline: auto !important;
    }
    .main-content{padding-bottom:clamp(52px, 6vw, 84px)!important}
    .j406-section{margin-top:clamp(18px, 2.4vw, 28px)!important}
    .j406-terminal{margin-top:clamp(18px, 2.4vw, 28px)!important}
    #campus-dock-section{margin-top:clamp(20px, 2.5vw, 28px)!important}
    #deals-vault-module, #lunch-arbitrage-module, #split-bill-module{margin-top:clamp(20px, 2.5vw, 28px)!important}
    #deals-vault-module>.container, #lunch-arbitrage-module>.container, #split-bill-module>.container{
      padding:clamp(22px, 2.8vw, 36px)!important;
    }

    /* 2. Hero Desktop Scale Expansion (10-12%) */
    @media(min-width: 1024px){
      .j406-hero{
        min-height:590px!important;
        padding:52px 48px!important;
        background:linear-gradient(90deg, rgba(7,13,9,.96) 0%, rgba(7,13,9,.88) 40%, rgba(7,13,9,.24) 58%, transparent 74%), url('/assets/images/dragon_bridge_hero_sunset_fire.jpg') center right/cover no-repeat!important;
      }
      .j411-radar{width:48%!important;max-width:560px!important}
      .j411-radar .j406-title{max-width:540px!important;font-size:40px!important;line-height:1.12!important}
      .j406-kicker{font-size:13px!important;letter-spacing:.15em!important}
      .j406-copy{font-size:16px!important;line-height:1.5!important;max-width:520px!important}
      .j425-dayparts{gap:4px!important;margin:14px 0 6px!important}
      .j425-dayparts button{font-size:13.5px!important;padding:7px 14px!important}
      .j411-quick-grid{gap:10px!important;margin-top:24px!important}
    }

    /* 3. Balanced 40/60 Lunch Arbitrage Grid */
    @media(min-width: 900px){
      .arbitrage-grid{
        display:grid!important;
        grid-template-columns: 4fr 6fr !important;
        gap:clamp(22px, 2.5vw, 34px)!important;
        align-items:start!important;
      }
      .calc-control-panel{
        padding:26px!important;
      }
      .arbitrage-comparison-cards{
        display:flex!important;
        flex-direction:column!important;
        gap:14px!important;
      }
    }

    /* 4. Desktop Typography Scaling */
    .section-desc, .j406-copy, #deals-section-dynamic-desc{
      font-size:15px!important;line-height:1.55!important;
    }
    .input-field-group label, .split-input-field label{
      font-size:14.5px!important;font-weight:650!important;line-height:1.4!important;
    }
    .split-input, #j406-link-input, .calc-input{
      font-size:15px!important;min-height:46px!important;
    }

    /* 5. Three-Tier CTA Architecture */
    /* Tier 1: Gold Filled Primary CTA */
    .btn-cta-primary,
    .j411-quick-grid button:first-child,
    .j406-terminal>button,
    #btn-download-split-png,
    .btn-feed-mode.is-active,
    .btn-ecosystem-tab.is-active,
    .btn-cinema-day.is-active{
      background:linear-gradient(135deg, #E5C378, #B98A36)!important;
      color:#21170A!important;
      border:0!important;
      font-weight:750!important;
      box-shadow:0 4px 18px rgba(229,195,120,0.28)!important;
      min-height:46px;
      cursor:pointer;
      transition:transform .18s ease, filter .18s ease, box-shadow .18s ease!important;
    }
    .btn-cta-primary:hover,
    .j411-quick-grid button:first-child:hover,
    .j406-terminal>button:hover,
    #btn-download-split-png:hover{
      filter:brightness(1.08)!important;
      transform:translateY(-1px)!important;
      box-shadow:0 6px 22px rgba(229,195,120,0.38)!important;
    }

    /* Tier 2: Champagne Outline Secondary CTA / Shortcuts */
    .btn-cta-secondary,
    .j411-quick-grid button:not(:first-child),
    .j427-ticket-card button,
    #btn-copy-split-text,
    .j406-hint,
    .btn-feed-mode:not(.is-active),
    .btn-ecosystem-tab:not(.is-active),
    .btn-cinema-day:not(.is-active){
      background:rgba(255, 253, 248, 0.9)!important;
      border:1.5px solid rgba(126, 91, 29, 0.32)!important;
      color:#6B4A18!important;
      font-weight:650!important;
      box-shadow:0 2px 6px rgba(74, 54, 22, 0.04)!important;
      cursor:pointer;
      transition:all .18s ease!important;
    }
    body.theme-dark .j411-quick-grid button:not(:first-child),
    body.theme-dark .j427-ticket-card button,
    body.theme-dark #btn-copy-split-text,
    body.theme-dark .j406-hint,
    body.theme-dark .btn-feed-mode:not(.is-active),
    body.theme-dark .btn-ecosystem-tab:not(.is-active),
    body.theme-dark .btn-cinema-day:not(.is-active){
      background:rgba(14, 22, 17, 0.6)!important;
      border:1px solid rgba(197, 168, 128, 0.35)!important;
      color:#E6DFD1!important;
    }
    .j411-quick-grid button:not(:first-child):hover,
    .j427-ticket-card button:hover,
    #btn-copy-split-text:hover,
    .j406-hint:hover{
      border-color:#8F6218!important;
      background:#FFFFFF!important;
      color:#21170A!important;
      transform:translateY(-1px)!important;
    }
    body.theme-dark .j411-quick-grid button:not(:first-child):hover,
    body.theme-dark .j427-ticket-card button:hover,
    body.theme-dark #btn-copy-split-text:hover,
    body.theme-dark .j406-hint:hover{
      border-color:rgba(197, 168, 128, 0.65)!important;
      background:rgba(25, 38, 29, 0.85)!important;
      color:#FFFFFF!important;
      transform:translateY(-1px)!important;
    }

    /* Tier 3: Tertiary Context Action / Text-Link Style */
    .j408-brand-card button,
    #btn-share-split-native{
      background:transparent!important;
      border:0!important;
      color:#7A5418!important;
      font-weight:650!important;
      padding:6px 12px!important;
      font-size:13.5px!important;
      cursor:pointer;
      transition:all .18s ease!important;
      margin-top:auto!important;
    }
    body.theme-dark .j408-brand-card button,
    body.theme-dark #btn-share-split-native{
      color:#D8B27E!important;
    }
    .j408-brand-card button:hover,
    #btn-share-split-native:hover{
      color:#21170A!important;
      background:rgba(126, 91, 29, 0.08)!important;
      border-radius:8px!important;
      text-decoration:underline!important;
    }
    body.theme-dark .j408-brand-card button:hover,
    body.theme-dark #btn-share-split-native:hover{
      color:#FFFFFF!important;
      background:rgba(197, 168, 128, 0.1)!important;
      border-radius:8px!important;
      text-decoration:underline!important;
    }

    /* 6. Editorial Scroll Cues */
    .j406-head{align-items:center!important;display:flex!important;justify-content:space-between!important;gap:14px!important;margin-bottom:14px!important}
    .j406-head>span, .j406-scroll-cue{
      display:inline-flex!important;align-items:center!important;gap:6px!important;
      padding:5px 13px!important;border-radius:999px!important;
      font-size:12.5px!important;font-weight:650!important;letter-spacing:.02em!important;
      text-transform:none!important;line-height:1.2!important;white-space:nowrap!important;
      transition:all .2s ease!important;
    }
    body.theme-dark .j406-head>span, body.theme-dark .j406-scroll-cue{
      background:rgba(197,168,128,.12)!important;border:1px solid rgba(197,168,128,.28)!important;color:#E5C378!important;
    }
    body.theme-light .j406-head>span, body.theme-light .j406-scroll-cue{
      background:rgba(126,91,29,.08)!important;border:1px solid rgba(126,91,29,.24)!important;color:#7A5418!important;
    }

    /* 7. Ticket Cards Light Mode Contrast */
    body.theme-light .j427-ticket-card .j406-kicker{
      color:#7A5418!important;font-weight:750!important;letter-spacing:.12em!important;
    }
    body.theme-light .j427-ticket-card strong{
      color:#201C16!important;font-weight:800!important;
    }
    body.theme-light .j427-ticket-card p{
      color:#554A3C!important;border-top:1px dashed rgba(126,91,29,.22)!important;
    }

    /* 8. Campus Ribbon High Contrast (#6B4A18) */
    body.theme-light .j410-local-ribbon{
      background:rgba(255,253,248,.75)!important;
      border-block:1px solid rgba(126,91,29,.24)!important;
      margin-top:clamp(20px,2.8vw,32px)!important;
    }
    body.theme-light .j410-local-ribbon span{
      color:#6B4A18!important;font-weight:650!important;font-size:13.5px!important;letter-spacing:.02em!important;
    }
    body.theme-light .j410-local-ribbon span+span{
      border-left:1px solid rgba(126,91,29,.2)!important;
    }

    /* 9. Unified F&B Brand Cards (.j408-brand-card) */
    body.theme-light .j408-brand-card{
      min-height:204px!important;height:100%!important;
      background:#FFFDF8!important;border:1.5px solid rgba(126,91,29,.22)!important;border-radius:16px!important;
      box-shadow:0 8px 24px rgba(74,54,22,.06)!important;
    }
    body.theme-light .j408-brand-card:hover{
      transform:translateY(-3px);border-color:rgba(154,107,24,.45)!important;box-shadow:0 16px 36px rgba(74,54,22,.12)!important;
    }
    body.theme-light .j408-brand-card .j408-brand-name{
      color:#201C16!important;font-size:16px!important;font-weight:750!important;
    }
    body.theme-light .j408-brand-card .j408-brand-place{
      color:#746B5C!important;font-size:13.5px!important;font-weight:550!important;
    }

    /* 10. Pristine KTX Terminal Surface (#FFFDF8) */
    body.theme-light .j406-terminal{
      background:#FFFDF8!important;
      border:1.5px solid rgba(126,91,29,.22)!important;
      box-shadow:0 16px 40px rgba(74,54,22,.07)!important;
    }
    body.theme-light .j406-terminal>h2{
      color:#201C16!important;font-weight:700!important;
    }
    body.theme-light .j406-terminal>.j406-copy{
      color:#554A3C!important;font-size:15px!important;line-height:1.55!important;
    }
    body.theme-light #j406-link-output{
      background:rgba(250,246,237,.95)!important;border:1px solid rgba(126,91,29,.22)!important;color:#554A3C!important;
    }

    /* 11. Purge Nested Dark Bento Panels in Lower Modules */
    body.theme-light #lunch-arbitrage-module .bento-card,
    body.theme-light #split-bill-module .bento-card{
      background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;
    }

    /* 12. Lịch Rạp 7 Ngày (Daylight Editorial Table) */
    body.theme-light #cinema-schedule-container{
      background:#FFFDF8!important;border:1.5px solid rgba(126,91,29,.22)!important;
      box-shadow:0 12px 32px rgba(74,54,22,.06)!important;border-radius:16px!important;
      margin-top:14px!important;
    }
    body.theme-light .cinema-schedule-block{
      background:transparent!important;border:0!important;padding:0!important;
    }
    body.theme-light .cinema-day-details{
      background:rgba(126,91,29,.04)!important;border:1px solid rgba(126,91,29,.16)!important;color:#201C16!important;border-radius:12px!important;
    }

    /* 13. Bàn Tính Bữa Trưa (Daylight Comparison Panel) */
    body.theme-light #lunch-arbitrage-module .calc-control-panel{
      background:#FFFDF8!important;border:1.5px solid rgba(126,91,29,.22)!important;border-radius:16px!important;
      box-shadow:0 8px 24px rgba(74,54,22,.05)!important;
    }
    body.theme-light #lunch-arbitrage-module .app-calc-card{
      background:#FFFDF8!important;border:1.5px solid rgba(126,91,29,.22)!important;border-radius:14px!important;
      padding:18px!important;box-shadow:0 8px 24px rgba(74,54,22,.05)!important;
    }
    body.theme-light #lunch-arbitrage-module .app-calc-total{
      color:#201C16!important;font-size:24px!important;font-weight:800!important;
    }
    body.theme-light #lunch-arbitrage-module .app-calc-breakdown{
      color:#6E6253!important;font-size:12.5px!important;
    }

    /* 14. Chia Bill VietQR (Luminous Form + Forest Velvet Result Highlight) */
    body.theme-light #split-bill-module .split-controls{
      background:#FFFDF8!important;border:1.5px solid rgba(126,91,29,.22)!important;border-radius:16px!important;
      padding:22px!important;box-shadow:0 8px 24px rgba(74,54,22,.05)!important;
    }
    body.theme-light #split-bill-module .split-result-panel{
      background:linear-gradient(145deg,#1C2B22,#0E1612)!important;
      border:1.5px solid rgba(212,175,55,.35)!important;
      color:#F5EFE6!important;
      box-shadow:0 18px 48px rgba(0,0,0,.2)!important;
      border-radius:16px!important;
      padding:24px!important;
    }
    body.theme-light #split-bill-module .split-breakdown-box{
      background:rgba(255,255,255,.07)!important;border:1px solid rgba(212,175,55,.25)!important;color:#F5EFE6!important;
    }
    body.theme-light #split-bill-module .split-result-panel .higher-share-amount,
    body.theme-light #split-bill-module .split-result-panel .share-amount{
      color:#E5C378!important;text-shadow:0 2px 10px rgba(0,0,0,.3)!important;
    }

    /* 15. Standardized Single Form System (#C9B58D Border) */
    body.theme-light input,
    body.theme-light select,
    body.theme-light textarea,
    body.theme-light .split-input,
    body.theme-light #j406-link-input,
    body.theme-light .calc-input{
      background:#FFFDF8!important;
      border:1.5px solid #C9B58D!important;
      border-radius:11px!important;
      color:#201C16!important;
      box-shadow:0 1px 3px rgba(74,54,22,.04)!important;
      font-size:14.5px!important;
      transition:border-color .18s ease,box-shadow .18s ease,background-color .18s ease!important;
    }
    body.theme-light input:hover,
    body.theme-light select:hover,
    body.theme-light textarea:hover,
    body.theme-light .split-input:hover,
    body.theme-light #j406-link-input:hover,
    body.theme-light .calc-input:hover{
      border-color:#A07828!important;background:#FFFFFF!important;
      box-shadow:0 2px 8px rgba(74,54,22,.08)!important;
    }
    body.theme-light input:focus,
    body.theme-light select:focus,
    body.theme-light textarea:focus,
    body.theme-light .split-input:focus,
    body.theme-light #j406-link-input:focus,
    body.theme-light .calc-input:focus{
      border-color:#8F6218!important;background:#FFFFFF!important;
      box-shadow:0 0 0 3px rgba(143,98,24,.22),0 2px 10px rgba(74,54,22,.1)!important;
      outline:none!important;
    }
    body.theme-light .calc-slider{accent-color:#8F6218!important}
    body.theme-light .bridge-btn{
      background:rgba(255,253,248,.88)!important;border:1.5px solid #C9B58D!important;color:#554A3C!important;
      transition:all .18s ease!important;
    }
    body.theme-light .bridge-btn:hover{
      border-color:#A07828!important;color:#21170A!important;
    }
    body.theme-light .bridge-btn.active{
      background:linear-gradient(135deg,#D9B86C,#B98932)!important;color:#21170A!important;font-weight:700!important;border-color:transparent!important;
    }
    body.theme-light .disclaimer-note{
      background:rgba(126,91,29,.05)!important;border:1px dashed rgba(126,91,29,.25)!important;color:#5C4F40!important;
    }

    /* 16. Bottom Dock Elevation (+15% depth) */
    body.theme-light #counter-quick-dock{
      background:rgba(252,249,243,.98)!important;
      border-top:1.5px solid rgba(126,91,29,.35)!important;
      box-shadow:0 -14px 34px rgba(74,54,22,.15),0 -2px 6px rgba(74,54,22,.08)!important;
      backdrop-filter:blur(20px)!important;
    }
    body.theme-light #counter-quick-dock .counter-dock-btn,
    body.theme-light #counter-quick-dock .dock-icon,
    body.theme-light #counter-quick-dock .counter-dock-btn span:last-child{
      color:#795315!important;
    }
    body.theme-light #counter-quick-dock .counter-dock-btn:hover{
      background:rgba(126,91,29,.06)!important;
    }

    /* 17. Headings & Typography Colors */
    body.theme-light .section-title,
    body.theme-light .section-header h2{color:#201C16!important}
    body.theme-light .j406-kicker{color:#7A5418!important}

    @media(max-width:760px){
      .j406-head>span, .j406-scroll-cue{padding:4px 10px!important;font-size:11.5px!important}
      .j410-local-ribbon{grid-template-columns:1fr!important}
      .j410-local-ribbon span+span{border-left:0!important;border-top:1px solid rgba(126,91,29,.2)!important}
      body.theme-light #lunch-arbitrage-module .calc-control-panel,
      body.theme-light #split-bill-module .split-controls,
      body.theme-light #split-bill-module .split-result-panel{padding:18px!important}
    }
  </style>`;
}

function renderJ430UnifiedSystemStyles() {
  return `<style id="j430-unified-system-styles">
    :root{
      --j430-content:1180px;--j430-gutter:clamp(16px,3vw,28px);--j430-section:clamp(30px,5vw,56px);
      --j430-radius-lg:24px;--j430-radius-md:16px;--j430-focus:#E5C378;
      --j430-serif:'Playfair Display',Georgia,serif;--j430-sans:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;
    }
    html{scroll-behavior:smooth}
    body{font-family:var(--j430-sans)!important;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}
    .main-content{padding-bottom:clamp(64px,8vw,108px)!important}
    .j406-concierge,#campus-dock-section>.container,#deals-vault-module>.container,#lunch-arbitrage-module>.container,#split-bill-module>.container{
      width:min(calc(100% - (var(--j430-gutter) * 2)),var(--j430-content))!important;margin-inline:auto!important;
    }
    .j406-concierge{padding-inline:0!important}
    .j406-head{align-items:end!important;margin-bottom:18px!important}
    .j406-head h2,#deals-heading,#title-lunch-module,#title-split-module{
      font-family:var(--j430-serif)!important;font-size:clamp(27px,3vw,42px)!important;line-height:1.08!important;letter-spacing:-.025em!important;font-weight:650!important;
    }
    .j406-head>span{font-size:12px!important;letter-spacing:.08em!important;text-transform:uppercase!important}
    .j406-section{margin-top:var(--j430-section)!important;padding-top:0!important}
    .j406-hero+.j406-section{margin-top:20px!important}
    .j406-horizon{gap:14px!important;padding:2px 2px 14px!important;scroll-padding-inline:2px;scroll-snap-type:x mandatory}
    .j406-horizon>.j406-card{scroll-snap-align:start;min-height:190px!important;padding:22px!important;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
    .j406-horizon>.j406-card:hover{transform:translateY(-3px);border-color:rgba(229,195,120,.5)!important;box-shadow:0 22px 52px rgba(0,0,0,.28)!important}
    .j408-brand-card{min-width:214px!important;justify-content:flex-start!important}
    .j408-brand-card button{margin-top:auto!important}
    .j406-terminal{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:10px!important;align-items:end!important;padding:24px!important;border:1px solid rgba(197,168,128,.2)!important;border-radius:var(--j430-radius-lg)!important;background:linear-gradient(145deg,rgba(30,43,36,.34),rgba(7,12,10,.16))!important}
    .j406-terminal>h2,.j406-terminal>.j406-copy,.j406-terminal>.j406-hint-row,.j406-terminal>.j406-terminal-output{grid-column:1/-1}
    .j406-terminal>h2{font-family:var(--j430-serif)!important;font-size:clamp(27px,3vw,40px)!important;margin:0!important}
    #j406-link-input{min-height:48px!important;border-radius:12px!important;padding-inline:14px!important}
    .j406-terminal>button{min-height:48px!important;padding:0 20px!important;border-radius:12px!important;background:linear-gradient(135deg,#E5C378,#B98A36)!important;color:#21170A!important;font-weight:750!important;border:0!important}
    #campus-dock-section{margin-top:var(--j430-section)!important}
    #campus-dock-section .campus-dock-toolbar{gap:8px!important;overflow-x:auto!important;scrollbar-width:none;padding-block:4px!important}
    #deals-vault-module,#lunch-arbitrage-module,#split-bill-module{margin-top:var(--j430-section)!important;padding:0!important;border:0!important}
    #deals-vault-module>.container,#lunch-arbitrage-module>.container,#split-bill-module>.container{
      position:relative;padding:clamp(22px,3.5vw,40px)!important;border-radius:var(--j430-radius-lg)!important;overflow:hidden;
    }
    #deals-vault-module>.container::before,#lunch-arbitrage-module>.container::before,#split-bill-module>.container::before{
      content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,transparent,#D4AF37 25%,rgba(229,195,120,.25) 70%,transparent);pointer-events:none;
    }
    body.theme-dark #deals-vault-module>.container,body.theme-dark #lunch-arbitrage-module>.container,body.theme-dark #split-bill-module>.container{
      background:linear-gradient(145deg,rgba(28,42,33,.82),rgba(8,14,10,.9))!important;border:1px solid rgba(212,175,55,.17)!important;box-shadow:0 24px 70px rgba(0,0,0,.25)!important;
    }
    body.theme-light #deals-vault-module>.container,body.theme-light #lunch-arbitrage-module>.container,body.theme-light #split-bill-module>.container{
      background:linear-gradient(145deg,rgba(255,253,248,.98),rgba(239,231,216,.92))!important;border:1px solid rgba(126,91,29,.2)!important;box-shadow:0 24px 58px rgba(74,54,22,.09)!important;
    }
    #cinema-schedule-container{margin-top:22px!important;padding:20px!important}
    #lunch-arbitrage-module input,#split-bill-module input,#split-bill-module textarea{min-height:46px!important;border-radius:11px!important;padding-inline:12px!important}
    #lunch-arbitrage-module button,#split-bill-module button,#deals-vault-module button{min-height:42px;border-radius:11px;transition:transform .18s ease,filter .18s ease}
    #lunch-arbitrage-module button:hover,#split-bill-module button:hover,#deals-vault-module button:hover{filter:brightness(1.06);transform:translateY(-1px)}
    button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{
      outline:3px solid color-mix(in srgb,var(--j430-focus) 72%,transparent)!important;outline-offset:3px!important;
    }
    .theme-toggle-btn{transition:transform .24s ease,background-color .24s ease!important}
    .theme-toggle-btn:hover{transform:rotate(8deg) scale(1.04)}
    @media(max-width:760px){
      :root{--j430-section:30px;--j430-gutter:14px}
      .j406-head{margin-bottom:14px!important}.j406-head h2,#deals-heading,#title-lunch-module,#title-split-module{font-size:27px!important}
      .j406-horizon>.j406-card{min-height:174px!important;padding:18px!important}
      .j408-brand-card{min-width:76vw!important}
      .j406-terminal{grid-template-columns:1fr!important;padding:20px!important}.j406-terminal>*{grid-column:1!important}.j406-terminal>button{width:100%}
      #deals-vault-module>.container,#lunch-arbitrage-module>.container,#split-bill-module>.container{padding:20px 16px!important;border-radius:19px!important}
      #cinema-schedule-container{padding:16px!important}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.j406-horizon>.j406-card,.theme-toggle-btn,button{transition:none!important}}
  </style>`;
}

let J465_MONOLITHIC_STYLESHEET = '';

function renderJ465MonolithicStyles() {
  if (J465_MONOLITHIC_STYLESHEET) return J465_MONOLITHIC_STYLESHEET;
  const legacyLayers = [
    renderCashierHudStyles(), renderJ403LuxuryStyles(), renderJ405PinnacleStyles(),
    renderJ406ConciergeStyles(), renderJ408CraftStyles(), renderJ410DanangStyles(),
    renderJ411Styles(), renderJ421Styles(), renderJ428Styles(), renderJ429LightStyles(),
    renderJ430UnifiedSystemStyles(), renderJ433MasterStyles(), renderJ434MasterStyles(),
    renderJ435RefinedStyles(), renderJ436PinnaclePolishStyles(), renderJ437UltimateStyles(),
    renderJ438MasterPolishStyles(), renderJ439DesignFreezeStyles(),
    renderJ440QuietLuxuryStyles(), renderJ441LightEditorialStyles()
  ];
  const css = legacyLayers.map((layer) => String(layer)
    .replace(/^\s*<style[^>]*>/i, '')
    .replace(/<\/style>\s*$/i, '')).join('\n');

  J465_MONOLITHIC_STYLESHEET = `<style id="j465-monolithic-production-styles">${css}
    /* J445 master cleanup: final, documented surface contract. */
    #main-content > * { display:block; }
    #dorm-shopping-module { display:block!important; margin:clamp(8px,1.5vw,16px) 0 0!important; }
    #dorm-shopping-module>.container {
      width:min(calc(100% - (var(--j430-gutter,24px) * 2)),var(--j430-content,1180px));
      margin-inline:auto; padding:clamp(22px,3.2vw,38px); border-radius:24px;
      border:1px solid rgba(197,168,128,.22); box-sizing:border-box;
    }
    body.theme-dark #dorm-shopping-module>.container { background:linear-gradient(145deg,rgba(28,42,33,.82),rgba(8,14,10,.92)); box-shadow:0 24px 70px rgba(0,0,0,.24); }
    body.theme-light #dorm-shopping-module>.container { background:linear-gradient(145deg,rgba(255,253,248,.98),rgba(239,231,216,.92)); box-shadow:0 24px 58px rgba(74,54,22,.09); }
    #dorm-shopping-module .dorm-skus-grid { grid-template-columns:repeat(4,minmax(0,1fr))!important; gap:14px!important; }
    #dorm-shopping-module .dorm-sku-card { padding:14px!important; border-width:1px!important; border-color:rgba(197,168,128,.2)!important; border-radius:16px!important; }
    #dorm-shopping-module .dorm-sku-card>div:first-child>div:first-child { height:132px!important; background:transparent!important; }
    #dorm-shopping-module .sku-title { min-height:2.7em; }
    .j411-radar { width:40%; max-width:40%!important; }
    .j445-campus-tag { display:inline-flex; align-items:center; align-self:flex-start; min-height:24px; margin:8px 0 2px; padding:0 9px; border:1px solid rgba(197,168,128,.26); border-radius:999px; color:#C5A880; background:rgba(197,168,128,.08); font-size:10px; font-weight:700; letter-spacing:.025em; }
    body.theme-light .j445-campus-tag { color:#79591f; background:rgba(197,168,128,.13); }
    @media(max-width:1020px){ #dorm-shopping-module .dorm-skus-grid { grid-template-columns:repeat(3,minmax(0,1fr))!important; } }
    @media(max-width:760px){
      .j411-radar { width:100%; max-width:100%!important; }
      #dorm-shopping-module>.container { padding:20px 16px; border-radius:19px; }
      #dorm-shopping-module .dorm-skus-grid { display:flex!important; overflow-x:auto; scroll-snap-type:x mandatory; gap:12px!important; padding:2px 2px 14px; scrollbar-width:none; }
      #dorm-shopping-module .dorm-sku-card { flex:0 0 82vw; max-width:320px; scroll-snap-align:start; }
    }
    /* J450 contextual app shell: one navigation pattern, three focused surfaces. */
    .j450-context-nav{position:sticky;top:58px;z-index:72;width:min(calc(100% - 28px),1180px);margin:16px auto 6px;padding:6px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;border:1px solid rgba(197,168,128,.22);border-radius:16px;background:rgba(10,17,13,.9);backdrop-filter:blur(18px) saturate(135%);box-shadow:0 16px 44px rgba(0,0,0,.16)}
    .j450-context-tab{min-height:48px;border:0;border-radius:11px;background:transparent;color:#C9C4B8;font:700 12px/1.2 Inter,system-ui,sans-serif;letter-spacing:.04em;cursor:pointer;transition:background .18s ease,color .18s ease,transform .18s ease}
    .j450-context-tab:hover{background:rgba(197,168,128,.09);color:#F7F1E5}.j450-context-tab:active{transform:scale(.985)}
    .j450-context-tab[aria-selected="true"]{background:linear-gradient(135deg,#E5C378,#B88A35);color:#10160F;box-shadow:0 8px 22px rgba(197,168,128,.22)}
    .j450-context-tab:focus-visible{outline:2px solid #E5C378;outline-offset:2px}.j450-context-tab small{display:block;margin-top:3px;font-size:9px;font-weight:600;letter-spacing:.01em;opacity:.78}
    body.theme-light .j450-context-nav{background:rgba(255,252,245,.92);border-color:rgba(126,91,29,.2);box-shadow:0 16px 38px rgba(74,54,22,.1)}
    body.theme-light .j450-context-tab{color:#664D24}body.theme-light .j450-context-tab:hover{background:rgba(197,168,128,.14);color:#34230C}
    /* J455: context tabs are wayfinding, never visibility gates. All twelve surfaces remain discoverable. */
    body[data-j450-context] #main-content>#j406-private-concierge,body[data-j450-context] #main-content>#campus-dock-section,body[data-j450-context] #main-content>#deals-vault-module,body[data-j450-context] #main-content>#lunch-arbitrage-module,body[data-j450-context] #main-content>#student-savings-module,body[data-j450-context] #main-content>#split-bill-module,body[data-j450-context] #main-content>#dorm-shopping-module{display:block!important}
    body[data-j450-context="evening"] #dorm-shopping-module .dorm-skus-grid{display:flex!important;overflow-x:auto!important;overflow-y:hidden;scroll-snap-type:x mandatory;gap:12px!important;padding:2px 2px 14px;scrollbar-width:thin;scrollbar-color:rgba(197,168,128,.38) transparent}
    body[data-j450-context="evening"] #dorm-shopping-module .dorm-sku-card{flex:0 0 272px;max-width:80vw;scroll-snap-align:start}
    .j405-pass-front{background-image:none!important;background:radial-gradient(circle at 78% 18%,rgba(229,195,120,.16),transparent 32%),linear-gradient(145deg,#213429,#101A14)!important}
    .j405-pass-front>*{opacity:1!important;pointer-events:auto!important}
    /* J455 Coastal Craft: warm daylight porcelain, river-blue night and tactile cinema tickets. */
    :root{--j455-sand:#FBF9F5;--j455-river:#0B1116;--j455-sunset:#E27D42;--j455-gold:#C5A880}
    body.theme-dark{background:radial-gradient(circle at 78% 8%,rgba(226,125,66,.09),transparent 30%),linear-gradient(180deg,#0B1116,#08100D 48%,#07100C)!important}
    body.theme-light{background:radial-gradient(circle at 82% 6%,rgba(226,125,66,.10),transparent 32%),linear-gradient(180deg,#FBF9F5,#F3ECDF 58%,#EEE5D5)!important}
    .j406-hero{min-height:clamp(390px,52vw,620px);background-position:center!important}
    .j411-radar{width:40%;max-width:40%!important;background:linear-gradient(90deg,rgba(6,12,10,.86),rgba(6,12,10,.38),transparent)!important}
    .j434-ticket-card{position:relative;overflow:visible!important}
    .j434-ticket-card:before,.j434-ticket-card:after{content:"";position:absolute;top:50%;width:14px;height:14px;border-radius:50%;background:var(--j455-sand);transform:translateY(-50%);z-index:2}
    .j434-ticket-card:before{left:-7px}.j434-ticket-card:after{right:-7px}
    body.theme-dark .j434-ticket-card:before,body.theme-dark .j434-ticket-card:after{background:var(--j455-river)}
    #dorm-shopping-module .section-title:after{content:" · chọn món cần, kiểm tra giá tại Mall";font:600 12px/1.4 Inter,system-ui,sans-serif;color:var(--text-muted)}
    .j408-brand-card,.dorm-sku-card{transition:transform .18s ease,box-shadow .18s ease!important}
    .j408-brand-card:hover,.dorm-sku-card:hover{transform:translateY(-3px)!important;box-shadow:0 18px 42px rgba(44,31,10,.12)!important}
    /* J456 retention layer: factual counter checklist and scan-first sharing surface. */
    .j456-counter-checklist{margin-top:14px;padding:14px 15px;border:1px solid rgba(197,168,128,.28);border-radius:14px;background:rgba(197,168,128,.07);color:#F4EEE3}
    .j456-counter-checklist strong{display:block;margin-bottom:8px;font:700 15px/1.3 Inter,system-ui,sans-serif;color:#E5C378}
    .j456-counter-checklist ol{margin:0;padding-left:20px;display:grid;gap:6px;font:500 13px/1.45 Inter,system-ui,sans-serif}
    .j456-counter-checklist small{display:block;margin-top:9px;color:#AEB8B1;font:500 11px/1.45 Inter,system-ui,sans-serif}
    body.theme-light .j456-counter-checklist{background:#FFF9EC;color:#342B20;border-color:rgba(126,91,29,.24)}
    body.theme-light .j456-counter-checklist strong{color:#79591F}body.theme-light .j456-counter-checklist small{color:#685E50}
    .vietqr-canvas-wrapper{display:grid!important;place-items:center!important;min-height:280px!important;padding:18px!important}
    .vietqr-canvas-wrapper img,.vietqr-canvas-wrapper table{width:min(72vw,360px)!important;height:auto!important;max-width:100%!important}
    #split-bill-module .split-actions{align-items:stretch!important}
    #btn-download-split-png{min-height:48px!important;font-size:14px!important}
    /* J457 Monolithic Quiet Luxury: one uninterrupted Song Han night canvas. */
    html,body,#jayt-app-root,.jayt-app-shell,.main-content,.jayt-footer,
    body.theme-light,body.theme-dark{
      background:linear-gradient(180deg,#0D1612 0%,#070C0A 100%) fixed!important;
      color:#F4EEE3!important;
    }
    #main-content>section,#campus-dock-section,#deals-vault-module,
    #lunch-arbitrage-module,#student-savings-module,#split-bill-module,
    #dorm-shopping-module{background:transparent!important;border-color:rgba(212,175,55,.22)!important}
    #dorm-shopping-module>.container,#campus-dock-section>.container,
    #deals-vault-module>.container,#lunch-arbitrage-module>.container,
    #student-savings-module>.container,#split-bill-module>.container,
    .j406-terminal,.j406-card,.j408-brand-card,.j434-ticket-card,.dorm-sku-card,
    .cinema-schedule-block,.schedule-rhythm-section,.bento-card,.calc-control-panel,
    .app-calc-card,.split-controls,.split-result-panel,.cluster-info-card{
      background:#16221B!important;
      color:#F4EEE3!important;
      border:1px solid rgba(212,175,55,.30)!important;
      box-shadow:0 18px 48px rgba(0,0,0,.20)!important;
    }
    body.theme-light .section-title,body.theme-light .section-desc,
    body.theme-light .j406-terminal,body.theme-light #deals-vault-module,
    body.theme-light #lunch-arbitrage-module,body.theme-light #student-savings-module,
    body.theme-light #split-bill-module,body.theme-light #dorm-shopping-module{color:#F4EEE3!important}
    body.theme-light input,body.theme-light textarea,body.theme-light select,
    body.theme-dark input,body.theme-dark textarea,body.theme-dark select{
      background:#09110D!important;color:#F4EEE3!important;border-color:rgba(212,175,55,.30)!important;
    }
    .jayt-footer{border-top:1px solid rgba(212,175,55,.24)!important;padding:30px 18px 96px!important}
    .jayt-footer .footer-content{display:grid!important;justify-items:center!important;gap:8px!important;text-align:center!important;color:#AEB8B1!important}
    .jayt-footer strong{font:700 15px/1.4 'Playfair Display',Georgia,serif;color:#E5C378!important;letter-spacing:.035em}
    .jayt-footer p{margin:0!important;font:500 11px/1.5 Inter,system-ui,sans-serif!important}
    @media(max-width:760px){
      .j450-context-nav{top:52px;margin-top:10px;width:calc(100% - 24px);gap:4px;padding:5px;border-radius:14px}.j450-context-tab{min-height:46px;padding:6px 4px;font-size:10px;letter-spacing:.015em}.j450-context-tab small{font-size:8px}
      #main-content>#lunch-arbitrage-module,#main-content>#split-bill-module{position:absolute!important;width:1px!important;height:1px!important;margin:-1px!important;padding:0!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;clip-path:inset(50%)!important;white-space:nowrap!important;border:0!important}
    }
    /* J460 total surface contract: legacy component names cannot introduce ivory. */
    :root{--j460-canvas:#0B120E;--j460-surface:#141F18;--j460-input:#0E1712;--j460-line:rgba(197,168,128,.25);--j460-metal:#E5C378;--j460-copy:#CBD5E1}
    html,body,body.theme-dark,body.theme-light,#jayt-app-root,.jayt-app-shell,.main-content,.jayt-footer{background-color:var(--j460-canvas)!important;background-image:none!important;color:var(--j460-copy)!important}
    .j406-card,.j427-ticket-card,.j408-brand-card,.bento-card,.dorm-sku-card,
    #deals-vault-module>.container,#lunch-arbitrage-module,#lunch-arbitrage-module>.container,
    #split-bill-module,#split-bill-module>.container,#student-savings-module>.container,
    .calc-control-panel,.arbitrage-grid,.app-calc-card,.split-controls,.split-result-panel,
    .split-breakdown-box,.cinema-schedule-block,.schedule-rhythm-section,.cluster-info-card,
    .dorm-skus-explorer,.j406-terminal,.j434-ticket-card{
      background-color:var(--j460-surface)!important;
      color:var(--j460-copy)!important;
      border-color:var(--j460-line)!important;
    }
    .j427-ticket-card,.j434-ticket-card{clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));}
    #lunch-arbitrage-module input,#lunch-arbitrage-module select,#lunch-arbitrage-module textarea,
    #split-bill-module input,#split-bill-module select,#split-bill-module textarea,
    .app-calc-card input,.split-controls input{
      background:var(--j460-input)!important;color:#F4EEE3!important;border:1px solid var(--j460-line)!important;
    }
    #lunch-arbitrage-module .app-calc-total,#split-bill-module .higher-share-amount,
    #split-bill-module .share-amount,.j427-ticket-card .price,.j434-ticket-card .price{color:var(--j460-metal)!important}
    #main-content :is(.section-title,h1,h2,h3,h4,strong){color:#F4EEE3!important}
    #main-content :is(.section-desc,.app-calc-breakdown,.split-breakdown-box,p,small,label){color:var(--j460-copy)!important}
    #main-content .dorm-sku-card [style*="background"],#main-content .j427-ticket-card [style*="background"]{background-color:transparent!important}
    /* J465 single-surface contract: no legacy ivory can re-enter a card or control. */
    :root{
      --j465-canvas:#09110D;--j465-surface:#121E17;--j465-surface-raised:#17261D;
      --j465-control:#0C1510;--j465-line:rgba(197,168,128,.27);
      --j465-gold:#E5C378;--j465-copy:#D7DED9;--j465-muted:#9EAAA2;
    }
    html,body,body.theme-light,body.theme-dark,#jayt-app-root,.jayt-app-shell,.main-content,.jayt-footer{
      background:linear-gradient(180deg,#0D1612 0%,var(--j465-canvas) 100%) fixed!important;
      color:var(--j465-copy)!important;
    }
    #main-content>section:not(#j406-private-concierge),
    #main-content>section:not(#j406-private-concierge)>.container,
    #main-content :is(.bento-card,.j406-card,.j408-brand-card,.j427-ticket-card,.j434-ticket-card,.dorm-sku-card,.cinema-schedule-block,.schedule-rhythm-section,.calc-control-panel,.arbitrage-grid,.app-calc-card,.split-controls,.split-result-panel,.split-breakdown-box,.cluster-info-card,.dorm-skus-explorer){
      background-color:var(--j465-surface)!important;background-image:none!important;
      color:var(--j465-copy)!important;border-color:var(--j465-line)!important;
      box-shadow:0 18px 48px rgba(0,0,0,.22)!important;
    }
    #main-content :is(input,textarea,select),#main-content [contenteditable="true"]{
      background:var(--j465-control)!important;color:#F4EEE3!important;
      border-color:var(--j465-line)!important;color-scheme:dark;
    }
    #main-content :is(.section-title,h1,h2,h3,h4,strong,.sku-price,.price,.app-calc-total,.higher-share-amount,.share-amount){color:var(--j465-gold)!important}
    #main-content :is(.section-desc,p,small,label,.app-calc-breakdown){color:var(--j465-copy)!important}
    #main-content :is(.text-muted,[style*="#A3B1A8"],[style*="#685E50"]){color:var(--j465-muted)!important}
    #j406-private-concierge .j406-hero{background-color:#07100C!important;/* Preserve the authored Song Han / Dragon Bridge image. */}
  </style>`;
  return J465_MONOLITHIC_STYLESHEET;
}

function getJ450TimedContext() {
  const hour = new Date().getHours();
  if (hour >= 10 && hour < 15) return 'lunch';
  if (hour >= 15 && hour < 24) return 'evening';
  return 'table';
}

function getJ450InitialContext() {
  const today = new Date().toISOString().slice(0, 10);
  try {
    const saved = JSON.parse(localStorage.getItem('jayt_context_tab') || 'null');
    if (saved && saved.date === today && ['lunch', 'evening', 'table'].includes(saved.context)) return saved.context;
  } catch (_) {}
  return getJ450TimedContext();
}

function renderJ450ContextTabs() {
  const active = getJ450InitialContext();
  const tabs = [['lunch','TRƯA NAY ĂN CHI?','So giá 3 ứng dụng'],['evening','TỐI NI ĐI MÔ?','Quán quen · lịch rạp'],['table','CHIA TIỀN TẠI BÀN','VietQR chẵn từng đồng']];
  return `<nav class="j450-context-nav" role="tablist" aria-label="Chọn ngữ cảnh tiện ích">${tabs.map(([key,label,note]) => `<button type="button" id="j450-tab-${key}" class="j450-context-tab" role="tab" aria-selected="${key === active}" aria-controls="main-content" tabindex="${key === active ? '0' : '-1'}" data-j450-tab="${key}">${label}<small>${note}</small></button>`).join('')}</nav>`;
}

function selectJ450Context(context, persist = true) {
  const next = ['lunch', 'evening', 'table'].includes(context) ? context : getJ450TimedContext();
  document.body.dataset.j450Context = next;
  document.querySelectorAll('[data-j450-tab]').forEach((tab) => {
    const selected = tab.dataset.j450Tab === next;
    tab.setAttribute('aria-selected', selected ? 'true' : 'false');
    tab.tabIndex = selected ? 0 : -1;
  });
  const destinations = { lunch:'lunch-arbitrage-module', evening:'j406-private-concierge', table:'split-bill-module' };
  ['j406-private-concierge','campus-dock-section','deals-vault-module','lunch-arbitrage-module','student-savings-module','split-bill-module','dorm-shopping-module'].forEach((id) => {
    const section = document.getElementById(id); if (section) section.setAttribute('aria-hidden', 'false');
  });
  if (persist) { try { localStorage.setItem('jayt_context_tab', JSON.stringify({ context:next, date:new Date().toISOString().slice(0,10) })); } catch (_) {} }
}

function attachJ450ContextEvents() {
  const tabs = Array.from(document.querySelectorAll('[data-j450-tab]'));
  tabs.forEach((tab,index) => {
    tab.addEventListener('click', () => {
      selectJ450Context(tab.dataset.j450Tab);
      const target = { lunch:'lunch-arbitrage-module', evening:'j406-private-concierge', table:'split-bill-module' }[tab.dataset.j450Tab];
      document.getElementById(target)?.scrollIntoView({behavior:'smooth',block:'start'});
    });
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
      event.preventDefault();
      let target=index;
      if(event.key==='ArrowLeft') target=(index-1+tabs.length)%tabs.length;
      if(event.key==='ArrowRight') target=(index+1)%tabs.length;
      if(event.key==='Home') target=0;
      if(event.key==='End') target=tabs.length-1;
      tabs[target].focus(); selectJ450Context(tabs[target].dataset.j450Tab);
    });
  });
  document.querySelectorAll('a[href^="#"]').forEach((link) => link.addEventListener('click', () => {
    const target=link.getAttribute('href').slice(1);
    if(target==='lunch-arbitrage-module') selectJ450Context('lunch');
    if(target==='dorm-shopping-module'||target==='cinema-schedule-container') selectJ450Context('evening');
    if(target==='split-bill-module') selectJ450Context('table');
  }));
  selectJ450Context(getJ450InitialContext(), false);
}


function renderQuarantinedAncillaryVault() {
  return `
    <section id="jayt-quarantined-ancillary-section" class="jayt-ancillary-section" style="margin: 36px auto 24px; max-width: 1200px; padding: 0 clamp(12px, 3vw, 24px); box-sizing: border-box;">
      <details id="jayt-ancillary-modules-drawer" class="jayt-ancillary-drawer" style="border: 1.5px solid rgba(197, 168, 128, 0.28); border-radius: 16px; background: rgba(14,22,17,0.85); overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.35);">
        <summary style="cursor: pointer; padding: 16px 22px; font-weight: 750; color: #E5C378; display: flex; justify-content: space-between; align-items: center; user-select: none; outline: none; background: rgba(22,34,27,0.9); transition: background 0.2s;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 18px;">🏛️</span>
            <span style="font-size: 14px; font-family:'Playfair Display', Georgia, serif; letter-spacing: 0.4px;">CẨM NANG &amp; TIỆN ÍCH ĐÔ THỊ ĐÀ NẴNG MỞ RỘNG (THU GỌN)</span>
            <span style="font-size: 11px; background: rgba(229,195,120,0.16); color: #E5C378; border: 1px solid rgba(229,195,120,0.35); padding: 2px 8px; border-radius: 999px; font-weight: 600;">6 phân hệ phụ</span>
          </div>
          <span style="font-size: 12px; color: #A3B1A8;">[Bấm để mở rộng tiện ích đô thị] ▾</span>
        </summary>
        <div class="quarantined-ancillary-body" style="padding: 20px 8px;">
          ${renderJ450ContextTabs()}
          ${renderJ406PrivateConcierge()}
          ${renderCampusDock()}
          ${renderCampusDealsSection()}
          ${renderLunchArbitrageModule()}
          ${renderMobilityHubModule()}
          ${renderStudentSavingsModule()}
          ${renderSplitBillModule()}
        </div>
      </details>
    </section>
  `;
}

function renderApp() {
  const root = document.getElementById('jayt-app-root');
  if (!root) return;

  initOfferDomNodes();

  root.innerHTML = [
    `<div class="jayt-app-shell j403-shell j405-shell ${state.theme}" data-version="v3.496.0-j465-monolithic-surface">`,
      renderJ465MonolithicStyles(),
      renderCashierHudStyles(),
      renderHeader(),
      renderMobileNavDrawer(),
      '<main id="main-content" class="main-content">',
      '<!-- FEATURE 01: HERO TAKEOVER (FOLD 1 & FOLD 2) -->',
      renderDormShoppingModule(),
      '<!-- QUARANTINED ANCILLARY URBAN UTILITIES -->',
      renderQuarantinedAncillaryVault(),
      '</main>',
      renderFooter(),
      '<!-- Modals & Sheets -->',
      '<div id="counter-3sec-modal" style="display: none;"></div>',
      renderCounterSheetModal(),
      renderOnsiteBillSplitModal(),
      renderZaloModal(),
      renderFnbDirectoryModal(),
      renderDormCatalogModal(),
      '<div id="cashier-quick-modal" style="display: none;"></div>',
      '<div id="on-the-spot-modal" style="display: none;"></div>',
      '<div id="offer-detail-drawer" class="offer-drawer-backdrop" style="display: none;" aria-hidden="true"></div>',
      '<div id="jayt-toast-container" class="toast-container" aria-live="polite"></div>',
      '<!-- Module 2: Sticky Bottom Quick Dock (4 buttons) -->',
      renderCounterQuickDock(),
    '</div>'
  ].join('\n');

  document.body.classList.remove('theme-light', 'theme-dark');
  document.body.classList.add(state.theme, 'j403-gold-forest', 'j405-pinnacle');
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  if (themeMeta) themeMeta.setAttribute('content', state.theme === 'theme-light' ? '#F4EFE4' : '#141C16');
  attachOnsiteEvents();
  attachAppEvents();
  attachCashierHudEvents();
  attachScheduleRhythmEvents();
  attachJ450ContextEvents();
  updateCampusOffersDOM();
  handleHashNavigation();
  window.addEventListener('scroll', updateCounterDockVisibility, { passive: true });
  updateCounterDockVisibility();
}


function renderJ399LegacyApp() {
  const root = document.getElementById('jayt-app-root');
  if (!root) return;

  initOfferDomNodes();

  root.innerHTML = `
    <div class="j399-shell">
      ${renderCashierHudStyles()}
      ${renderJ399Styles()}
      ${renderJ399Header()}
      <main class="j399-wrap">
        ${renderJ399Tabs()}
        ${renderJ399CounterPanel()}
        ${renderJ399TodayPanel()}
        ${renderJ399PassPanel()}
      </main>
      ${renderCounterQuickDock()}
      ${renderCounterSheetModal()}
      ${renderOnsiteBillSplitModal()}
      ${renderZaloModal()}
      ${renderJ399BillModal()}
      <div id="on-the-spot-modal" style="display: none;"></div>
      <div id="counter-3sec-modal" style="display: none;"></div>
      <div id="cashier-quick-modal" style="display: none;"></div>
      <div id="jayt-toast-container" class="toast-container" aria-live="polite"></div>
    </div>
  `;

  attachOnsiteEvents();
  attachCashierHudEvents();
  window.addEventListener('scroll', updateCounterDockVisibility, { passive: true });
  selectJ399Tab(J399_STATE.activeTab);
  updateCounterDockVisibility();
}

// Initial bootstrap
if (typeof document !== 'undefined') {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderApp);
  } else {
    renderApp();
  }
  window.addEventListener('hashchange', handleHashNavigation);
}



