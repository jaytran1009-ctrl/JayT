    'Xem và săn trực tiếp tại: https://jayt-production-v3420.vercel.app/'
  ].join('\n');
  copyVoucherCodeToClipboard(text);
  showJaytToast('✅ Đã sao chép lịch 4 khung giờ vàng vào bộ nhớ tạm!');
}

function downloadJaytFlashCalendar() {
  const icsContent = 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//JayT Corp//Da Nang Flash Sale//VI\r\nBEGIN:VEVENT\r\nSUMMARY:Gio Vang San Voucher JayT (11:30 & 20:00)\r\nDESCRIPTION:San ma Shopee Live 50%, Freeship Xtra 0d tai JayT Da Nang\r\nSTATUS:CONFIRMED\r\nEND:VEVENT\r\nEND:VCALENDAR';
  if (typeof Blob !== 'undefined' && typeof URL !== 'undefined' && URL.createObjectURL) {
    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'jayt_gio_vang_san_deal.ics';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showJaytToast('✅ Đã tải file lịch (.ics)! Mở file để thêm vào lịch điện thoại.');
  } else {
    copyFlashRemindersToClipboard();
  }
}



// ============================================================================
// FEATURE 01: DIRECT SKU CROSS-PLATFORM RADAR MODAL (JAYT DIRECTIVE)
// ============================================================================
function openSkuCrossPlatformRadar(skuId) {
  const allSkus = (typeof J387_DORM_SKUS !== 'undefined' ? J387_DORM_SKUS : [])
    .concat(typeof J465_STAGING_ACCESS_TRADE_OFFERS !== 'undefined' ? J465_STAGING_ACCESS_TRADE_OFFERS : []);
  const p = allSkus.find(item => item.sku_id === skuId || item.offer_id === skuId) || (typeof window !== 'undefined' && window.__lastSkuMap ? window.__lastSkuMap[skuId] : null);
  const basePrice = p ? p.observed_price : 69000;
  const productName = p ? p.product_name : 'Sản phẩm chọn lọc';

  const radar = computeCrossPlatformRadar({
    platform: (p && p.platform) ? p.platform.toLowerCase() : 'shopee',
    productName: productName,
    cleanUrl: p ? p.canonical_url : ''
  }, basePrice);

  let modal = document.getElementById('jayt-sku-cross-radar-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'jayt-sku-cross-radar-modal';
    modal.className = 'zalo-modal-backdrop is-open';
    document.body.appendChild(modal);
  } else {
    modal.classList.add('is-open');
  }

  const money = (num) => (Number(num) || 0).toLocaleString('vi-VN') + '₫';

  let matrixHtml = '<div class="j401-cross-radar-matrix" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin:16px 0;">';
  for (let i = 0; i < radar.platforms.length; i++) {
    const item = radar.platforms[i];
    const isBest = (item.id === radar.cheapestPlatform.id);
    matrixHtml += '<div style="background:rgba(22,34,27,0.88); border:1.5px solid ' + (isBest ? '#10B981' : 'rgba(229,195,120,0.25)') + '; border-radius:14px; padding:14px; position:relative; box-shadow:' + (isBest ? '0 0 20px rgba(16,185,129,0.35)' : 'none') + ';">' +
      (isBest ? '<div style="position:absolute; top:-10px; right:12px; background:#10B981; color:#0A110D; font-size:10px; font-weight:850; padding:2px 10px; border-radius:999px; letter-spacing:0.5px;">🏆 SÀN RẺ NHẤT HÔM NAY</div>' : '') +
      '<div style="font-size:14px; font-weight:800; color:' + item.color + '; margin-bottom:4px; display:flex; align-items:center; gap:6px;">' +
        '<span>' + item.name + ' Mall</span>' +
        (isBest ? '<span style="font-size:11px; background:rgba(16,185,129,0.2); color:#34D399; padding:1px 6px; border-radius:4px;">Giá Đáy</span>' : '') +
      '</div>' +
      '<div style="font-size:11px; color:#A3B1A8; margin-bottom:8px; line-height:1.35;">' + item.voucherLabel + '</div>' +
      '<div style="font-size:22px; font-weight:900; color:' + (isBest ? '#34D399' : '#E5C378') + '; margin-bottom:4px; font-family:\'Playfair Display\', serif;">' + money(item.payable) + '</div>' +
      '<div style="font-size:11px; color:#8C9990; margin-bottom:12px;">Tiết kiệm: <strong style="color:#10B981;">' + money(item.stack.savings) + '</strong> (' + item.stack.discountPercent + '%)</div>' +
      '<button type="button" class="btn-cta-primary" onclick="dispatchSmartAffiliate(&quot;' + item.id + '&quot;, &quot;&quot;, &quot;' + item.code + '&quot;)" style="width:100%; padding:8px 10px; font-size:11.5px; font-weight:800; border-radius:8px; background:' + (isBest ? '#10B981' : 'linear-gradient(135deg, rgba(229,195,120,0.25), rgba(229,195,120,0.12))') + '; color:' + (isBest ? '#06090E' : '#F4EFE6') + '; border:' + (isBest ? 'none' : '1px solid rgba(229,195,120,0.5)') + '; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:4px;">' +
        '<span>⚡ Mở App &amp; Áp Mã ↗</span>' +
      '</button>' +
    '</div>';
  }
  matrixHtml += '</div>';

  modal.innerHTML = '<div class="zalo-modal-dialog" style="max-width: 680px; width: 95%; background: #0E1611; border: 2px solid #E5C378; border-radius: 20px; padding: 22px; box-shadow: 0 16px 50px rgba(0,0,0,0.85); max-height: 90vh; overflow-y: auto;">' +
    '<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(229,195,120,0.25); padding-bottom: 12px; margin-bottom: 14px;">' +
      '<div style="display: flex; align-items: center; gap: 8px;">' +
        '<span style="font-size: 22px;">⚡</span>' +
        '<div>' +
          '<h3 style="margin: 0; font-size: 16.5px; font-weight: 850; color: #E5C378; font-family: \'Playfair Display\', Georgia, serif;">Radar Đối Chiếu Giá 3 Sàn Thời Gian Thực</h3>' +
          '<div style="font-size: 11.5px; color: #A3B1A8; margin-top: 2px;">Sản phẩm: <strong style="color: #F4EFE6;">' + escapeHtml(productName) + '</strong></div>' +
        '</div>' +
      '</div>' +
      '<button type="button" onclick="closeSkuCrossPlatformRadar()" style="background: none; border: none; color: #A3B1A8; font-size: 22px; cursor: pointer; padding: 4px 8px;" aria-label="Đóng cửa sổ">✕</button>' +
    '</div>' +
    '<div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; font-size: 12px; color: #F4EFE6; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">' +
      '<div>Định vị sàn rẻ nhất: <strong style="color: #34D399; font-size: 13px;">' + radar.cheapestPlatform.name + ' Mall (' + money(radar.cheapestPlatform.payable) + ')</strong></div>' +
      '<div style="color: #E5C378; font-size: 11.5px;">Tiết kiệm thêm <strong style="color: #34D399;">' + money(radar.arbitrageMargin) + '</strong> so với giá trung bình</div>' +
    '</div>' +
    matrixHtml +
    '<div style="border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 12px; font-size: 11px; color: #8C9990; line-height: 1.45; text-align: center;">' +
      '💡 <em>JayT đối soát giá quan sát thời gian thực kết hợp thuật toán cấn trừ 4 tầng (Shop + Sàn + Freeship + Ví). Bấm "Mở App" để tự động sao chép mã và mở app sàn chính ngạch.</em>' +
    '</div>' +
  '</div>';
}

function closeSkuCrossPlatformRadar() {
  const modal = document.getElementById('jayt-sku-cross-radar-modal');
  if (modal) modal.classList.remove('is-open');
}

if (typeof window !== 'undefined') {
  window.openSkuCrossPlatformRadar = openSkuCrossPlatformRadar;
  window.closeSkuCrossPlatformRadar = closeSkuCrossPlatformRadar;
}

function openVoucherGuideModal(voucherCode, platform = 'shopee') {
  let modal = document.getElementById('jayt-voucher-guide-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'jayt-voucher-guide-modal';
    modal.className = 'zalo-modal-backdrop is-open';
    document.body.appendChild(modal);
  } else {
    modal.classList.add('is-open');
  }

  const vObj = DAILY_HOT_VOUCHERS.find(v => v.code === voucherCode) || {
    code: voucherCode || 'SHOPEELIVE50',
    platform: platform,
    platformLabel: platform.toUpperCase(),
    discount: 'Giảm giá sâu nhất',
    minSpend: 'Đơn từ 0đ',
    badge: '🔥 VOUCHER HOT'
  };

  modal.innerHTML = `
    <div class="zalo-modal-dialog" style="max-width: 650px; width: 95%; background: #0E1611; border: 2px solid #E5C378; border-radius: 20px; padding: 24px; box-shadow: 0 16px 50px rgba(0,0,0,0.75); max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(229,195,120,0.25); padding-bottom: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 22px;">💡</span>
          <h3 style="margin: 0; font-size: 17px; font-weight: 850; color: #E5C378; font-family: 'Playfair Display', Georgia, serif;">Hướng Dẫn Áp Mã &amp; Mẹo Săn Đáy (Pro-Tips)</h3>
        </div>
        <button type="button" onclick="closeVoucherGuideModal()" style="background: none; border: none; color: #A3B1A8; font-size: 20px; cursor: pointer; padding: 4px 8px;" aria-label="Đóng cửa sổ">✕</button>
      </div>

      <!-- Voucher Code Showcase Box -->
      <div style="background: rgba(22,34,27,0.85); border: 1.5px solid #10B981; border-radius: 12px; padding: 14px 18px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div>
          <div style="font-size: 11px; color: #10B981; font-weight: 750; text-transform: uppercase;">${vObj.platformLabel} · ${vObj.badge}</div>
          <div style="font-size: 16px; font-weight: 800; color: #F4EFE6;">${vObj.discount}</div>
          <div style="font-size: 12px; color: #E5C378;">${vObj.minSpend}</div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <strong style="font-family: monospace; font-size: 16px; color: #E5C378; background: rgba(10,17,13,0.9); padding: 6px 12px; border-radius: 8px; border: 1px dashed rgba(229,195,120,0.4);">${vObj.code}</strong>
          <button type="button" onclick="copyVoucherCodeToClipboard('${vObj.code}')" style="padding: 8px 12px; border-radius: 8px; background: #10B981; color: #0A110D; font-size: 12px; font-weight: 750; border: none; cursor: pointer;">Sao chép mã</button>
        </div>
      </div>

      <!-- 3-Step Action Guide -->
      <div style="margin-bottom: 20px;">
        <h4 style="color: #E5C378; font-size: 14px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px;">📋 Quy Trình 3 Bước Săn Đáy Thần Tốc:</h4>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="background: rgba(22,34,27,0.6); border: 1px solid rgba(229,195,120,0.2); border-radius: 10px; padding: 10px 14px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="font-size: 16px; background: #E5C378; color: #0A110D; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 850; flex-shrink: 0;">1</span>
            <div>
              <strong style="color: #F4EFE6; font-size: 13px;">Bước 1 — Lưu mã:</strong>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.45;">Bấm sao chép mã ẩn hiển thị trên JayT để lưu vào bộ nhớ tạm của điện thoại / máy tính.</div>
            </div>
          </div>
          <div style="background: rgba(22,34,27,0.6); border: 1px solid rgba(229,195,120,0.2); border-radius: 10px; padding: 10px 14px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="font-size: 16px; background: #E5C378; color: #0A110D; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 850; flex-shrink: 0;">2</span>
            <div>
              <strong style="color: #F4EFE6; font-size: 13px;">Bước 2 — Mở ứng dụng sàn:</strong>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.45;">Bấm nút mở app sàn (<code style="color:#E5C378;">shopee://</code>, <code style="color:#E5C378;">lazada://</code>, <code style="color:#E5C378;">snssdk1180://</code>) đã tích hợp sẵn mã liên kết JayT.</div>
            </div>
          </div>
          <div style="background: rgba(22,34,27,0.6); border: 1px solid rgba(229,195,120,0.2); border-radius: 10px; padding: 10px 14px; display: flex; gap: 12px; align-items: flex-start;">
            <span style="font-size: 16px; background: #E5C378; color: #0A110D; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 850; flex-shrink: 0;">3</span>
            <div>
              <strong style="color: #F4EFE6; font-size: 13px;">Bước 3 — Chốt đơn giảm sâu:</strong>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.45;">Tại bước thanh toán, dán mã vào ô "Shop Voucher" hoặc "Shopee/TikTok Voucher" để cấn trừ tiền tức thì.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pro-Tips for Da Nang Students & Office Workers -->
      <div style="margin-bottom: 20px;">
        <h4 style="color: #34D399; font-size: 14px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px;">⚡ Kho Mẹo Thực Chiến Độc Quyền (Pro-Tips Đà Nẵng):</h4>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="background: rgba(16,185,129,0.08); border: 1px dashed rgba(16,185,129,0.3); border-radius: 10px; padding: 10px 14px;">
            <strong style="color: #34D399; font-size: 12.5px;">🎥 Mẹo Săn Mã Shopee Video Giảm 20%:</strong>
            <p style="font-size: 12px; color: #A3B1A8; margin: 4px 0 0; line-height: 1.45;">Vào mục Video trên Shopee, tìm sản phẩm muốn mua hoặc bấm lưu video của shop; thêm hàng vào giỏ từ video để áp được voucher giảm 20% (tối đa 40k–100k).</p>
          </div>
          <div style="background: rgba(16,185,129,0.08); border: 1px dashed rgba(16,185,129,0.3); border-radius: 10px; padding: 10px 14px;">
            <strong style="color: #34D399; font-size: 12.5px;">👥 Mẹo Gộp Đơn KTX Hòa Khánh:</strong>
            <p style="font-size: 12px; color: #A3B1A8; margin: 4px 0 0; line-height: 1.45;">Rủ bạn bè cùng phòng trọ gộp chung một giỏ hàng vượt mốc 150k để kích hoạt Freeship Xtra 0đ và mã hoàn xu, xuất thẻ Zalo Deal Pass để chia tiền chuẩn xác từng đồng.</p>
          </div>
          <div style="background: rgba(16,185,129,0.08); border: 1px dashed rgba(16,185,129,0.3); border-radius: 10px; padding: 10px 14px;">
            <strong style="color: #34D399; font-size: 12.5px;">⏰ Mẹo Canh Khung Giờ Vàng Săn Deal:</strong>
            <p style="font-size: 12px; color: #A3B1A8; margin: 4px 0 0; line-height: 1.45;">Hẹn giờ vào các mốc: <strong>00:00</strong> (Freeship 0đ đêm), <strong>11:30</strong> (Cơm trưa ShopeeFood 30k &amp; TikTok Live 50k), <strong>20:00</strong> (Shopee Live 50%) và <strong>21:00</strong> (Xả kho KTX Choice 29k).</p>
          </div>
        </div>
      </div>

      <!-- Trust Statement & Action Row -->
      <div style="background: rgba(22,34,27,0.5); border: 1px solid rgba(229,195,120,0.18); border-radius: 10px; padding: 10px 12px; margin-bottom: 16px; text-align: center;">
        <div style="font-size: 11.5px; color: #10B981; font-weight: 700;">✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn · Cam kết không phát sinh chi phí ẩn</div>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
        <button type="button" class="btn-cta-primary" onclick="dispatchSmartAffiliate('${vObj.platform}', '', '${vObj.code}'); closeVoucherGuideModal();" style="padding: 10px 18px; border-radius: 10px; font-size: 13px; font-weight: 800; background: #E5C378; color: #0A110D; border: none; cursor: pointer;">
          ⚡ Áp Mã Ẩn &amp; Mở App ↗
        </button>
        <button type="button" class="btn-cta-secondary" onclick="closeVoucherGuideModal()" style="padding: 10px 16px; border-radius: 10px; font-size: 12.5px; font-weight: 600; background: rgba(255,255,255,0.08); color: #F4EFE6; border: 1px solid rgba(255,255,255,0.2); cursor: pointer;">
          Đóng lại ✕
        </button>
      </div>
    </div>
  `;
}

function closeVoucherGuideModal() {
  const modal = document.getElementById('jayt-voucher-guide-modal');
  if (modal) {
    modal.classList.remove('is-open');
  }
}

function renderDailyHotVoucherBoard() {
  const activePlat = (typeof state !== 'undefined' && state.activeVoucherPlatform) ? state.activeVoucherPlatform : 'ALL';
  const activeChip = (typeof state !== 'undefined' && state.activeContextChip) ? state.activeContextChip : 'ALL';

  const visibleVouchers = DAILY_HOT_VOUCHERS.filter(v => {
    if (activePlat !== 'ALL') {
      return (v.platformGroup || v.platform) === activePlat;
    }
    if (activeChip === 'ALL') return true;
    return v.category === activeChip;
  });

  const platformTabs = [
    { id: 'ALL', label: '🔥 Tất Cả Sàn (' + DAILY_HOT_VOUCHERS.length + ')', icon: '🔥' },
    { id: 'shopee', label: '🟠 Shopee (5 mã)', icon: '🟠' },
    { id: 'tiktok', label: '⚫ TikTok Shop (4 mã)', icon: '⚫' },
    { id: 'lazada', label: '🔵 Lazada (4 mã)', icon: '🔵' },
    { id: 'fnb_service', label: '🟢 F&B & Dịch Vụ (5 mã)', icon: '🟢' }
  ];

  return `
    <div id="j401-hot-voucher-shelf" class="j401-hot-voucher-shelf" style="margin-bottom: 24px; padding: 22px; border-radius: 18px; border: 1.5px solid rgba(229,195,120,0.4); background: rgba(14,22,17,0.88); box-shadow: 0 8px 32px rgba(0,0,0,0.35);">
      <!-- Header Row: Title & Action -->
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:14px; border-bottom:1px solid rgba(229,195,120,0.2); padding-bottom:12px;">
        <div>
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:20px;">🎟️</span>
            <h3 style="margin:0; font-size:18px; font-weight:850; color:#E5C378; font-family:'Playfair Display', Georgia, serif; letter-spacing:0.3px;">
              Bách Khoa Voucher 100% Affiliate · Sàn Thương Mại &amp; Đồ Ăn
            </h3>
          </div>
          <p style="margin:4px 0 0 0; font-size:12px; color:#A3B1A8;">
            Voucher độc quyền chọn lọc cho SV Đà Nẵng: Shopee Live 50%, TikTok Shop, Lazada Max, ShopeeFood, Grab, Xanh SM
          </p>
        </div>
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <button type="button" onclick="openFlashSaleReminderModal()" style="font-size:11.5px; font-weight:750; background:rgba(229,195,120,0.2); color:#E5C378; border:1px solid rgba(229,195,120,0.5); padding:6px 14px; border-radius:999px; cursor:pointer; display:inline-flex; align-items:center; gap:5px;">
            <span>🔔 Nhắc giờ săn</span>
          </button>
          <span style="font-size:11.5px; font-weight:750; background:rgba(229,195,120,0.15); color:#E5C378; border:1px solid rgba(229,195,120,0.4); padding:5px 12px; border-radius:999px;">Đang hiển thị: ${visibleVouchers.length} mã hot</span>
        </div>
      </div>

      <!-- Bản Tin Bóc Mã Ẩn Sáng Nay (Daily Hidden Voucher Bulletin) -->
      <div class="jayt-hidden-voucher-bulletin" style="background:linear-gradient(135deg, rgba(10,17,13,0.95), rgba(6,9,14,0.98)); border:1.5px solid rgba(229,195,120,0.4); border-radius:14px; padding:12px 16px; margin-bottom:16px; box-shadow:0 4px 18px rgba(0,0,0,0.4);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px; border-bottom:1px dashed rgba(229,195,120,0.2); padding-bottom:8px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="display:inline-block; width:9px; height:9px; border-radius:50%; background:#10B981; box-shadow:0 0 10px #10B981; animation:pulse 1.8s infinite;"></span>
            <strong style="font-size:13px; color:#E5C378; letter-spacing:0.3px;">📢 BẢN TIN BÓC MÃ ẨN ĐÀ NẴNG (Phiên Sáng &amp; Trưa)</strong>
          </div>
          <span style="font-size:11px; color:#10B981; font-weight:750; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.35); padding:2px 10px; border-radius:999px;">
            ⚡ Tự động áp mã vào app sàn · Độ trễ ≤ 22ms
          </span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:8px; font-size:11px;">
          <div style="background:rgba(238,77,45,0.08); border:1px solid rgba(238,77,45,0.25); border-radius:8px; padding:7px 10px;">
            <div style="font-weight:800; color:#EE4D2D; margin-bottom:2px;">🟠 SHOPEE LIVE 50%</div>
            <div style="color:#C5A880;">Mở 11:30 &amp; 19:30 · Giảm 50% đơn 0đ</div>
          </div>
          <div style="background:rgba(254,44,85,0.08); border:1px solid rgba(254,44,85,0.25); border-radius:8px; padding:7px 10px;">
            <div style="font-weight:800; color:#FE2C55; margin-bottom:2px;">🔴 TIKTOK SHOP KTX</div>
            <div style="color:#C5A880;">Mã Creator 30K · Freeship đơn 45K</div>
          </div>
          <div style="background:rgba(15,20,109,0.18); border:1px solid rgba(56,189,248,0.3); border-radius:8px; padding:7px 10px;">
            <div style="font-weight:800; color:#38BDF8; margin-bottom:2px;">🔵 LAZADA MAX</div>
            <div style="color:#C5A880;">Tích lũy 50K · Choice 3 món 29K</div>
          </div>
          <div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.25); border-radius:8px; padding:7px 10px;">
            <div style="font-weight:800; color:#10B981; margin-bottom:2px;">🟢 SHOPEEFOOD &amp; DI CHUYỂN</div>
            <div style="color:#C5A880;">ShopeeFood 30K · Xanh SM 50%</div>
          </div>
        </div>
      </div>

      <!-- Platform Filter Tabs (1-chạm) -->
      <div class="j401-voucher-platform-tabs" role="tablist" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; padding:8px; background:rgba(10,17,13,0.7); border-radius:12px; border:1px solid rgba(229,195,120,0.2);">
        ${platformTabs.map(tab => {
          const isAct = (activePlat === tab.id);
          return `
            <button
              type="button"
              class="btn-platform-tab ${isAct ? 'is-active active' : ''}"
              onclick="setVoucherPlatformTab('${tab.id}')"
              style="padding:7px 14px; border-radius:8px; font-size:12px; font-weight:${isAct ? '750' : '600'}; cursor:pointer; border:1px solid ${isAct ? '#E5C378' : 'transparent'}; background:${isAct ? '#E5C378' : 'transparent'}; color:${isAct ? '#0A110D' : '#C5A880'}; transition:all 0.15s ease;"
            >
              ${tab.label}
            </button>
          `;
        }).join('')}
      </div>

      <!-- Perforated Ticket Strip Voucher Cards Grid with Vivid Platform Branding & FOMO Pulse -->
      <div class="j401-vouchers-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(270px, 1fr)); gap:12px;">
        ${visibleVouchers.map(v => {
          const isScarcity = (v.quotaRemainingPercent <= 20);
          const platformTheme = (v.platform === 'shopee')
            ? { color: '#EE4D2D', bg: 'rgba(238,77,45,0.16)', border: 'rgba(238,77,45,0.4)', tag: 'SHOPEE' }
            : ((v.platform === 'tiktok')
              ? { color: '#FE2C55', bg: 'rgba(254,44,85,0.16)', border: 'rgba(254,44,85,0.4)', tag: 'TIKTOK' }
              : ((v.platform === 'lazada')
                ? { color: '#38BDF8', bg: 'rgba(15,20,109,0.28)', border: 'rgba(56,189,248,0.4)', tag: 'LAZADA' }
                : { color: '#10B981', bg: 'rgba(16,185,129,0.16)', border: 'rgba(16,185,129,0.4)', tag: 'F&B' }
              )
            );
          return `
          <div class="j401-hot-voucher-card" style="background:rgba(14,22,17,0.92); border:1px solid ${platformTheme.border}; border-radius:14px; display:flex; position:relative; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,0.3); transition:transform 0.2s cubic-bezier(0.16,1,0.3,1), box-shadow 0.2s ease;">
            <!-- Left Perforated Ticket Stub with Platform Branding -->
            <div style="width:92px; flex-shrink:0; background:linear-gradient(180deg, ${platformTheme.bg} 0%, rgba(10,17,13,0.95) 100%); padding:12px 6px; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; border-right:1.5px dashed rgba(229,195,120,0.35); position:relative;">
              <!-- Semicircular Perforation Cutouts -->
              <div style="position:absolute; top:-7px; right:-7px; width:14px; height:14px; border-radius:50%; background:#06090E; border:1px solid rgba(229,195,120,0.3); z-index:2;"></div>
              <div style="position:absolute; bottom:-7px; right:-7px; width:14px; height:14px; border-radius:50%; background:#06090E; border:1px solid rgba(229,195,120,0.3); z-index:2;"></div>

              <span style="font-size:9px; font-weight:850; color:${platformTheme.color}; background:${platformTheme.bg}; border:1px solid ${platformTheme.border}; padding:2px 6px; border-radius:4px; margin-bottom:6px; white-space:nowrap; letter-spacing:0.5px;">${platformTheme.tag}</span>
              <div style="font-size:16px; font-weight:900; color:#E5C378; line-height:1.15; margin-bottom:4px; font-family:'Playfair Display', Georgia, serif; text-shadow:0 0 10px rgba(229,195,120,0.3);">${v.discount}</div>
              <span style="font-size:9.5px; color:#A3B1A8; font-weight:600;">${v.platformLabel}</span>
            </div>

            <!-- Right Ticket Body -->
            <div style="flex:1; padding:10px 12px; display:flex; flex-direction:column; justify-content:space-between; min-width:0;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; gap:6px; margin-bottom:4px;">
                  <span style="font-size:11.5px; color:#E5C378; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${v.minSpend}</span>
                  <!-- Neon Quota Pill (FOMO pulsating when <= 20%) -->
                  <span style="font-size:9px; font-weight:850; ${isScarcity ? 'animation:pulse-fomo 1.5s infinite; background:linear-gradient(135deg, #EF4444, #DC2626); color:#FFFFFF; box-shadow:0 0 10px rgba(239,68,68,0.5);' : 'color:#10B981; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.35);'} padding:2px 7px; border-radius:999px; white-space:nowrap;">
                    ${isScarcity ? ('🔥 SẮP HẾT (CÒN ' + v.quotaRemainingPercent + '%)') : ('⚡ Còn ' + v.quotaRemainingPercent + '%')}
                  </span>
                </div>

                <div style="font-size:11px; color:#8C9990; line-height:1.35; margin-bottom:8px; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden;">${v.note}</div>

                <!-- Real-Time Quota Gauge (FOMO / Scarcity) -->
                <div class="j401-quota-gauge" style="margin-bottom:8px; background:rgba(10,17,13,0.6); padding:4px 6px; border-radius:6px; border:1px solid rgba(229,195,120,0.15);">
                  <div style="width:100%; height:4px; background:rgba(255,255,255,0.08); border-radius:999px; overflow:hidden;">
                    <div style="width:${v.quotaUsedPercent}%; height:100%; background:${isScarcity ? 'linear-gradient(90deg, #F59E0B, #EF4444)' : 'linear-gradient(90deg, #10B981, #E5C378)'}; border-radius:999px;"></div>
                  </div>
                </div>
              </div>

              <div>
                <div style="background:rgba(10,17,13,0.85); border:1px dashed rgba(229,195,120,0.3); border-radius:6px; padding:4px 8px; display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                  <span style="font-size:10px; color:#A3B1A8;">MÃ ƯU ĐÃI:</span>
                  <strong style="font-family:monospace; font-size:13px; color:#E5C378; letter-spacing:0.5px;">${v.code}</strong>
                </div>
                <div style="display:flex; gap:6px;">
                  <button type="button" class="btn-cta-secondary" onclick="openVoucherGuideModal('${v.code}', '${v.platform}')" style="width:auto !important; flex:0 0 auto !important; min-width:unset !important; min-height:34px !important; padding:6px 10px; font-size:11px; font-weight:700; border-radius:8px; background:rgba(229,195,120,0.1); color:#E5C378; border:1px solid rgba(229,195,120,0.35); cursor:pointer; display:inline-flex; align-items:center; gap:3px; white-space:nowrap;" title="Xem hướng dẫn áp mã 3 bước & mẹo săn đáy">
                    <span>💡 Mẹo</span>
                  </button>
                  <button type="button" class="btn-cta-primary" onclick="triggerJaytSensoryFeedback(event); dispatchSmartAffiliate('${v.platform}', '', '${v.code}', event)" style="flex:1 1 auto !important; width:auto !important; min-width:0; min-height:34px !important; padding:6px 8px; font-size:11px; font-weight:800; border-radius:8px; background:linear-gradient(135deg, rgba(229,195,120,0.22), rgba(229,195,120,0.1)); color:#F4EFE6; border:1.5px solid rgba(229,195,120,0.55); cursor:pointer; transition:all 0.15s ease; box-shadow:0 2px 8px rgba(0,0,0,0.2); display:inline-flex; align-items:center; justify-content:center; gap:4px; white-space:nowrap;" onmouseover="this.style.background='#E5C378';this.style.color='#0A110D';" onmouseout="this.style.background='linear-gradient(135deg, rgba(229,195,120,0.22), rgba(229,195,120,0.1))';this.style.color='#F4EFE6';">
                    <span>⚡ Áp Mã Ẩn ↗</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          `;
        }).join('')}
      </div>

      <!-- Affiliate Value-First Trust Statement -->
      <div style="margin-top:16px; padding:8px 14px; background:rgba(16,185,129,0.08); border:1px dashed rgba(16,185,129,0.3); border-radius:10px; text-align:center; font-size:11.5px; color:#10B981; font-weight:600;">
        ✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn · Cam kết không phát sinh chi phí ẩn
      </div>
    </div>
  `;
}

function renderAuxiliaryLinkInspector() {
  return `
    <div class="j401-voucher-box bento-card j401-auxiliary-proactive" style="margin-top: 28px; margin-bottom: 20px; padding: 22px; border: 1.5px solid rgba(229,195,120,0.35); border-radius: 18px; background: rgba(14,22,17,0.88); box-shadow: 0 8px 30px rgba(0,0,0,0.3);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 22px;">🔍</span>
          <h3 style="font-size: 16px; font-weight: 800; color: #E5C378; margin: 0; font-family: 'Playfair Display', Georgia, serif;">Khu Vực Nâng Cao · Bóc Tách Thêm Mã Ẩn Đa Sàn</h3>
        </div>
        <span style="font-size: 11px; background: rgba(197, 168, 128, 0.15); color: #E5C378; border: 1px solid rgba(197, 168, 128, 0.35); padding: 3px 12px; border-radius: 999px; font-weight: 600;">Dành cho khách chủ động (20% traffic) · Radar Quét 0.8s</span>
      </div>

      <!-- 4 Category Badges -->
      <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;">
        <span style="font-size:10.5px; font-weight:700; background:rgba(16,185,129,0.15); color:#10B981; border:1px solid rgba(16,185,129,0.4); padding:2.5px 9px; border-radius:6px;">🟢 Tân Thủ 0đ</span>
        <span style="font-size:10.5px; font-weight:700; background:rgba(239,68,68,0.15); color:#EF4444; border:1px solid rgba(239,68,68,0.4); padding:2.5px 9px; border-radius:6px;">🔴 Mã Ẩn Live/Video ≥ 50%</span>
        <span style="font-size:10.5px; font-weight:700; background:rgba(245,158,11,0.15); color:#F59E0B; border:1px solid rgba(245,158,11,0.4); padding:2.5px 9px; border-radius:6px;">🟡 Deal Hời Trong Tháng</span>
        <span style="font-size:10.5px; font-weight:700; background:rgba(139,92,246,0.15); color:#8B5CF6; border:1px solid rgba(139,92,246,0.4); padding:2.5px 9px; border-radius:6px;">🟣 Đáy 30 Ngày</span>
      </div>

      <p style="font-size: 12.5px; color: #A3B1A8; margin: 0 0 14px 0; line-height: 1.45;">
        Dán link sản phẩm bất kỳ để bóc tách thêm mã ẩn. Dán liên kết Shopee, Lazada, TikTok Shop hoặc AccessTrade. Thuật toán <code>calculateDynamicStack</code> bóc tách link trong \le 450ms và mô phỏng giá thực trả; công cụ không tìm hay tuyên bố voucher ẩn không kiểm chứng.
      </p>

      <!-- Futuristic Search Capsule Pill Container -->
      <div class="j401-search-capsule" style="display: flex; align-items: center; background: rgba(10,17,13,0.95); border: 1.5px solid rgba(229,195,120,0.4); border-radius: 999px; padding: 4px 6px 4px 16px; margin-bottom: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.4), 0 0 15px rgba(229,195,120,0.08); flex-wrap: wrap; gap: 6px;">
        <span style="font-size: 16px; opacity: 0.8;">🔗</span>
        <input id="j401-voucher-input" type="url" placeholder="Dán link Shopee / Lazada / TikTok Shop / AccessTrade..." aria-label="Link sản phẩm đa sàn" style="flex: 1; min-width: 220px; min-height: 40px; background: transparent; border: none; outline: none; color: #F4EFE6; font-size: 13px;">
        <button type="button" class="btn-cta-secondary" onclick="detectClipboardProductLink(true)" style="min-height: 38px; padding: 0 14px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 12px; background: rgba(229,195,120,0.12); color: #E5C378; border: 1px solid rgba(229,195,120,0.35); transition: all 0.15s;" title="Tự động nhận diện liên kết từ bộ nhớ tạm">📋 Dán từ bộ nhớ tạm</button>
        <button type="button" class="btn-cta-primary" onclick="handleVoucherLookup()" style="min-height: 38px; padding: 0 18px; border-radius: 999px; cursor: pointer; font-weight: 800; font-size: 12.5px; background: linear-gradient(135deg, #E5C378, #C5A880); color: #0A110D; border: none; box-shadow: 0 2px 10px rgba(229,195,120,0.3);">Quét Radar (0.8s) ⚡</button>
      </div>

      <div id="j401-clipboard-status" style="font-size: 11.5px; min-height: 18px; margin-bottom: 6px;"></div>

      <div style="margin-top: 6px; font-size: 11.5px; color: #A3B1A8; display:flex; gap:10px; flex-wrap:wrap;">
        <span>Thử mẫu nhanh:</span>
        <button type="button" style="background:none; border:none; color: #E5C378; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;" onclick="fillVoucherSample('https://shopee.vn/product/38729104/18274910245')">Shopee (Quạt JISULIFE)</button>
        <button type="button" style="background:none; border:none; color: #F59E0B; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;" onclick="fillVoucherSample('https://www.lazada.vn/products/item-i98765-s43210.html')">Lazada (Đèn LED)</button>
        <button type="button" style="background:none; border:none; color: #EF4444; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;" onclick="fillVoucherSample('https://shop.tiktok.com/view/product/172948201948')">TikTok Shop (Live 50%)</button>
        <button type="button" style="background:none; border:none; color: #10B981; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;" onclick="fillVoucherSample('https://fast.accesstrade.com.vn/deep_link/12345?url=https%3A%2F%2Fshopee.vn')">AccessTrade (Tân Thủ 0đ)</button>
      </div>

      <div id="j401-voucher-output" style="margin-top: 10px;"></div>
    </div>
  `;
}


function renderDormShoppingModule() {
  const categories = [
    { id: 'ALL', label: 'Tất cả (20)', count: 20 },
    { id: 'GIA_DUNG', label: 'Gia dụng KTX (6)', match: 'Gia dụng KTX' },
    { id: 'HOC_TAP', label: 'Học tập & Công nghệ (7)', match: 'Học tập & Công nghệ' },
    { id: 'CA_NHAN', label: 'Cá nhân & Di chuyển (5)', match: 'Cá nhân & Di chuyển' },
    { id: 'AN_VAT', label: 'Đồ ăn vặt & Gia vị (2)', match: 'Đồ ăn vặt & Gia vị' }
  ];

  const selectedCat = state.selectedDormCategory || 'ALL';
  const query = (state.dormSearchKeyword || '').toLowerCase().trim();

  const filteredProducts = J387_DORM_SKUS.filter(p => {
    const matchCat = (selectedCat === 'ALL') || (p.category === selectedCat);
    const matchKeyword = !query ||
      p.product_name.toLowerCase().includes(query) ||
      p.variant_name.toLowerCase().includes(query) ||
      p.merchant_name.toLowerCase().includes(query);
    return matchCat && matchKeyword;
  });

  const cluster1Survival = filteredProducts.filter(p => p.observed_price <= 49000 || p.sku_id === 'DORM_SKU_FEED_10_23244410073' || p.sku_id === 'DORM_SKU_FEED_14_29000715432' || p.sku_id === 'DORM_SKU_FEED_02_26609048170');
  const cluster2Desk = filteredProducts.filter(p => !cluster1Survival.includes(p) && (p.category === 'Học tập & Công nghệ' || p.observed_price > 180000));
  const cluster3Living = filteredProducts.filter(p => !cluster1Survival.includes(p) && !cluster2Desk.includes(p));

  const feedSnapshotStatus = '22/22 bản ghi staging: 20 Shopee + 2 AccessTrade · snapshot 15/09/2026';

  return `
    <section id="dorm-shopping-module" class="bento-section" aria-labelledby="title-dorm-module" style="margin-top: 32px;">
      <div class="container">
        <!-- Unified Subsystem Header -->
        <div class="section-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
          <div>
            <h2 id="title-dorm-module" class="section-title">Trạm Săn Voucher &amp; Deal Đáy Đa Sàn</h2>
            <p class="section-desc">Hệ điều hành tiết kiệm số JayT Đà Nẵng: Ưu tiên phục vụ khách thụ động · Bày sẵn voucher hot nhất trong ngày &amp; kệ deal KTX giá ép đáy · Bóc tách mã ẩn đa sàn khi dán link. Mọi CTA chỉ mở URL canonical sạch; không chuyển hướng affiliate và không phát tracking.</p>
          </div>

          <!-- Read-only staging provenance badge; no network health claim -->
          <div style="display: inline-flex; align-items: center; gap: 10px; background: rgba(4, 120, 87, 0.08); border: 1.5px solid var(--accent); border-radius: var(--radius-chip); padding: 8px 14px; font-size: 12.5px;">
            <span>Snapshot staging chỉ đọc · affiliate_enabled: false</span>
          </div>
        </div>

        <!-- Golden Hour Live Radar & Flash Sale Sticky Ribbon (Fold 1 Hero Banner) -->
        <div id="jayt-golden-hour-alert" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; background:rgba(6,9,14,0.92); border:1.5px solid #E5C378; border-radius:12px; padding:12px 18px; margin-bottom:16px; box-shadow:0 4px 20px rgba(0,0,0,0.4);">
          <div style="display:flex; align-items:center; gap:10px; font-size:13.5px; color:#E5C378; font-weight:800; letter-spacing:0.3px;">
            <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#10B981; box-shadow:0 0 10px #10B981; animation:pulse 1.8s infinite;"></span>
            <span>🟢 JAYT ĐÀ NẴNG [LIVE RADAR]</span>
            <span style="color:#C5A880; font-weight:700;">⚡ FLASH SALE ${getNextFlashSaleSlot().slotName || '19:30 - 21:30'}</span>
          </div>
          <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:#E5C378; font-family:monospace; font-weight:800; background:rgba(229,195,120,0.12); padding:4px 12px; border-radius:8px; border:1px solid rgba(229,195,120,0.3);">
            <span>⚡ GIỜ VÀNG HÒA KHÁNH:</span>
            <span>(CÒN <span id="jayt-ttl-countdown">${getNextFlashSaleSlot().countdownFormatted}</span>)</span>
          </div>
        </div>

        <!-- Feed snapshot status: factual observation, not a live check -->
        <div id="health-worker-status-bar" style="background: var(--bg-card); border-left: 3.5px solid var(--accent); border-radius: 8px; border: 1px solid var(--border-color); border-left-width: 3.5px; padding: 10px 14px; font-size: 12.5px; color: var(--text-muted); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <span id="health-worker-status-text"><em>${feedSnapshotStatus}</em></span>
          <span style="font-size: 11px; background: rgba(0,0,0,0.05); padding: 4px 9px; border-radius: 999px; color: var(--text-main); font-weight: 500;">Giá quan sát có thể thay đổi · kiểm tra giá và tồn kho tại trang canonical</span>
        </div>

        <!-- ============================================================== -->
        <!-- MẶT TIỀN ƯU TIÊN: CHO KHÁCH THỤ ĐỘNG (80% TRAFFIC)             -->
        <!-- ============================================================== -->

        <!-- Smart Context Chips (Bộ lọc nhu cầu 1-chạm) -->
        ${renderSmartContextChips()}

        <!-- 1. Bảng Tổng Hợp Mã Giảm Giá Hot Nhất Trong Ngày -->
        ${renderDailyHotVoucherBoard()}

        <!-- 2. Kệ Deal Tuyển Chọn KTX (22-50 SKU) -->
        <div style="margin-bottom: var(--space-4);">
          <div style="margin-bottom: var(--space-3);">
            <input 
              type="text" 
              id="input-dorm-search" 
              placeholder="🔍 Tìm ổ cắm chống giật, ấm siêu tốc, quạt tích điện, bàn học, nệm KTX, máy tính Casio..." 
              value="${state.dormSearchKeyword || ''}" 
              style="width: 100%; min-height: 48px; padding: 0 var(--space-4); border-radius: var(--radius-control); border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.95rem;" 
              aria-label="Tìm kiếm sản phẩm KTX"
            />
          </div>
          <div class="dorm-filter-bar" role="tablist" style="display: flex; gap: 8px; flex-wrap: wrap;">
            ${categories.map(c => {
              const isAct = (selectedCat === 'ALL' && c.id === 'ALL') || selectedCat === c.match;
              return `
                <button 
                  type="button"
                  class="dorm-tab-btn btn-dorm-cat ${isAct ? 'active is-active' : ''}" 
                  data-dorm-cat="${c.match || 'ALL'}"
                  style="padding: 8px 14px; border-radius: var(--radius-chip); font-size: 13px; font-weight: ${isAct ? '700' : '500'}; cursor: pointer; border: 1px solid ${isAct ? 'var(--accent)' : 'var(--border-color)'}; background: ${isAct ? 'var(--accent)' : 'var(--bg-card)'}; color: ${isAct ? '#ffffff' : 'var(--text-main)'}; min-height: 40px;"
                >
                  ${c.label}
                </button>
              `;
            }).join('')}
          </div>
        </div>

        <!-- Two contrasting, responsive Shopee price shelves -->
        ${renderJ465DormPriceShelf('Nhóm 1 — Đồ KTX Sinh Tồn ≤ 49K 🔥 [ƯU TIÊN HÒA KHÁNH]', 'Vật dụng thiết yếu giá đáy KTX Bách Khoa & Sư Phạm · Đối soát đáy 30–90 ngày qua.', cluster1Survival, '#10B981')}
        ${renderJ465DormPriceShelf('Nhóm 2 — Góc Bàn Học & Deadline Decor ≤ 199K 💻', 'Quạt mini Turbo, đèn LED chống cận, tai nghe không dây, sạc dự phòng trong suốt 30000mAh.', cluster2Desk, '#3B82F6')}
        ${renderJ465DormPriceShelf('Nhóm 3 — Phụ Kiện Công Nghệ & Tiện Ích KTX ⚡', 'Cáp sạc nhanh 65W, loa bluetooth mini, đồ ăn vặt & nhu yếu phẩm KTX Đà Nẵng.', cluster3Living, '#F59E0B')}

        ${filteredProducts.length === 0 ? `
          <div style="text-align: center; padding: 40px; color: var(--text-muted); background: var(--bg-card); border-radius: var(--radius-card); border: 1px dashed var(--border-color);">
            Không tìm thấy vật dụng KTX phù hợp từ khóa "${query}". Vui lòng thử từ khóa khác hoặc chọn mục Tất cả.
          </div>
        ` : ''}

        ${renderJ465AccessTradeOffers()}

        <!-- Kèo Săn Chung KTX Section -->
        <div class="bento-card" style="margin-bottom: 22px; padding: 18px; border-radius: 16px; border: 1px solid rgba(16,185,129,0.3); background: rgba(16,185,129,0.06);">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:18px;">👥</span>
              <span style="font-size:14px; font-weight:750; color:var(--text-main);">Kèo Săn Chung KTX Hòa Khánh · Gom Đơn Tiết Kiệm</span>
            </div>
            <span style="font-size:11.5px; color:#10B981; font-weight:700; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.4); padding:3px 10px; border-radius:999px;">Miễn phí ship + Giảm thêm 15k-30k/bạn</span>
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
            <label style="font-size:12px; color:var(--text-muted);">Số bạn cùng gom:
              <select id="ktx-group-count" onchange="runKtxGroupCalc()" style="margin-left:4px; padding:6px 10px; border-radius:6px; background:var(--bg-surface); color:var(--text-main); border:1px solid var(--border-color); font-size:12px;">
                <option value="2">2 bạn</option>
                <option value="3" selected>3 bạn</option>
                <option value="4">4 bạn</option>
                <option value="5">5 bạn</option>
              </select>
            </label>
            <label style="font-size:12px; color:var(--text-muted);">Tổng giỏ (VND):
              <input id="ktx-group-basket" type="number" min="50000" step="10000" value="300000" oninput="runKtxGroupCalc()" style="width:120px; margin-left:4px; padding:6px 10px; border-radius:6px; background:var(--bg-surface); color:var(--text-main); border:1px solid var(--border-color); font-size:12px;">
            </label>
            <span id="ktx-group-calc-result" style="font-size:13px; color:var(--accent); font-weight:750; margin-left:auto;">
              Mỗi bạn: 75.000đ (Tiết kiệm 25.000đ)
            </span>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- KHU VỰC NÂNG CAO: CHO KHÁCH CHỦ ĐỘNG DÁN LINK (20% TRAFFIC)     -->
        <!-- ============================================================== -->
        ${renderAuxiliaryLinkInspector()}

        <div style="margin-top: var(--space-6); padding: var(--space-3) var(--space-4); background: var(--bg-surface-subtle); border-radius: var(--radius-control); border: 1px solid var(--border-color); font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px;">
          <span>ℹ️</span>
          <span><strong>Snapshot staging chỉ đọc.</strong> Giá, điều kiện và tồn kho có thể thay đổi sau thời điểm quan sát; hãy xác nhận tại trang canonical. Không URL nào trong kệ này chứa Partner ID hay tham số tracking.</span>
        </div>
      </div>
    </section>
  `;
}

function renderFooter() {
  return `
    <footer class="jayt-footer" role="contentinfo">
      <div class="container footer-content">
        <strong>JAYT CORP — Nền tảng tiện ích số &amp; Đời sống tiêu dùng Đà Nẵng</strong>
        <p>Bản quyền &copy; 2026 Tập Đoàn OPC JayT · Công cụ chạy trên trình duyệt, không thu thập dữ liệu cá nhân.</p>
      </div>
    </footer>
  `;
}

function renderZaloModal() {
  return `
    <div id="zalo-pass-modal" class="zalo-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="zalo-modal-title">
      <div class="zalo-modal-dialog">
        <div class="zalo-modal-header">
          <h3 id="zalo-modal-title" class="zalo-modal-title">🎟️ Thẻ Zalo Pass Chia Tiền Kèo Nhóm</h3>
          <button id="btn-close-zalo-modal" class="btn-modal-close" aria-label="Đóng cửa sổ">✕</button>
        </div>

        <div class="zalo-canvas-preview-box">
          <canvas id="canvas-zalo-offer-pass" width="1080" height="1440" style="width: 100%; max-height: 380px; object-fit: contain;"></canvas>
        </div>

        <div class="zalo-form-grid">
          <div>
            <label for="zalo-modal-people-count" style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 4px;">Số người tham gia (1&ndash;50):</label>
            <input type="number" id="zalo-modal-people-count" class="zalo-form-input" min="1" max="50" value="2" />
            <div id="err-people-count" class="form-error-msg">Vui lòng nhập số nguyên từ 1 đến 50</div>
          </div>
          <div>
            <label for="zalo-modal-total-amount" style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 4px;">Tổng tiền kèo (VNĐ):</label>
            <input type="number" id="zalo-modal-total-amount" class="zalo-form-input" step="1000" min="1000" value="100000" />
            <div id="err-total-amount" class="form-error-msg">Vui lòng nhập số tiền hợp lệ (> 0 VNĐ)</div>
          </div>
        </div>

        <div id="zalo-modal-split-explanation" class="split-rule-info">
          <!-- Populated by JS -->
        </div>

        <div class="modal-action-row">
          <button id="btn-download-zalo-png" class="btn-cta-primary" style="flex: 1;">
            Xuất vé Zalo Pass (PNG)
          </button>
          <button id="btn-copy-zalo-text" class="btn-cta-secondary" style="flex: 1;">
            📋 Sao Chép Tin Nhắn
          </button>
          <button id="btn-share-zalo-native" class="btn-cta-secondary" style="min-width: 100px;">
            🚀 Chia Sẻ
          </button>
        </div>
      </div>
    </div>
  `;
}

// Canvas Drawer
function openZaloProductDealPass(skuId = null, customData = null) {
  let product = null;
  if (skuId && typeof J387_DORM_SKUS !== 'undefined') {
    product = J387_DORM_SKUS.find(p => p.sku_id === skuId);
  }
  const title = (product ? product.product_name : '') || (customData ? customData.title : '') || 'Vật dụng KTX sinh viên';
  const brand = (product ? product.merchant_name : '') || (customData ? customData.brand : '') || 'Shopee Mall';
  const total = (product ? product.observed_price : 0) || (customData ? customData.price : 68000) || 68000;
  const originalPrice = (customData && customData.originalPrice) ? customData.originalPrice : (product ? Math.round(product.observed_price * 1.5) : 125000);
  const voucherCode = (customData && customData.voucherCode) ? customData.voucherCode : 'SHOPEELIVE50';
  const qrUrl = (product ? product.canonical_url : '') || (customData ? customData.url : '') || 'https://jayt-production-v3420.vercel.app/#dorm-shopping-module';

  const savings = Math.max(0, originalPrice - total);
  const discountPercent = originalPrice > 0 ? Math.round((savings / originalPrice) * 100) : 45;

  state.activeZaloModal = {
    isProductPass: true,
    skuId: skuId || 'deal_radar',
    offerId: skuId || 'deal_radar',
    brand: brand,
    title: title,
    campusName: 'KTX Hòa Khánh · Cụm ĐH Đà Nẵng',
    count: 4,
    total: total,
    originalPrice: originalPrice,
    voucherCode: voucherCode,
    savings: savings,
    discountPercent: discountPercent,
    qrUrl: qrUrl
  };

  const modal = document.getElementById('zalo-pass-modal');
  if (modal) {
    modal.classList.add('is-open');
  }

  const peopleIn = document.getElementById('zalo-modal-people-count');
  const totalIn = document.getElementById('zalo-modal-total-amount');

  if (peopleIn) peopleIn.value = 4;
  if (totalIn) totalIn.value = total;

  updateZaloModalPass();
}

function drawZaloProductDealPass(ctx, W, H, passData, isDark) {
  // Background
  ctx.fillStyle = '#06090E';
  ctx.fillRect(0, 0, W, H);

  // Outer Card Frame
  const pad = 40;
  ctx.fillStyle = '#0E1611';
  ctx.strokeStyle = '#D4AF37';
  ctx.lineWidth = 4;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(pad, pad, W - pad * 2, H - pad * 2, 32);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(pad, pad, W - pad * 2, H - pad * 2);
    ctx.strokeRect(pad, pad, W - pad * 2, H - pad * 2);
  }

  // Top Header Banner
  ctx.fillStyle = '#16221B';
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(pad, pad, W - pad * 2, 160, [32, 32, 0, 0]);
    ctx.fill();
  } else {
    ctx.fillRect(pad, pad, W - pad * 2, 160);
  }

  ctx.fillStyle = '#D4AF37';
  ctx.fillRect(pad, pad + 158, W - pad * 2, 3);

  ctx.fillStyle = '#E5C378';
  ctx.font = 'bold 24px -apple-system, sans-serif';
  ctx.fillText('JAYT DEALS · HỆ ĐIỀU HÀNH TIẾT KIỆM SỐ ĐÀ NẴNG', 80, 105);

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 44px -apple-system, sans-serif';
  ctx.fillText('KÈO SĂN CHUNG KTX HÒA KHÁNH 👥', 80, 160);

  // Merchant Tag
  ctx.fillStyle = '#10B981';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  ctx.fillText(('🏪 ' + (passData.brand || 'SHOPEE MALL CHÍNH HÃNG')).toUpperCase(), 80, 260);

  // Product Title (Wrapped up to 3 lines)
  ctx.fillStyle = '#F4EFE6';
  ctx.font = 'bold 40px -apple-system, sans-serif';
  const words = (passData.title || 'Vật dụng KTX sinh viên').split(' ');
  let line = '';
  let yPos = 320;
  let linesCount = 0;
  for (let n = 0; n < words.length; n++) {
    const testLine = line + words[n] + ' ';
    const metrics = ctx.measureText(testLine);
    if (metrics.width > 920 && n > 0) {
      ctx.fillText(line, 80, yPos);
      line = words[n] + ' ';
      yPos += 48;
      linesCount++;
      if (linesCount >= 3) break;
    } else {
      line = testLine;
    }
  }
  if (linesCount < 3) {
    ctx.fillText(line, 80, yPos);
    yPos += 48;
  }

  // Locality descriptor
  ctx.fillStyle = '#A3B1A8';
  ctx.font = '24px -apple-system, sans-serif';
  ctx.fillText('📍 ' + (passData.campusName || 'KTX Bách Khoa & Sư Phạm · Liên Chiểu, Đà Nẵng'), 80, yPos + 10);

  // High-contrast 2-tier price comparison box
  const priceBoxY = yPos + 50;
  ctx.fillStyle = '#141E17';
  ctx.strokeStyle = '#D4AF37';
  ctx.lineWidth = 2.5;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(80, priceBoxY, W - 160, 240, 20);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(80, priceBoxY, W - 160, 240);
    ctx.strokeRect(80, priceBoxY, W - 160, 240);
  }

  // Listed Price
  ctx.fillStyle = '#8C9990';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  ctx.fillText('GIÁ NIÊM YẾT:', 120, priceBoxY + 55);

  const origStr = Number(passData.originalPrice || (passData.total * 1.5)).toLocaleString('vi-VN') + ' ₫';
  ctx.fillStyle = '#EF4444';
  ctx.font = 'bold 36px -apple-system, sans-serif';
  ctx.fillText(origStr, 340, priceBoxY + 55);
  const origMetrics = ctx.measureText(origStr);
  ctx.strokeStyle = '#EF4444';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(335, priceBoxY + 44);
  ctx.lineTo(345 + origMetrics.width, priceBoxY + 44);
  ctx.stroke();

  // JayT Bottom Price
  ctx.fillStyle = '#E5C378';
  ctx.font = 'bold 28px -apple-system, sans-serif';
  ctx.fillText('GIÁ ÉP ĐÁY JAYT:', 120, priceBoxY + 130);

  ctx.fillStyle = '#34D399';
  ctx.font = 'bold 74px -apple-system, sans-serif';
  ctx.fillText(Number(passData.total).toLocaleString('vi-VN') + ' ₫', 120, priceBoxY + 210);

  // Savings Badge
  ctx.fillStyle = '#F59E0B';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  const savStr = '★ TIẾT KIỆM ' + Number(passData.savings || (passData.originalPrice - passData.total)).toLocaleString('vi-VN') + ' ₫ (' + (passData.discountPercent || 45) + '%)';
  ctx.fillText(savStr, 560, priceBoxY + 210);

  // Applied Voucher Box
  const voucherBoxY = priceBoxY + 265;
  ctx.fillStyle = '#0A110D';
  ctx.strokeStyle = '#E5C378';
  ctx.lineWidth = 2;
  ctx.setLineDash([8, 8]);
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(80, voucherBoxY, W - 160, 100, 16);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(80, voucherBoxY, W - 160, 100);
    ctx.strokeRect(80, voucherBoxY, W - 160, 100);
  }
  ctx.setLineDash([]);

  ctx.fillStyle = '#A3B1A8';
  ctx.font = 'bold 24px -apple-system, sans-serif';
  ctx.fillText('MÃ VOUCHER ÁP DỤNG:', 120, voucherBoxY + 58);

  ctx.fillStyle = '#E5C378';
  ctx.font = 'bold 38px monospace';
  ctx.fillText(passData.voucherCode || 'SHOPEELIVE50', 500, voucherBoxY + 60);

  // Roommate Split Box
  const splitBoxY = voucherBoxY + 125;
  ctx.fillStyle = 'rgba(16,185,129,0.12)';
  ctx.strokeStyle = '#10B981';
  ctx.lineWidth = 2.5;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(80, splitBoxY, W - 160, 140, 18);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(80, splitBoxY, W - 160, 140);
    ctx.strokeRect(80, splitBoxY, W - 160, 140);
  }

  const memberCount = passData.count || 4;
  const perPerson = Math.ceil(passData.total / memberCount);

  ctx.fillStyle = '#10B981';
  ctx.font = 'bold 24px -apple-system, sans-serif';
  ctx.fillText('RỦ BẠN PHÒNG TRỌ MUA CHUNG (' + memberCount + ' BẠN):', 120, splitBoxY + 50);

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 46px -apple-system, sans-serif';
  ctx.fillText('Mỗi bạn chỉ: ' + perPerson.toLocaleString('vi-VN') + ' ₫', 120, splitBoxY + 105);

  ctx.fillStyle = '#E5C378';
  ctx.font = '22px -apple-system, sans-serif';
  ctx.fillText('✓ Tiết kiệm thêm phí ship KTX', 650, splitBoxY + 105);

  // QR Code Area
  const qrBoxX = W - 300;
  const qrBoxY = splitBoxY + 165;
  const qrBoxSize = 220;

  ctx.fillStyle = '#FFFFFF';
  ctx.strokeStyle = '#D5DCE3';
  ctx.lineWidth = 2;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize, 16);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize);
    ctx.strokeRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize);
  }

  if (typeof window !== 'undefined' && typeof window.qrcode === 'function') {
    try {
      const qr = window.qrcode(0, 'M');
      qr.addData(passData.qrUrl || 'https://jayt-production-v3420.vercel.app/#dorm-shopping-module');
      qr.make();
      const count = qr.getModuleCount();
      const cellSize = (qrBoxSize - 28) / count;
      ctx.fillStyle = '#000000';
      for (let r = 0; r < count; r++) {
        for (let c = 0; c < count; c++) {
          if (qr.isDark(r, c)) {
            ctx.fillRect(
              Math.floor(qrBoxX + 14 + c * cellSize),
              Math.floor(qrBoxY + 14 + r * cellSize),
              Math.ceil(cellSize),
              Math.ceil(cellSize)
            );
          }
        }
      }
    } catch (e) {
      console.error('QR draw error:', e);
    }
  }

  // Footer text
  ctx.fillStyle = '#E5C378';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  ctx.fillText('QUÉT MÃ SĂN DEAL ĐÁY NGAY', 80, qrBoxY + 50);

  ctx.fillStyle = '#A3B1A8';
  ctx.font = '21px -apple-system, sans-serif';
  ctx.fillText('• Bóc tách link <= 0.2ms · Không đoán voucher ẩn', 80, qrBoxY + 95);
  ctx.fillText('• Giá quan sát có thể thay đổi · Mở trang canonical', 80, qrBoxY + 135);

  ctx.fillStyle = '#10B981';
  ctx.font = 'bold 21px -apple-system, sans-serif';
  ctx.fillText('✓ Bảo toàn tròn đồng · #AffiliateValueFirst · JayT Corp', 80, qrBoxY + 175);
}

function drawCanvasPass(canvas, passData) {
  if (passData && passData.isProductPass) {
    drawZaloProductDealPass(ctx, W, H, passData, isDark);
    return;
  }
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = 1080;
  const H = 1440;

  const isDark = (state.theme === 'theme-dark');

  // Background
  ctx.fillStyle = isDark ? '#101419' : '#F7F8FA';
  ctx.fillRect(0, 0, W, H);

  // Card Outer Container
  const pad = 40;
  ctx.fillStyle = isDark ? '#1B222A' : '#FFFFFF';
  ctx.strokeStyle = isDark ? '#43505E' : '#D5DCE3';
  ctx.lineWidth = 3;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(pad, pad, W - pad * 2, H - pad * 2, 32);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(pad, pad, W - pad * 2, H - pad * 2);
    ctx.strokeRect(pad, pad, W - pad * 2, H - pad * 2);
  }

  // Header Banner
  ctx.fillStyle = '#D4AF37';
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(pad, pad, W - pad * 2, 160, [32, 32, 0, 0]);
    ctx.fill();
  } else {
    ctx.fillRect(pad, pad, W - pad * 2, 160);
  }

  ctx.fillStyle = '#FFFFFF';
  ctx.font = 'bold 44px -apple-system, sans-serif';
  ctx.fillText('JAYT ĐÀ NẴNG', 80, 115);

  ctx.font = '22px -apple-system, sans-serif';
  ctx.fillText('PHIẾU KÈO NHÓM & CHIA TIỀN CHÍNH XÁC', 80, 160);

  // Brand and Offer Title
  ctx.fillStyle = '#D4AF37';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  ctx.fillText((passData.brand || 'ƯU ĐÃI ĐỐI SOÁT').toUpperCase(), 80, 265);

  ctx.fillStyle = isDark ? '#F3F6FA' : '#17212B';
  ctx.font = 'bold 42px -apple-system, sans-serif';
  const words = (passData.title || '').split(' ');
  let line = '';
  let yPos = 325;
  let linesCount = 0;
  for (let n = 0; n < words.length; n++) {
    const testLine = line + words[n] + ' ';
    const metrics = ctx.measureText(testLine);
    if (metrics.width > 920 && n > 0) {
      ctx.fillText(line, 80, yPos);
      line = words[n] + ' ';
      yPos += 46;
      linesCount++;
      if (linesCount >= 3) break;
    } else {
      line = testLine;
    }
  }
  if (linesCount < 3) {
    ctx.fillText(line, 80, yPos);
  }

  // Campus / Area descriptor
  ctx.fillStyle = isDark ? '#B7C2CE' : '#526171';
  ctx.font = '24px -apple-system, sans-serif';
  ctx.fillText('📍 ' + (passData.campusName || 'Cụm trường liên kết Đà Nẵng'), 80, yPos + 48);

  // Dashed divider
  ctx.strokeStyle = isDark ? '#43505E' : '#D5DCE3';
  ctx.lineWidth = 2;
  ctx.setLineDash([12, 10]);
  ctx.beginPath();
  ctx.moveTo(80, 680);
  ctx.lineTo(W - 80, 680);
  ctx.stroke();
  ctx.setLineDash([]);

  // Bill & Split Summary
  ctx.fillStyle = isDark ? '#B7C2CE' : '#526171';
  ctx.font = '24px -apple-system, sans-serif';
  ctx.fillText('SỐ THÀNH VIÊN:', 80, 750);
  ctx.fillText('TỔNG HÓA ĐƠN KÈO:', 560, 750);

  ctx.fillStyle = isDark ? '#F3F6FA' : '#17212B';
  ctx.font = 'bold 38px -apple-system, sans-serif';
  ctx.fillText(passData.count + ' người', 80, 805);
  ctx.fillText(Number(passData.total).toLocaleString('vi-VN') + ' ₫', 560, 805);

  // Big Share Box
  ctx.fillStyle = isDark ? '#064E3B' : '#ECFDF5';
  ctx.strokeStyle = '#D4AF37';
  ctx.lineWidth = 3;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(80, 860, W - 160, 240, 20);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(80, 860, W - 160, 240);
    ctx.strokeRect(80, 860, W - 160, 240);
  }

  ctx.fillStyle = '#D4AF37';
  ctx.font = 'bold 26px -apple-system, sans-serif';
  ctx.fillText('MỖI BẠN CHUYỂN KHOẢN:', 120, 920);

  ctx.fillStyle = isDark ? '#F3F6FA' : '#17212B';
  ctx.font = 'bold 74px -apple-system, sans-serif';
  ctx.fillText(Number(passData.higherShare).toLocaleString('vi-VN') + ' ₫', 120, 1005);

  ctx.font = '24px -apple-system, sans-serif';
  if (passData.remainder > 0) {
    ctx.fillStyle = '#D97706';
    ctx.fillText('★ ' + passData.higherCount + ' bạn chuyển ' + Number(passData.higherShare).toLocaleString('vi-VN') + '₫  •  ' + passData.lowerCount + ' bạn chuyển ' + Number(passData.lowerShare).toLocaleString('vi-VN') + '₫', 120, 1065);
  } else {
    ctx.fillStyle = '#D4AF37';
    ctx.fillText('✓ Chia đều chẵn tiền cho toàn bộ ' + passData.count + ' thành viên (Bảo toàn 100%)', 120, 1065);
  }

  // QR Code Area (Bottom Section)
  const qrUrl = passData.qrUrl || ('https://jayt-production-v3420.vercel.app/#offer-' + passData.offerId);
  const qrBoxX = W - 320;
  const qrBoxY = 1130;
  const qrBoxSize = 240;

  ctx.fillStyle = '#FFFFFF';
  ctx.strokeStyle = '#D5DCE3';
  ctx.lineWidth = 2;
  if (ctx.roundRect) {
    ctx.beginPath();
    ctx.roundRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize, 16);
    ctx.fill();
    ctx.stroke();
  } else {
    ctx.fillRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize);
    ctx.strokeRect(qrBoxX, qrBoxY, qrBoxSize, qrBoxSize);
  }

  if (typeof window !== 'undefined' && typeof window.qrcode === 'function') {
    try {
      const qr = window.qrcode(0, 'M');
      qr.addData(qrUrl);
      qr.make();
      const count = qr.getModuleCount();
      const cellSize = (qrBoxSize - 32) / count;
      ctx.fillStyle = '#000000';
      for (let r = 0; r < count; r++) {
        for (let c = 0; c < count; c++) {
          if (qr.isDark(r, c)) {
            ctx.fillRect(
              Math.floor(qrBoxX + 16 + c * cellSize),
              Math.floor(qrBoxY + 16 + r * cellSize),
              Math.ceil(cellSize),
              Math.ceil(cellSize)
            );
          }
        }
      }
    } catch (e) {
      console.error('QR draw error:', e);
    }
  }

  // QR Label & Footer Text
  ctx.fillStyle = isDark ? '#F3F6FA' : '#17212B';
  ctx.font = 'bold 24px -apple-system, sans-serif';
  ctx.fillText('QR MỞ KÈO', 80, 1170);

  ctx.fillStyle = isDark ? '#B7C2CE' : '#526171';
  ctx.font = '22px -apple-system, sans-serif';
  ctx.fillText('Quét QR bằng Zalo hoặc Camera để xem chi tiết ưu đãi tại JayT', 80, 1215);

  ctx.font = '20px -apple-system, sans-serif';
  ctx.fillText('✓ Dữ liệu đối soát minh bạch — Không phát sinh chênh lệch tiền lẻ', 80, 1260);

  ctx.font = '20px monospace';
  ctx.fillText('https://jayt-production-v3420.vercel.app', 80, 1340);
}

function showToast(msg) {
  const container = document.getElementById('jayt-toast-container');
  if (!container) return;
  const toast = document.createElement('div');
  toast.className = 'jayt-toast';
  toast.innerText = msg;
  container.appendChild(toast);
  setTimeout(() => {
    if (container.contains(toast)) {
      container.removeChild(toast);
    }
  }, 3200);
}

function updateCampusOffersDOM(focusOnNextCard) {
  const t0 = (typeof performance !== 'undefined') ? performance.now() : Date.now();

  // 1. Update Campus Dock Buttons aria-pressed
  document.querySelectorAll('.campus-dock-btn').forEach(btn => {
    const cid = btn.getAttribute('data-cluster-id');
    const isSelected = (cid === state.selectedClusterId);
    btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
    btn.classList.toggle('is-active', isSelected);
  });

  // 2. Update Summary Box
  const summaryBox = document.getElementById('cluster-summary-box');
  if (summaryBox) {
    summaryBox.innerHTML = renderClusterSummaryPanel();
  }

  // 3. Sort by active schedule slot and paginate
  const filtered = getFilteredOffers();
  const currentSlot = getCurrentScheduleSlot();
  const activeSlotId = state.scheduleSlot || currentSlot.id;

  const sorted = [...filtered].sort((a, b) => {
    const sA = getOfferSlotRelevance(a, activeSlotId);
    const sB = getOfferSlotRelevance(b, activeSlotId);
    return sB - sA;
  });

  if (!state.visibleOfferCount) {
    state.visibleOfferCount = (typeof window !== 'undefined' && window.innerWidth < 768) ? 6 : ((typeof window !== 'undefined' && window.innerWidth < 1024) ? 9 : 12);
  }

  const visibleOffers = sorted.slice(0, state.visibleOfferCount);

  // 4. Populate container with Visual Cards
  const container = document.getElementById('campus-offers-container');
  if (container) {
    if (visibleOffers.length === 0) {
      container.innerHTML = `
        <div class="empty-offers-card" style="grid-column: 1 / -1; padding: 40px 20px; text-align: center; background: var(--bg-card); border-radius: var(--radius-card); border: 1px dashed var(--border-color);">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🔍</div>
          <h3 class="empty-offers-title" style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Chưa có kèo phù hợp</h3>
          <p class="empty-offers-desc" style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">
            Rất tiếc chưa tìm thấy ưu đãi theo bộ lọc bạn chọn. Vui lòng đổi cụm cơ sở hoặc xem danh sách đầy đủ toàn thành phố.
          </p>
          <button class="btn-cta-primary" id="btn-empty-reset-all" style="padding: 10px 24px; min-height: 44px; border-radius: var(--radius-chip); cursor: pointer;">
            Xem tất cả ${J372_OFFERS.length} ưu đãi Đà Nẵng &rarr;
          </button>
        </div>
      `;
    } else {
      const prevNodesCount = container.children.length;
      const nodes = visibleOffers.map(o => {
        let n = OFFER_DOM_NODES.get(o.offer_id);
        if (!n) {
          n = renderSingleVisualCard(o);
          OFFER_DOM_NODES.set(o.offer_id, n);
        }
        return n;
      });
      container.replaceChildren(...nodes);

      if (focusOnNextCard && nodes.length > prevNodesCount && nodes[prevNodesCount]) {
        const firstNew = nodes[prevNodesCount].querySelector('button');
        if (firstNew) firstNew.focus();
      }
    }
  }

  // 5. Update Pagination View More button
  const paginContainer = document.getElementById('pagination-container');
  if (paginContainer) {
    const remaining = Math.max(0, sorted.length - state.visibleOfferCount);
    if (remaining > 0) {
      paginContainer.innerHTML = `
        <button type="button" class="btn-view-more-offers" id="btn-view-more-offers">
          Xem thêm (còn ${remaining} ưu đãi) ↓
        </button>
      `;
      const moreBtn = document.getElementById('btn-view-more-offers');
      if (moreBtn) {
        moreBtn.addEventListener('click', () => {
          const step = (typeof window !== 'undefined' && window.innerWidth < 768) ? 6 : ((typeof window !== 'undefined' && window.innerWidth < 1024) ? 9 : 12);
          state.visibleOfferCount = (state.visibleOfferCount || 12) + step;
          updateCampusOffersDOM(true);
        });
      }
    } else {
      paginContainer.innerHTML = '';
    }
  }

  // 6. Update Schedule Rhythm Header
  const rhythmContainer = document.getElementById('schedule-rhythm-container');
  if (rhythmContainer) {
    rhythmContainer.innerHTML = renderScheduleRhythmSection();
    attachScheduleRhythmEvents();
  }

  // 7. Update dynamic deals section description
  const dealsDesc = document.getElementById('deals-section-dynamic-desc');
  if (dealsDesc) {
    dealsDesc.textContent = getDealsSectionDesc();
  }

  const t1 = (typeof performance !== 'undefined') ? performance.now() : Date.now();
  if (typeof window !== 'undefined') {
    window.lastCampusSwitchDurationMs = (t1 - t0);
  }
}

function openZaloModal(offerId, defaultCount, customOffer = null) {
  const offer = (offerId ? J372_OFFERS.find(o => o.offer_id === offerId) : null) || customOffer;
  if (!offer) return;

  const priceInfo = extractOfferPrice(offer);
  const count = parseInt(defaultCount, 10) || 2;

  let total = 100000;
  if (priceInfo.basePrice > 0) {
    total = priceInfo.isPerPerson ? (priceInfo.basePrice * count) : priceInfo.basePrice;
  }

  const currentCluster = J372_CAMPUS_MAPPING.clusters.find(c => c.cluster_id === state.selectedClusterId);
  const campusName = currentCluster ? currentCluster.name : 'Đà Nẵng';

  state.activeZaloModal = {
    offerId: offerId,
    brand: offer.brand || 'JayT Đối Soát',
    title: offer.title,
    campusName: campusName,
    count: count,
    total: total,
    isPerPerson: priceInfo.isPerPerson,
    basePrice: priceInfo.basePrice
  };

  const modal = document.getElementById('zalo-pass-modal');
  if (modal) {
    modal.classList.add('is-open');
  }

  const peopleIn = document.getElementById('zalo-modal-people-count');
  const totalIn = document.getElementById('zalo-modal-total-amount');

  if (peopleIn) peopleIn.value = count;
  if (totalIn) totalIn.value = total;

  updateZaloModalPass();
}

function updateZaloModalPass() {
  if (!state.activeZaloModal) return;

  const peopleIn = document.getElementById('zalo-modal-people-count');
  const totalIn = document.getElementById('zalo-modal-total-amount');
  const errPeople = document.getElementById('err-people-count');
  const errTotal = document.getElementById('err-total-amount');
  const expBox = document.getElementById('zalo-modal-split-explanation');

  const countVal = parseInt(peopleIn.value, 10);
  const totalVal = parseInt(totalIn.value, 10);

  let hasError = false;
  if (isNaN(countVal) || countVal < 1 || countVal > 50) {
    if (errPeople) errPeople.classList.add('is-visible');
    hasError = true;
  } else {
    if (errPeople) errPeople.classList.remove('is-visible');
  }

  if (isNaN(totalVal) || totalVal <= 0) {
    if (errTotal) errTotal.classList.add('is-visible');
    hasError = true;
  } else {
    if (errTotal) errTotal.classList.remove('is-visible');
  }

  if (hasError) return;

  const split = calculateIntegerSplit(totalVal, countVal);
  state.activeZaloModal.count = countVal;
  state.activeZaloModal.total = totalVal;
  state.activeZaloModal.higherShare = split.higherShare;
  state.activeZaloModal.lowerShare = split.lowerShare;
  state.activeZaloModal.higherCount = split.higherCount;
  state.activeZaloModal.lowerCount = split.lowerCount;
  state.activeZaloModal.remainder = split.remainder;

  if (expBox) {
    if (split.remainder === 0) {
      expBox.innerHTML = `<strong style="color: #D4AF37;">✓ Chia đều:</strong> Tất cả ${countVal} bạn chuyển đúng <strong>${Number(split.baseShare).toLocaleString('vi-VN')} ₫</strong>.`;
    } else {
      expBox.innerHTML = `<strong style="color: #D97706;">★ Phân bổ bù lẻ:</strong> ${split.higherCount} bạn chuyển <strong>${Number(split.higherShare).toLocaleString('vi-VN')} ₫</strong> &bull; ${split.lowerCount} bạn chuyển <strong>${Number(split.lowerShare).toLocaleString('vi-VN')} ₫</strong>.`;
    }
  }

  const canvas = document.getElementById('canvas-zalo-offer-pass');
  drawCanvasPass(canvas, state.activeZaloModal);
}

function attachAppEvents() {
  // Ecosystem tabs delegation
  const ecoBar = document.querySelector('.ecosystem-filter-bar');
  if (ecoBar && !ecoBar._hasListener) {
    ecoBar._hasListener = true;
    ecoBar.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-ecosystem-tab');
      if (!btn) return;
      state.selectedEcosystem = btn.getAttribute('data-ecosystem') || 'ALL';
      if (state.selectedEcosystem === 'dorm') {
        const dormMod = document.getElementById('dorm-shopping-module');
        if (dormMod) { dormMod.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      }
      if (state.selectedEcosystem === 'dorm') {
        const dormMod = document.getElementById('dorm-shopping-module');
        if (dormMod) { dormMod.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      }
      if (state.selectedEcosystem === 'dorm') {
        const dormMod = document.getElementById('dorm-shopping-module');
        if (dormMod) { dormMod.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      }
      state.visibleDealCount = 20;
      updateCampusOffersDOM();
      // Re-render deals section tab active state
      document.querySelectorAll('.btn-ecosystem-tab').forEach(b => {
        const isAct = b.getAttribute('data-ecosystem') === state.selectedEcosystem;
        b.classList.toggle('is-active', isAct);
        b.setAttribute('aria-selected', isAct ? 'true' : 'false');
        b.style.background = isAct ? 'var(--accent)' : 'var(--bg-card)';
        b.style.color = isAct ? '#ffffff' : 'var(--text-main)';
        b.style.borderColor = isAct ? 'var(--accent)' : 'var(--border-color)';
      });
    });
  }

  // Cinema day tabs delegation
  const cinemaDaysBar = document.querySelector('.cinema-days-bar');
  if (cinemaDaysBar && !cinemaDaysBar._hasListener) {
    cinemaDaysBar._hasListener = true;
    cinemaDaysBar.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-cinema-day');
      if (!btn) return;
      state.selectedCinemaDay = btn.getAttribute('data-cinema-day') || 'MON';
      const container = document.getElementById('cinema-schedule-container');
      if (container) container.innerHTML = renderCinemaSevenDaySchedule();
    });
  }

  // Delegation for cinema-invite, rescue-cluster, copy-code
  document.addEventListener('click', (e) => {
    // Cinema 1-Click Group Invite
    const cinemaInviteBtn = e.target.closest('[data-action="cinema-invite"]');
    if (cinemaInviteBtn) {
      const dayLabel = cinemaInviteBtn.getAttribute('data-day-label') || 'Thứ 4';
      const highlight = cinemaInviteBtn.getAttribute('data-highlight') || 'Đồng giá vé rạp';
      const mockOffer = {
        offer_id: 'CINEMA_INVITE',
        brand: 'Rạp Phim Đà Nẵng (' + dayLabel + ')',
        title: 'Kèo Xem Phim Sinh Viên: ' + highlight,
        price: 45000,
        price_display: '45.000₫'
      };
      if (typeof openZaloModal === 'function') {
        openZaloModal(null, 2, mockOffer);
      }
      return;
    }

    // Rescue deals 25K cluster tab switching
    const rescueBtn = e.target.closest('.btn-rescue-cluster');
    if (rescueBtn) {
      const clusterId = rescueBtn.getAttribute('data-rescue-cluster');
      if (clusterId) {
        state.selectedClusterId = clusterId;
        const container = document.getElementById('rescue-deals-25k-container');
        if (container && typeof renderRescueDeals25kSection === 'function') {
          container.outerHTML = renderRescueDeals25kSection();
        }
      }
      return;
    }

    const copyBtn = e.target.closest('[data-action="copy-code"]');
    if (!copyBtn) return;
    const codeToCopy = copyBtn.getAttribute('data-code');
    if (!codeToCopy) return;

    navigator.clipboard.writeText(codeToCopy).then(() => {
      try { if (navigator.vibrate) navigator.vibrate(50); } catch (_) {}
      showToast(`Đã sao chép mã "${codeToCopy}" vào bộ nhớ tạm!`);
      copyBtn.textContent = '✓ Đã sao chép!';
      setTimeout(() => {
        copyBtn.textContent = '✂️ 1. Sao chép mã';
      }, 2000);
    }).catch(() => {
      prompt('Sao chép mã giảm giá:', codeToCopy);
    });
  });

  // Theme Toggle
  const btnTheme = document.getElementById('btn-theme-toggle');
  if (btnTheme) {
    btnTheme.addEventListener('click', () => {
      const nextTheme = (state.theme === 'theme-dark') ? 'theme-light' : 'theme-dark';
      state.theme = nextTheme;
      document.body.classList.remove('theme-light', 'theme-dark');
      document.body.classList.add(nextTheme, 'j403-gold-forest', 'j405-pinnacle');
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', nextTheme === 'theme-light' ? '#F4EFE4' : '#141C16');
      if (typeof window !== 'undefined') {
        localStorage.setItem('jayt_theme', nextTheme);
      }
      renderApp();
    });
  }

  
  // Mobile Navigation Drawer Controls & Focus Trap (NAV_02)
  const btnMobileMenu = document.getElementById('btn-mobile-menu');
  const btnCloseDrawer = document.getElementById('btn-close-mobile-menu');
  const drawerBackdrop = document.getElementById('mobile-nav-backdrop');
  const navDrawer = document.getElementById('mobile-nav-drawer');
  let lastFocusedNavTrigger = null;

  function openMobileMenu() {
    if (!navDrawer || !drawerBackdrop) return;
    lastFocusedNavTrigger = document.activeElement;
    drawerBackdrop.style.display = 'block';
    navDrawer.style.display = 'flex';
    // Force reflow
    void navDrawer.offsetWidth;
    drawerBackdrop.classList.add('open');
    navDrawer.classList.add('open');
    if (btnMobileMenu) btnMobileMenu.setAttribute('aria-expanded', 'true');
    if (btnCloseDrawer) btnCloseDrawer.focus();
    document.addEventListener('keydown', handleDrawerKeydown);
  }

  function closeMobileMenu() {
    if (!navDrawer || !drawerBackdrop) return;
    drawerBackdrop.classList.remove('open');
    navDrawer.classList.remove('open');
    if (btnMobileMenu) btnMobileMenu.setAttribute('aria-expanded', 'false');
    document.removeEventListener('keydown', handleDrawerKeydown);
    setTimeout(() => {
      drawerBackdrop.style.display = 'none';
      navDrawer.style.display = 'none';
    }, 160);
    if (lastFocusedNavTrigger && typeof lastFocusedNavTrigger.focus === 'function') {
      lastFocusedNavTrigger.focus();
    }
  }

  function handleDrawerKeydown(e) {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeMobileMenu();
      return;
    }
    if (e.key === 'Tab') {
      const focusables = navDrawer.querySelectorAll('button, a[href]');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  if (btnMobileMenu) {
    btnMobileMenu.onclick = () => {
      const isExpanded = btnMobileMenu.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    };
  }

  if (btnCloseDrawer) {
    btnCloseDrawer.onclick = closeMobileMenu;
  }

  if (drawerBackdrop) {
    drawerBackdrop.onclick = closeMobileMenu;
  }

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.onclick = (e) => {
      const targetId = link.getAttribute('data-target');
      closeMobileMenu();
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth' });
        }
      }
    };
  });

  // Campus Dock Button Clicks (In-Memory Filter)
  document.querySelectorAll('.campus-dock-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.selectedClusterId = btn.getAttribute('data-cluster-id') || 'ALL';
      try { localStorage.setItem('jayt_campus_cluster', state.selectedClusterId); } catch (_) {}
      updateCampusOffersDOM();
    });
  });

  // Category tabs
  document.querySelectorAll('[data-deal-cat]').forEach(btn => {
    btn.addEventListener('click', () => {
      state.selectedDealCategory = btn.getAttribute('data-deal-cat');
      document.querySelectorAll('[data-deal-cat]').forEach(b => {
        const isActive = (b.getAttribute('data-deal-cat') === state.selectedDealCategory);
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      updateCampusOffersDOM();
    });
  });

  // Summary box delegation (Reset button & Feed Switcher)
  const summaryBox = document.getElementById('cluster-summary-box');
  if (summaryBox) {
    summaryBox.addEventListener('click', (e) => {
      const btnReset = e.target.closest('#btn-reset-campus-filter');
      if (btnReset) {
        state.selectedClusterId = 'ALL';
        try { localStorage.setItem('jayt_campus_cluster', 'ALL'); } catch (_) {}
        updateCampusOffersDOM();
        return;
      }
      const btnFeedStudent = e.target.closest('#btn-feed-student-budget');
      if (btnFeedStudent) {
        state.storefrontFeedFilter = 'STUDENT_BUDGET';
        state.visibleDealCount = 20;
        updateCampusOffersDOM();
        return;
      }
      const btnFeedAll = e.target.closest('#btn-feed-all-catalog');
      if (btnFeedAll) {
        state.storefrontFeedFilter = 'ALL';
        state.visibleDealCount = 20;
        updateCampusOffersDOM();
        return;
      }
    });
  }

  // Event delegation on #campus-offers-container (J374 Visual-First)
  const container = document.getElementById('campus-offers-container');
  if (container && !container._hasDelegation) {
    container._hasDelegation = true;
    container.addEventListener('click', (e) => {
      // 1. Open Detail Drawer
      const detailBtn = e.target.closest('[data-action="open-drawer"]');
      if (detailBtn) {
        const offerId = detailBtn.getAttribute('data-offer-id');
        if (offerId) openOfferDrawer(offerId, detailBtn);
        return;
      }

      // 2. Open Invite / Rủ bạn kèo này
      const inviteBtn = e.target.closest('[data-action="open-invite"]');
      if (inviteBtn) {
        const offerId = inviteBtn.getAttribute('data-offer-id');
        if (offerId) openZaloModal(offerId, 2);
        return;
      }

      // 3. Quick split button
      const quickBtn = e.target.closest('.btn-zalo-quick');
      if (quickBtn) {
        openZaloModal(quickBtn.getAttribute('data-zalo-offer'), quickBtn.getAttribute('data-split'));
        return;
      }
      // 4. Custom split button
      const customBtn = e.target.closest('.btn-zalo-custom');
      if (customBtn) {
        openZaloModal(customBtn.getAttribute('data-zalo-offer'), 3);
        return;
      }
      // 5. Copy code button
      const copyBtn = e.target.closest('.btn-copy-ticket');
      if (copyBtn) {
        const code = (copyBtn.getAttribute('data-code') || '').trim();
        if (!code) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(() => {
            showToast(`✓ Đã sao chép mã ${code}!`);
          }).catch(() => {
            showToast('Mã ưu đãi: ' + code);
          });
        } else {
          showToast('Mã ưu đãi: ' + code);
        }
        return;
      }
      // 6. Empty reset button
      const emptyReset = e.target.closest('#btn-empty-reset-all');
      if (emptyReset) {
        state.selectedClusterId = 'ALL';
        state.selectedDealCategory = 'ALL';
        document.querySelectorAll('[data-deal-cat]').forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-deal-cat') === 'ALL');
        });
        updateCampusOffersDOM();
        return;
      }
    });
  }

  // Keyboard navigation & Escape key & Focus trap for Drawer
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (state.activeDrawerOfferId) {
        e.preventDefault();
        closeOfferDrawer();
      }
    }
    if (e.key === 'Tab' && state.activeDrawerOfferId) {
      const drawer = document.getElementById('offer-detail-drawer');
      if (drawer && drawer.classList.contains('is-open')) {
        const focusables = drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (focusables.length > 0) {
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }
  });

  // Deep-link popstate and hash navigation
  window.addEventListener('popstate', () => {
    if (window.location.hash.startsWith('#offer-')) {
      const offerId = window.location.hash.replace('#offer-', '');
      openOfferDrawer(offerId);
    } else if (state.activeDrawerOfferId) {
      closeOfferDrawer();
    }
  });

  // Schedule auto-recompute on visibilitychange and resume
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && !state.scheduleManualOverride && !state.activeDrawerOfferId && !onsiteState.billModalOpen) {
      const newSlot = getCurrentScheduleSlot();
      if (newSlot.id !== state.scheduleSlot) {
        state.scheduleSlot = newSlot.id;
        updateCampusOffersDOM();
      }
    }
  });

  // Zalo Modal Controls
  const btnCloseModal = document.getElementById('btn-close-zalo-modal');
  const modalBackdrop = document.getElementById('zalo-pass-modal');
  if (btnCloseModal && modalBackdrop) {
    btnCloseModal.addEventListener('click', () => modalBackdrop.classList.remove('is-open'));
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) modalBackdrop.classList.remove('is-open');
    });
  }

  const peopleIn = document.getElementById('zalo-modal-people-count');
  const totalIn = document.getElementById('zalo-modal-total-amount');
  if (peopleIn) peopleIn.addEventListener('input', updateZaloModalPass);
  if (totalIn) totalIn.addEventListener('input', updateZaloModalPass);

  // Zalo Modal Download PNG
  const btnDownloadZalo = document.getElementById('btn-download-zalo-png');
  if (btnDownloadZalo) {
    btnDownloadZalo.addEventListener('click', () => {
      const canvas = document.getElementById('canvas-zalo-offer-pass');
      if (!canvas) return;
      try {
        const url = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = url;
        a.download = `zalo_pass_${state.activeZaloModal ? state.activeZaloModal.offerId : 'jayt'}.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        showToast('✓ Đã tải Thẻ Zalo Pass (PNG)');
      } catch (err) {
        showToast('Không thể xuất ảnh: ' + err.message);
      }
    });
  }

  // Zalo Modal Copy Text
  const btnCopyZaloText = document.getElementById('btn-copy-zalo-text');
  if (btnCopyZaloText) {
    btnCopyZaloText.addEventListener('click', () => {
      if (!state.activeZaloModal) return;
      const m = state.activeZaloModal;
      if (m.isProductPass) {
        const memberCount = m.count || 4;
        const perPerson = Math.ceil(m.total / memberCount);
        const msg = [
          '🔥 [JAYT - KÈO SĂN CHUNG KTX HÒA KHÁNH]',
          'Món: ' + m.title + ' (' + m.brand + ')',
          'Giá niêm yết: ~' + Number(m.originalPrice || m.total * 1.5).toLocaleString('vi-VN') + ' ₫~',
          'Giá ép đáy JayT: ' + Number(m.total).toLocaleString('vi-VN') + ' ₫ (Tiết kiệm ' + Number(m.savings || 0).toLocaleString('vi-VN') + ' ₫)',
          'Mã voucher áp dụng: ' + (m.voucherCode || 'SHOPEELIVE50'),
          '---------------------------------',
          '👉 Rủ ' + memberCount + ' bạn mua chung, mỗi bạn chỉ: ' + Number(perPerson).toLocaleString('vi-VN') + ' ₫',
          'Link xem chi tiết: ' + (m.qrUrl || 'https://jayt-production-v3420.vercel.app/#dorm-shopping-module')
        ].join('\n');
        copyVoucherCodeToClipboard(msg);
        showToast('✓ Đã sao chép tin nhắn rủ bạn Zalo!');
        return;
      }
      const msg = [
        '🎬 [JAYT ĐÀ NẴNG - KÈO NHÓM]',
        'Ưu đãi: ' + m.title + ' (' + m.brand + ')',
        'Khu vực: ' + m.campusName,
        'Số người: ' + m.count + ' thành viên',
        'Tổng chi phí: ' + Number(m.total).toLocaleString('vi-VN') + ' ₫',
        '---------------------------------',
        m.remainder === 0
          ? '👉 Mỗi bạn chuyển: ' + Number(m.higherShare).toLocaleString('vi-VN') + ' ₫'
          : '👉 ' + m.higherCount + ' bạn chuyển: ' + Number(m.higherShare).toLocaleString('vi-VN') + ' ₫\n👉 ' + m.lowerCount + ' bạn chuyển: ' + Number(m.lowerShare).toLocaleString('vi-VN') + ' ₫',
        '---------------------------------',
        'Mở xem ưu đãi: https://jayt-production-v3420.vercel.app/#offer-' + m.offerId
      ].join('\n');

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(msg).then(() => {
          showToast('✓ Đã sao chép nội dung tin nhắn Zalo!');
        }).catch(() => {
          showToast('Vui lòng chọn thủ công tin nhắn');
        });
      }
    });
  }

  // Zalo Modal Share Native
  const btnShareZalo = document.getElementById('btn-share-zalo-native');
  if (btnShareZalo) {
    btnShareZalo.addEventListener('click', async () => {
      if (!state.activeZaloModal) return;
      const m = state.activeZaloModal;
      const shareData = {
        title: 'JayT Kèo Nhóm — ' + m.title,
        text: `Kèo nhóm ${m.count} bạn cùng đi ${m.brand}: mỗi bạn chuyển ${Number(m.higherShare).toLocaleString('vi-VN')}₫!`,
        url: 'https://jayt-production-v3420.vercel.app/#offer-' + m.offerId
      };
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (e) {
          // Share cancellation ignored per spec
        }
      } else {
        showToast('Trình duyệt chưa hỗ trợ share native. Vui lòng bấm sao chép tin nhắn!');
      }
    });
  }

  // Lunch Arbitrage Events
  const dishPriceInput = document.getElementById('slider-dish-price');
  if (dishPriceInput) {
    dishPriceInput.addEventListener('input', () => {
      state.dishPrice = parseInt(dishPriceInput.value, 10) || 35000;
      const section = document.getElementById('lunch-arbitrage-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderLunchArbitrageModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
      }
    });
  }

  document.querySelectorAll('[data-lunch-app][data-lunch-field]').forEach(input => {
    input.addEventListener('input', () => {
      const app = input.dataset.lunchApp;
      const field = input.dataset.lunchField;
      if (!state.lunchInputs[app]) state.lunchInputs[app] = { deliveryFee: 0, voucher: 0 };
      state.lunchInputs[app][field] = toNonNegativeVnd(input.value);
      const section = document.getElementById('lunch-arbitrage-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderLunchArbitrageModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
      }
    });
  });

  document.querySelectorAll('[data-lunch-scenario]').forEach(btn => {
    btn.addEventListener('click', () => {
      const scenario = btn.dataset.lunchScenario;
      state.lunchScenario[scenario] = !state.lunchScenario[scenario];
      const section = document.getElementById('lunch-arbitrage-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderLunchArbitrageModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
      }
    });
  });

  document.querySelectorAll('[data-stack-input]').forEach(input => {
    input.addEventListener('input', () => {
      state.voucherStack[input.dataset.stackInput] = toNonNegativeVnd(input.value);
      const section = document.getElementById('student-savings-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderStudentSavingsModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
      }
    });
  });

  // Split Bill Module Events
  const splitTotalIn = document.getElementById('input-split-total');
  const splitCountIn = document.getElementById('input-split-count');
  const splitActIn = document.getElementById('input-split-activity');

  function updateSplitBillModuleUI() {
    state.splitTotal = parseInt(splitTotalIn.value, 10) || 100000;
    state.splitCount = parseInt(splitCountIn.value, 10) || 3;
    state.splitActivity = (splitActIn && splitActIn.value) || '';

    const section = document.getElementById('split-bill-module');
    if (section) {
      const temp = document.createElement('div');
      temp.innerHTML = renderSplitBillModule();
      section.replaceWith(temp.firstElementChild);
      attachAppEvents();
    }
  }

  if (splitTotalIn) splitTotalIn.addEventListener('input', updateSplitBillModuleUI);
  if (splitCountIn) splitCountIn.addEventListener('input', updateSplitBillModuleUI);
  if (splitActIn) splitActIn.addEventListener('input', updateSplitBillModuleUI);

  // Dorm shopping tab buttons
  document.querySelectorAll('[data-dorm-cat]').forEach(btn => {
    btn.addEventListener('click', () => {
      state.selectedDormCategory = btn.getAttribute('data-dorm-cat');
      const section = document.getElementById('dorm-shopping-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderDormShoppingModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
      }
    });
  });

  const dormSearchInput = document.getElementById('input-dorm-search');
  if (dormSearchInput) {
    dormSearchInput.addEventListener('input', () => {
      state.dormSearchKeyword = dormSearchInput.value;
      const section = document.getElementById('dorm-shopping-module');
      if (section) {
        const temp = document.createElement('div');
        temp.innerHTML = renderDormShoppingModule();
        section.replaceWith(temp.firstElementChild);
        attachAppEvents();
        const newSearch = document.getElementById('input-dorm-search');
        if (newSearch) {
          newSearch.focus();
          newSearch.selectionStart = newSearch.selectionEnd = newSearch.value.length;
        }
      }
    });
  }
}

function handleHashNavigation() {
  const hash = window.location.hash;
  if (!hash || !hash.startsWith('#offer-')) return;
  const offerId = hash.replace('#offer-', '');

  // If in cluster filter, switch to ALL so target card is in DOM
  if (state.selectedClusterId !== 'ALL') {
    state.selectedClusterId = 'ALL';
    updateCampusOffersDOM();
  }

  setTimeout(() => {
    const el = document.getElementById('offer-' + offerId);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.classList.add('offer-highlight-active');
      setTimeout(() => el.classList.remove('offer-highlight-active'), 3000);
    }
  }, 150);
}

