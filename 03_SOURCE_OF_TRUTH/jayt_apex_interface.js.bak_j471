  function runKtxGroupCalc() {
    const count = Number(document.getElementById('ktx-group-count')?.value || 3);
    const basket = Number(document.getElementById('ktx-group-basket')?.value || 300000);
    const res = calculateKtxGroupBuy(basket, count);
    const out = document.getElementById('ktx-group-calc-result');
    if (out) {
      out.innerHTML = 'Mỗi bạn: <strong>' + res.perPersonPayable.toLocaleString('vi-VN') + 'đ</strong> (Tiết kiệm ' + res.perPersonSaving.toLocaleString('vi-VN') + 'đ/bạn)';
    }
  }
  window.runKtxGroupCalc = runKtxGroupCalc;
  window.calculateKtxGroupBuy = calculateKtxGroupBuy;
