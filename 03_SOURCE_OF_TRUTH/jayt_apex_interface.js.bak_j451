function closeChronoReminderModal() {
  const modal = document.getElementById('jayt-chrono-reminder-modal');
  if (modal) {
    modal.classList.remove('is-open');
    modal.style.display = 'none';
  }
}

function startJaytChronoHeartbeat() {
  if (typeof window === 'undefined') return;
  if (window._chronoHeartbeatStarted) return;
  window._chronoHeartbeatStarted = true;

  function tick() {
    const el = document.getElementById('jayt-chrono-live-countdown');
    if (el) {
      const info = getGoldenHourCountdownInfo();
      const statusPrefix = info.isActive ? '🔥 ĐANG TRONG GIỜ VÀNG:' : '⏳ ĐẾM LÙI ĐẾN GIỜ VÀNG TIẾP THEO:';
      const slotName = info.isActive ? info.activeSlot.name : (info.nextSlot ? info.nextSlot.name : '00:00 Săn Đêm');
      el.innerHTML = `
        <span style="color:#E5C378; font-weight:750;">${statusPrefix} <strong style="color:#F4EFE6;">${escapeHtml(slotName)}</strong></span>
        <span style="display:inline-block; margin-left:8px; background:#10B981; color:#0A110D; font-weight:900; font-family:monospace; padding:3px 8px; border-radius:6px; font-size:14px; letter-spacing:1px;">
          ${info.countdownFormatted}
        </span>
      `;
    }
  }

  setInterval(tick, 1000);
}

function renderJaytChronoCalendarHtml() {
  const countdownInfo = getGoldenHourCountdownInfo();
  const statusPrefix = countdownInfo.isActive ? '🔥 ĐANG TRONG GIỜ VÀNG:' : '⏳ ĐẾM LÙI ĐẾN GIỜ VÀNG TIẾP THEO:';
  const slotName = countdownInfo.isActive ? countdownInfo.activeSlot.name : (countdownInfo.nextSlot ? countdownInfo.nextSlot.name : '00:00 Săn Đêm');

  setTimeout(() => {
    if (typeof startJaytChronoHeartbeat === 'function') startJaytChronoHeartbeat();
  }, 100);

  return `
    <!-- JAYT-433: CHRONO-CALENDAR & GOLDEN HOUR RADAR COMPONENT -->
