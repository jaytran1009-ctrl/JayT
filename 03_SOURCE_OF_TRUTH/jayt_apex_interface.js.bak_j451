function getJaytGoldMonogramSvg(size) {
  const px = Math.max(24, Number(size) || 34);
  const id = String(px).replace(/[^0-9]/g, '') || '34';
  return '<svg class="jayt-gold-monogram" width="' + px + '" height="' + px + '" viewBox="0 0 153 167" role="img" aria-label="JT Gold Edition">' +
    '<defs><linearGradient id="jtGold' + id + '" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#d4bb92"/><stop offset="50%" stop-color="#a68b5e"/><stop offset="100%" stop-color="#d4bb92"/></linearGradient></defs>' +
    '<path fill="url(#jtGold' + id + ')" d="M145.1 0H85.3C80.9 0 77.4 3.6 77.4 7.9v105.7c0 21.1-17.2 38.3-38.3 38.3-21.1 0-38.3-17.2-38.3-38.3V75.8h-7.9v37.9c0 25.4 20.7 46.2 46.2 46.2 25.4 0 46.2-20.7 46.2-46.2V7.9H145.1V0z"/>' +
    '<path fill="url(#jtGold' + id + ')" d="M145.1 22.4H99.8v111.3h-7.9V22.4H69.5v-7.9h83.5v7.9z"/>' +
    '</svg>';
}

