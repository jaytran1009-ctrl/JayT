function renderManualProductPromptHtml(radar, parsed, isModal = false) {
  // Zero-Typing Mandate (JAYT-423): 100% automated 1-Click experience, zero manual input UI
  return '';
}

function applyManualProductName(sourceInputId = null) {
  let val = '';
  if (sourceInputId) {
    const el = document.getElementById(sourceInputId);
    if (el) val = el.value;
  }
  if (!val) {
    const modalInput = document.getElementById('jayt-modal-manual-product-name');
    const inlineInput = document.getElementById('jayt-inline-manual-product-name');
    const anyInput = document.getElementById('jayt-manual-product-name');
    val = (modalInput && modalInput.value) || (inlineInput && inlineInput.value) || (anyInput && anyInput.value) || '';
  }
  val = String(val || '').trim();
  if (!val || isGarbageQuery(val)) {
    if (typeof showJaytToast === 'function') {
      showJaytToast('⚠️ Vui lòng nhập tên sản phẩm hợp lệ (ví dụ: Áo khoác Cardigan ATYS)');
    }
    return;
  }

  const detectedBrand = extractBrandFromText(val);
  const clean = sanitizeProductTitle(val, detectedBrand || '');
  if (!clean || isGarbageQuery(clean)) {
    if (typeof showJaytToast === 'function') {
      showJaytToast('⚠️ Tên sản phẩm chưa đủ rõ. Vui lòng nhập lại!');
    }
    return;
  }

  if (typeof window !== 'undefined' && window.__lastParsed) {
    const p = window.__lastParsed;
    p.title = clean;
    p.cleanTitle = clean;
    p.coreModel = clean;
    p.brand = detectedBrand || 'Chính Hãng';
    p.searchQuery = clean;
    p.needsUserInput = false;
    p.status = 'RESOLVED';

    const defaultBasket = 120000;
    const radar = computeCrossPlatformRadar(p, defaultBasket);
    window.__lastRadar = radar;

    // Refresh modal if open
    const modal = document.getElementById('jayt-voucher-scanner-modal');
    if (modal && modal.classList.contains('is-open')) {
      openVoucherScannerModal(radar, p, window.__lastInitialStack, defaultBasket, 16000);
    }
    // Refresh inline output if exists
    if (typeof window.__reExecuteRender === 'function') {
      window.__reExecuteRender();
    }
    if (typeof showJaytToast === 'function') {
      showJaytToast('✅ Đã cập nhật: ' + clean + ' · Sẵn sàng đối chiếu 3 sàn!');
    }
  }
}

