          <span style="font-size:11px; font-weight:800; background:rgba(229,195,120,0.15); color:#E5C378; border:1px solid rgba(229,195,120,0.4); padding:3px 12px; border-radius:999px;">
            🏆 5 Đợt Bùng Nổ Q4/2026
          </span>
        </div>

        <!-- Mega Sale Cards Grid -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:12px;">
          ${JAYT_MEGA_SALE_CALENDAR.map(sale => `
            <div class="jayt-mega-sale-card" style="background:rgba(10,17,13,0.9); border:1.5px solid rgba(229,195,120,0.3); border-radius:12px; padding:14px; display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                  <span style="font-size:10px; font-weight:800; background:rgba(16,185,129,0.15); color:#34D399; padding:2px 8px; border-radius:4px; border:1px solid rgba(16,185,129,0.3);">
                    ${escapeHtml(sale.badge)}
