            </div>
            <ul style="margin:0; padding-left:16px; font-size:11.5px; line-height:1.55; color:#FCA5A5;">
              ${review.cons.map(c => `<li style="margin-bottom:6px;">${escapeHtml(c)}</li>`).join('')}
            </ul>
          </div>
        </div>
      </div>

      <!-- SECTION 3: THƯ VIỆN ẢNH CHỤP MỘC THỰC TẾ -->
      <div style="margin-bottom:18px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:6px;">
          <div style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:16px;">📸</span>
            <strong style="font-size:13.5px; color:#E5C378; text-transform:uppercase; letter-spacing:0.3px;">Thư Viện Ảnh Chụp Mộc Thực Tế</strong>
          </div>
          <span style="font-size:10.5px; color:#34D399; background:rgba(16,185,129,0.15); padding:2px 8px; border-radius:4px; border:1px solid rgba(16,185,129,0.3);">
            Không Photoshop · Camera Thường
          </span>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:10px;">
          ${review.realPhotos.map((photo, pIdx) => `
            <div class="jayt-real-photo-card" onclick="openPhotoLightbox(${pIdx})" style="cursor:pointer; background:rgba(10,17,13,0.85); border:1px solid rgba(229,195,120,0.25); border-radius:10px; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; transition:transform 0.2s ease, border-color 0.2s ease; box-shadow:0 2px 8px rgba(0,0,0,0.4);" onmouseover="this.style.borderColor='#10B981'; this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='rgba(229,195,120,0.25)'; this.style.transform='translateY(0)'">
              <div style="position:relative; width:100%; aspect-ratio:4/3; background:#121914; overflow:hidden;">
                <img src="${escapeHtml(photo.url)}" alt="${escapeHtml(photo.title)}" loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block;" />
                <span style="position:absolute; top:4px; left:4px; font-size:9px; font-weight:750; color:#E5C378; background:rgba(0,0,0,0.75); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px); padding:2px 5px; border-radius:4px; border:1px solid rgba(229,195,120,0.25); white-space:nowrap;">
                  ${escapeHtml(photo.tag)}
                </span>
                <span style="position:absolute; bottom:4px; right:4px; font-size:8.5px; color:#FFFFFF; background:rgba(0,0,0,0.65); padding:1px 4px; border-radius:3px;">
                  🔍 Phóng to
                </span>
              </div>
              <div style="padding:8px; display:flex; flex-direction:column; justify-content:space-between; flex:1;">
                <div style="font-size:11px; font-weight:750; color:#F4EFE6; line-height:1.3; margin-bottom:4px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" title="${escapeHtml(photo.title)}">
                  ${escapeHtml(photo.title)}
                </div>
                <div style="font-size:9.5px; color:#A3B1A8; line-height:1.3; font-style:italic; border-top:1px dashed rgba(255,255,255,0.1); padding-top:4px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                  ${escapeHtml(photo.note)}
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- SECTION 4: NÚT MUA 1-CLICK TRONG MODAL (MASTER ACTION CTA) -->
      <div class="jayt-review-winner-action-box" style="background:linear-gradient(135deg, rgba(16,185,129,0.18), rgba(14,22,17,0.95)); border:1.5px solid #10B981; border-radius:14px; padding:14px 16px; box-shadow:0 6px 20px rgba(16,185,129,0.25);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
          <div>
            <div style="font-size:11px; color:#34D399; font-weight:750; text-transform:uppercase;">NƠI BÁN RẺ NHẤT ĐÃ KIỂM CHỨNG:</div>
            <div style="font-size:13.5px; font-weight:800; color:#F4EFE6;">
              ${escapeHtml(bestPlatformName)} · Giá thanh toán: <strong style="color:#34D399; font-size:16px;">${money(bestPrice)}</strong>
              ${savings > 0 ? (' · <span style="color:#FCD34D; font-size:12px;">(Rẻ hơn ' + money(savings) + ')</span>') : ''}
            </div>
          </div>
          <span style="font-size:10.5px; color:#A3B1A8;">Direct PDP · 0 Ma Sát</span>
        </div>

        <button type="button" class="btn-cta-primary btn-review-modal-buy-action"
          data-sku-id="${escapeHtml((review && review.skuId) || (currentRadar && currentRadar.skuId) || '')}"
          data-product-name="${escapeHtml(review.productName || '')}"
          data-platform-id="${escapeHtml(bestPlatformId)}"
          data-platform-name="${escapeHtml(bestPlatformName)}"
          data-voucher-code="${escapeHtml(voucherCode)}"
          data-direct-url="${escapeHtml(targetPayload && targetPayload.pdpUrl || '')}"
          data-search-query="${escapeHtml(targetPayload && targetPayload.searchQuery || '')}"
          data-product-payload="${escapeHtml(JSON.stringify(targetPayload || {}))}"
          onclick="triggerJaytSensoryFeedback(event); dispatchReviewModalBuyAction(this);"
          style="width:100%; padding:13px 18px; border-radius:10px; font-size:13.5px; font-weight:850; background:linear-gradient(135deg, #10B981, #059669); color:#FFFFFF; border:none; cursor:pointer; display:flex; justify-content:center; align-items:center; gap:8px; box-shadow:0 4px 14px rgba(16,185,129,0.4); text-transform:uppercase; letter-spacing:0.3px;">
          <span>🔥 MUA NGAY GIÁ ĐÁY ĐÃ XÁC THỰC: ${money(bestPrice)} TẠI ${escapeHtml(bestPlatformName)} ↗</span>
        </button>
        <div style="font-size:10px; color:#34D399; text-align:center; margin-top:6px; font-weight:600;">
          ✨ 1-Click mở App sàn tự cấn trừ toàn bộ mã giảm tốt nhất · Mã tiếp thị liên kết bảo đảm giá rẻ nhất
        </div>
      </div>
    </div>
  `;
}

function dispatchReviewModalBuyAction(triggerBtn = null) {
  const modal = document.getElementById('jayt-authentic-reviews-modal');
  let platformId = null;
  let targetPayload = null;
  let voucherCode = null;

  if (triggerBtn && triggerBtn.dataset && triggerBtn.dataset.platformId) {
    platformId = triggerBtn.dataset.platformId;
    voucherCode = triggerBtn.dataset.voucherCode || 'JAYTSPECIAL';
    const directUrl = triggerBtn.dataset.directUrl;
    const searchQuery = triggerBtn.dataset.searchQuery;
    const cleanTitle = triggerBtn.dataset.productName;
    if (triggerBtn.dataset.productPayload) {
      try {
        const parsedPayload = JSON.parse(triggerBtn.dataset.productPayload);
        if (parsedPayload && (parsedPayload.pdpUrl || parsedPayload.searchQuery || parsedPayload.cleanTitle)) {
          targetPayload = Object.assign({ cleanTitle: cleanTitle }, parsedPayload);
        }
      } catch (e) {}
    }
    if (!targetPayload) {
      if (directUrl) {
        targetPayload = { pdpUrl: directUrl, cleanTitle: cleanTitle, isSearchFallback: false };
      } else if (searchQuery) {
        targetPayload = { searchQuery: searchQuery, cleanTitle: cleanTitle, isSearchFallback: true, isTrustedShop: true };
      }
    }
  }
  if (!platformId && modal) {
    platformId = modal._currentBestPlatformId;
    targetPayload = modal._currentTargetPayload;
    voucherCode = modal._currentVoucherCode;
  }
  if (platformId) {
    // JAYT-443 Martial Law State-Integrity Sanity Check
    const prodName = (triggerBtn && triggerBtn.dataset && triggerBtn.dataset.productName) || (modal && modal._currentReview && modal._currentReview.productName) || '';
    if (/ốp.*lưng|case/i.test(prodName) && targetPayload && /ổ.*cắm|o.*cam/i.test(targetPayload.searchQuery || '')) {
      targetPayload.searchQuery = 'Ốp Lưng iPhone TPU Chống Sốc';
      targetPayload.cleanTitle = 'Ốp Lưng iPhone TPU Chống Sốc';
    }
    dispatchSmartAffiliate(platformId, targetPayload, voucherCode);
  }
  closeAuthenticReviewsModal();
}

function closeAuthenticReviewsModal() {
  const modal = document.getElementById('jayt-authentic-reviews-modal');
  if (modal) {
    modal.classList.remove('is-open');
    modal.style.display = 'none';
  }
  if (typeof document !== 'undefined' && document.body) {
    document.body.style.overflow = '';
  }
}

function openShopeeVideoTaggedLink(rawUrl, shopId, itemId) {
  triggerJaytSensoryFeedback();
  let cleanShopId = String(shopId || '').replace(/\D/g, '');
  let cleanItemId = String(itemId || '').replace(/\D/g, '');

  if ((!cleanShopId || !cleanItemId) && rawUrl) {
    const m = rawUrl.match(/(?:product\/|-i\.)(\d+)[/.](\d+)/) || rawUrl.match(/product\/[^\d]*(\d+)[/.](\d+)/);
    if (m) {
      if (!cleanShopId) cleanShopId = m[1];
      if (!cleanItemId) cleanItemId = m[2];
    } else {
      const mItem = rawUrl.match(/itemid=(\d+)/i);
      const mShop = rawUrl.match(/shopid=(\d+)/i);
      if (mItem && !cleanItemId) cleanItemId = mItem[1];
      if (mShop && !cleanShopId) cleanShopId = mShop[1];
    }
  }

  let targetUrl = rawUrl;
  if (cleanShopId && cleanItemId) {
    targetUrl = 'https://shopee.vn/product/' + cleanShopId + '/' + cleanItemId + '?is_video=1';
  } else if (cleanItemId) {
    targetUrl = 'https://shopee.vn/product/0/' + cleanItemId + '?is_video=1';
  } else if (rawUrl) {
    try {
      const cleanRaw = String(rawUrl).replace(/shopee_store_/g, '');
      const u = new URL(cleanRaw);
      u.searchParams.set('is_video', '1');
      targetUrl = u.toString();
    } catch (_) {
      targetUrl = String(rawUrl).replace(/shopee_store_/g, '');
    }
  }

  showJaytToast('🎬 Đang mở liên kết gắn tag Shopee Video! Thêm vào giỏ hàng từ Video để lấy mã giảm 20% - 50%!');

  if (typeof window !== 'undefined') {
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent || '');
    if (isMobile && cleanItemId) {
      const deepLink = 'shopeevn://product?shopid=' + (cleanShopId || '0') + '&itemid=' + cleanItemId + '&is_video=1&partner=17372870594';
      window.location.href = deepLink;
      setTimeout(() => {
        window.open(targetUrl, '_blank', 'noopener,noreferrer');
      }, 750);
    } else {
      window.open(targetUrl, '_blank', 'noopener,noreferrer');
    }
  }
}

function renderDailyHotVoucherBoard() {
