                <a href="https://mbbank.com.vn/" target="_blank" rel="noopener noreferrer" class="btn-cta-primary" style="flex: 1; min-height: 38px; font-size: 12px; padding: 6px 8px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
