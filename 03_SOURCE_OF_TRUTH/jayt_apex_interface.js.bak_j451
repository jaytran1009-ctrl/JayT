      ${priceRangeInfo ? `<div style="background: rgba(229,195,120,0.1); border: 1px solid rgba(229,195,120,0.3); border-radius: 10px; padding: 10px; margin-bottom: 14px; font-size: 12px; color: #E5C378; text-align: center;">
        🎯 <strong>Biên độ giá:</strong> ${escapeHtml(priceRangeInfo)}
