      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px;">
        <!-- TOP 3 ƯU ĐIỂM ĐƯỢC KHEN NHIỀU NHẤT -->
        <div style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px; padding: 10px 12px;">
          <div style="color: #34D399; font-size: 11.5px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px;">
            🟢 Top 3 Ưu Điểm Được Khen Nhiều Nhất (Mention Counts)
          </div>
          <ul style="margin: 0; padding-left: 16px; font-size: 11px; line-height: 1.5; color: #F4EFE6;">
            ${pros.map(p => `<li style="margin-bottom: 4px;">${escapeHtml(p)}</li>`).join('')}
          </ul>
        </div>

        <!-- TOP 2 ĐIỂM TRỪ THỰC TẾ NGƯỜI BÁN HAY GIẤU -->
        <div style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.3); border-radius: 10px; padding: 10px 12px;">
          <div style="color: #F87171; font-size: 11.5px; font-weight: 800; text-transform: uppercase; margin-bottom: 6px;">
            🔴 Top 2 Điểm Trừ Thực Tế Người Bán Hay Giấu
          </div>
          <ul style="margin: 0; padding-left: 16px; font-size: 11px; line-height: 1.5; color: #FCA5A5;">
            ${cons.map(c => `<li style="margin-bottom: 4px;">${escapeHtml(c)}</li>`).join('')}
          </ul>
        </div>
