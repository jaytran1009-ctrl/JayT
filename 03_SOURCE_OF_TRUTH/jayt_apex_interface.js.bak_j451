      <!-- PHÂN HỆ 1: RADAR 4 KHUNG GIỜ VÀNG NHẢ MÃ ẨN TRONG NGÀY -->
      <div style="margin-bottom:20px; border-bottom:1px solid rgba(229,195,120,0.25); padding-bottom:16px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:22px;">⚡</span>
            <div>
              <h4 style="margin:0; font-size:15.5px; font-weight:850; color:#E5C378; letter-spacing:0.3px; font-family:'Playfair Display', Georgia, serif;">
                RADAR 4 KHUNG GIỜ VÀNG NHẢ MÃ ẨN TRONG NGÀY (LIVE HEARTBEAT)
              </h4>
              <p style="margin:2px 0 0; font-size:11.5px; color:#A3B1A8;">
                Hệ thống bóc tách thuật toán xả mã của Shopee, TikTok Shop, Lazada &amp; F&amp;B Đà Nẵng
              </p>
            </div>
          </div>

          <!-- Live Digital Countdown Box -->
          <div id="jayt-chrono-live-countdown" style="display:inline-flex; align-items:center; background:rgba(0,0,0,0.6); border:1.5px solid #10B981; border-radius:10px; padding:6px 12px; font-size:12px;">
            <span style="color:#E5C378; font-weight:750;">${statusPrefix} <strong style="color:#F4EFE6;">${escapeHtml(slotName)}</strong></span>
            <span style="display:inline-block; margin-left:8px; background:#10B981; color:#0A110D; font-weight:900; font-family:monospace; padding:3px 8px; border-radius:6px; font-size:14px; letter-spacing:1px;">
              ${countdownInfo.countdownFormatted}
            </span>
          </div>
        </div>

        <!-- 4 Khung Giờ Cards -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:10px;">
          ${JAYT_GOLDEN_HOURS_RADAR.map(slot => {
            const isCurrentlyActive = countdownInfo.isActive && countdownInfo.activeSlot && (countdownInfo.activeSlot.id === slot.id);
            const isNext = !countdownInfo.isActive && countdownInfo.nextSlot && (countdownInfo.nextSlot.id === slot.id);
            const borderCol = isCurrentlyActive ? '#10B981' : (isNext ? 'rgba(229,195,120,0.6)' : 'rgba(255,255,255,0.1)');
            const bgCol = isCurrentlyActive ? 'rgba(16,185,129,0.12)' : (isNext ? 'rgba(229,195,120,0.08)' : 'rgba(255,255,255,0.02)');

            return `
              <div class="jayt-golden-hour-card" style="border:1.5px solid ${borderCol}; background:${bgCol}; border-radius:12px; padding:12px; display:flex; flex-direction:column; justify-content:space-between; transition:all 0.2s ease;">
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                    <span style="font-size:13px; font-weight:850; color:#E5C378;">${escapeHtml(slot.badge)}</span>
                    <span style="font-size:9.5px; font-weight:750; background:${isCurrentlyActive ? '#10B981' : 'rgba(229,195,120,0.15)'}; color:${isCurrentlyActive ? '#0A110D' : '#E5C378'}; padding:2px 6px; border-radius:4px;">
                      ${isCurrentlyActive ? '🔥 ĐANG MỞ' : escapeHtml(slot.tag)}
                    </span>
                  </div>
                  <div style="font-size:12px; font-weight:800; color:#F4EFE6; margin-bottom:4px;">
                    ${escapeHtml(slot.name)}
                  </div>
                  <div style="font-size:11px; color:#34D399; margin-bottom:4px; font-weight:600;">
                    🎟️ ${escapeHtml(slot.coreVoucher)}
                  </div>
                  <div style="font-size:10px; color:#A3B1A8; line-height:1.35; margin-bottom:8px;">
                    💡 ${escapeHtml(slot.stackStrategy)}
                  </div>
                </div>

                <div style="display:flex; gap:6px; margin-top:4px;">
                  <button type="button" class="btn-hour-predrop" onclick="triggerJaytSensoryFeedback(event); openGoldenHourRadarVoucher('${slot.id}')" style="flex:1; padding:6px 8px; font-size:10.5px; font-weight:750; background:rgba(229,195,120,0.18); color:#E5C378; border:1px solid rgba(229,195,120,0.4); border-radius:6px; cursor:pointer;">
                    🛒 Mở Ví Săn Mã ↗
                  </button>
                  <button type="button" class="btn-hour-remind" onclick="triggerJaytSensoryFeedback(event); openChronoReminderModal('SALE_DOUBLE_DAY_1010')" style="padding:6px 10px; font-size:10.5px; font-weight:700; background:rgba(255,255,255,0.06); color:#F4EFE6; border:1px solid rgba(255,255,255,0.2); border-radius:6px; cursor:pointer;">
                    ⏰ Đặt Chuông
                  </button>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>

      <!-- PHÂN HỆ 2: LỊCH DỰ BÁO SIÊU SALE 30 – 60 – 90 NGÀY -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:22px;">📅</span>
            <div>
              <h4 style="margin:0; font-size:15.5px; font-weight:850; color:#E5C378; letter-spacing:0.3px; font-family:'Playfair Display', Georgia, serif;">
                LỊCH DỰ BÁO SIÊU SALE 30 – 60 – 90 NGÀY (CHU KỲ SALE SÂU)
              </h4>
              <p style="margin:2px 0 0; font-size:11.5px; color:#A3B1A8;">
                Dự báo trước các đợt bùng nổ voucher giảm 50% – 80% khi xếp chồng 4 tầng mã
