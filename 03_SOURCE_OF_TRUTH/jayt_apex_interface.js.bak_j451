function getGoldenHourCountdownInfo() {
  const now = new Date();
  const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
  const vnTime = new Date(utc + (3600000 * 7));
  const currentMinutes = vnTime.getHours() * 60 + vnTime.getMinutes();
  const currentSeconds = vnTime.getSeconds();

  const slots = [
    { id: 'HOUR_0000', start: 0, end: 60, def: JAYT_GOLDEN_HOURS_RADAR[0] },
    { id: 'HOUR_1130', start: 690, end: 780, def: JAYT_GOLDEN_HOURS_RADAR[1] },
    { id: 'HOUR_1630', start: 990, end: 1080, def: JAYT_GOLDEN_HOURS_RADAR[2] },
    { id: 'HOUR_2000', start: 1200, end: 1320, def: JAYT_GOLDEN_HOURS_RADAR[3] }
  ];

  let activeSlot = null;
  let nextSlot = null;
  let diffSeconds = 0;

  for (const s of slots) {
    if (currentMinutes >= s.start && currentMinutes < s.end) {
      activeSlot = s.def;
      const remainingMinutes = (s.end - 1) - currentMinutes;
      const remainingSeconds = 60 - currentSeconds;
      diffSeconds = remainingMinutes * 60 + remainingSeconds;
      break;
    }
  }

  if (!activeSlot) {
    for (const s of slots) {
      if (currentMinutes < s.start) {
        nextSlot = s.def;
        const remainingMinutes = (s.start - 1) - currentMinutes;
        const remainingSeconds = 60 - currentSeconds;
        diffSeconds = remainingMinutes * 60 + remainingSeconds;
        break;
      }
    }
    if (!nextSlot) {
      nextSlot = slots[0].def;
      const minutesUntilMidnight = (1440 - 1) - currentMinutes;
      const remainingSeconds = 60 - currentSeconds;
      diffSeconds = minutesUntilMidnight * 60 + remainingSeconds;
    }
  }

  const hours = Math.floor(diffSeconds / 3600);
  const mins = Math.floor((diffSeconds % 3600) / 60);
  const secs = diffSeconds % 60;
  const pad = (n) => String(n).padStart(2, '0');
  const countdownFormatted = `${pad(hours)}:${pad(mins)}:${pad(secs)}`;

  return {
    isActive: Boolean(activeSlot),
    activeSlot,
    nextSlot,
    diffSeconds,
    hours,
    mins,
    secs,
    countdownFormatted,
    currentVnTime: vnTime
  };
}

function generateCalendarLinks(eventData) {
  const baseUrl = 'https://calendar.google.com/calendar/render';
  const title = encodeURIComponent(eventData.title || 'Siêu Sale JayT');
  const dates = `${eventData.startDateStr || '20261010T000000'}/${eventData.endDateStr || '20261010T235959'}`;
  const details = encodeURIComponent(
    `${eventData.title}\n` +
    `Mức giảm dự kiến: ${eventData.discountForecast} khi xếp chồng mã.\n` +
    `Chiến lược xếp mã: ${eventData.layerStack}\n\n` +
    `Săn giá đáy tại JayT: https://jayt-production-v3420.vercel.app\n` +
    `Đối tác chính thức: Shopee (17372870594) · Lazada (262501305) · TikTok Shop (VNVNLCB6LYL3)`
  );
  const location = encodeURIComponent('Nền tảng săn giá đáy JayT: https://jayt-production-v3420.vercel.app');
  const googleUrl = `${baseUrl}?action=TEMPLATE&text=${title}&dates=${dates}&details=${details}&location=${location}`;
  return { googleUrl };
}

function downloadJaytEventIcs(eventId) {
  const evt = JAYT_MEGA_SALE_CALENDAR.find(e => e.id === eventId) || JAYT_MEGA_SALE_CALENDAR[0];
  const nowStr = new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
  const ics = [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:-//OPC JayT Corp//JayT Chrono Calendar//VI',
    'CALSCALE:GREGORIAN',
    'METHOD:PUBLISH',
    'BEGIN:VEVENT',
    `UID:jayt-${evt.id}-${Date.now()}@jayt.vn`,
    `DTSTAMP:${nowStr}`,
    `DTSTART:${evt.startDateStr}`,
    `DTEND:${evt.endDateStr}`,
    `SUMMARY:${evt.title}`,
    `DESCRIPTION:${evt.description} - Săn mã tại https://jayt-production-v3420.vercel.app (Shopee 17372870594, Lazada 262501305, TikTok VNVNLCB6LYL3)`,
    'URL:https://jayt-production-v3420.vercel.app',
    'STATUS:CONFIRMED',
    'BEGIN:VALARM',
    'TRIGGER:-PT30M',
    'ACTION:DISPLAY',
    'DESCRIPTION:Nhắc hẹn siêu sale JayT',
    'END:VALARM',
    'END:VEVENT',
    'END:VCALENDAR'
  ].join('\r\n');

  if (typeof Blob !== 'undefined' && typeof URL !== 'undefined' && URL.createObjectURL) {
    const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `jayt_sieu_sale_${evt.id.toLowerCase()}.ics`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    if (typeof showJaytToast === 'function') {
      showJaytToast('📅 Đã tải lịch (.ics)! Mở tệp để đồng bộ vào Apple / Google / Outlook Calendar.');
    }
  }
}

