// JAYT-436: DUAL-TIER SEMANTIC DECOUPLING & GENERIC PRODUCT TITLE ENGINE
// Strictly strips Tầng 1 proprietary brands (Ema, Lock&Lock, Baseus...) from Tầng 2 (Shop Uy Tín)
const TIER1_PROPRIETARY_BRANDS_REGEX = /\b(Ema|Lock&Lock|LocknLock|Jisulife|Ugreen|Baseus|Logitech|Sunhouse|Điện Quang|TopGia|Koreno|Anker|Xiaomi|Apple|Samsung|Hoco)\b/gi;

function getGenericSemanticTitle(parsed, fallback = 'Sản phẩm tiện ích KTX') {
  if (!parsed) return fallback;
  const rawUrl = String(parsed.rawUrl || parsed.cleanUrl || parsed.canonical_url || '').toLowerCase();
  const rawTitle = String(parsed.cleanTitle || parsed.coreModel || parsed.title || '').trim();

  // Explicit known generic categories
  if (/ốp|op\b|case|shin.*case|bao.*da.*điện.*thoại/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Ốp Lưng iPhone TPU Chống Sốc';
  }
  if (/khăn.*giấy|khan.*giay|topgia/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Khăn Giấy Treo Tường Rút Đa Năng';
  }
  if (/mì.*koreno|mi.*koreno|mì.*tôm|mi.*tom|mì.*ăn.*liền/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Mì Koreno Rong Biển Nấu 4 Phút';
  }
  if (/gối.*công.*thái.*học|goi.*cong.*thai.*hoc/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Gối Ngủ Công Thái Học Cao Su Non';
  }
  if (/bình.*giữ.*nhiệt|binh.*giu.*nhiet/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Bình Nước Giữ Nhiệt Inox 500ml';
  }
  if (/cáp.*sạc|cap.*sac/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Cáp Sạc Nhanh Type-C 20W Bọc Dù';
  }
  if (/củ.*sạc|cu.*sac|\bgan\b/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Củ Sạc Nhanh GaN 30W Siêu Nhỏ';
  }
  if (/tai.*nghe|\btws\b/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Tai Nghe Bluetooth TWS Chống Ồn';
  }
  if (/đèn.*led|den.*led/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Đèn LED Học Chống Cận 3 Chế Độ Sáng';
  }
  if (/giá.*đỡ|gia.*do/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Giá Đỡ Điện Thoại Kim Loại Xếp Gọn';
  }
  if (/quạt.*mini|quat.*mini/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Quạt Cầm Tay Mini Tích Điện Turbo';
  }
  if (/chuột.*bluetooth|chuot.*bluetooth/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Chuột Bluetooth Không Dây Silent';
  }
  if (/ấm.*siêu.*tốc|am.*sieu.*toc/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Ấm Siêu Tốc Inox 1.8L Chống Bỏng';
  }
  if (/ổ\s*cắm|\bo\s*cam\b|\bo\s*cam\s*dien\b/i.test(rawTitle + ' ' + rawUrl)) {
    return 'Ổ Cắm Điện Đa Năng Chống Cháy';
  }

  // Strip brand names cleanly
  let cleaned = rawTitle.replace(TIER1_PROPRIETARY_BRANDS_REGEX, '').replace(/\s{2,}/g, ' ').trim();
  cleaned = cleaned.replace(/^sản phẩm\s+/i, '').trim();
  return (cleaned && !isGarbageQuery(cleaned)) ? cleaned : fallback;
}

function getGenericSemanticSearchQuery(parsed) {
  return getGenericSemanticTitle(parsed);
}

function computeCrossPlatformRadar(parsed, baseValue = 120000) {
  let matchedTriplet = null;
  if (parsed) {
    const rawUrl = String(parsed.rawUrl || parsed.cleanUrl || parsed.canonical_url || '').toLowerCase();
    const itemId = String(parsed.itemId || parsed.sku_id || parsed.skuId || parsed.variant_id || '');
    const title = String(parsed.title || parsed.product_name || parsed.productName || '').toLowerCase();
    const skuKey = String(parsed.sku_id || parsed.skuId || parsed.id || parsed.offer_id || '');

    // 1. Direct O(1) Shelf-to-Triplet Map check
    if (typeof SHELF_SKU_TO_TRIPLET_MAP !== 'undefined') {
      const mappedId = SHELF_SKU_TO_TRIPLET_MAP[skuKey] || SHELF_SKU_TO_TRIPLET_MAP[itemId];
      if (mappedId) {
        matchedTriplet = CROSS_PLATFORM_SKU_TRIPLETS.find(t => t.id === mappedId) || null;
      }
    }

    // 2. Exact match on Triplet ID or Match Keys
    if (!matchedTriplet) {
      for (let i = 0; i < CROSS_PLATFORM_SKU_TRIPLETS.length; i++) {
        const t = CROSS_PLATFORM_SKU_TRIPLETS[i];
        if (skuKey && (t.id === skuKey || t.matchKeys.some(k => k === skuKey))) {
          matchedTriplet = t;
          break;
        }
        if (itemId && (t.id === itemId || t.matchKeys.some(k => String(k) === String(itemId)))) {
          matchedTriplet = t;
          break;
        }
        const specificModels = ['lhc1439', 'shd1182', 'm350s', 'nexode', 'tungsten gold'];
        const hasSpecificModel = t.matchKeys.some(k => {
          if (!k || /^\d+$/.test(k)) return false;
          const lowerK = k.toLowerCase();
          return specificModels.includes(lowerK) && ((rawUrl && rawUrl.toLowerCase().includes(lowerK)) || (title && title.toLowerCase().includes(lowerK)));
        });
        if (hasSpecificModel) {
          matchedTriplet = t;
          break;
        }
      }
    }
  }

  const platforms = [];
  const baseValueNum = Math.max(20000, Number(baseValue) || 120000);
  const defaultQuery = (matchedTriplet && (matchedTriplet.cleanTitle || matchedTriplet.title))
    ? ((matchedTriplet.brand && !((matchedTriplet.cleanTitle || matchedTriplet.title).toLowerCase().includes(matchedTriplet.brand.toLowerCase())) ? (matchedTriplet.brand + ' ') : '') + (matchedTriplet.cleanTitle || matchedTriplet.title))
    : (cleanProductSearchQuery(parsed) || ((parsed && (parsed.cleanTitle || parsed.coreModel || parsed.title)) || 'Đồ Dùng Tiện Ích Phòng Trọ'));

  if (matchedTriplet) {
    const pShopee = matchedTriplet.platforms.shopee;
    const pLazada = matchedTriplet.platforms.lazada;
    const pTiktok = matchedTriplet.platforms.tiktok;

    if (pShopee && pShopee.available) {
      const shopeeStack = calculateDynamicStack({
        basketValue: pShopee.observedPrice,
        shopDiscount: Math.round(pShopee.observedPrice * 0.10),
        platformVoucher: Math.min(40000, Math.round(pShopee.observedPrice * 0.20)),
        deliveryFee: pShopee.deliveryFee || 16000,
        freeshipCredit: pShopee.freeshipCredit || 16000,
        paymentDiscount: 0
      });
      platforms.push({
        id: 'shopee',
        name: 'Shopee Mall',
        merchantName: pShopee.merchantName,
        variantName: pShopee.variantName,
        color: '#EE4D2D',
        available: true,
        voucherLabel: pShopee.voucherLabel || 'Mã Live 20% + Freeship Xtra',
        code: pShopee.voucherCode || 'SHOPEELIVE50',
        observedPrice: pShopee.observedPrice,
        stack: shopeeStack,
        payable: shopeeStack.payable,
        savings: shopeeStack.savings,
        isVerifiedPdp: true,
        payload: {
          pdpUrl: pShopee.pdpUrl,
          shopId: pShopee.shopId,
          itemId: pShopee.itemId,
          modelId: pShopee.modelId,
          variantName: pShopee.variantName
        },
        actionLabel: pShopee.actionLabel || '🏛️ Mở Shopee Mall Chính Hãng ↗'
      });
    } else {
      const estPrice = baseValueNum;
      const shopeeStack = calculateDynamicStack({
        basketValue: estPrice,
        shopDiscount: Math.round(estPrice * 0.10),
        platformVoucher: Math.min(40000, Math.round(estPrice * 0.20)),
        deliveryFee: 18000,
        freeshipCredit: 18000,
        paymentDiscount: 0
      });
      const mallQuery = (pShopee && pShopee.searchQuery) || defaultQuery;
      platforms.push({
        id: 'shopee',
        name: 'Shopee Mall',
        merchantName: (pShopee && pShopee.merchantName) || 'Gian hàng Shopee Mall Chính Hãng',
        statusLabel: 'Đối chiếu gian hàng Shopee Mall chính hãng',
        variantName: matchedTriplet.variantName,
        color: '#EE4D2D',
        available: true,
        voucherLabel: 'Mã Live 20% + Freeship Xtra (Ước tính Mall)',
        code: 'SHOPEELIVE50',
        observedPrice: estPrice,
        stack: shopeeStack,
        payable: shopeeStack.payable,
        savings: shopeeStack.savings,
        isVerifiedPdp: false,
        payload: {
          isSearchFallback: true,
          isMallSearch: true,
          searchQuery: mallQuery
        },
        actionLabel: '🏛️ Mở Shopee Mall Chính Hãng ↗'
      });
    }

    if (pLazada && pLazada.available) {
      const lazStack = calculateDynamicStack({
        basketValue: pLazada.observedPrice,
        shopDiscount: Math.round(pLazada.observedPrice * 0.08),
        platformVoucher: Math.min(35000, Math.round(pLazada.observedPrice * 0.22)),
        deliveryFee: pLazada.deliveryFee || 18000,
        freeshipCredit: pLazada.freeshipCredit || 18000,
        paymentDiscount: 0
      });
      platforms.push({
        id: 'lazada',
