                    ${escapeHtml(sale.discountForecast)}
                  </span>
                </div>

                <div style="font-size:13.5px; font-weight:850; color:#F4EFE6; margin-bottom:4px; line-height:1.35;">
                  ${escapeHtml(sale.title)}
                </div>

                <div style="font-size:11px; color:#A3B1A8; margin-bottom:6px;">
                  🗓️ Ngày diễn ra: <strong style="color:#E5C378;">${escapeHtml(sale.dateRange)}</strong>
                </div>

                <div style="font-size:10.5px; color:#34D399; background:rgba(0,0,0,0.3); border-left:2.5px solid #10B981; padding:5px 8px; border-radius:4px; margin-bottom:10px; line-height:1.4;">
                  ⚡ <strong>Xếp 4 tầng mã:</strong> ${escapeHtml(sale.layerStack)}
                </div>
              </div>

              <div style="display:flex; flex-direction:column; gap:6px;">
                <button type="button" class="btn-cta-primary btn-chrono-remind" onclick="triggerJaytSensoryFeedback(event); openChronoReminderModal('${sale.id}')" style="width:100%; padding:9px 12px; border-radius:8px; font-size:11.5px; font-weight:800; background:linear-gradient(135deg, #10B981, #059669); color:#FFFFFF; border:none; cursor:pointer; display:flex; justify-content:center; align-items:center; gap:6px; box-shadow:0 2px 8px rgba(16,185,129,0.3);">
                  <span>⏰ Đặt Lịch Nhắc Hẹn 1-Click ↗</span>
                </button>
                <button type="button" class="btn-cta-secondary btn-chrono-predrop" onclick="triggerJaytSensoryFeedback(event); openPreDropVoucherStash('shopee')" style="width:100%; padding:7px 10px; border-radius:8px; font-size:11px; font-weight:750; background:rgba(229,195,120,0.12); color:#E5C378; border:1px solid rgba(229,195,120,0.35); cursor:pointer;">
                  <span>📥 Lưu Trước Mã Ví Sàn (Pre-Drop) ↗</span>
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  `;
}

function openFlashSaleReminderModal(slot = null) {
  openChronoReminderModal(slot);
}

function closeFlashSaleReminderModal() {
  closeChronoReminderModal();
}

function downloadJaytFlashCalendar() {
  downloadJaytEventIcs('SALE_DOUBLE_DAY_1010');
}



// ============================================================================
// FEATURE 01: DIRECT SKU CROSS-PLATFORM RADAR MODAL (JAYT DIRECTIVE)
// ============================================================================
function openSkuCrossPlatformRadar(skuOrPayload, optTitle, optPrice, optPlatform) {
  if (typeof triggerJaytSensoryFeedback === 'function') {
    triggerJaytSensoryFeedback();
  }

  let skuId = '';
  let p = null;
  let basePrice = 69000;
  let productName = 'Sản phẩm chọn lọc';
  let platform = 'shopee';

  if (typeof skuOrPayload === 'object' && skuOrPayload !== null) {
    p = skuOrPayload;
    skuId = String(p.sku_id || p.offer_id || p.id || p.itemId || '');
    productName = p.product_name || p.title || optTitle || 'Sản phẩm chọn lọc';
    basePrice = Number(p.observed_price || p.price || optPrice) || 69000;
    platform = (p.platform || optPlatform || 'shopee').toLowerCase();
  } else if (typeof skuOrPayload === 'string') {
    skuId = skuOrPayload;
    const allSkus = (typeof J387_DORM_SKUS !== 'undefined' ? J387_DORM_SKUS : [])
      .concat(typeof J465_STAGING_ACCESS_TRADE_OFFERS !== 'undefined' ? J465_STAGING_ACCESS_TRADE_OFFERS : []);
    p = allSkus.find(item => item.sku_id === skuId || item.offer_id === skuId || item.id === skuId)
      || (typeof window !== 'undefined' && window.__lastSkuMap ? window.__lastSkuMap[skuId] : null);

    // Check if skuId itself is directly a Triplet ID or matchKey
    if (!p && typeof CROSS_PLATFORM_SKU_TRIPLETS !== 'undefined') {
      const trip = CROSS_PLATFORM_SKU_TRIPLETS.find(t => t.id === skuId || (t.matchKeys && t.matchKeys.includes(skuId)));
      if (trip) {
        productName = trip.title;
        basePrice = (trip.platforms.shopee && trip.platforms.shopee.observedPrice) || 69000;
        platform = 'shopee';
        p = {
          sku_id: skuId,
          product_name: trip.title,
          observed_price: basePrice,
          canonical_url: trip.platforms.shopee ? trip.platforms.shopee.pdpUrl : '',
          platform: 'shopee'
        };
      }
    }

    productName = p ? (p.product_name || p.title) : (optTitle || 'Sản phẩm chọn lọc');
    basePrice = Number(p ? (p.observed_price || p.price) : optPrice) || 69000;
    platform = (p && p.platform) ? p.platform.toLowerCase() : (optPlatform ? String(optPlatform).toLowerCase() : 'shopee');
  }

  // Construct normalized parsed link payload
  const parsed = {
    platform: platform,
    platformName: platform === 'shopee' ? 'Shopee' : (platform === 'lazada' ? 'Lazada' : 'TikTok Shop'),
    productName: productName,
    title: productName,
    product_name: productName,
    rawUrl: p ? (p.canonical_url || p.official_partner_url || '') : '',
    cleanUrl: p ? (p.canonical_url || p.official_partner_url || '') : '',
    canonical_url: p ? p.canonical_url : '',
    itemId: p ? String(p.variant_id || p.itemId || skuId || '') : skuId,
    skuId: skuId,
    sku_id: skuId,
    shopId: p ? String(p.merchant_id || '').replace(/\D/g, '') : '',
    host: platform + '.vn',
    resolvedLocally: true,
    resolvedInMs: 1
  };

  const radar = computeCrossPlatformRadar(parsed, basePrice);

  const initialStack = calculateDynamicStack({
    basketValue: basePrice,
    shopDiscount: Math.round(basePrice * 0.10),
    platformVoucher: Math.min(40000, Math.round(basePrice * 0.20)),
    deliveryFee: 16000,
    freeshipCredit: 16000,
    paymentDiscount: 0
  });

  if (typeof window !== 'undefined') {
    window.__lastRadar = radar;
    window.__lastParsed = parsed;
    window.__lastInitialStack = initialStack;
  }

  openVoucherScannerModal(radar, parsed, initialStack, basePrice, 16000);
}

function closeSkuCrossPlatformRadar() {
  closeVoucherScannerModal();
}

if (typeof window !== 'undefined') {
  window.openSkuCrossPlatformRadar = openSkuCrossPlatformRadar;
  window.closeSkuCrossPlatformRadar = closeSkuCrossPlatformRadar;
}


function reportVoucherIssue(code) {
  if (typeof triggerJaytSensoryFeedback === 'function') triggerJaytSensoryFeedback();
  if (typeof state === 'undefined') window.state = {};
  if (!state.reportedVouchers) state.reportedVouchers = {};
  state.reportedVouchers[code] = (state.reportedVouchers[code] || 0) + 1;

  const voucher = (typeof DAILY_HOT_VOUCHERS !== 'undefined') ? DAILY_HOT_VOUCHERS.find(v => v.code === code) : null;
  const nextBest = voucher && voucher.nextBestCode ? DAILY_HOT_VOUCHERS.find(v => v.code === voucher.nextBestCode) : null;

  let msg = '⚠️ Đã ghi nhận báo cáo cho ưu đãi [' + code + '].';
  if (nextBest) {
    msg += ' Đề xuất thay thế: [' + nextBest.discount + ' - ' + nextBest.platformLabel + ']!';
  } else {
    msg += ' Hệ thống sẽ đối soát hạn ngạch và cập nhật sau 60s.';
  }
  showJaytToast(msg);
}
window.reportVoucherIssue = reportVoucherIssue;

function openVoucherGuideModal(voucherCode, platform = 'shopee') {
  let modal = document.getElementById('jayt-voucher-guide-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'jayt-voucher-guide-modal';
    modal.className = 'zalo-modal-backdrop is-open';
    document.body.appendChild(modal);
  } else {
    modal.classList.add('is-open');
  }

  const vObj = DAILY_HOT_VOUCHERS.find(v => v.code === voucherCode) || {
    code: voucherCode || 'SHOPEELIVE50',
    platform: platform,
    platformLabel: platform.toUpperCase(),
    discount: 'Giảm giá sâu nhất',
    minSpend: 'Đơn từ 0đ',
    badge: '🔥 VOUCHER HOT',
    type: 'CLAIMABLE',
    eligibility: 'Áp dụng theo chính sách sàn TMĐT.'
  };

  const isClaimable = (vObj.type === 'CLAIMABLE');
  const brandColors = {
    shopee: { bg: '#EE4D2D', name: 'Shopee' },
    lazada: { bg: '#002F6C', name: 'Lazada' },
    tiktok: { bg: '#FE2C55', name: 'TikTok Shop' },
    fnb_service: { bg: '#00B14F', name: 'F&B & Dịch Vụ' }
  };
  const activeBrand = brandColors[vObj.platformGroup || vObj.platform] || { bg: '#E5C378', name: 'Sàn TMĐT' };

  modal.innerHTML = `
    <div class="zalo-modal-dialog" style="max-width: 680px; width: 95%; background: #0E1611; border: 2px solid #E5C378; border-radius: 20px; padding: 22px; box-shadow: 0 16px 50px rgba(0,0,0,0.85); max-height: 92vh; overflow-y: auto;">
      <!-- Header with Golden Touch -->
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid rgba(229,195,120,0.3); padding-bottom: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 26px;">💡</span>
          <div>
            <h3 style="margin: 0; font-size: 17.5px; font-weight: 850; color: #E5C378; font-family: 'Playfair Display', Georgia, serif;">
              ${isClaimable ? 'Hướng Dẫn Thu Thập Voucher Vào Ví (Không Cần Nhập Mã)' : 'Hướng Dẫn Sao Chép & Dán Mã Nhập Tay Tại Giỏ Hàng'}
            </h3>
            <p style="margin: 2px 0 0; font-size: 12px; color: #A3B1A8;">
              ${isClaimable ? 'Voucher thu thập sự kiện sàn: Bấm Lưu vào ví, sàn tự động cấn trừ tiền mặt khi đặt hàng' : '3 bước cấn trừ tiền mặt trực tiếp & mẹo ăn thêm 20% - 50%'}
            </p>
          </div>
        </div>
        <button type="button" onclick="closeVoucherGuideModal()" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #F4EFE6; font-size: 18px; cursor: pointer; padding: 4px 10px; border-radius: 8px;" aria-label="Đóng cửa sổ">✕</button>
      </div>

      <!-- CRITICAL WARNING NOTICE FOR CLAIMABLE VOUCHERS -->
      ${isClaimable ? `
      <div style="background: rgba(239,68,68,0.12); border: 1.5px solid #EF4444; border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; display: flex; gap: 12px; align-items: flex-start;">
        <span style="font-size: 24px;">🚨</span>
        <div style="font-size: 12px; color: #FCA5A5; line-height: 1.5;">
          <strong style="color: #FFFFFF; font-size: 13px; text-transform: uppercase;">Lưu Ý Sống Còn Về Cơ Chế Sàn:</strong><br/>
          Voucher này là <strong>Voucher Thu Thập Trên Sự Kiện / Ví</strong> của ${activeBrand.name}. <strong>Tuyệt đối KHÔNG gõ ký tự vào ô mã voucher</strong> lúc thanh toán (nếu gõ sẽ bị sàn báo lỗi <em>"Voucher này không hợp lệ hoặc không còn hiệu lực"</em>). Bạn chỉ cần bấm nút <strong>"Lưu vào ví"</strong> bên dưới, sàn sẽ <strong>tự động cấn trừ</strong> vào hóa đơn!<br/>
          <div style="margin-top: 6px; color: #FCD34D; font-weight: 700;">⚠️ ${vObj.eligibility}</div>
        </div>
      </div>
      ` : `
      <div style="background: rgba(245,158,11,0.12); border: 1.5px solid #F59E0B; border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; display: flex; gap: 12px; align-items: flex-start;">
        <span style="font-size: 22px;">ℹ️</span>
        <div style="font-size: 12px; color: #FCD34D; line-height: 1.5;">
          <strong>ĐIỀU KIỆN ÁP MÃ:</strong> ${vObj.eligibility}
        </div>
      </div>
      `}

      <!-- High-Impact Voucher Code Hero Card -->
      <div style="background: linear-gradient(135deg, rgba(22,34,27,0.95), rgba(10,17,13,0.95)); border: 1.5px solid ${activeBrand.bg}; border-radius: 14px; padding: 14px 18px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; background: ${activeBrand.bg}; color: #FFFFFF; font-size: 10.5px; font-weight: 800; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; margin-bottom: 4px;">
            <span>${vObj.platformLabel}</span> · <span>${vObj.badge}</span> · <span>${isClaimable ? '📥 THU THẬP VÍ' : '📋 MÃ NHẬP TAY'}</span>
          </div>
          <div style="font-size: 17px; font-weight: 850; color: #F4EFE6;">${vObj.discount}</div>
          <div style="font-size: 12px; color: #E5C378;">${vObj.minSpend}</div>
        </div>
        <div>
          ${isClaimable ? `
            <div style="background: rgba(16,185,129,0.15); border: 1.5px solid #10B981; border-radius: 10px; padding: 8px 14px; text-align: center;">
              <div style="font-size: 11px; color: #10B981; font-weight: 750; text-transform: uppercase;">Hình thức ưu đãi:</div>
              <div style="font-size: 14px; color: #34D399; font-weight: 850;">🎟️ Lưu Vào Ví Sàn 1-Chạm</div>
              <div style="font-size: 10px; color: #A3B1A8; margin-top: 2px;">Tự động trừ tiền khi thanh toán</div>
            </div>
          ` : `
            <div style="display: flex; align-items: center; gap: 8px;">
              <strong id="modal-voucher-code-display" style="font-family: monospace; font-size: 17px; color: #E5C378; background: rgba(0,0,0,0.7); padding: 7px 14px; border-radius: 8px; border: 1.5px dashed rgba(229,195,120,0.5); letter-spacing: 0.5px;">${vObj.code}</strong>
              <button type="button" onclick="copyVoucherCodeToClipboard('${vObj.code}'); this.innerText='✅ Đã sao chép!';" style="padding: 9px 14px; border-radius: 8px; background: #10B981; color: #0A110D; font-size: 12.5px; font-weight: 800; border: none; cursor: pointer; transition: all 0.15s; white-space: nowrap;">Sao chép mã</button>
            </div>
          `}
        </div>
      </div>

      <!-- Actionable 3-Step Guide with Visual Diagrams -->
      <div style="margin-bottom: 20px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
          <h4 style="color: #E5C378; font-size: 13.5px; margin: 0; text-transform: uppercase; letter-spacing: 0.6px; font-weight: 800;">
            ${isClaimable ? '📋 Quy Trình 3 Bước Thu Thập Vào Ví & Tự Động Trừ Tiền:' : '📋 Quy Trình 3 Bước Áp Mã Tiền Mặt Trực Tiếp:'}
          </h4>
          <span style="font-size: 11px; color: #10B981; font-weight: 700;">Chuẩn vận hành sàn TMĐT</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px;">
          <!-- Step 1 Card -->
          <div style="background: rgba(22,34,27,0.7); border: 1px solid rgba(229,195,120,0.25); border-radius: 12px; padding: 12px 16px; display: flex; gap: 14px; align-items: flex-start;">
            <div style="font-size: 15px; background: #E5C378; color: #0A110D; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; flex-shrink: 0; box-shadow: 0 2px 8px rgba(229,195,120,0.4);">1</div>
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px;">
                <strong style="color: #F4EFE6; font-size: 13.5px;">${isClaimable ? 'Bước 1 — Bấm nút mở Ví Voucher sàn' : 'Bước 1 — Bấm nút lưu mã 1-chạm'}</strong>
                <span style="font-size: 10.5px; background: rgba(16,185,129,0.15); color: #10B981; border: 1px solid rgba(16,185,129,0.4); padding: 1px 7px; border-radius: 6px; font-weight: 700;">${isClaimable ? '📲 Mở thẳng Ví Sàn' : '📋 Tự động nạp bộ nhớ tạm'}</span>
              </div>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.5; margin-top: 3px;">
                ${isClaimable 
                  ? 'Bấm nút <strong>"Lưu Vào Ví Sàn ↗"</strong> bên dưới. Hệ thống sẽ mở thẳng ứng dụng ' + activeBrand.name + ' và dẫn bạn đến đúng Trung tâm Voucher / Trang sự kiện chính thức.'
                  : 'Nhấn nút <strong>"Sao chép mã"</strong> phía trên. Hệ thống tự động nạp mã giảm giá vào khay nhớ tạm của điện thoại/máy tính.'}
              </div>
            </div>
          </div>

          <!-- Step 2 Card -->
          <div style="background: rgba(22,34,27,0.7); border: 1px solid rgba(229,195,120,0.25); border-radius: 12px; padding: 12px 16px; display: flex; gap: 14px; align-items: flex-start;">
            <div style="font-size: 15px; background: #E5C378; color: #0A110D; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; flex-shrink: 0; box-shadow: 0 2px 8px rgba(229,195,120,0.4);">2</div>
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px;">
                <strong style="color: #F4EFE6; font-size: 13.5px;">${isClaimable ? 'Bước 2 — Bấm nút "Lưu" (Thu thập) trên màn hình app' : 'Bước 2 — Mở app sàn & Chọn mục Voucher ở giỏ hàng'}</strong>
                <span style="font-size: 10.5px; background: rgba(245,158,11,0.15); color: #F59E0B; border: 1px solid rgba(245,158,11,0.4); padding: 1px 7px; border-radius: 6px; font-weight: 700;">${isClaimable ? '📥 1-Chạm Nạp Vào Ví' : '🛒 Vị trí: Trước nút Đặt hàng'}</span>
              </div>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.5; margin-top: 3px;">
                ${isClaimable
                  ? 'Trên giao diện sự kiện của ' + activeBrand.name + ', bấm nút <strong>[LƯU]</strong> hoặc <strong>[THU THẬP]</strong>. Voucher sẽ được nạp tức thì vào tài khoản của bạn.'
                  : 'Bấm nút mở app sàn bên dưới, chọn sản phẩm và vào màn hình Thanh toán. Tìm đúng ô <strong>"Shopee Voucher"</strong> / <strong>"Lazada Voucher"</strong> / <strong>"Mã giảm giá TikTok"</strong>.'}
              </div>
              <div style="margin-top: 6px; padding: 6px 10px; background: rgba(0,0,0,0.4); border: 1px dashed rgba(229,195,120,0.3); border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: #E5C378;">
                <span>📍 Nút bấm trên app:</span>
                <span style="background: rgba(255,255,255,0.08); padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.15);">${isClaimable ? '[ 🎟️ Lưu / Thu Thập Vào Ví ]' : '[ 🎟️ Chọn hoặc nhập mã voucher > ]'}</span>
              </div>
            </div>
          </div>

          <!-- Step 3 Card -->
          <div style="background: rgba(22,34,27,0.7); border: 1px solid rgba(229,195,120,0.25); border-radius: 12px; padding: 12px 16px; display: flex; gap: 14px; align-items: flex-start;">
            <div style="font-size: 15px; background: #E5C378; color: #0A110D; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; flex-shrink: 0; box-shadow: 0 2px 8px rgba(229,195,120,0.4);">3</div>
            <div style="flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px;">
                <strong style="color: #F4EFE6; font-size: 13.5px;">${isClaimable ? 'Bước 3 — Vào giỏ hàng thanh toán (Sàn tự động trừ tiền)' : 'Bước 3 — Dán mã & Cấn trừ tiền mặt tức thì'}</strong>
                <span style="font-size: 10.5px; background: rgba(16,185,129,0.15); color: #10B981; border: 1px solid rgba(16,185,129,0.4); padding: 1px 7px; border-radius: 6px; font-weight: 700;">💰 Giảm trừ tiền mặt</span>
              </div>
              <div style="font-size: 12px; color: #A3B1A8; line-height: 1.5; margin-top: 3px;">
                ${isClaimable
                  ? 'Khi bạn vào màn hình Giỏ Hàng & Thanh toán, sàn ' + activeBrand.name + ' sẽ <strong>tự động tích chọn voucher này</strong> trong mục voucher khả dụng để giảm trừ hóa đơn. Bạn không cần nhập bất kỳ ký tự nào!'
                  : 'Chạm giữ ô nhập mã rồi chọn <strong>"Dán"</strong> (Paste) và bấm <strong>"Áp dụng"</strong>. Tiền mặt sẽ được cấn trừ trực tiếp vào hóa đơn của bạn trước khi bấm Đặt hàng.'}
              </div>
              <div style="margin-top: 6px; padding: 6px 10px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: #34D399; font-weight: 700;">
                <span>✅ Kết quả:</span>
                <span>Cấn trừ trực tiếp ${vObj.discount} vào tổng tiền thanh toán</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Kho Mẹo Săn Đáy Thực Chiến Theo Sàn -->
      <div style="background: rgba(10,17,13,0.95); border: 1px solid rgba(229,195,120,0.3); border-radius: 14px; padding: 14px 18px; margin-bottom: 20px;">
        <h4 style="color: #E5C378; font-size: 13px; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800;">
          💡 Kho Mẹo Thực Chiến Độc Quyền JayT (Ăn Thêm 20% - 50%):
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px;">
          <div style="background: rgba(238,77,45,0.08); border: 1px solid rgba(238,77,45,0.25); border-radius: 10px; padding: 10px;">
            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
              <span>🟠</span>
              <strong style="color: #EE4D2D; font-size: 12.5px;">Shopee Live &amp; Shopee Video:</strong>
            </div>
            <p style="font-size: 11.5px; color: #A3B1A8; margin: 0; line-height: 1.45;">
              Vào Shopee Video hoặc Livestream tìm sản phẩm KTX, bấm lưu voucher 20% - 50% ngay trong video. Tiết kiệm thêm 30k - 50k so với mua trực tiếp trên trang chủ.
            </p>
          </div>
          <div style="background: rgba(15,20,109,0.2); border: 1px solid rgba(56,189,248,0.3); border-radius: 10px; padding: 10px;">
            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
              <span>🔵</span>
              <strong style="color: #38BDF8; font-size: 12.5px;">Lazada Cộng Dồn 3 Tầng:</strong>
            </div>
            <p style="font-size: 11.5px; color: #A3B1A8; margin: 0; line-height: 1.45;">
              Thu thập Voucher Tích Lũy mỗi ngày. Lazada cho phép cộng dồn đồng thời 3 tầng: <em>Voucher Sàn + Voucher Tích Lũy + Freeship Max</em> trên cùng 1 đơn hàng.
            </p>
          </div>
          <div style="background: rgba(254,44,85,0.08); border: 1px solid rgba(254,44,85,0.25); border-radius: 10px; padding: 10px;">
            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
              <span>🔴</span>
              <strong style="color: #FE2C55; font-size: 12.5px;">TikTok Shop Gom Đơn KTX:</strong>
            </div>
            <p style="font-size: 11.5px; color: #A3B1A8; margin: 0; line-height: 1.45;">
              Gộp đơn cùng bạn phòng trọ đạt mốc từ 150.000đ trở lên để mở khóa Freeship 0đ toàn quốc và mã hoàn xu 15% tối đa 50k từ các phiên live đối tác.
            </p>
          </div>
          <div style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25); border-radius: 10px; padding: 10px;">
            <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
              <span>🟢</span>
              <strong style="color: #34D399; font-size: 12.5px;">Đồ Ăn &amp; Xe Máy — ShopeeFood / Grab / Xanh SM:</strong>
            </div>
            <p style="font-size: 11.5px; color: #A3B1A8; margin: 0; line-height: 1.45;">
              Tại màn hình chốt đơn, bấm vào ô <strong>"Khuyến mãi / Ưu đãi"</strong> dán mã độc quyền Đà Nẵng để trừ ngay 25.000đ - 30.000đ trước khi chọn phương thức thanh toán.
            </p>
          </div>
        </div>
      </div>

      <!-- Trust Statement & Action Row -->
      <div style="background: rgba(22,34,27,0.6); border: 1px solid rgba(229,195,120,0.22); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; text-align: center;">
        <div style="font-size: 12px; color: #10B981; font-weight: 700;">✨ JayT tự động áp mã ẩn tốt nhất khi mở ứng dụng sàn cho bạn · Cam kết không phát sinh chi phí ẩn</div>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
        <button type="button" class="btn-cta-primary" onclick="dispatchSmartAffiliate('${vObj.platform}', '', '${vObj.code}'); closeVoucherGuideModal();" style="padding: 10px 20px; border-radius: 10px; font-size: 13px; font-weight: 850; background: linear-gradient(135deg, #E5C378, #C5A880); color: #0A110D; border: none; cursor: pointer; box-shadow: 0 2px 12px rgba(229,195,120,0.35);">
          ${isClaimable ? '🎟️ Mở Ví Voucher Trên App Sàn ↗' : '⚡ Áp Mã Ẩn & Mở App ↗'}
        </button>
        <button type="button" class="btn-cta-secondary" onclick="closeVoucherGuideModal()" style="padding: 10px 16px; border-radius: 10px; font-size: 12.5px; font-weight: 600; background: rgba(255,255,255,0.08); color: #F4EFE6; border: 1px solid rgba(255,255,255,0.2); cursor: pointer;">
          Đóng lại ✕
        </button>
      </div>
    </div>
  `;
}

function closeVoucherGuideModal() {
  const modal = document.getElementById('jayt-voucher-guide-modal');
  if (modal) {
    modal.classList.remove('is-open');
  }
}

