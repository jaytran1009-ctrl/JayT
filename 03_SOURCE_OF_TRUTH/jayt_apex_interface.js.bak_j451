            <span>⏰ ĐẶT LỊCH NHẮC HẸN &amp; PRE-DROP STASH</span>
          </div>
          <h3 style="margin:0 0 4px; font-size:17.5px; font-weight:850; color:#F4EFE6; line-height:1.35; font-family:'Playfair Display', Georgia, serif;">
            ${escapeHtml(evt.title)}
          </h3>
          <div style="font-size:12px; color:#A3B1A8;">
            Thời gian: <strong style="color:#E5C378;">${escapeHtml(evt.dateRange)}</strong>
          </div>
        </div>
        <button type="button" onclick="closeChronoReminderModal()" style="background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.2); color:#F4EFE6; font-size:18px; cursor:pointer; padding:5px 12px; border-radius:8px;" aria-label="Đóng cửa sổ">✕</button>
      </div>

      <!-- Info Box -->
      <div style="background:linear-gradient(135deg, rgba(16,185,129,0.12), rgba(229,195,120,0.1)); border:1.5px solid rgba(16,185,129,0.35); border-radius:14px; padding:14px; margin-bottom:16px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <span style="font-size:11.5px; font-weight:750; color:#34D399; text-transform:uppercase;">Dự Báo Mức Giảm Sâu:</span>
          <span style="font-size:18px; font-weight:900; color:#34D399;">${escapeHtml(evt.discountForecast)}</span>
        </div>
        <div style="font-size:11.5px; color:#F4EFE6; line-height:1.5; margin-bottom:8px;">
