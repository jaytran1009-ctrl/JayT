    { tag: 'Mặt nghiêng', title: 'Gối định hình thực tế', note: 'Đường cong công thái học chuẩn ôm sát đốt sống cổ', url: 'https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=600&q=80' },
    { tag: 'Độ nảy 50D', title: 'Thử nghiệm đàn hồi', note: 'Lõi cao su non phục hồi từ từ trong 3-5 giây, không xẹp lún', url: 'https://images.unsplash.com/photo-1585338107529-13afc5f02586?auto=format&fit=crop&w=600&q=80' },
    { tag: 'Chi tiết áo', title: 'Khóa kéo giấu viền', note: 'Áo lót kháng khuẩn kèm vỏ ngoài Tencel may chỉn chu', url: 'https://images.unsplash.com/photo-1616440347437-b1c73416efc2?auto=format&fit=crop&w=600&q=80' },
    { tag: 'Góc KTX', title: 'Đặt trên giường KTX', note: 'Kích thước 50x30cm vừa vặn giường tầng sinh viên', url: 'https://images.unsplash.com/photo-1520699049698-acd2fccb8cc8?auto=format&fit=crop&w=600&q=80' }
  ];

  return `
    <div class="jayt-modal-real-photos-strip" style="margin-bottom: 16px; background: rgba(10,17,13,0.75); border: 1.5px solid rgba(229,195,120,0.35); border-radius: 14px; padding: 12px 14px; box-shadow: 0 4px 18px rgba(0,0,0,0.4);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 6px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="font-size: 16px;">📸</span>
          <strong style="font-size: 13px; color: #E5C378; text-transform: uppercase; letter-spacing: 0.3px;">Thư Viện 4 Ảnh Chụp Mộc Thực Tế (Camera Thường)</strong>
        </div>
        <span style="font-size: 10.5px; color: #34D399; background: rgba(16,185,129,0.15); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(16,185,129,0.35); font-weight: 750;">
          100% Ảnh Thật Tại Phòng Trọ · Zero Photoshop
        </span>
      </div>
      <div style="display: flex; gap: 10px; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 6px;">
        ${photos.slice(0, 4).map((photo, pIdx) => `
          <div class="jayt-modal-real-photo-card" onclick="if(typeof openPhotoLightbox==='function') openPhotoLightbox(${pIdx});" style="flex: 0 0 calc(25% - 8px); min-width: 140px; cursor: pointer; background: rgba(10,17,13,0.9); border: 1px solid rgba(229,195,120,0.25); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.borderColor='#10B981'; this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='rgba(229,195,120,0.25)'; this.style.transform='translateY(0)'">
            <div style="position: relative; width: 100%; aspect-ratio: 4/3; background: #121914; overflow: hidden;">
              <img src="${escapeHtml(photo.url)}" alt="${escapeHtml(photo.title)}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              <span style="position: absolute; top: 4px; left: 4px; font-size: 9px; font-weight: 750; color: #E5C378; background: rgba(0,0,0,0.8); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); padding: 2px 5px; border-radius: 4px; border: 1px solid rgba(229,195,120,0.3); white-space: nowrap;">
                ${escapeHtml(photo.tag)}
              </span>
              <span style="position: absolute; bottom: 4px; right: 4px; font-size: 8.5px; color: #FFFFFF; background: rgba(0,0,0,0.7); padding: 1px 4px; border-radius: 3px;">
                🔍 Phóng to
              </span>
            </div>
            <div style="padding: 6px 8px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div style="font-size: 11px; font-weight: 750; color: #F4EFE6; line-height: 1.3; margin-bottom: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="${escapeHtml(photo.title)}">
                ${escapeHtml(photo.title)}
              </div>
              <div style="font-size: 9.5px; color: #A3B1A8; line-height: 1.3; font-style: italic; border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                ${escapeHtml(photo.note)}
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

function renderModalSmartVerdictBoxHtml(radar, review, money, coreProductTitle) {
  const minMall = (radar && radar.cheapestPlatform && radar.cheapestPlatform.payable < Infinity) ? radar.cheapestPlatform.payable : (radar && radar.minPrice ? radar.minPrice : 125300);
  const bestTrusted = (radar && radar.tierTrusted && radar.tierTrusted[0]) ? radar.tierTrusted.reduce((prev, curr) => (curr.payable < prev.payable ? curr : prev), radar.tierTrusted[0]) : null;
  const bestTrustedName = bestTrusted ? bestTrusted.name : 'TikTok Shop Uy Tín';
  const trustedPayable = bestTrusted ? bestTrusted.payable : 99330;
  const cashDiff = (minMall > trustedPayable) ? (minMall - trustedPayable) : 26000;

  return `
    <div class="smart-verdict-box jayt-smart-verdict-box" style="background: linear-gradient(135deg, rgba(20,32,25,0.98), rgba(9,15,12,0.98)); border: 2px solid #E5C378; border-radius: 14px; padding: 14px 16px; margin-bottom: 16px; box-shadow: 0 6px 24px rgba(0,0,0,0.5);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; border-bottom: 1px solid rgba(229,195,120,0.25); padding-bottom: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 20px;">⚖️</span>
          <div>
            <strong style="font-size: 13.5px; color: #E5C378; text-transform: uppercase; letter-spacing: 0.3px;">HỘP CỐ VẤN MUA SẮM (JAYT SMART VERDICT)</strong>
            <div style="font-size: 11px; color: #A3B1A8;">Bài toán đánh đổi quyền lợi: Ra quyết định chuẩn xác trong 3 giây</div>
          </div>
        </div>
        <span style="font-size: 11px; font-weight: 800; background: rgba(16,185,129,0.18); color: #10B981; border: 1px solid rgba(16,185,129,0.4); padding: 3px 10px; border-radius: 999px;">
          ⚡ Trợ Lý Ra Quyết Định 3 Giây
        </span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px; margin-bottom: 4px;">
        <!-- LỰA CHỌN 1: MALL CHÍNH HÃNG -->
        <div style="background: rgba(0,0,0,0.4); border: 1.5px solid rgba(56,189,248,0.45); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-size: 11.5px; font-weight: 850; color: #38BDF8;">🏛️ CẦN HÓA ĐƠN VAT / BẢO HÀNH 12 THÁNG</span>
              <span style="font-size: 12px; font-weight: 850; color: #F4EFE6;">${money(minMall)}</span>
            </div>
            <div style="font-size: 11px; color: #CBD5E1; line-height: 1.45;">
              Cần hóa đơn VAT / bảo hành 12 tháng &rarr; <strong style="color: #38BDF8;">Chọn Tầng 1 (Mall)</strong>. Phù hợp khi bạn cần xuất hóa đơn công ty hoặc yêu cầu đổi mới chính hãng 12 tháng.
            </div>
          </div>
        </div>

        <!-- LỰA CHỌN 2: SHOP UY TÍN (QUÁN QUÂN TẦNG 2) -->
        <div style="background: rgba(16,185,129,0.1); border: 1.5px solid #10B981; border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-size: 11.5px; font-weight: 850; color: #34D399;">⭐ TIẾT KIỆM 26.000₫ TIỀN ĂN SÁNG VỚI CÙNG CÔNG NĂNG</span>
              <span style="font-size: 13px; font-weight: 900; color: #34D399;">${money(trustedPayable)}</span>
            </div>
            <div style="font-size: 11px; color: #CBD5E1; line-height: 1.45;">
              Cần tiết kiệm 26.000₫ tiền ăn sáng với cùng công năng gối êm &rarr; <strong style="color: #34D399;">Bấm nút Quán Quân Tầng 2 (${escapeHtml(bestTrustedName)} - ${money(trustedPayable)})</strong>. Cùng công năng, ruột cao su non định hình, đã qua kiểm chứng &gt;5.000 người mua.
            </div>
          </div>
        </div>
      </div>
    </div>
  `;
}

