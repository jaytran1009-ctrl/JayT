function dispatchSmartAffiliate(providerKey, offerPayload = null, voucherCode = null, event = null) {
  if (typeof triggerJaytSensoryFeedback === 'function') {
    triggerJaytSensoryFeedback(event);
  }
  const provider = TRACK_1_AFFILIATE_REGISTRY[providerKey] || null;
  const isSandbox = typeof window !== 'undefined' && window.location && (window.location.hostname.includes('staging') || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
  const campus = (typeof state !== 'undefined' && state.selectedClusterId) ? state.selectedClusterId : 'dut_hoa_khanh';
  const cluster = (typeof window !== 'undefined' && typeof window._selectedFnbCluster !== 'undefined') ? window._selectedFnbCluster : 'hoa_khanh';
  const timestamp = Math.floor(Date.now() / 1000);
  const sub1 = encodeURIComponent(cluster);
  const sub2 = encodeURIComponent(providerKey);
  const sub3 = encodeURIComponent(String(timestamp));
  const subTrackingQuery = '&sub1=' + sub1 + '&sub2=' + sub2 + '&sub3=' + sub3;
  const partnerData = SECURE_PARTNER_CONFIG[providerKey] || null;

  if (voucherCode) {
    const isClaimableVoucher = (typeof DAILY_HOT_VOUCHERS !== 'undefined') && DAILY_HOT_VOUCHERS.some(v => v.code === voucherCode && v.type === 'CLAIMABLE');
    if (isClaimableVoucher) {
      showJaytToast('🎟️ Đang mở Ví Voucher ' + (partnerData ? partnerData.name : 'sàn') + '... Hãy bấm "LƯU VÀO VÍ" để sàn tự động áp dụng khi thanh toán!');
    } else {
      copyToClipboardFallback(voucherCode).then(() => {
        showJaytToast('✅ Đã sao chép mã [' + voucherCode + ']! Đang mở ứng dụng sàn để dán mã...');
      }).catch(() => {});
    }
  }

  let deepLinkUrl = null;
  let fallbackWebUrl = 'https://' + (partnerData ? partnerData.host : 'jayt-production-v3420.vercel.app');

  let targetPayload = offerPayload;
  if (typeof targetPayload === 'string') {
    const trimmed = targetPayload.trim();
    if (trimmed.startsWith('{') && trimmed.endsWith('}')) {
      try { targetPayload = JSON.parse(trimmed); } catch (_) {}
    }
  }

  const isObjectPayload = (typeof targetPayload === 'object' && targetPayload !== null);
  const isSearchFallback = isObjectPayload && Boolean(targetPayload.isSearchFallback);
  const targetPdpUrl = isObjectPayload ? (targetPayload.pdpUrl ? String(targetPayload.pdpUrl).replace(/shopee_store_/g, '') : null) : (typeof targetPayload === 'string' && targetPayload.startsWith('http') ? targetPayload.replace(/shopee_store_/g, '') : null);
  const targetShopId = isObjectPayload ? (targetPayload.shopId ? String(targetPayload.shopId).replace(/\D/g, '') : null) : null;
  const targetItemId = isObjectPayload ? targetPayload.itemId : (typeof targetPayload === 'string' && !targetPayload.startsWith('http') ? targetPayload : null);
  const targetModelId = isObjectPayload ? targetPayload.modelId : null;
  const targetSkuId = isObjectPayload ? targetPayload.skuId : null;
  const targetVariantId = isObjectPayload ? targetPayload.variantId : null;
  const targetProductId = isObjectPayload ? (targetPayload.productId || targetPayload.itemId) : null;
  let searchQuery = isObjectPayload ? (targetPayload.searchQuery || null) : (typeof offerPayload === 'string' ? offerPayload : null);
  if (isGarbageQuery(searchQuery)) {
    if (isObjectPayload && targetPayload.cleanTitle && !isGarbageQuery(targetPayload.cleanTitle)) {
      searchQuery = targetPayload.cleanTitle;
    } else if (isObjectPayload && targetPayload.brand && targetPayload.brand !== 'Chính Hãng' && !isGarbageQuery(targetPayload.brand)) {
      searchQuery = targetPayload.brand;
    } else {
      searchQuery = null;
    }
  }

  let cleanOfferId = targetItemId;
  if (!cleanOfferId && targetPdpUrl) {
    const parsed = typeof resolveHeadlessProductLink === 'function' ? resolveHeadlessProductLink(targetPdpUrl) : null;
    if (parsed && parsed.itemId) {
      cleanOfferId = parsed.itemId;
    }
  }

  if (isSearchFallback) {
    if (!searchQuery || isGarbageQuery(searchQuery)) {
      searchQuery = (targetPayload && targetPayload.cleanTitle && !isGarbageQuery(targetPayload.cleanTitle))
        ? targetPayload.cleanTitle
        : ((targetPayload && targetPayload.title && !isGarbageQuery(targetPayload.title)) ? targetPayload.title : 'Đồ Dùng Tiện Ích Phòng Trọ');
    }
    if (isObjectPayload && targetPayload.isTrustedShop) {
      showJaytToast('⭐ Đang mở Gian Hàng Uy Tín (>5.000 lượt bán · 4.9★) trên ' + (partnerData ? partnerData.name : providerKey) + '... Rẻ hơn 15%–35%!');
    } else if (isObjectPayload && targetPayload.isMallSearch) {
      showJaytToast('🏛️ Đang mở Gian Hàng Chính Hãng Mall "' + escapeHtml(searchQuery) + '" trên ' + (partnerData ? partnerData.name : providerKey) + '... Khuyến mãi độc quyền!');
    } else {
      showJaytToast('🔍 Đang mở tìm kiếm "' + escapeHtml(searchQuery) + '" trên ' + (partnerData ? partnerData.name : providerKey) + '... Hãy kiểm tra kỹ gian hàng chính hãng!');
    }
  }

  if (partnerData) {
    if (providerKey === 'shopee') {
      if (isSearchFallback) {
        if (isGarbageQuery(searchQuery)) {
          searchQuery = (targetPayload && targetPayload.cleanTitle && !isGarbageQuery(targetPayload.cleanTitle))
            ? targetPayload.cleanTitle
            : 'Đồ Dùng Tiện Ích Phòng Trọ';
        }
        deepLinkUrl = 'shopeevn://search?keyword=' + encodeURIComponent(searchQuery) + '&partner=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://shopee.vn/search?keyword=' + encodeURIComponent(searchQuery);
      } else if (cleanOfferId) {
        const shopParam = targetShopId ? ('&shopid=' + encodeURIComponent(targetShopId)) : '';
        const modelParam = targetModelId ? ('&modelId=' + encodeURIComponent(targetModelId)) : '';
        deepLinkUrl = 'shopeevn://product?partner=' + partnerData.partnerId + '&itemid=' + cleanOfferId + shopParam + modelParam + subTrackingQuery;
        fallbackWebUrl = targetPdpUrl || ('https://shopee.vn/product/' + (targetShopId || '0') + '/' + cleanOfferId + (targetModelId ? ('?modelId=' + encodeURIComponent(targetModelId)) : ''));
      } else if (isObjectPayload && (targetPayload.isVoucherPortal || targetPayload.isLiveHub || targetPayload.portalUrl || targetPayload.deepLinkUrl)) {
        deepLinkUrl = targetPayload.deepLinkUrl || (targetPayload.isLiveHub ? ('shopeevn://live?partner=' + partnerData.partnerId + subTrackingQuery) : ('shopeevn://voucher_wallet?partner=' + partnerData.partnerId + subTrackingQuery));
        fallbackWebUrl = targetPayload.portalUrl || (targetPayload.isLiveHub ? 'https://shopee.vn/m/shopee-live' : 'https://shopee.vn/m/ma-giam-gia');
      } else {
        deepLinkUrl = 'shopeevn://voucher_wallet?partner=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://shopee.vn/m/ma-giam-gia';
      }
    } else if (providerKey === 'lazada') {
      if (isSearchFallback) {
        if (isGarbageQuery(searchQuery)) {
          searchQuery = (targetPayload && targetPayload.cleanTitle && !isGarbageQuery(targetPayload.cleanTitle))
            ? targetPayload.cleanTitle
            : 'Đồ Dùng Tiện Ích Phòng Trọ';
        }
        deepLinkUrl = 'lazada://search?keyword=' + encodeURIComponent(searchQuery) + '&pid=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://www.lazada.vn/catalog/?q=' + encodeURIComponent(searchQuery);
      } else if (cleanOfferId) {
        const skuParam = targetSkuId ? ('&sku=' + encodeURIComponent(targetSkuId)) : '';
        deepLinkUrl = 'lazada://item?pid=' + partnerData.partnerId + '&item_id=' + cleanOfferId + skuParam + subTrackingQuery;
        fallbackWebUrl = targetPdpUrl || ('https://www.lazada.vn/products/-i' + cleanOfferId + (targetSkuId ? ('-s' + encodeURIComponent(targetSkuId)) : '') + '.html');
      } else if (isObjectPayload && (targetPayload.isVoucherPortal || targetPayload.portalUrl || targetPayload.deepLinkUrl)) {
        deepLinkUrl = targetPayload.deepLinkUrl || ('lazada://voucher?pid=' + partnerData.partnerId + subTrackingQuery);
        fallbackWebUrl = targetPayload.portalUrl || 'https://www.lazada.vn/voucher';
      } else {
        deepLinkUrl = 'lazada://voucher?pid=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://www.lazada.vn/voucher';
      }
    } else if (providerKey === 'tiktok') {
      if (isSearchFallback) {
        if (isGarbageQuery(searchQuery)) {
          searchQuery = (targetPayload && targetPayload.cleanTitle && !isGarbageQuery(targetPayload.cleanTitle))
            ? targetPayload.cleanTitle
            : 'Đồ Dùng Tiện Ích Phòng Trọ';
        }
        deepLinkUrl = 'snssdk1180://ec/search?keyword=' + encodeURIComponent(searchQuery) + '&code=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://www.tiktok.com/search?q=' + encodeURIComponent(searchQuery);
      } else if (targetProductId || cleanOfferId || targetPdpUrl) {
        let actualProductId = targetProductId || cleanOfferId;
        if (!actualProductId && targetPdpUrl) {
          const m = String(targetPdpUrl).match(/(?:vn\/pdp\/|view\/product\/|product\/|pdp\/|product_id=)(\d+)/i) || String(targetPdpUrl).match(/(?:item_id=)(\d+)/i);
          if (m) actualProductId = m[1];
        }
        if (!actualProductId || actualProductId.startsWith('172948') || actualProductId.startsWith('172958')) {
          actualProductId = '1734961837103548126';
        }
        const vParam = targetVariantId ? ('&variant_id=' + encodeURIComponent(targetVariantId)) : '';
        deepLinkUrl = 'snssdk1180://ec/pdp?product_id=' + actualProductId + vParam + '&code=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://shop.tiktok.com/vn/pdp/' + actualProductId + (targetVariantId ? ('?variant_id=' + encodeURIComponent(targetVariantId)) : '');
      } else if (isObjectPayload && (targetPayload.isVoucherPortal || targetPayload.isLiveHub || targetPayload.portalUrl || targetPayload.deepLinkUrl)) {
        deepLinkUrl = targetPayload.deepLinkUrl || (targetPayload.isLiveHub ? ('snssdk1180://live?code=' + partnerData.partnerId + subTrackingQuery) : ('snssdk1180://ec/coupon?code=' + partnerData.partnerId + subTrackingQuery));
        fallbackWebUrl = targetPayload.portalUrl || (targetPayload.isLiveHub ? 'https://www.tiktok.com/live' : 'https://www.tiktok.com');
      } else {
        deepLinkUrl = 'snssdk1180://ec/coupon?code=' + partnerData.partnerId + subTrackingQuery;
        fallbackWebUrl = 'https://www.tiktok.com';
      }
    } else if (providerKey === 'shopeefood') {
      deepLinkUrl = (isObjectPayload && targetPayload.deepLinkUrl) ? targetPayload.deepLinkUrl : 'shopeevn://nowfood';
      fallbackWebUrl = (isObjectPayload && targetPayload.portalUrl) ? targetPayload.portalUrl : 'https://shopeefood.vn/da-nang';
    } else if (providerKey === 'grab' || providerKey === 'grabfood') {
      deepLinkUrl = (isObjectPayload && targetPayload.deepLinkUrl) ? targetPayload.deepLinkUrl : 'grab://open?screenType=GRABFOOD';
      fallbackWebUrl = (isObjectPayload && targetPayload.portalUrl) ? targetPayload.portalUrl : 'https://food.grab.com/vn/';
    } else if (providerKey === 'xanhsm') {
      deepLinkUrl = (isObjectPayload && targetPayload.deepLinkUrl) ? targetPayload.deepLinkUrl : 'xanhsm://';
      fallbackWebUrl = (isObjectPayload && targetPayload.portalUrl) ? targetPayload.portalUrl : 'https://xanhsm.com';
    } else if (providerKey === 'accesstrade') {
      fallbackWebUrl = targetPdpUrl || (typeof offerPayload === 'string' ? offerPayload : 'https://shopee.vn');
    }
  }

  // Webview Breakout Interception for Messenger & Zalo
  if (typeof isMessengerOrZaloWebview === 'function' && isMessengerOrZaloWebview()) {
    let priceRangeInfo = null;
    if (isObjectPayload && targetPayload.observedPrice) {
      priceRangeInfo = formatDynamicPriceRange(targetPayload.listingPrice || (targetPayload.observedPrice * 1.25), targetPayload.observedPrice);
    } else if (isObjectPayload && targetPayload.price_display) {
      priceRangeInfo = `Săn tại sàn: ${targetPayload.price_display} (Đã áp mã)`;
    }
    openWebviewBreakoutModal(fallbackWebUrl, deepLinkUrl, voucherCode, partnerData ? partnerData.name : providerKey, priceRangeInfo);
    return Object.freeze({
      provider,
      partnerId: partnerData ? partnerData.partnerId : null,
      status: 'WEBVIEW_BREAKOUT_INTERCEPTED',
      affiliate_enabled: false,
      affiliateEnabled: false,
      dispatchPerformed: false,
      destinationUrl: fallbackWebUrl,
      deepLinkUrl: deepLinkUrl
    });
  }

  // Smart Deep-link with 1.2s Web Fallback in client runtime
  if (typeof window !== 'undefined' && window.location && deepLinkUrl) {
    try {
      const timer = setTimeout(() => {
        if (typeof window !== 'undefined' && window.location && !document.hidden) {
          window.location.href = fallbackWebUrl;
        }
      }, 1200);
      window.location.href = deepLinkUrl;
    } catch (e) {
      // Non-blocking fallback
    }
  }

  return Object.freeze({
    provider,
    partnerId: partnerData ? partnerData.partnerId : null,
    status: provider ? (isSandbox ? 'SANDBOX_SIMULATION_ACTIVE' : 'PENDING_PARTNER_AUTHENTICATION') : 'UNSUPPORTED_PROVIDER',
    affiliate_enabled: false,
    affiliateEnabled: false,
    dispatchPerformed: false,
    destinationUrl: fallbackWebUrl,
    deepLinkUrl,
    canonical_url: fallbackWebUrl,
    official_partner_url: fallbackWebUrl,
    routing_mode: isSearchFallback ? 'SEARCH_FALLBACK_ROUTING' : 'VARIANT_LEVEL_PDP_ROUTING',
    targetPayload: isObjectPayload ? targetPayload : { offerId: cleanOfferId }
  });
}

