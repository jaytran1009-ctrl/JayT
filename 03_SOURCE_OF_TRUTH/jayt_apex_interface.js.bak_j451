const JAYT_FNB_GOLDEN_HOURS = Object.freeze({
  slots: [
    { id: 'LUNCH', startH: 11, startM: 0, endH: 12, endM: 30, label: 'Khung Giờ Vàng Trưa (11:00–12:30)' },
    { id: 'DINNER', startH: 16, startM: 30, endH: 18, endM: 30, label: 'Khung Giờ Vàng Chiều Tối (16:30–18:30)' }
  ],
  vouchers: [
    {
      id: 'FNB_SPFOOD_30K',
      platform: 'ShopeeFood',
      badge: '🔥 Giảm 30K',
