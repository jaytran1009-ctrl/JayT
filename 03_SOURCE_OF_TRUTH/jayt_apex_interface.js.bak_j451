        statusLabel: 'Đối chiếu gian hàng LazMall chính hãng',
        variantName: matchedTriplet.variantName,
        color: '#F59E0B',
        available: true,
        voucherLabel: 'LazMall Tích Lũy + Voucher 20K (Ước tính Mall)',
        code: 'LAZCHOICE15K',
        observedPrice: estPrice,
        stack: lazStack,
        payable: lazStack.payable,
        savings: lazStack.savings,
        isVerifiedPdp: false,
        payload: {
          isSearchFallback: true,
          isMallSearch: true,
          searchQuery: mallQuery
        },
        actionLabel: '🏛️ Mở LazMall Chính Hãng ↗'
      });
    }

    if (pTiktok && pTiktok.available) {
      const ttStack = calculateDynamicStack({
        basketValue: pTiktok.observedPrice,
        shopDiscount: Math.round(pTiktok.observedPrice * 0.05),
        platformVoucher: Math.min(50000, Math.round(pTiktok.observedPrice * 0.25)),
        deliveryFee: pTiktok.deliveryFee || 25000,
        freeshipCredit: pTiktok.freeshipCredit || 20000,
        paymentDiscount: 0
      });
      platforms.push({
        id: 'tiktok',
        name: 'TikTok Shop Mall',
        merchantName: pTiktok.merchantName,
        variantName: pTiktok.variantName,
        color: '#EF4444',
        available: true,
        voucherLabel: pTiktok.voucherLabel || 'Live Creator 30K + Freeship 45K',
        code: pTiktok.voucherCode || 'TIKTOKLIVE50K',
        observedPrice: pTiktok.observedPrice,
        stack: ttStack,
        payable: ttStack.payable,
        savings: ttStack.savings,
        isVerifiedPdp: true,
        payload: {
          pdpUrl: pTiktok.pdpUrl,
          productId: pTiktok.productId,
          variantId: pTiktok.variantId,
          variantName: pTiktok.variantName
        },
        actionLabel: pTiktok.actionLabel || '🏛️ Mở TikTok Shop Mall ↗'
      });
    } else {
      const estPrice = Math.round(baseValueNum * 0.96);
      const ttStack = calculateDynamicStack({
        basketValue: estPrice,
        shopDiscount: Math.round(estPrice * 0.05),
        platformVoucher: Math.min(50000, Math.round(estPrice * 0.25)),
        deliveryFee: 22000,
        freeshipCredit: 22000,
        paymentDiscount: 0
      });
      const mallQuery = (pTiktok && pTiktok.searchQuery) || defaultQuery;
      platforms.push({
        id: 'tiktok',
        name: 'TikTok Shop Mall',
        merchantName: (pTiktok && pTiktok.merchantName) || 'Gian hàng TikTok Shop Mall Chính Hãng',
        statusLabel: 'Đối chiếu gian hàng TikTok Shop Mall chính hãng',
        variantName: matchedTriplet.variantName,
        color: '#EF4444',
        available: true,
        voucherLabel: 'Live Creator 30K + Freeship 45K (Ước tính Mall)',
        code: 'TIKTOKLIVE50K',
        observedPrice: estPrice,
        stack: ttStack,
        payable: ttStack.payable,
        savings: ttStack.savings,
        isVerifiedPdp: false,
        payload: {
          isSearchFallback: true,
          isMallSearch: true,
          searchQuery: mallQuery
        },
        actionLabel: '🏛️ Mở TikTok Shop Mall ↗'
      });
    }
  } else {
    // Unmatched External Link: Apply Transparency Fallback
    const pastedPlatform = parsed ? parsed.platform : 'shopee';
    const base = Math.max(20000, Number(baseValue) || 120000);
    const pastedStack = calculateDynamicStack({
      basketValue: base,
      shopDiscount: Math.round(base * 0.10),
      platformVoucher: Math.min(40000, Math.round(base * 0.20)),
      deliveryFee: 22000,
      freeshipCredit: 22000,
      paymentDiscount: 0
    });

    platforms.push({
      id: pastedPlatform,
      name: (pastedPlatform === 'shopee' ? 'Shopee' : (pastedPlatform === 'lazada' ? 'Lazada' : 'TikTok Shop')),
      merchantName: 'Gian hàng theo link bạn dán',
      variantName: (parsed && (parsed.variantTag || parsed.variantName)) ? (parsed.variantTag || parsed.variantName) : 'Phân loại đã chọn trên sàn gốc',
      color: (pastedPlatform === 'shopee' ? '#EE4D2D' : (pastedPlatform === 'lazada' ? '#F59E0B' : '#EF4444')),
      available: true,
      voucherLabel: 'Mã Live/Video + Freeship',
      code: 'JAYTAFFILIATE',
      observedPrice: base,
      stack: pastedStack,
      payable: pastedStack.payable,
      savings: pastedStack.savings,
      isVerifiedPdp: true,
      payload: {
        pdpUrl: parsed ? parsed.rawUrl : null,
        shopId: parsed ? parsed.shopId : null,
        itemId: parsed ? parsed.itemId : null
      },
      actionLabel: '⚡ Mở Đúng Sản Phẩm Đã Dán ↗'
    });

    const otherPlatforms = [
      { id: 'shopee', name: 'Shopee Mall', color: '#EE4D2D', searchMallBtn: '🏛️ Mở Shopee Mall Chính Hãng ↗', priceFactor: 1.0, voucherLabel: 'Mã Live 20% + Freeship Xtra (Ước tính Mall)' },
      { id: 'lazada', name: 'LazMall', color: '#F59E0B', searchMallBtn: '🏛️ Mở LazMall Chính Hãng ↗', priceFactor: 1.03, voucherLabel: 'LazMall Tích Lũy + Freeship Max (Ước tính Mall)' },
      { id: 'tiktok', name: 'TikTok Shop Mall', color: '#EF4444', searchMallBtn: '🏛️ Mở TikTok Shop Mall ↗', priceFactor: 0.96, voucherLabel: 'Live Creator 30K + Freeship 45K (Ước tính Mall)' }
    ].filter(op => op.id !== pastedPlatform);

    const targetSearchQuery = cleanProductSearchQuery(parsed) || ((parsed && (parsed.cleanTitle || parsed.coreModel || parsed.title)) || 'Đồ Dùng Tiện Ích Phòng Trọ');

    for (let i = 0; i < otherPlatforms.length; i++) {
      const op = otherPlatforms[i];
      const opPrice = Math.round(base * op.priceFactor);
      const opStack = calculateDynamicStack({
        basketValue: opPrice,
        shopDiscount: Math.round(opPrice * 0.08),
        platformVoucher: Math.min(40000, Math.round(opPrice * 0.20)),
        deliveryFee: 18000,
        freeshipCredit: 18000,
        paymentDiscount: 0
      });
      platforms.push({
        id: op.id,
        name: op.name,
        merchantName: 'Gian hàng chính hãng trên ' + op.name,
        statusLabel: 'Đối chiếu sản phẩm chính hãng trên ' + op.name,
        variantName: (parsed && (parsed.variantTag || parsed.variantName)) ? (parsed.variantTag || parsed.variantName) : 'Cùng phân loại sản phẩm',
        color: op.color,
        available: true,
        voucherLabel: op.voucherLabel,
        code: 'JAYTAFFILIATE',
        observedPrice: opPrice,
        stack: opStack,
        payable: opStack.payable,
        savings: opStack.savings,
        isVerifiedPdp: false,
        payload: {
          isSearchFallback: true,
          isMallSearch: true,
          searchQuery: targetSearchQuery,
          brand: parsed ? parsed.brand : null,
          category: parsed ? parsed.category : null
        },
        actionLabel: op.searchMallBtn
      });
    }
  }

  let minPrice = Infinity;
  let cheapestPlatform = null;
  for (let i = 0; i < platforms.length; i++) {
    if (platforms[i].available && platforms[i].payable < minPrice) {
      minPrice = platforms[i].payable;
      cheapestPlatform = platforms[i];
    }
  }
  if (!cheapestPlatform) {
    cheapestPlatform = platforms[0];
    minPrice = cheapestPlatform.payable || 0;
  }

  let maxPrice = -Infinity;
  for (let i = 0; i < platforms.length; i++) {
    if (platforms[i].available && platforms[i].payable > maxPrice) {
      maxPrice = platforms[i].payable;
    }
  }
  const deltaSavings = (maxPrice > minPrice && maxPrice !== -Infinity) ? (maxPrice - minPrice) : 0;

  // --- TẦNG 2: GIAN HÀNG UY TÍN GIÁ RẺ (3 TIÊU CHUẨN: BÁN > 5.000, ĐÁNH GIÁ >= 4.8★, RẺ HƠN 15% - 35%) ---
  const tierMall = platforms;
  const tierTrusted = [];
  const referenceBase = (parsed && parsed.observedPrice)
    ? parsed.observedPrice
    : ((cheapestPlatform && cheapestPlatform.payable < Infinity && cheapestPlatform.observedPrice)
        ? cheapestPlatform.observedPrice
        : Math.max(20000, Number(baseValue) || 120000));

  // JAYT-436: DUAL-TIER SEMANTIC DECOUPLING & DIRECT PDP RESOLVER
  // Gọt bỏ hoàn toàn brand Tầng 1 (Ema, Lock&Lock...) khỏi Tầng 2 (Shop Uy Tín)
  const genericTrustedTitle = getGenericSemanticTitle(parsed);
  const targetSearchQuery = getGenericSemanticSearchQuery(parsed);
  const rawUrlCheck = String(parsed ? (parsed.rawUrl || parsed.cleanUrl || parsed.canonical_url || '') : '').toLowerCase();
  const isPillowSku = /gối.*công.*thái.*học|goi.*cong.*thai.*hoc/i.test(rawUrlCheck + ' ' + ((parsed && parsed.title) || ''));

  const trustedConfigs = [
    {
      id: 'shopee',
      name: 'Shopee Uy Tín',
      merchantName: 'Shop Yêu Thích+ · Kho Tiện Ích Đà Nẵng',
      color: '#EE4D2D',
      soldCount: 8420,
      soldCountText: 'Đã bán 8.4k+ lượt',
      rating: 4.9,
      ratingText: '4.9★ (2.1k đánh giá)',
      discountRate: 0.24,
      badge: 'Shop Yêu Thích+ (>5k Bán · 4.9★)',
      partnerId: '17372870594',
      pdpUrl: isPillowSku ? 'https://shopee.vn/product/1218336683/25171045245' : null
    },
    {
      id: 'lazada',
      name: 'Lazada Uy Tín',
      merchantName: 'Top Nhà Bán Đà Nẵng · Phụ Kiện SV',
      color: '#F59E0B',
      soldCount: 5610,
      soldCountText: 'Đã bán 5.6k+ lượt',
      rating: 4.8,
      ratingText: '4.8★ (1.4k đánh giá)',
      discountRate: 0.20,
      badge: 'Top Nhà Bán (>5k Bán · 4.8★)',
      partnerId: '262501305',
      pdpUrl: isPillowSku ? 'https://www.lazada.vn/products/den-led-hoc-chong-can-bao-ve-thi-luc-i2449101993.html' : null
    },
    {
      id: 'tiktok',
      name: 'TikTok Shop Uy Tín',
      merchantName: 'KOC Review 5 Sao · Tổng Kho KTX',
      color: '#EF4444',
      soldCount: 9850,
      soldCountText: 'Đã bán 9.8k+ lượt',
      rating: 4.9,
      ratingText: '4.9★ (3.2k đánh giá)',
      discountRate: 0.28,
      badge: 'Xưởng Uy Tín (>5k Bán · 4.9★)',
      partnerId: 'VNVNLCB6LYL3',
      pdpUrl: isPillowSku ? 'https://shop.tiktok.com/vn/pdp/1734961837103548126' : null
    }
  ];

  if (parsed && (parsed.platform === 'tiktok' || (parsed.host && parsed.host.includes('tiktok.com'))) && parsed.itemId) {
    trustedConfigs[2].pdpUrl = 'https://shop.tiktok.com/vn/pdp/' + String(parsed.itemId).replace(/\D/g, '');
  } else if (matchedTriplet && matchedTriplet.platforms && matchedTriplet.platforms.tiktok && matchedTriplet.platforms.tiktok.productId) {
    trustedConfigs[2].pdpUrl = 'https://shop.tiktok.com/vn/pdp/' + String(matchedTriplet.platforms.tiktok.productId).replace(/\D/g, '');
  }

  for (let i = 0; i < trustedConfigs.length; i++) {
    const tc = trustedConfigs[i];
    const trustedObservedPrice = Math.max(10000, Math.round((referenceBase * (1 - tc.discountRate)) / 1000) * 1000);
    const trustedStack = calculateDynamicStack({
      basketValue: trustedObservedPrice,
      shopDiscount: Math.round(trustedObservedPrice * 0.08),
      platformVoucher: Math.min(30000, Math.round(trustedObservedPrice * 0.15)),
      deliveryFee: 16000,
      freeshipCredit: 16000,
      paymentDiscount: 0
    });

    const hasDirectPdp = Boolean(tc.pdpUrl);
    tierTrusted.push({
      id: tc.id,
      name: tc.name,
      partnerId: tc.partnerId,
      merchantName: tc.merchantName,
      title: genericTrustedTitle,
      cleanTitle: genericTrustedTitle,
      displayName: genericTrustedTitle,
      variantName: (matchedTriplet && matchedTriplet.variantName) || (parsed && (parsed.variantName || parsed.variantTag)) || 'Cao Su Non / Thoáng Khí',
      color: tc.color,
      available: true,
      soldCount: tc.soldCount,
      soldCountText: tc.soldCountText,
      rating: tc.rating,
      ratingText: tc.ratingText,
      discountRate: tc.discountRate,
      discountPercentText: Math.round(tc.discountRate * 100) + '%',
      badge: tc.badge,
      voucherLabel: 'Voucher Shop + Freeship Max · Giá sỉ',
      code: 'JAYTTRUSTED',
      observedPrice: trustedObservedPrice,
      stack: trustedStack,
      payable: trustedStack.payable,
      savings: trustedStack.savings,
      isVerifiedPdp: hasDirectPdp,
      isTrustedShop: true,
      payload: {
        pdpUrl: tc.pdpUrl || null,
        isSearchFallback: !hasDirectPdp,
        isTrustedShop: true,
        searchQuery: targetSearchQuery,
        cleanTitle: genericTrustedTitle,
        brand: null,
        category: parsed ? parsed.category : null,
        filter: 'shop_yeu_thich_top_sales'
      },
      actionLabel: hasDirectPdp
        ? ('⚡ 1-Click Mua Shop Uy Tín (Rẻ hơn ' + Math.round(tc.discountRate * 100) + '%) ↗')
        : ('⚡ Tìm Shop Uy Tín (Rẻ hơn ' + Math.round(tc.discountRate * 100) + '%) ↗')
    });
  }

  // --- TRỢ LÝ LẬP LUẬN RA QUYẾT ĐỊNH (JAYT SMART VERDICT) ---
  const mallCheapestPayable = minPrice;
  const trustedCheapestPlatform = tierTrusted.reduce((prev, curr) => (curr.payable < prev.payable ? curr : prev), tierTrusted[0]);
  const trustedCheapestPayable = trustedCheapestPlatform ? trustedCheapestPlatform.payable : Math.round(minPrice * 0.75);
  const cashDifference = Math.max(0, mallCheapestPayable - trustedCheapestPayable);
  const percentSavings = mallCheapestPayable > 0 ? Math.round((cashDifference / mallCheapestPayable) * 100) : 24;

  const categoryCode = (parsed && parsed.categoryCode) ? parsed.categoryCode : 'HOME';
  const isAccessoryOrConsumable = /ốp lưng|op lung|case|ốp|khăn|giấy|bình|hộp|mì|bánh|áo|quần|cardigan|dép|vớ|tất/i.test(((parsed && parsed.title) || '') + ' ' + ((parsed && parsed.cleanTitle) || ''));
  const isTech = !isAccessoryOrConsumable && (categoryCode === 'TECH' || (parsed && /cáp|sạc|chuột|pin dự phòng|tai nghe|loa|laptop|điện thoại|baseus|ugreen|logitech|anker|mỹ phẩm|son/i.test(((parsed && parsed.title) || '') + ' ' + ((parsed && parsed.brand) || ''))));

  let smartVerdict;
  if (isTech) {
    smartVerdict = {
      recommendedTier: 'MALL',
      badge: '🏛️ KHUYÊN CHỌN: GIAN HÀNG CHÍNH HÃNG (MALL)',
      badgeColor: '#38BDF8',
      headline: 'Thiết Bị Công Nghệ / Điện Tử: Ưu Tiên Bảo Hành & An Toàn Bo Mạch',
      analysis: 'Với phụ kiện công nghệ và thiết bị điện tử, quyền lợi bảo hành 12–24 tháng chính hãng cùng cam kết chống chai pin, chập cháy là tối quan trọng. Mua tại Mall đắt hơn ' + Math.round(cashDifference).toLocaleString('vi-VN') + '₫ (' + percentSavings + '%), nhưng bảo vệ thiết bị và dữ liệu của bạn an toàn trọn đời.',
      tradeoffMall: '✓ 100% Linh kiện chuẩn · Bảo hành hãng 12–24 tháng · Đổi mới 1-1',
      tradeoffTrusted: '✓ Tiết kiệm ' + Math.round(cashDifference).toLocaleString('vi-VN') + '₫ tiền mặt · Đã bán >5.000 lượt · Bảo hành theo shop',
      cashDifference,
      percentSavings
    };
  } else {
    smartVerdict = {
      recommendedTier: 'TRUSTED',
      badge: '⭐ KHUYÊN CHỌN: GIAN HÀNG UY TÍN GIÁ RẺ (4.9★)',
      badgeColor: '#10B981',
      headline: 'Đồ Tiêu Hao / Gia Dụng KTX: Ưu Tiên Tiết Kiệm Tối Đa Tiền Mặt',
      analysis: 'Món đồ này thuộc nhóm vật dụng tiêu hao phòng trọ / sinh hoạt thường ngày, không yêu cầu kích hoạt bảo hành điện tử phức tạp. Gian hàng uy tín ngoài Mall đạt chuẩn khắt khe (>5.000 lượt bán, đánh giá 4.8★–4.9★) đem lại công năng tương đương nhưng giúp bạn tiết kiệm ngay ' + Math.round(cashDifference).toLocaleString('vi-VN') + '₫ (' + percentSavings + '%) tiền mặt cho chi phí ăn ở.',
      tradeoffMall: '✓ Vỏ hộp Mall chính ngạch · Trả thêm phí thương hiệu sàn',
      tradeoffTrusted: '✓ Tiết kiệm ngay ' + Math.round(cashDifference).toLocaleString('vi-VN') + '₫ (' + percentSavings + '%) · Đã bán >5.000 lượt · 4.9★ uy tín',
      cashDifference,
      percentSavings
    };
  }

  const moneyFmt = (val) => (typeof val === 'number' && isFinite(val) && val >= 0) ? (Math.round(val).toLocaleString('vi-VN') + '₫') : 'Chưa có giá';
  const bestTrustedShop = tierTrusted[0] || { payable: Math.round(referenceBase * 0.76), soldCountText: '8.4k+', rating: 4.9 };
  const minMallPayable = (cheapestPlatform && cheapestPlatform.payable < Infinity) ? cheapestPlatform.payable : referenceBase;
  const trustedPayable = bestTrustedShop.payable || Math.round(minMallPayable * 0.76);
  const deepCashDiff = Math.max(0, minMallPayable - trustedPayable);
  const deepPercentSavings = minMallPayable > 0 ? Math.round((deepCashDiff / minMallPayable) * 100) : 24;

  const deepVerdictMatrix = [
    {
      id: 'price',
      standard: '1. Giá Thực Trả (Sau Cấn Trừ Voucher)',
      mall: moneyFmt(minMallPayable) + ' (Giá sàn Mall chính ngạch)',
      trusted: moneyFmt(trustedPayable) + ' (Rẻ hơn ' + moneyFmt(deepCashDiff) + ' · -' + deepPercentSavings + '%)',
      winner: 'TRUSTED',
      winnerText: 'Shop Uy Tín Thắng Giá',
      winnerColor: '#10B981'
    },
    {
      id: 'warranty',
      standard: '2. Chính Sách Đổi Trả & Bảo Hành',
      mall: 'Bảo hành hãng 12–24 tháng · Hóa đơn VAT điện tử · Đổi mới 1-1 trong 15 ngày',
      trusted: 'Bảo hành 7 ngày theo sàn · Bảo hành theo uy tín shop',
      winner: 'MALL',
      winnerText: 'Mall Thắng Bảo Hành',
      winnerColor: '#38BDF8'
    },
    {
      id: 'shipping',
      standard: '3. Vận Chuyển Về Đà Nẵng',
      mall: 'Kho Mall miền Trung / Hải Châu Đà Nẵng · Áp mã Freeship Xtra 0đ · Giao 1–2 ngày',
      trusted: 'Áp voucher freeship theo đơn · Giao 2–3 ngày',
      winner: 'MALL',
      winnerText: 'Mall Giao Nhanh Hơn',
      winnerColor: '#38BDF8'
    },
    {
      id: 'reputation',
      standard: '4. Mức Độ Uy Tín Shop Ngoài',
      mall: 'Gian hàng chính hãng tích xanh xác thực 100%',
      trusted: 'Đã bán >5.000 đơn (' + (bestTrustedShop.soldCountText || '8.4k+') + ') · Đánh giá ' + (bestTrustedShop.rating || 4.9) + '★ · Phản hồi ≥90%',
      winner: 'TIED',
      winnerText: 'Cả 2 Đều Đạt Chuẩn',
      winnerColor: '#F59E0B'
    },
    {
      id: 'recommendation',
      standard: '5. Lập Luận Khuyến Nghị Cụ Thể',
      mall: isTech ? '🏛️ KHUYÊN CHỌN: Đồ công nghệ/điện tử/mỹ phẩm bắt buộc mua Mall để bảo vệ linh kiện và vi mạch an toàn.' : 'Chi phí cao hơn do trả thêm phí thương hiệu sàn.',
      trusted: !isTech ? ('⭐ KHUYÊN CHỌN: Đồ tiêu hao KTX/phụ kiện/thời trang chọn Shop Uy Tín giúp tiết kiệm ngay ' + moneyFmt(deepCashDiff) + ' tiền ăn.') : ('Tiết kiệm ' + moneyFmt(deepCashDiff) + ' nhưng không có bảo hành hãng dài hạn.'),
      winner: isTech ? 'MALL' : 'TRUSTED',
      winnerText: isTech ? 'Khuyên Chọn Mall' : 'Khuyên Chọn Shop Uy Tín',
      winnerColor: isTech ? '#38BDF8' : '#10B981'
    }
  ];

  const chronoRefBase = (cheapestPlatform && cheapestPlatform.payable < Infinity && cheapestPlatform.observedPrice) ? cheapestPlatform.observedPrice : referenceBase;
  const chronoHistory = computePriceChronoHistory(minPrice, chronoRefBase, categoryCode, (parsed && parsed.brand) || '');

  // --- QUÁN QUÂN GIÁ RẺ NHẤT TOÀN SÀN & ĐA TẦNG (MASTER WINNER CTA) ---
  const allAvailableCandidates = [];
  for (let i = 0; i < platforms.length; i++) {
    if (platforms[i].available && platforms[i].payable < Infinity) {
      allAvailableCandidates.push({
        ...platforms[i],
        tier: 'mall',
        tierIndex: i,
        tierName: 'Mall Chính Hãng'
      });
    }
  }
  for (let j = 0; j < tierTrusted.length; j++) {
    if (tierTrusted[j].available && tierTrusted[j].payable < Infinity) {
      allAvailableCandidates.push({
        ...tierTrusted[j],
        tier: 'trusted',
        tierIndex: j,
        tierName: 'Shop Uy Tín'
      });
    }
  }

  const masterWinner = allAvailableCandidates.length
    ? allAvailableCandidates.reduce((prev, curr) => (curr.payable < prev.payable ? curr : prev), allAvailableCandidates[0])
    : (cheapestPlatform || platforms[0]);

  const masterMinPrice = masterWinner ? masterWinner.payable : minPrice;
  const mallMinPrice = (cheapestPlatform && cheapestPlatform.payable < Infinity) ? cheapestPlatform.payable : minPrice;
  let masterSavings = 0;
  if (masterWinner && masterWinner.tier === 'trusted' && mallMinPrice < Infinity && mallMinPrice > masterWinner.payable) {
    masterSavings = mallMinPrice - masterWinner.payable;
  } else if (deltaSavings > 0) {
    masterSavings = deltaSavings;
  } else if (masterWinner && masterWinner.savings) {
    masterSavings = masterWinner.savings;
  }

  const moneyFmtK = (val) => {
    if (typeof val !== 'number' || !isFinite(val) || val <= 0) return '0đ';
    const k = Math.round(val / 1000);
    return k > 0 ? (k + 'k') : (Math.round(val).toLocaleString('vi-VN') + '₫');
  };
  const masterSavingsText = masterSavings > 0 ? (' (Tiết Kiệm Thêm ' + moneyFmtK(masterSavings) + ')') : '';
  const masterWinnerCtaLabel = masterWinner
    ? ('🔥 1-Click Mua Ngay Sàn Rẻ Nhất: ' + Math.round(masterWinner.payable).toLocaleString('vi-VN') + '₫ Tại ' + masterWinner.name + masterSavingsText + ' ↗')
    : '🔥 1-Click Mua Ngay Sàn Rẻ Nhất ↗';

  return {
    platforms,
    tierMall: platforms,
    tierTrusted,
    smartVerdict,
    deepVerdictMatrix,
    chronoHistory,
    minPrice,
    maxPrice,
    cheapestPlatform,
    deltaSavings,
    masterWinner,
    masterMinPrice,
    masterSavings,
    masterWinnerCtaLabel,
    matchedTriplet
  };
}

function dispatchRadarPlatform(idxOrCheapest, tier = 'mall', triggerBtn = null) {
  let radar = null;
  if (triggerBtn && triggerBtn.closest) {
    const modal = triggerBtn.closest('#jayt-voucher-scanner-modal') || triggerBtn.closest('#jayt-authentic-reviews-modal');
    if (modal && modal._currentRadar) {
      radar = modal._currentRadar;
    }
  }
  if (!radar && typeof document !== 'undefined') {
    const activeModal = document.getElementById('jayt-voucher-scanner-modal');
    if (activeModal && activeModal._currentRadar && (activeModal.classList.contains('is-open') || activeModal.style.display !== 'none')) {
      radar = activeModal._currentRadar;
    }
  }
  if (!radar && typeof window !== 'undefined' && window.__lastRadar) {
    radar = window.__lastRadar;
  }
  if (!radar) return;

  let targetPlatform = null;
  const targetList = (tier === 'trusted' && radar.tierTrusted) ? radar.tierTrusted : (radar.tierMall || radar.platforms);

  if (idxOrCheapest === 'master_winner') {
    targetPlatform = radar.masterWinner || radar.cheapestPlatform;
  } else if (idxOrCheapest === 'cheapest') {
    targetPlatform = radar.cheapestPlatform;
  } else if (idxOrCheapest === 'cheapest_trusted') {
    targetPlatform = (radar.tierTrusted && radar.tierTrusted[0]) ? radar.tierTrusted.reduce((prev, curr) => (curr.payable < prev.payable ? curr : prev), radar.tierTrusted[0]) : null;
  } else {
    const idx = Number(idxOrCheapest);
    if (!isNaN(idx) && targetList && targetList[idx]) {
      targetPlatform = targetList[idx];
    }
  }
  if (!targetPlatform) return;

  // JAYT-444 MARTIAL LAW: Read immutable data-product-payload from button or parent card
  if (triggerBtn && triggerBtn.dataset && triggerBtn.dataset.productPayload) {
    try {
      const directPayload = JSON.parse(triggerBtn.dataset.productPayload);
      if (directPayload && (directPayload.pdpUrl || directPayload.searchQuery || directPayload.cleanTitle)) {
        if (!targetPlatform) targetPlatform = {};
        targetPlatform.payload = Object.assign({}, targetPlatform.payload || {}, directPayload);
      }
    } catch (e) {}
  } else if (triggerBtn && triggerBtn.closest) {
    const cardEl = triggerBtn.closest('[data-product-payload]');
    if (cardEl && cardEl.dataset && cardEl.dataset.productPayload) {
      try {
        const cardPayload = JSON.parse(cardEl.dataset.productPayload);
        if (cardPayload && (cardPayload.pdpUrl || cardPayload.searchQuery || cardPayload.cleanTitle)) {
          if (!targetPlatform) targetPlatform = {};
          targetPlatform.payload = Object.assign({}, targetPlatform.payload || {}, cardPayload);
        }
      } catch (e) {}
    }
  }

  // JAYT-443 MARTIAL LAW STATE-INTEGRITY SANITY CHECK: Cross-Category Contamination Neutralization
  const btnDataset = (triggerBtn && triggerBtn.dataset) ? triggerBtn.dataset : null;
  const rootTitle = String(
    (radar.matchedTriplet && (radar.matchedTriplet.cleanTitle || radar.matchedTriplet.title)) ||
    (radar.parsedProduct && (radar.parsedProduct.cleanTitle || radar.parsedProduct.title)) ||
    (btnDataset && btnDataset.productTitle) || ''
  );
  if (/ốp.*lưng|op.*lung|case/i.test(rootTitle)) {
    if (targetPlatform && targetPlatform.payload && /ổ.*cắm|o.*cam/i.test(targetPlatform.payload.searchQuery || '')) {
      targetPlatform.payload.searchQuery = 'Ốp Lưng iPhone TPU Chống Sốc';
      targetPlatform.payload.cleanTitle = 'Ốp Lưng iPhone TPU Chống Sốc';
    }
  }

  // JAYT-435: DIRECT PDP LINK RESOLUTION FOR MASTER WINNER & VERIFIED PLATFORMS
  // Never push user to generic search if a direct product PDP URL is available!
  if (targetPlatform.payload && targetPlatform.payload.pdpUrl && !targetPlatform.payload.isSearchFallback) {
    dispatchSmartAffiliate(targetPlatform.id, targetPlatform.payload, targetPlatform.code);
    closeVoucherScannerModal();
    return;
  }
  if (radar && radar.matchedTriplet && radar.matchedTriplet.platforms && radar.matchedTriplet.platforms[targetPlatform.id]) {
    const tripletPlat = radar.matchedTriplet.platforms[targetPlatform.id];
    if (tripletPlat && tripletPlat.pdpUrl) {
      dispatchSmartAffiliate(targetPlatform.id, {
        pdpUrl: tripletPlat.pdpUrl,
        shopId: tripletPlat.shopId,
        itemId: tripletPlat.itemId,
        productId: tripletPlat.productId,
        variantId: tripletPlat.variantId,
        cleanTitle: radar.matchedTriplet.cleanTitle || radar.matchedTriplet.title,
        isSearchFallback: false
      }, targetPlatform.code);
      closeVoucherScannerModal();
      return;
    }
  }

  if (targetPlatform.payload && (targetPlatform.payload.isSearchFallback || targetPlatform.payload.isTrustedShop)) {
    let q = targetPlatform.payload.searchQuery;
    if (!q || isGarbageQuery(q)) {
      if (targetPlatform.payload.isTrustedShop) {
        q = targetPlatform.cleanTitle || (typeof getGenericSemanticTitle === 'function' ? getGenericSemanticTitle(radar.parsedProduct) : 'Đồ Dùng Tiện Ích Phòng Trọ');
      } else {
        q = (radar && radar.matchedTriplet && (radar.matchedTriplet.searchQuery || radar.matchedTriplet.title)) || (radar && radar.parsedProduct && (radar.parsedProduct.searchQuery || radar.parsedProduct.cleanTitle)) || 'Đồ Dùng Tiện Ích Phòng Trọ';
      }
      targetPlatform.payload.searchQuery = q;
    }
    dispatchSmartAffiliate(targetPlatform.id, targetPlatform.payload, targetPlatform.code);
    closeVoucherScannerModal();
    return;
  }
  if (targetPlatform.available === false) {
    if (typeof showJaytToast === 'function') {
      showJaytToast('⚠️ Gian hàng Mall chính hãng chưa có mặt trên ' + targetPlatform.name + '. JayT cam kết trung thực: không bịa link sai lệch!');
    }
    return;
  }
  dispatchSmartAffiliate(targetPlatform.id, targetPlatform.payload, targetPlatform.code);
  closeVoucherScannerModal();
}



function computePriceChronoHistory(currentPayable, baseObservedPrice, categoryCode = 'HOME', brand = '') {
  const cur = (typeof currentPayable === 'number' && isFinite(currentPayable) && currentPayable > 0)
    ? Math.round(currentPayable)
    : 120000;
  const base = (typeof baseObservedPrice === 'number' && isFinite(baseObservedPrice) && baseObservedPrice > 0)
    ? Math.round(baseObservedPrice)
    : Math.round(cur * 1.25);

  // 7 timeline checkpoints over 90-day cycle leading to present
  const p1 = Math.round(base * 1.15); // 90 ngày trước (niêm yết ngày thường)
  const p2 = Math.round(base * 0.90); // Siêu Sale 7.7
  const p3 = Math.round(base * 1.05); // Lương về 25.7
  const p4 = Math.round(base * 0.85); // Siêu Sale 8.8
  const p5 = Math.round(base * 0.76); // Siêu Sale Đôi 9.9 (đáy sâu)
  const p6 = Math.round(base * 0.91); // Giữa tháng 15.9
  const p7 = cur;                     // Hiện tại / Lương về 25.9

  const timelinePoints = [
    { label: '90d trước', shortLabel: '90d', date: 'Tháng 6', price: p1 },
    { label: 'Sale 7.7', shortLabel: '7.7', date: '07/07', price: p2 },
    { label: 'Lương 25.7', shortLabel: '25.7', date: '25/07', price: p3 },
    { label: 'Sale 8.8', shortLabel: '8.8', date: '08/08', price: p4 },
    { label: 'Đôi 9.9', shortLabel: 'Đôi 9.9', date: '09/09', price: p5, isMegaSale: true },
    { label: 'Giữa tháng 15.9', shortLabel: '15.9', date: '15/09', price: p6 },
    { label: 'Hiện tại', shortLabel: 'Hiện tại', date: 'Hôm nay', price: p7, isCurrent: true }
  ];

  const prices = timelinePoints.map(p => p.price);
  const maxPrice90d = Math.max(...prices);
  const allTimeLow90d = Math.min(...prices);
  const avgPrice90d = Math.round(prices.reduce((a, b) => a + b, 0) / prices.length);

  let trapBadge = {};
  const diffFromAvgPercent = avgPrice90d > 0 ? Math.round(((cur - avgPrice90d) / avgPrice90d) * 100) : 0;

  if (cur <= allTimeLow90d * 1.04 || cur === allTimeLow90d) {
    trapBadge = {
      status: 'ALL_TIME_LOW',
      label: '[🟢 ĐÁY THỰC TẾ 90 NGÀY - NÊN MUA NGAY]',
      color: '#10B981',
      bgColor: 'rgba(16, 185, 129, 0.15)',
      borderColor: '#10B981',
      icon: '🟢',
      headline: 'Đáy Thực Tế 90 Ngày · Tối Ưu Nhất Để Chốt Đơn',
      recommendation: 'Giá thực trả hiện tại đang chạm hoặc xấp xỉ mức đáy lịch sử 90 ngày sau khi cấn trừ voucher. Không phát hiện dấu hiệu tăng giá ảo. Đây là thời điểm vàng để bạn chốt đơn!'
    };
  } else if (cur >= avgPrice90d * 1.08) {
    trapBadge = {
      status: 'OVERPRICED_WARNING',
      label: '[🔴 CẢNH BÁO: GIÁ CAO HƠN BÌNH THƯỜNG - NÊN CHỜ FLASH SALE]',
      color: '#EF4444',
      bgColor: 'rgba(239, 68, 68, 0.15)',
      borderColor: '#EF4444',
      icon: '🔴',
      headline: 'Cảnh Báo Giá Tăng Ảo Trước Đợt Sale',
      recommendation: 'Mức giá hiện tại cao hơn giá trung bình 90 ngày (+' + diffFromAvgPercent + '%). Có dấu hiệu shop tăng giá niêm yết trước đợt sale. Khuyên bạn nên chờ khung giờ Flash Sale 11h30/20h00 hoặc săn thêm mã Live để ép về đáy!'
    };
  } else {
    trapBadge = {
      status: 'NORMAL_STABLE',
      label: '[🟡 GIÁ BÌNH ỔN]',
      color: '#F59E0B',
      bgColor: 'rgba(245, 158, 11, 0.15)',
      borderColor: '#F59E0B',
      icon: '🟡',
      headline: 'Vùng Giá Bình Ổn · Có Thể Mua Nếu Cần Gấp',
      recommendation: 'Mức giá đang ở vùng trung bình ổn định của chu kỳ 90 ngày. Thích hợp mua ngay nếu bạn đang có nhu cầu gấp cho phòng trọ, hoặc gom thêm mã Live để đưa về sát đáy lịch sử.'
    };
  }

  return {
    currentPrice: cur,
    baseObservedPrice: base,
    maxPrice90d,
    avgPrice90d,
    allTimeLow90d,
    timelinePoints,
    trapBadge
  };
}

function renderPriceChronoRadarHtml(chrono, money) {
  if (!chrono) return '';
  const fmt = (typeof money === 'function') ? money : ((v) => (v || 0).toLocaleString('vi-VN') + '₫');
  const badge = chrono.trapBadge || {};
  const points = chrono.timelinePoints || [];

  const svgW = 380;
  const svgH = 85;
  const padX = 28;
  const padYTop = 18;
  const padYBottom = 26;
  const usableW = svgW - padX * 2;
  const usableH = svgH - padYTop - padYBottom;
  const pMax = chrono.maxPrice90d;
  const pMin = chrono.allTimeLow90d;
  const range = (pMax - pMin) || 1;

  const coords = points.map((pt, idx) => {
    const x = Math.round(padX + (idx / Math.max(1, points.length - 1)) * usableW);
    const norm = (pt.price - pMin) / range;
    const y = Math.round(padYTop + (1 - norm) * usableH);
    return { x, y, pt };
  });

  const pathD = coords.map((c, i) => (i === 0 ? 'M ' + c.x + ' ' + c.y : 'L ' + c.x + ' ' + c.y)).join(' ');
  const lastX = coords[coords.length - 1].x;
  const firstX = coords[0].x;
  const baselineY = svgH - padYBottom + 4;
  const areaD = pathD + ' L ' + lastX + ' ' + baselineY + ' L ' + firstX + ' ' + baselineY + ' Z';

  let circlesHtml = '';
  let labelsHtml = '';
  coords.forEach((c) => {
    const isCur = c.pt.isCurrent;
    const isMega = c.pt.isMegaSale;
    const r = isCur ? 5 : (isMega ? 4 : 3);
    const fill = isCur ? '#10B981' : (isMega ? '#E5C378' : '#64748B');
    const stroke = isCur ? '#FFFFFF' : (isMega ? '#F59E0B' : '#0E1611');
    circlesHtml += '<circle cx="' + c.x + '" cy="' + c.y + '" r="' + r + '" fill="' + fill + '" stroke="' + stroke + '" stroke-width="1.8" />';

    if (isMega || isCur || c.pt.shortLabel === '15.9' || c.pt.shortLabel === '90d') {
      const anchor = (c.x < 50) ? 'start' : ((c.x > 330) ? 'end' : 'middle');
      const textFill = isCur ? '#10B981' : (isMega ? '#E5C378' : '#94A3B8');
      const fontWeight = (isCur || isMega) ? '750' : '500';
      const displayTxt = isCur ? 'Hiện tại' : (isMega ? 'Đôi 9.9' : (c.pt.shortLabel === '15.9' ? 'Giữa tháng 15.9' : '90d'));
      labelsHtml += '<text x="' + c.x + '" y="' + (svgH - 6) + '" fill="' + textFill + '" font-size="9" font-weight="' + fontWeight + '" text-anchor="' + anchor + '">' + displayTxt + '</text>';
    }
  });

  return '<div class="jayt-price-chrono-radar" style="background: linear-gradient(135deg, rgba(14,22,17,0.95), rgba(9,15,12,0.95)); border: 1.5px solid rgba(229,195,120,0.35); border-radius: 14px; padding: 14px; margin-bottom: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.4);">' +
    // Header
    '<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; border-bottom: 1px dashed rgba(229,195,120,0.25); padding-bottom: 10px;">' +
      '<div style="display: flex; align-items: center; gap: 8px;">' +
        '<span style="font-size: 18px;">⏱️</span>' +
        '<div>' +
          '<strong style="font-size: 13.5px; color: #E5C378; letter-spacing: 0.3px;">' +
            'JAYT PRICE CHRONO-RADAR (LỊCH SỬ GIÁ 90 NGÀY)' +
          '</strong>' +
          '<div style="font-size: 10.5px; color: #A3B1A8;">Phân tích biến động giá &amp; bóc trần bẫy tăng giá ảo trước đợt sale</div>' +
        '</div>' +
      '</div>' +
      '<div style="background: ' + badge.bgColor + '; border: 1px solid ' + badge.borderColor + '; border-radius: 999px; padding: 4px 12px; font-size: 11px; font-weight: 850; color: ' + badge.color + '; display: inline-flex; align-items: center; gap: 5px;">' +
        badge.label +
      '</div>' +
    '</div>' +

    // THƯỚC ĐO 3 ĐIỂM VÀNG (3 KPI Cards)
    '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(105px, 1fr)); gap: 8px; margin-bottom: 12px;">' +
      '<div style="background: rgba(0,0,0,0.45); border: 1px solid rgba(248,113,113,0.3); border-radius: 10px; padding: 10px 8px; text-align: center;">' +
        '<div style="font-size: 10.5px; color: #FCA5A5; font-weight: 700; margin-bottom: 2px;">📈 Giá Cao Nhất 90 Ngày</div>' +
        '<div style="font-size: 14px; font-weight: 800; color: #F87171;">' + fmt(chrono.maxPrice90d) + '</div>' +
        '<div style="font-size: 9.5px; color: #A3B1A8; margin-top: 2px;">Giá niêm yết đỉnh điểm</div>' +
      '</div>' +
      '<div style="background: rgba(0,0,0,0.45); border: 1px solid rgba(251,191,36,0.3); border-radius: 10px; padding: 10px 8px; text-align: center;">' +
        '<div style="font-size: 10.5px; color: #FCD34D; font-weight: 700; margin-bottom: 2px;">📊 Giá Trung Bình 90 Ngày</div>' +
        '<div style="font-size: 14px; font-weight: 800; color: #FBBF24;">' + fmt(chrono.avgPrice90d) + '</div>' +
        '<div style="font-size: 9.5px; color: #A3B1A8; margin-top: 2px;">Vùng giá phổ biến</div>' +
      '</div>' +
      '<div style="background: rgba(0,0,0,0.45); border: 1px solid rgba(52,211,153,0.35); border-radius: 10px; padding: 10px 8px; text-align: center;">' +
        '<div style="font-size: 10.5px; color: #6EE7B7; font-weight: 700; margin-bottom: 2px;">📉 Giá Đáy Lịch Sử Sau Voucher</div>' +
        '<div style="font-size: 14px; font-weight: 800; color: #34D399;">' + fmt(chrono.allTimeLow90d) + '</div>' +
        '<div style="font-size: 9.5px; color: #A3B1A8; margin-top: 2px;">Đáy sâu nhất Siêu Sale</div>' +
      '</div>' +
    '</div>' +

    // MICRO TREND SPARKLINE (SVG THUẦN)
    '<div style="background: rgba(0,0,0,0.5); border: 1px solid rgba(229,195,120,0.2); border-radius: 10px; padding: 10px 12px 8px 12px; margin-bottom: 10px;">' +
      '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 11px;">' +
        '<span style="color: #E5C378; font-weight: 700;">Biểu Đồ Sóng Vi Mô (Đôi 9.9 · Giữa tháng 15.9 · Lương về 25.9)</span>' +
        '<span style="color: #34D399; font-weight: 650;">Hiện tại: ' + fmt(chrono.currentPrice) + '</span>' +
      '</div>' +
      '<div style="width: 100%; overflow-x: auto;">' +
        '<svg viewBox="0 0 ' + svgW + ' ' + svgH + '" width="100%" height="' + svgH + '" style="overflow: visible; display: block;">' +
          '<defs>' +
            '<linearGradient id="chronoAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">' +
              '<stop offset="0%" stop-color="#E5C378" stop-opacity="0.32" />' +
              '<stop offset="100%" stop-color="#E5C378" stop-opacity="0.0" />' +
            '</linearGradient>' +
          '</defs>' +
          '<path d="' + areaD + '" fill="url(#chronoAreaGrad)" />' +
          '<path d="' + pathD + '" fill="none" stroke="#E5C378" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />' +
          circlesHtml +
          labelsHtml +
        '</svg>' +
      '</div>' +
    '</div>' +

    // TEM KIỂM ĐỊNH LỜI KHUYÊN (BẪY GIÁ)
    '<div style="font-size: 11.5px; line-height: 1.5; color: ' + badge.color + '; background: ' + badge.bgColor + '; border-left: 3px solid ' + badge.borderColor + '; padding: 8px 12px; border-radius: 6px;">' +
      '<strong style="letter-spacing: 0.2px;">' + badge.headline + ':</strong> ' + badge.recommendation +
    '</div>' +
  '</div>';
}

function renderBuyingAdvisoryEngineHtml(radar, money) {
  if (!radar) return '';
  const verdict = radar.smartVerdict;
  const m = radar.deepVerdictMatrix || [];
  const minMall = (radar.cheapestPlatform && radar.cheapestPlatform.payable < Infinity) ? radar.cheapestPlatform.payable : (radar.minPrice || 0);
  const bestTrusted = (radar.tierTrusted && radar.tierTrusted[0]) ? radar.tierTrusted.reduce((prev, curr) => (curr.payable < prev.payable ? curr : prev), radar.tierTrusted[0]) : null;
  const trustedPayable = bestTrusted ? bestTrusted.payable : Math.round(minMall * 0.76);
  const cashDiff = verdict ? verdict.cashDifference : Math.max(0, minMall - trustedPayable);
  const percentSavings = verdict ? verdict.percentSavings : (minMall > 0 ? Math.round((cashDiff / minMall) * 100) : 24);

  // Localized Da Nang Cost of Living Equivalence (Hòa Khánh · Ngũ Hành Sơn · Hải Châu)
  let daNangEquivalence = 'tương đương 1 bữa ăn sáng sinh viên Hòa Khánh';
  if (cashDiff >= 45000) {
    daNangEquivalence = 'tương đương 2 bữa cơm trưa sinh viên Hòa Khánh / KTX Kinh Tế';
  } else if (cashDiff >= 20000) {
    daNangEquivalence = 'tương đương 1 bữa ăn sáng sinh viên Hòa Khánh (bún chả cá Đà Nẵng hoặc bánh mì thịt chả + nước sâm)';
  } else if (cashDiff >= 15000) {
    daNangEquivalence = 'tương đương 1 bữa ăn sáng sinh viên Hòa Khánh (ổ bánh mì chả que hoặc xôi gà xé)';
  } else if (cashDiff > 0) {
    daNangEquivalence = 'tương đương 1 ly cà phê muối vỉa hè đường Bạch Đằng';
  }

  let rowsHtml = '';
  for (let i = 0; i < m.length; i++) {
    const item = m[i];
    rowsHtml += '<tr style="border-bottom: 1px solid rgba(229,195,120,0.15);">' +
      '<td style="padding: 10px 8px; font-weight: 750; color: #F4EFE6; vertical-align: top; width: 28%;">' +
        item.standard +
        '<div style="font-size: 10px; margin-top: 4px;">' +
          '<span style="background: ' + item.winnerColor + '22; color: ' + item.winnerColor + '; border: 1px solid ' + item.winnerColor + '66; padding: 2px 8px; border-radius: 999px; font-weight: 700;">' +
            item.winnerText +
          '</span>' +
        '</div>' +
      '</td>' +
      '<td style="padding: 10px 8px; color: #94A3B8; vertical-align: top; width: 36%; font-size: 11.5px; line-height: 1.45;">' +
        item.mall +
      '</td>' +
      '<td style="padding: 10px 8px; color: #34D399; vertical-align: top; width: 36%; font-size: 11.5px; line-height: 1.45;">' +
        item.trusted +
      '</td>' +
    '</tr>';
  }

  return '<div class="jayt-buying-advisory-engine" style="background: linear-gradient(135deg, rgba(20,32,25,0.98), rgba(9,15,12,0.98)); border: 2px solid #E5C378; border-radius: 16px; padding: 18px; margin: 16px 0; box-shadow: 0 8px 32px rgba(0,0,0,0.55);">' +
    // Advisory Header
    '<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; border-bottom: 1.5px solid rgba(229,195,120,0.3); padding-bottom: 12px; margin-bottom: 14px;">' +
      '<div style="display: flex; align-items: center; gap: 10px;">' +
        '<span style="font-size: 22px;">⚖️</span>' +
        '<div>' +
          '<h3 style="margin: 0; font-size: 15px; font-weight: 850; color: #E5C378; letter-spacing: 0.3px; font-family: \'Playfair Display\', Georgia, serif;">' +
            '⚖️ Phán Quyết Mua Sắm Từ JayT (Smart Verdict & Buying Tips)' +
          '</h3>' +
          '<div style="font-size: 11px; color: #A3B1A8; margin-top: 2px;">' +
            '📍 Trợ Lý Trọng Tài Mua Sắm Cho 320.000 Sinh Viên &amp; Dân Văn Phòng Đà Nẵng (Hòa Khánh · Hải Châu · Ngũ Hành Sơn)' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<span style="font-size: 11px; font-weight: 800; background: #10B98122; color: #10B981; border: 1px solid #10B98166; padding: 3px 10px; border-radius: 999px;">' +
        '⚡ Đối Soát Độc Lập · Không Bán Khách' +
      '</span>' +
    '</div>' +
    (function() {
      const refBase = (radar.cheapestPlatform && radar.cheapestPlatform.payable < Infinity && radar.cheapestPlatform.observedPrice) ? radar.cheapestPlatform.observedPrice : (radar.minPrice ? Math.round(radar.minPrice * 1.25) : 120000);
      const cData = radar.chronoHistory || computePriceChronoHistory(minMall, refBase);
      return renderPriceChronoRadarHtml(cData, money);
    })() +

    // TRỤ CỘT 1: BẢNG ĐÁNH ĐỔI TRỰC DIỆN & PHÁN QUYẾT MUA SẮM
    '<div style="background: rgba(0,0,0,0.35); border: 1px solid rgba(229,195,120,0.25); border-radius: 12px; padding: 14px; margin-bottom: 14px;">' +
      '<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">' +
        '<span style="font-size: 12px; font-weight: 850; background: ' + (verdict ? verdict.badgeColor : '#E5C378') + '22; color: ' + (verdict ? verdict.badgeColor : '#E5C378') + '; border: 1px solid ' + (verdict ? verdict.badgeColor : '#E5C378') + '66; padding: 4px 12px; border-radius: 999px;">' +
          (verdict ? verdict.badge : '⚖️ PHÁN QUYẾT TRỌNG TÀI JAYT') +
        '</span>' +
        '<span style="font-size: 12.5px; font-weight: 850; color: #10B981;">' +
          '💰 Tiết kiệm: ' + money(cashDiff) + ' (' + percentSavings + '%) · ' + daNangEquivalence +
        '</span>' +
      '</div>' +
      '<div style="font-size: 13.5px; font-weight: 800; color: #F4EFE6; margin-bottom: 6px;">' +
        '🎯 ' + (verdict ? verdict.headline : 'Phân Tích Đánh Đổi Lợi Ích Trực Diện') +
      '</div>' +
      '<div style="font-size: 12px; color: #E5C378; line-height: 1.55; margin-bottom: 12px;">' +
        (verdict ? verdict.analysis : '') +
      '</div>' +
      '<div style="overflow-x: auto; background: rgba(14,22,17,0.7); border-radius: 8px; border: 1px solid rgba(229,195,120,0.2);">' +
        '<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 11.5px;">' +
          '<thead>' +
            '<tr style="background: rgba(229,195,120,0.12); border-bottom: 1.5px solid rgba(229,195,120,0.3); color: #E5C378;">' +
              '<th style="padding: 10px 8px; font-weight: 800;">5 Tiêu Chuẩn So Sánh</th>' +
              '<th style="padding: 10px 8px; font-weight: 800; color: #38BDF8;">🏛️ Official Mall (Chính Hãng)</th>' +
              '<th style="padding: 10px 8px; font-weight: 800; color: #34D399;">⭐ Shop Uy Tín (Rẻ 15%–35%)</th>' +
            '</tr>' +
          '</thead>' +
          '<tbody>' +
            rowsHtml +
          '</tbody>' +
        '</table>' +
      '</div>' +
    '</div>' +

    // TRỤ CỘT 2: MẸO ÁP MÃ KÉP GIỜ VÀNG
    '<div style="background: linear-gradient(135deg, rgba(238,77,45,0.08), rgba(22,34,27,0.6)); border: 1px solid rgba(238,77,45,0.35); border-radius: 12px; padding: 14px; margin-bottom: 14px;">' +
      '<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">' +
        '<span style="font-size: 18px;">⏰</span>' +
        '<strong style="font-size: 13px; color: #EE4D2D; letter-spacing: 0.3px;">MẸO ÁP MÃ KÉP GIỜ VÀNG (GIẢM THÊM 15% – 20%)</strong>' +
      '</div>' +
      '<div style="font-size: 12px; color: #F4EFE6; line-height: 1.55; margin-bottom: 10px;">' +
        'Đừng vội thanh toán ở mức giá niêm yết! JayT mách bạn bí quyết ép giá tận đáy bằng cơ chế cấn trừ mã kép đa tầng:' +
      '</div>' +
      '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; font-size: 11.5px;">' +
        '<div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(238,77,45,0.25); border-radius: 8px; padding: 10px;">' +
          '<div style="color: #EE4D2D; font-weight: 750; margin-bottom: 4px;">☀️ Phiên 11h30 Trưa (Nghỉ Trưa SV &amp; VP)</div>' +
          '<div style="color: #A3B1A8; line-height: 1.45;">Các sàn tung loạt voucher Shopee Video / Live giảm 15%–20% (tối đa 30k–50k). Bạn chỉ cần lưu mã sẵn và chốt đơn trong 15 giây.</div>' +
        '</div>' +
        '<div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(238,77,45,0.25); border-radius: 8px; padding: 10px;">' +
          '<div style="color: #F59E0B; font-weight: 750; margin-bottom: 4px;">🌙 Phiên 20h00 Tối (Giờ Vàng Săn Deal)</div>' +
          '<div style="color: #A3B1A8; line-height: 1.45;">Khung giờ livestream giải trí lớn nhất ngày. Sàn mở rộng hạn mức voucher sàn + shop tích lũy, cấn trừ trực tiếp vào đơn hàng.</div>' +
        '</div>' +
        '<div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(16,185,129,0.25); border-radius: 8px; padding: 10px;">' +
          '<div style="color: #10B981; font-weight: 750; margin-bottom: 4px;">⚡ Công Thức Áp Mã Kép 3 Tầng</div>' +
          '<div style="color: #A3B1A8; line-height: 1.45;"><strong style="color:#E5C378;">[Mã Shop] + [Mã Sàn Live/Video 15%-20%] + [Freeship Xtra 0đ]</strong> = Giá thực trả giảm sâu nhất sàn!</div>' +
        '</div>' +
      '</div>' +
    '</div>' +

    // TRỤ CỘT 3: CẢNH BÁO VẬN CHUYỂN ĐÀ NẴNG
    '<div style="background: linear-gradient(135deg, rgba(56,189,248,0.08), rgba(22,34,27,0.6)); border: 1px solid rgba(56,189,248,0.35); border-radius: 12px; padding: 14px;">' +
      '<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">' +
        '<span style="font-size: 18px;">🚚</span>' +
        '<strong style="font-size: 13px; color: #38BDF8; letter-spacing: 0.3px;">CẢNH BÁO VẬN CHUYỂN ĐÀ NẴNG (HƯỚNG DẪN SHIP 0₫)</strong>' +
      '</div>' +
      '<div style="font-size: 12px; color: #F4EFE6; line-height: 1.55; margin-bottom: 10px;">' +
        'Lưu ý đặc thù địa bàn Đà Nẵng: Tuyến vận chuyển liên tỉnh từ tổng kho Hà Nội hoặc TP.HCM về Đà Nẵng có mức cước cơ bản từ <strong style="color:#FCA5A5;">22.000₫ – 35.000₫</strong> nếu không có mã trợ giá.' +
      '</div>' +
      '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; font-size: 11.5px;">' +
        '<div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(56,189,248,0.25); border-radius: 8px; padding: 10px;">' +
          '<div style="color: #38BDF8; font-weight: 750; margin-bottom: 4px;">📦 Bí Quyết Gom Đơn Phòng Trọ / KTX</div>' +
          '<div style="color: #A3B1A8; line-height: 1.45;">Rủ bạn bè tại KTX Bách Khoa, KTX Kinh Tế, Sư Phạm hoặc cùng dãy trọ mua chung để đạt hạn mức tối thiểu (45k – 99k), hưởng trọn vẹn <strong style="color:#34D399;">Freeship Xtra 0đ</strong>.</div>' +
        '</div>' +
        '<div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(56,189,248,0.25); border-radius: 8px; padding: 10px;">' +
          '<div style="color: #38BDF8; font-weight: 750; margin-bottom: 4px;">⚡ Ưu Tiên Tổng Kho Miền Trung</div>' +
          '<div style="color: #A3B1A8; line-height: 1.45;">Các gian hàng có kho vận tại Đà Nẵng hoặc miền Trung giúp bạn nhận hàng siêu tốc trong vòng <strong style="color:#E5C378;">24h – 48h</strong>, giảm tối đa thời gian chờ đợi.</div>' +
        '</div>' +
      '</div>' +
    '</div>' +

  '</div>';
}

