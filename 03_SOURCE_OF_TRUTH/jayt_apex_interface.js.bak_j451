            </div>
            <div style="background:rgba(255,255,255,0.1); height:5px; border-radius:3px; overflow:hidden;">
              <div style="background:#10B981; width:${review.metrics.delivery}%; height:100%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: BẢN TÓM TẮT KHEN / CHÊ 30 GIÂY -->
      <div style="margin-bottom:16px;">
        <div style="display:flex; align-items:center; gap:6px; margin-bottom:10px;">
          <span style="font-size:16px;">⏱️</span>
          <strong style="font-size:13.5px; color:#E5C378; text-transform:uppercase; letter-spacing:0.3px;">Bản Tóm Tắt Khen / Chê 30 Giây (Toán Học Nhất Quán ABSA)</strong>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:12px;">
          <!-- 3 ƯU ĐIỂM ĐƯỢC KHEN NHIỀU NHẤT -->
          <div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.3); border-radius:12px; padding:12px 14px;">
            <div style="display:flex; align-items:center; gap:6px; margin-bottom:8px; color:#34D399; font-size:12px; font-weight:800; text-transform:uppercase;">
              <span>🟢 Điểm Được Khen Nhiều Nhất (Lượt Đề Cập Thực Tế)</span>
            </div>
            <ul style="margin:0; padding-left:16px; font-size:11.5px; line-height:1.55; color:#F4EFE6;">
              ${review.pros.map(p => `<li style="margin-bottom:6px;">${escapeHtml(p)}</li>`).join('')}
            </ul>
          </div>

          <!-- 1-2 NHƯỢC ĐIỂM NGƯỜI BÁN HAY GIẤU -->
          <div style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:12px; padding:12px 14px;">
