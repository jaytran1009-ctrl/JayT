        <div>
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:20px;">🎟️</span>
            <h3 style="margin:0; font-size:18px; font-weight:850; color:#E5C378; font-family:'Playfair Display', Georgia, serif; letter-spacing:0.3px;">
              Bách Khoa Voucher 100% Affiliate · Sàn Thương Mại &amp; Đồ Ăn
            </h3>
          </div>
          <p style="margin:4px 0 0 0; font-size:12px; color:#A3B1A8;">
            Voucher độc quyền chọn lọc cho SV Đà Nẵng: Shopee Live 50%, TikTok Shop, Lazada Max, ShopeeFood, Grab, Xanh SM
          </p>
        </div>
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <button type="button" class="btn-chrono-open-modal" onclick="triggerJaytSensoryFeedback(event); openChronoReminderModal()" style="font-size:11.5px; font-weight:750; background:rgba(229,195,120,0.2); color:#E5C378; border:1px solid rgba(229,195,120,0.5); padding:6px 14px; border-radius:999px; cursor:pointer; display:inline-flex; align-items:center; gap:5px;">
            <span>🔔 Nhắc Giờ Săn &amp; Lịch Sale</span>
          </button>
          <span style="font-size:11.5px; font-weight:750; background:rgba(229,195,120,0.15); color:#E5C378; border:1px solid rgba(229,195,120,0.4); padding:5px 12px; border-radius:999px;">Đang hiển thị: ${visibleVouchers.length} mã hot</span>
        </div>
      </div>

      <!-- JAYT-433: CỖ MÁY LỊCH DỰ BÁO SIÊU SALE & RADAR GIỜ VÀNG NHẢ MÃ ẨN -->
      ${renderJaytChronoCalendarHtml()}

      <!-- BẢNG ĐỐI SOÁT GIÁ TRỊ: TỰ VÀO APP SÀN (1.454 VOUCHER) VS. TRUY CẬP QUA JAYT (BỘ LỌC TINH HOA) -->
      <div class="jayt-voucher-paradox-card" style="background:linear-gradient(135deg, rgba(14,22,17,0.96), rgba(8,13,10,0.98)); border:1.5px solid rgba(229,195,120,0.45); border-radius:16px; padding:18px 20px; margin-bottom:18px; box-shadow:0 6px 24px rgba(0,0,0,0.45);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px; border-bottom:1px solid rgba(229,195,120,0.25); padding-bottom:10px;">
          <div style="display:flex; align-items:center; gap:10px;">
            <span style="font-size:22px;">⚖️</span>
