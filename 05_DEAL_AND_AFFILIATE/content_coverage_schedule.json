  "tri_state_result_rules": {
    "STATE_1_PROMOTION_DETAIL": {
      "criteria": "Có trang khuyến mãi chi tiết công khai, ghi nhận rõ giá ưu đãi, thời hạn, điều kiện áp dụng",
      "candidate_action": "Tạo hoặc cập nhật Candidate JSON với revision mới",
      "readiness_state": "READY_FOR_CEO_REVIEW",
      "eligible_for_staging_review": true
    },
    "STATE_2_NO_PUBLIC_PROMO_OR_GENERIC": {
      "criteria": "Trang thông tin sản phẩm, giới thiệu chung, menu chuẩn, banner sự kiện không có giá/hạn cụ thể cho chi nhánh Đà Nẵng",
      "candidate_action": "Ghi nhận trạng thái bằng chứng trung thực, không tự gán giá/voucher giả định",
      "readiness_state": "NEEDS_RECHECK",
      "render_eligible": false,
      "deal_price": null
    },
    "STATE_3_CHALLENGE_OR_NOT_FOUND_OR_DYNAMIC": {
      "criteria": "Bị chặn bởi anti-bot/Cloudflare, trang 404, hoặc voucher cá nhân hóa trong app yêu cầu đăng nhập",
      "candidate_action": "Ghi nhận mã capture receipt và lý do kỹ thuật chi tiết",
      "readiness_state": "NEEDS_RECHECK",
      "render_eligible": false,
