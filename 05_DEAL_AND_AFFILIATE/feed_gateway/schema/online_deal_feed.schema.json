{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JayT Online Deal Feed Item Schema",
  "description": "Standardized schema for incoming online platform affiliate feeds with trust boundary provenance",
  "type": "object",
  "required": [
    "feed_provider",
    "external_deal_id",
    "item_name",
    "original_price",
    "discounted_price",
    "currency",
    "conditions",
    "valid_from",
    "valid_to",
    "affiliate_tracking_url",
    "affiliate_disclosure",
    "volatile_flag",
    "raw_payload_sha256",
    "ingestion_timestamp",
    "provenance_audit"
  ],
  "properties": {
    "feed_provider": {
      "type": "string",
      "enum": [
        "ACCESSTRADE_VN",
        "MASOFFER_VN",
        "ECOMMOBI_VN",
        "SHOPEE_AFFILIATE",
        "LAZADA_AFFILIATE",
        "TIKTOK_AFFILIATE",
        "AFFILIATE_NETWORK_API",
        "OFFICIAL_OPEN_PLATFORM_API"
      ]
    },
    "external_deal_id": {
      "type": "string",
      "minLength": 1
    },
    "item_name": {
      "type": "string",
      "minLength": 3
    },
    "original_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "discounted_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "discount_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "currency": {
      "type": "string",
      "enum": [
        "VND",
        "USD"
      ]
    },
    "voucher_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "object",
      "required": [
        "min_spend",
        "user_eligibility",
        "payment_method",
        "transparent_rules"
      ],
      "properties": {
        "min_spend": {
          "type": "number",
          "minimum": 0
        },
        "user_eligibility": {
          "type": "string",
          "minLength": 1
        },
        "payment_method": {
          "type": "string",
          "minLength": 1
        },
        "transparent_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "affiliate_tracking_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "affiliate_disclosure": {
      "type": "string",
      "enum": [
        "AFFILIATE_LINK"
      ]
    },
    "volatile_flag": {
      "type": "boolean",
      "const": true
    },
    "raw_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ingestion_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_audit": {
      "type": "object",
      "required": [
        "provider_id",
        "endpoint_protocol",
        "source_item_id",
        "received_at",
        "raw_payload_sha256",
        "trust_boundary_verified"
      ],
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "endpoint_protocol": {
          "type": "string",
          "enum": [
            "HTTPS"
          ]
        },
        "source_item_id": {
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trust_boundary_verified": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "governance_status": {
      "type": "string",
      "enum": [
        "RAW_PROVIDER_PAYLOAD",
        "POTENTIAL_UNVERIFIED_SOURCE",
        "PENDING_CANDIDATE_REVIEW"
      ]
    }
  },
  "additionalProperties": false
}